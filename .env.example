# 9jaBeacon Environment & Automation Configuration

# ----------------------------------------------------
# 1. Tier 1 (Primary AI): Cloudflare Workers AI
# Auto-cascades: llama-3.1-8b -> llama-3.3-70b -> llama-3.2-3b -> mistral-7b -> qwen-14b
# Image: @cf/black-forest-labs/flux-1-schnell
# ----------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# ----------------------------------------------------
# 2. Tier 2 (Fallback 1): OpenRouter Multi-Model Cloud AI
# Auto-cascades across active free/fast models:
# llama-3.3-70b:free -> gemini-2.0-flash-exp:free -> mistral-7b:free -> deepseek-r1:free -> qwen-2.5-72b -> gpt-4o-mini
# ----------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ----------------------------------------------------
# 3. Tier 3 (Fallback 2): Pollinations AI (Zero Key Required)
# Auto-cascades: openai -> mistral -> llama -> searchgpt
# ----------------------------------------------------
POLLINATIONS_API_KEY=

# ----------------------------------------------------
# 4. Image CDN: Cloudinary Unsigned Upload
# ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=phwka7ak
CLOUDINARY_UPLOAD_PRESET=voxawell

# ----------------------------------------------------
# General Site & Admin Settings
# ----------------------------------------------------
ADMIN_SECRET_KEY=naijapulse_admin_key_2025
SITE_URL=https://9jabeacon.pages.dev
SITE_NAME=9jaBeacon
