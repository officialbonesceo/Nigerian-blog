---
interface FAQItem {
  question: string;
  answer: string;
  category: string;
}

const FAQ_LIST: FAQItem[] = [
  {
    category: 'Currency & Market Rates',
    question: 'How are the daily Naira exchange rates (USD, GBP, EUR, CAD, USDT) verified?',
    answer: '9jaBeacon aggregates daily foreign exchange benchmarks through official Central Bank of Nigeria (CBN) autonomous NAFEM interbank filings, paired with direct surveys of Bureau De Change (BDC) street trading corridors across Broad Street Lagos, Wuse Zone 4 Abuja, and verified P2P digital liquidity wires. Benchmarks update continuously four times daily (Morning Open, Mid-Day Fix, Closing Corridor, and Evening Recap) to provide actionable pricing transparency for importers, diaspora remittancers, freelancers, and students.',
  },
  {
    category: 'Verification Standards',
    question: 'How does 9jaBeacon verify breaking news and maintain factual accuracy?',
    answer: 'All reporting on 9jaBeacon is corroborated through primary source documentation, verified institutional gazettes, regulatory disclosures, and vetted ground correspondents across Nigeria and international wire bureaus. We enforce a strict two-source corroboration rule before tagging any development as "Breaking News," ensuring readers receive factual, bias-free reporting rather than unverified social media rumor.',
  },
  {
    category: 'Editorial Corrections & Tips',
    question: 'How can readers submit whistleblower news tips or request factual corrections?',
    answer: 'Our newsroom operates under a transparent open-corrections charter. If an article contains an inadvertent error or new verifiable facts emerge, stakeholders and readers can submit documentation directly to our Contact & Editorial desk. Validated corrections are published with an editorial timestamp at the top of the article. Confidentially protected news tips and whistleblower dossiers can also be transmitted through our secure editorial channels.',
  },
  {
    category: 'Community Discussions',
    question: 'How do reader perspectives and community comments work?',
    answer: 'Readers can contribute civil viewpoints, constructive insights, and commentary directly under published stories. Submissions are screened against defamatory language, hate speech, and spam to foster respectful, insightful public discourse while honoring genuine civic dialogue on national affairs.',
  },
  {
    category: 'Weekly Rankings',
    question: 'How is "Most Read This Week" determined?',
    answer: 'Rankings reflect authentic aggregate reader engagement on our stories during the current 7-day rolling window. Rankings update dynamically based on genuine unique reader sessions, page scroll depth, and reading duration, resetting weekly to guarantee fresh coverage rather than stale archive repetition.',
  },
  {
    category: 'Publishing Transparency',
    question: 'What does the "Sponsored Feature" badge mean on partner guides?',
    answer: 'To protect editorial independence and comply with digital advertising standards, any commercial partnerships or sponsored resources are clearly labeled as sponsored features. Commercial sponsors have zero input or influence over our independent investigative reporting or newsroom decisions.',
  },
  {
    category: 'Mobile & Data Efficiency',
    question: 'How is 9jaBeacon optimized for fast reading on Nigerian mobile networks?',
    answer: '9jaBeacon is engineered with ultra-lightweight responsive markup, high-compression modern WebP visuals, and Progressive Web App (PWA) client caching. The entire website loads in under 1 second on standard 3G/4G mobile connections, using less than 150KB of baseline bandwidth so readers can access timely information without wasting costly mobile data.',
  },
  {
    category: 'Syndication & RSS Feeds',
    question: 'Can readers subscribe to 9jaBeacon via RSS feeds or social wires?',
    answer: 'Yes. 9jaBeacon provides full RSS syndication across all categories at /rss.xml, along with dedicated category feeds. Real-time alerts and news highlights are syndicated to our verified social feeds on Bluesky (@9jabeacon.bsky.social), Facebook, YouTube, and partner wires with strict anti-spam rate controls.',
  },
];

// Schema.org FAQPage structured data for Google Rich Snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': FAQ_LIST.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<!-- FAQ Section: Collapsible Drawer (Closed by default to keep UI clean and compact) -->
<section id="faq-section" class="my-8">
  <!-- FAQ Schema for Google Rich Snippets -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <details class="group/faq rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-xs transition-all overflow-hidden">
    <summary class="p-4 sm:p-5 flex items-center justify-between cursor-pointer list-none select-none hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <span>Editorial Standards & Reader FAQ</span>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Verification criteria, reader guidelines, and editorial policies
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 font-mono hidden sm:inline">
          {FAQ_LIST.length} Questions
        </span>
        <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-open/faq:rotate-180 group-open/faq:bg-emerald-500/10 group-open/faq:text-emerald-600 dark:group-open/faq:text-emerald-400 transition-all duration-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </summary>

    <!-- Expandable Content (Shown when user clicks) -->
    <div class="p-4 sm:p-5 pt-2 border-t border-slate-100 dark:border-slate-800 space-y-3">
      {FAQ_LIST.map((faq, idx) => (
        <details class="group rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800/80 transition-all overflow-hidden">
          <summary class="flex items-center justify-between gap-3 p-3.5 sm:p-4 cursor-pointer list-none select-none">
            <div class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-md bg-emerald-500/10 dark:bg-emerald-400/15 text-emerald-600 dark:text-emerald-400 text-[11px] font-bold flex items-center justify-center shrink-0 font-mono">
                {idx + 1}
              </span>
              <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors text-left leading-snug">
                {faq.question}
              </span>
            </div>
            <svg class="w-3.5 h-3.5 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-4 pb-4 pt-1 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300 border-t border-slate-200/60 dark:border-slate-700/60">
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono mb-1.5">
              {faq.category}
            </span>
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </details>
</section>
