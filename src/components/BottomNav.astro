---
interface Props {
  activeNav?: 'home' | 'category' | 'search' | 'saved' | 'menu';
}

const { activeNav = 'home' } = Astro.props;
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 backdrop-blur-lg border-t border-slate-800/80 px-2 py-1.5 safe-area-bottom">
  <div class="flex items-center justify-around max-w-md mx-auto">
    <!-- Home -->
    <a
      href="/"
      class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-all ${
        activeNav === 'home'
          ? 'text-emerald-500 font-bold'
          : 'text-slate-400 hover:text-slate-200'
      }`}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-[10px] tracking-tight">Home</span>
    </a>

    <!-- Category -->
    <a
      href="/category/politics"
      class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-all ${
        activeNav === 'category'
          ? 'text-emerald-500 font-bold'
          : 'text-slate-400 hover:text-slate-200'
      }`}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
      </svg>
      <span class="text-[10px] tracking-tight">Category</span>
    </a>

    <!-- Search -->
    <a
      href="/search"
      class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-all ${
        activeNav === 'search'
          ? 'text-emerald-500 font-bold'
          : 'text-slate-400 hover:text-slate-200'
      }`}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span class="text-[10px] tracking-tight">Search</span>
    </a>

    <!-- Saved -->
    <a
      href="/saved"
      class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-all relative ${
        activeNav === 'saved'
          ? 'text-emerald-500 font-bold'
          : 'text-slate-400 hover:text-slate-200'
      }`}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
      <span class="text-[10px] tracking-tight">Saved</span>
      <span id="saved-badge" class="hidden absolute top-0.5 right-2 w-2 h-2 rounded-full bg-emerald-500"></span>
    </a>

    <!-- Menu Drawer Trigger -->
    <button
      id="btn-nav-menu"
      type="button"
      class={`flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-all ${
        activeNav === 'menu'
          ? 'text-emerald-500 font-bold'
          : 'text-slate-400 hover:text-slate-200'
      }`}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <span class="text-[10px] tracking-tight">Menu</span>
    </button>
  </div>
</nav>

<script is:inline>
  // Update saved badge on client load
  try {
    const saved = JSON.parse(localStorage.getItem('naijapulse_bookmarks') || '[]');
    const badge = document.getElementById('saved-badge');
    if (badge && saved.length > 0) {
      badge.classList.remove('hidden');
    }
  } catch {}

  document.getElementById('btn-nav-menu')?.addEventListener('click', () => {
    document.getElementById('mobile-drawer')?.classList.remove('translate-x-full');
    document.getElementById('drawer-backdrop')?.classList.remove('hidden');
  });
</script>
