---
/**
 * Strategic High-Converting Ad Placements for 9jaBeacon
 * Supports:
 * 1. 320x50 Banner (Key: 68c3e01457bdbc56eeaf6737cd933b72)
 * 2. 300x250 Native Banner (Key: 6605a898998325cc0d10c2c5c77a29d8)
 * 3. High-Converting Smartlink (https://www.profitableratecpmnetwork.com/ip0y1pan?key=406d5b2ea65353486dc2e9a7547d5ead)
 *
 * Isolated via zero-CLS sandboxed frames to prevent window.atOptions collisions
 * and ensure seamless multi-unit rendering across articles and feeds.
 */

import { getD1, getCustomAds } from '../lib/runtime-db';

interface Props {
  format?: 'banner-320x50' | 'banner-300x250' | 'in-article' | 'smartlink' | 'feed' | 'sidebar';
  className?: string;
  smartLinkUrl?: string;
  headline?: string;
  teaser?: string;
}

const {
  format = 'in-article',
  className = '',
  smartLinkUrl = '',
  headline = '',
  teaser = '',
} = Astro.props;

const DEFAULT_SMARTLINK = 'https://www.profitableratecpmnetwork.com/ip0y1pan?key=406d5b2ea65353486dc2e9a7547d5ead';

let effectiveHeadline = headline;
let effectiveTeaser = teaser;
let effectiveLink = (smartLinkUrl && smartLinkUrl.trim().length > 0) ? smartLinkUrl.trim() : DEFAULT_SMARTLINK;

if (!headline) {
  try {
    const db = getD1(Astro.locals);
    const activeAds = await getCustomAds(db, true);
    if (activeAds && activeAds.length > 0) {
      const liveAd = activeAds[0];
      effectiveHeadline = liveAd.title;
      effectiveTeaser = liveAd.teaser || '';
      effectiveLink = liveAd.target_url;
    }
  } catch {}
}

const BANNER_320X50_KEY = '68c3e01457bdbc56eeaf6737cd933b72';
const BANNER_300X250_KEY = '6605a898998325cc0d10c2c5c77a29d8';

// Build safe iframe srcdocs that avoid race conditions
const srcDoc320x50 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_320X50_KEY}','format':'iframe','height':50,'width':320,'params':{}};</script><script src="https://www.highrevenueformat.com/${BANNER_320X50_KEY}/invoke.js"></script></body></html>`;

const srcDoc300x250 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_300X250_KEY}','format':'iframe','height':250,'width':300,'params':{}};</script><script src="https://www.highrevenueformat.com/${BANNER_300X250_KEY}/invoke.js"></script></body></html>`;
---

<!-- 1. Strategic 320x50 Mobile / Horizontal Banner -->
{format === 'banner-320x50' && (
  <div class={`my-5 w-full flex flex-col items-center justify-center not-prose ${className}`}>
    <div class="flex items-center justify-between w-full max-w-[320px] mb-1 px-1 text-[10px] text-slate-400 dark:text-slate-500 font-mono">
      <span>Advertisement</span>
      <a href="/contact#advertise" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Advertise With Us</a>
    </div>
    <div class="w-[320px] h-[50px] min-w-[320px] min-h-[50px] overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 flex items-center justify-center shadow-xs">
      <iframe
        srcdoc={srcDoc320x50}
        width="320"
        height="50"
        loading="lazy"
        scrolling="no"
        title="Sponsored Advertisement (320x50)"
        class="border-0 w-[320px] h-[50px] overflow-hidden block"
      />
    </div>
  </div>
)}

<!-- 2. Strategic 300x250 Native Banner (In-Article & Mid-Break) -->
{(format === 'banner-300x250' || format === 'in-article') && (
  <div class={`my-6 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs not-prose transition-colors ${className}`}>
    <div class="flex items-center justify-between gap-2 mb-3 pb-2 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">
          Sponsored Feature
        </span>
      </div>
      <a
        href="/contact#advertise"
        class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-medium border border-slate-200 dark:border-slate-700 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
      >
        Advertise
      </a>
    </div>

    <!-- 300x250 Iframe Banner Container -->
    <div class="w-full flex flex-col items-center justify-center min-h-[250px] py-1">
      <div class="w-[300px] h-[250px] min-w-[300px] min-h-[250px] overflow-hidden rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/80 flex items-center justify-center">
        <iframe
          srcdoc={srcDoc300x250}
          width="300"
          height="250"
          loading="lazy"
          scrolling="no"
          title="Native Sponsor Unit (300x250)"
          class="border-0 w-[300px] h-[250px] overflow-hidden block"
        />
      </div>
    </div>
  </div>
)}

<!-- 3. Strategic High-Converting Smartlink Spotlight Card (In-Article & In-Feed) -->
{(format === 'smartlink' || format === 'feed') && (
  <div class={`my-6 p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-emerald-200/80 dark:border-emerald-800/60 shadow-xs not-prose transition-all hover:border-emerald-400 dark:hover:border-emerald-600 ${className}`}>
    <div class="flex items-center justify-between gap-2 mb-3 pb-2 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-1.5">
        <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-black uppercase tracking-wider font-mono">
          Partner Spotlight
        </span>
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-400 font-bold">
          Trending Deal
        </span>
      </div>
      <a
        href="/contact#advertise"
        class="text-[10px] text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
      >
        Advertise With Us &rarr;
      </a>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5 text-left flex-1 min-w-0">
        <div class="w-11 h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-200 dark:border-emerald-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 leading-snug">
            {effectiveHeadline || 'Verified Financial Opportunities, High-Yield FX & Business Vaults in Nigeria'}
          </h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
            {effectiveTeaser || 'Explore vetted fintech tools, dollar cards, SME expansion grants, and verified market instruments curated for readers.'}
          </p>
        </div>
      </div>
      <a
        href={effectiveLink}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="shrink-0 w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-xs inline-flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
      >
        <span>Explore Offers</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
)}

<!-- 4. Strategic Desktop Sidebar 300x250 Banner + Smartlink Action -->
{format === 'sidebar' && (
  <aside class={`p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3 not-prose ${className}`}>
    <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 dark:text-slate-400 pb-2 border-b border-slate-100 dark:border-slate-800">
      <span class="font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Spotlight</span>
      <a href="/contact#advertise" class="hover:underline">Advertise</a>
    </div>

    <!-- 300x250 Native Banner -->
    <div class="w-full flex justify-center py-1">
      <div class="w-[300px] h-[250px] overflow-hidden rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800/80 flex items-center justify-center">
        <iframe
          srcdoc={srcDoc300x250}
          width="300"
          height="250"
          loading="lazy"
          scrolling="no"
          title="Sidebar Advertisement"
          class="border-0 w-[300px] h-[250px] overflow-hidden block"
        />
      </div>
    </div>

    <!-- Supplementary Smartlink Callout -->
    <a
      href={effectiveLink}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="block w-full text-center py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 text-xs font-bold transition shadow-xs cursor-pointer"
    >
      🔥 Explore Verified Partner Deals &rarr;
    </a>
  </aside>
)}
