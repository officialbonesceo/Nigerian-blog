---
/**
 * Strategic High-Converting Ad & Smartlink Placements for 9jaBeacon
 * 
 * Supports Diverse High-CTR Formats:
 * 1. 'banner-320x50' (Mobile & header display banner)
 * 2. 'banner-300x250' (High-RPM square display banner)
 * 3. 'feed' (Native in-feed news card matching editorial wire styling)
 * 4. 'breaking-teaser' (Urgent bulletin / breaking opportunity alert strip)
 * 5. 'opportunities-grid' (2 or 4-column native trending recommendations grid)
 * 6. 'spotlight' (High-impact full-width editorial cover banner)
 * 7. 'smartlink' (In-article partner spotlight with action button)
 * 8. 'read-also' (Editorial inline curiosity highlight callout)
 * 9. 'sidebar' (Desktop 300x250 banner + smartlink action)
 *
 * Distinct Image & Story Rotation:
 * Uses a library of 20 verified, high-quality Unsplash photos and diverse topics.
 * Accepts an `index` prop to guarantee that no two ad slots on the same page ever
 * share the same image, headline, or format.
 */

import { getD1, getCustomAds, getSiteSettings } from '../lib/runtime-db';

interface Props {
  format?:
    | 'banner-320x50'
    | 'banner-300x250'
    | 'in-article'
    | 'smartlink'
    | 'feed'
    | 'sidebar'
    | 'read-also'
    | 'opportunities-grid'
    | 'breaking-teaser'
    | 'spotlight';
  className?: string;
  smartLinkUrl?: string;
  headline?: string;
  teaser?: string;
  loading?: 'lazy' | 'eager';
  index?: number; // Deterministic offset to prevent duplicate images/stories on the same page
}

const {
  format = 'in-article',
  className = '',
  smartLinkUrl = '',
  headline = '',
  teaser = '',
  loading,
  index = 0,
