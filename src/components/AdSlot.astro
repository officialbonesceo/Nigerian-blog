// Rotate dynamically every 5 minutes, offset deterministically by slot index so no two slots on the page share the same item
const baseRotation = Math.floor(Date.now() / (5 * 60 * 1000));
const storyIndex = (baseRotation + index) % NATIVE_ROTATING_STORIES.length;
const currentNativeStory = NATIVE_ROTATING_STORIES[storyIndex];

// Multi-story slots take distinct offsets
const secondaryStory = NATIVE_ROTATING_STORIES[(storyIndex + 1) % NATIVE_ROTATING_STORIES.length];
const thirdStory = NATIVE_ROTATING_STORIES[(storyIndex + 2) % NATIVE_ROTATING_STORIES.length];
const fourthStory = NATIVE_ROTATING_STORIES[(storyIndex + 3) % NATIVE_ROTATING_STORIES.length];

let effectiveHeadline = headline || currentNativeStory.title;
let effectiveTeaser = teaser || currentNativeStory.teaser;
let effectiveLink = (smartLinkUrl && smartLinkUrl.trim().length > 0)
  ? smartLinkUrl.trim()
  : configuredSmartlink;

// Check for custom active ads in database
if (!headline) {
  try {
    const db = getD1(Astro.locals);
    const activeAds = await getCustomAds(db, true);
    if (activeAds && activeAds.length > 0) {
      const slotAd = activeAds[index % activeAds.length] || activeAds[0];
      effectiveHeadline = slotAd.title;
      effectiveTeaser = slotAd.teaser || currentNativeStory.teaser;
      effectiveLink = slotAd.target_url;
    }
  } catch {}
}

const BANNER_320X50_KEY = dbSettings.ad_banner_320x50_key || '68c3e01457bdbc56eeaf6737cd933b72';
const BANNER_300X250_KEY = dbSettings.ad_banner_300x250_key || '6605a898998325cc0d10c2c5c77a29d8';

const srcDoc320x50 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_320X50_KEY}','format':'iframe','height':50,'width':320,'params':{}};</script><script src="https://www.highrevenueformat.com/${BANNER_320X50_KEY}/invoke.js"></script></body></html>`;

const srcDoc300x250 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_300X250_KEY}','format':'iframe','height':250,'width':300,'params':{}};</script><script src="https://www.highrevenueformat.com/${BANNER_300X250_KEY}/invoke.js"></script></body></html>`;

const topBannerLoading = loading || 'eager';
const midBannerLoading = loading || 'lazy';
---

<!-- 1. Strategic 320x50 Mobile / Horizontal Banner -->
{format === 'banner-320x50' && (
  <div class={`my-3 w-full flex flex-col items-center justify-center not-prose ${className}`}>
