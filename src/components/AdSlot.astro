---
/**
 * AdSlot — Adsterra network units only.
 * Fake native "sponsored story" cards removed (user request).
 * Formats that used clickbait cards now either show a real Adsterra unit or nothing.
 */
import { getD1, getSiteSettings } from '../lib/runtime-db';

interface Props {
  format?:
    | 'banner-320x50'
    | 'banner-300x250'
    | 'in-article'
    | 'smartlink'
    | 'feed'
    | 'sidebar'
    | 'read-also'
    | 'opportunities-grid'
    | 'breaking-teaser'
    | 'spotlight';
  className?: string;
  smartLinkUrl?: string;
  headline?: string;
  teaser?: string;
  loading?: 'lazy' | 'eager';
  index?: number;
}

const {
  format = 'in-article',
  className = '',
  loading,
} = Astro.props;

let dbSettings: Record<string, string> = {};
try {
  const db = getD1(Astro.locals);
  dbSettings = await getSiteSettings(db);
} catch {}

const BANNER_320X50_KEY = dbSettings.ad_banner_320x50_key || '68c3e01457bdbc56eeaf6737cd933b72';
const BANNER_300X250_KEY = dbSettings.ad_banner_300x250_key || '6605a898998325cc0d10c2c5c77a29d8';

const srcDoc320x50 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_320X50_KEY}','format':'iframe','height':50,'width':320,'params':{}};<\/script><script src="https://www.highrevenueformat.com/${BANNER_320X50_KEY}/invoke.js"><\/script></body></html>`;

const srcDoc300x250 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:transparent;overflow:hidden;}</style></head><body><script>atOptions={'key':'${BANNER_300X250_KEY}','format':'iframe','height':250,'width':300,'params':{}};<\/script><script src="https://www.highrevenueformat.com/${BANNER_300X250_KEY}/invoke.js"><\/script></body></html>`;

// Real Adsterra units only
const show320 = format === 'banner-320x50';
const show300 =
  format === 'banner-300x250' ||
  format === 'in-article' ||
  format === 'feed' ||
  format === 'sidebar' ||
  format === 'smartlink' ||
  format === 'breaking-teaser' ||
  format === 'spotlight' ||
  format === 'read-also' ||
  format === 'opportunities-grid';

const topBannerLoading = loading || 'eager';
const midBannerLoading = loading || 'lazy';
---

{show320 && (
  <div class={`my-3 w-full flex flex-col items-center justify-center not-prose ${className}`}>
    <div class="flex items-center justify-between w-full max-w-[320px] mb-1 px-1 text-[10px] text-slate-400 dark:text-slate-500 font-mono">
      <span>Advertisement</span>
      <a href="/contact#advertise" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Advertise With Us</a>
    </div>
    <div class="w-[320px] h-[50px] min-w-[320px] min-h-[50px] overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 flex items-center justify-center shadow-xs">
      <iframe
        srcdoc={srcDoc320x50}
        width="320"
        height="50"
        loading={topBannerLoading}
        title="Sponsored Advertisement (320x50)"
        class="border-0 w-[320px] h-[50px] overflow-hidden block"
      />
    </div>
  </div>
)}

{show300 && (
  <div class={`my-6 flex flex-col items-center justify-center not-prose ${className}`}>
    <div class="flex items-center justify-between w-full max-w-[300px] mb-1 px-1 text-[10px] text-slate-400 dark:text-slate-500 font-mono">
      <span>Advertisement</span>
      <a href="/contact#advertise" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Advertise</a>
    </div>
    <div class="w-[300px] h-[250px] min-w-[300px] min-h-[250px] overflow-hidden rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 flex items-center justify-center">
      <iframe
        srcdoc={srcDoc300x250}
        width="300"
        height="250"
        loading={midBannerLoading}
        title="Native Sponsor Unit (300x250)"
        class="border-0 w-[300px] h-[250px] overflow-hidden block"
      />
    </div>
  </div>
)}
