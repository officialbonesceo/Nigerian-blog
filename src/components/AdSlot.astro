      <span>Advertisement</span>
      <a href="/contact#advertise" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Advertise With Us</a>
    </div>
    <div class="w-[320px] h-[50px] min-w-[320px] min-h-[50px] overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 flex items-center justify-center shadow-xs">
      <iframe
        srcdoc={srcDoc320x50}
        width="320"
        height="50"
        loading={topBannerLoading}
        title="Sponsored Advertisement (320x50)"
        class="border-0 w-[320px] h-[50px] overflow-hidden block"
      />
