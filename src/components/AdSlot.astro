  <article class={`p-3.5 sm:p-4 rounded-xl bg-white dark:bg-slate-900 border border-emerald-500/25 dark:border-emerald-500/20 hover:border-emerald-500/50 dark:hover:border-emerald-500/40 shadow-xs transition-all duration-200 group overflow-hidden ${className}`}>
