---
const trendingTopics = [
  { label: 'Trending', isBadge: true },
  { label: 'Fuel Prices', query: 'fuel' },
  { label: 'Naira to Dollar', query: 'naira' },
  { label: 'Elections 2027', query: 'elections' },
  { label: 'Dangote Refinery', query: 'dangote' },
  { label: 'CBN Rates', query: 'cbn' },
  { label: 'Lookman', query: 'lookman' },
  { label: 'Trade Surplus', query: 'trade' },
];
---

<div class="w-full overflow-x-auto no-scrollbar py-2.5 -mx-4 px-4 sm:mx-0 sm:px-0">
  <div class="flex items-center gap-2 whitespace-nowrap">
    {trendingTopics.map((topic) => (
      topic.isBadge ? (
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-600 text-white text-xs font-bold shadow-xs">
          <svg class="w-3 h-3 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          {topic.label}
        </span>
      ) : (
        <a
          href={`/search?q=${encodeURIComponent(topic.query || topic.label)}`}
          class="inline-flex items-center px-3 py-1 rounded-full bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-white text-xs font-medium transition-colors"
        >
          {topic.label}
        </a>
      )
    ))}
  </div>
</div>
