---
// src/components/StickmanStudio.astro
// Single Articulated Vector Stickman Presenter Studio
// Features: Bold Red Tie, Gaze (Up/Down/Left/Right/Side), Desk ON/OFF (Full Screen),
// Human Walking Gait (Legs & Arms moving like human), Gestures (Point Left/Right, Hands Sideway),
// Facial Expressions, Talking Lip-Sync, and Full Interactive Controls.
---

<div class="space-y-6 select-none" id="stickman-studio-wrapper">
  <!-- Studio Header Banner -->
  <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3 transition-colors">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-500 dark:text-red-400 text-xs font-bold uppercase tracking-wider font-mono mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Vector Broadcast Presenter &bull; Single Stickman Studio
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>9jaBeacon Stickman Motion & Animation Workbench</span>
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 max-w-3xl leading-relaxed">
          Procedural SVG stickman presenter with bold red tie &bull; Articulated head gaze, human bipedal walking kinematics, hands sideway / pointing poses, desk toggle (seated vs full-body standing), and live speech lip-sync &mdash; zero external images.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-bold text-slate-900 dark:text-white">
          1 Vector Anchor
        </span>
        <span class="px-2.5 py-1 rounded-lg bg-red-500/10 border border-red-500/30 font-bold text-red-600 dark:text-red-400">
          Bold Red Tie
        </span>
        <button
          id="btn-toggle-studio-theme"
          onclick="toggleStickmanStudioTheme()"
          class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium transition cursor-pointer flex items-center gap-1.5"
          title="Toggle Canvas Light/Dark Background"
        >
          <span id="theme-toggle-icon">🌙</span>
          <span id="theme-toggle-label">Dark Stage</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MAIN WORKBENCH GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- LEFT: LIVE STAGE & MONITOR (Col 7) -->
    <div class="lg:col-span-7 flex flex-col space-y-4">
      
      <!-- Stage Monitor Frame -->
      <div 
        id="sm-monitor-frame"
        class="relative w-full aspect-video rounded-2xl bg-slate-950 border-2 border-slate-800 overflow-hidden shadow-2xl flex flex-col justify-between p-3.5 sm:p-5 group select-none transition-colors duration-300"
      >
        <!-- Canvas Ambient Vignette -->
        <div id="sm-stage-vignette" class="absolute inset-0 bg-radial from-slate-900/50 via-slate-950 to-slate-950 pointer-events-none transition-opacity"></div>
        
        <!-- Subtle Stage Floor Horizon Line -->
        <div id="sm-stage-horizon" class="absolute bottom-16 left-0 right-0 h-px bg-slate-800/60 pointer-events-none"></div>

        <!-- TOP BAR: Status & Metadata Overlays -->
        <div class="relative z-20 flex items-center justify-between gap-2">
          <!-- Broadcast Bug / Watermark -->
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-red-500 animate-ping"></div>
            <span class="text-[11px] font-black tracking-widest text-white/90 font-mono">9JA BEACON LIVE</span>
          </div>

          <!-- Active State Badges -->
          <div class="flex items-center gap-2">
            <span id="sm-badge-mode" class="px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700 text-slate-300 text-[10px] font-mono font-bold">
              BEHIND DESK
            </span>
            <span id="sm-badge-motion" class="px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700 text-slate-300 text-[10px] font-mono font-bold">
              IDLE
            </span>
            <span id="sm-badge-status" class="px-2 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono font-bold">
              STANDBY
            </span>
          </div>
        </div>

        <!-- CENTER STAGE CANVAS: Procedural SVG Stickman Presenter -->
        <div class="relative z-10 flex-1 flex items-center justify-center my-auto min-h-0 overflow-hidden">
          <div 
            id="sm-camera-viewport"
            class="relative w-full h-full flex items-center justify-center transition-transform duration-300 ease-out"
            style="transform: scale(0.95) translateY(0px);"
          >
            <!-- STICKMAN SVG -->
            <svg 
              id="sm-svg" 
              viewBox="0 0 600 600" 
              class="w-full h-full max-h-[460px] drop-shadow-lg select-none"
              style="overflow: visible;"
            >
              <defs>
                <!-- Red Tie Gradient for extra crisp vibrancy -->
                <linearGradient id="smTieGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ef4444" />
                  <stop offset="60%" stop-color="#dc2626" />
                  <stop offset="100%" stop-color="#b91c1c" />
                </linearGradient>

                <!-- Tie Subtle Drop Shadow -->
                <filter id="smTieShadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.4"/>
                </filter>

                <!-- Floor Shadow Gradient -->
                <radialGradient id="smFloorShadow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.5" />
                  <stop offset="70%" stop-color="#000000" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>
              </defs>

              <!-- ROOT STAGE ACTOR GROUP: Controls horizontal X-position & facing direction -->
              <g id="sm-actor-group" transform="translate(0, 0)">
                
                <!-- Floor Contact Shadow -->
                <ellipse 
                  id="sm-floor-shadow" 
                  cx="300" 
                  cy="535" 
                  rx="65" 
                  ry="12" 
                  fill="url(#smFloorShadow)"
                  class="transition-all duration-200"
                />

                <!-- ============================================== -->
                <!-- FULL BODY: LEGS & LOWER BODY (STANDING / WALKING) -->
                <!-- ============================================== -->
                <g id="sm-legs-layer" class="transition-opacity duration-300">
                  <!-- Standing Pose Legs -->
                  <g id="sm-legs-stand" class="transition-opacity duration-200">
                    <!-- Left Leg -->
                    <line x1="288" y1="310" x2="284" y2="420" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                    <line x1="284" y1="420" x2="280" y2="525" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                    <!-- Left Foot -->
                    <line x1="280" y1="525" x2="256" y2="528" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                    
                    <!-- Right Leg -->
                    <line x1="312" y1="310" x2="316" y2="420" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                    <line x1="316" y1="420" x2="320" y2="525" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                    <!-- Right Foot -->
                    <line x1="320" y1="525" x2="344" y2="528" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />
                  </g>

                  <!-- Dynamic Walking Gait Legs (Hidden when not walking) -->
                  <g id="sm-legs-walk" class="hidden">
                    <!-- Dynamic Left Leg (Controlled via JS animation frame) -->
                    <path id="sm-walk-leg-l" d="M 288 310 L 270 420 L 260 525 L 240 528" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Dynamic Right Leg -->
                    <path id="sm-walk-leg-r" d="M 312 310 L 330 420 L 340 525 L 360 528" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                  </g>

                  <!-- Seated Lower Legs (Under Desk pose) -->
                  <g id="sm-legs-seated" class="hidden">
                    <line x1="288" y1="310" x2="282" y2="380" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke opacity-30" />
                    <line x1="312" y1="310" x2="318" y2="380" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke opacity-30" />
                  </g>
                </g>

                <!-- Pelvis Bar -->
                <line x1="285" y1="310" x2="315" y2="310" stroke="currentColor" stroke-width="8" stroke-linecap="round" class="sm-stroke" />

                <!-- ============================================== -->
                <!-- TORSO, SPINE, COLLAR & BOLD RED TIE -->
                <!-- ============================================== -->
                <g id="sm-torso-group">
                  <!-- Main Spine -->
                  <line id="sm-spine" x1="300" y1="150" x2="300" y2="310" stroke="currentColor" stroke-width="7.5" stroke-linecap="round" class="sm-stroke" />
                  
                  <!-- Shoulder Crossbar -->
                  <line x1="268" y1="170" x2="332" y2="170" stroke="currentColor" stroke-width="7" stroke-linecap="round" class="sm-stroke" />

                  <!-- Crisp Shirt Collar (Minimalist white flap) -->
                  <polygon points="291,146 309,146 305,158 295,158" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />

                  <!-- BOLD RED TIE (Iconic anchor tie) -->
                  <g id="sm-bold-red-tie" filter="url(#smTieShadow)">
                    <!-- Tie Knot -->
                    <polygon points="294,148 306,148 304,162 296,162" fill="#dc2626" stroke="#991b1b" stroke-width="1.5" />
                    <!-- Tie Body -->
                    <polygon points="296,162 304,162 308,245 300,268 292,245" fill="url(#smTieGradient)" stroke="#991b1b" stroke-width="1.5" />
                    <!-- Tie Center Fold Line -->
                    <line x1="300" y1="162" x2="300" y2="265" stroke="#fca5a5" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
                  </g>
                </g>

                <!-- ============================================== -->
                <!-- ARMS & HANDS (ARTICULATED KINEMATICS) -->
                <!-- ============================================== -->
                <g id="sm-arms-group">
                  
                  <!-- POSE 1: Hands Sideway (Relaxed Natural Human Stand) -->
                  <g id="sm-arm-pose-sideway" class="sm-arm-pose">
                    <!-- Left Arm: Hanging relaxed at side -->
                    <path d="M 268 170 L 258 230 L 254 290" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Left Hand: subtle palm -->
                    <circle cx="254" cy="292" r="4.5" fill="currentColor" class="sm-fill" />
                    
                    <!-- Right Arm: Hanging relaxed at side -->
                    <path d="M 332 170 L 342 230 L 346 290" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Right Hand: subtle palm -->
                    <circle cx="346" cy="292" r="4.5" fill="currentColor" class="sm-fill" />
                  </g>

                  <!-- POSE 2: Point Left (Left Arm Pointing, Right Arm Sideway) -->
                  <g id="sm-arm-pose-point-left" class="sm-arm-pose hidden">
                    <!-- Left Arm: Extended fully pointing left -->
                    <path d="M 268 170 L 200 170 L 138 170" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Left Hand Pointing: Arrow index finger -->
                    <polygon points="138,166 122,170 138,174" fill="currentColor" class="sm-fill" />
                    <line x1="138" y1="170" x2="118" y2="170" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" class="sm-stroke" />
                    
                    <!-- Right Arm: Sideway -->
                    <path d="M 332 170 L 342 230 L 346 290" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="346" cy="292" r="4.5" fill="currentColor" class="sm-fill" />
                  </g>

                  <!-- POSE 3: Point Right (Right Arm Pointing, Left Arm Sideway) -->
                  <g id="sm-arm-pose-point-right" class="sm-arm-pose hidden">
                    <!-- Left Arm: Sideway -->
                    <path d="M 268 170 L 258 230 L 254 290" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="254" cy="292" r="4.5" fill="currentColor" class="sm-fill" />
                    
                    <!-- Right Arm: Extended fully pointing right -->
                    <path d="M 332 170 L 400 170 L 462 170" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Right Hand Pointing: Arrow index finger -->
                    <polygon points="462,166 478,170 462,174" fill="currentColor" class="sm-fill" />
                    <line x1="462" y1="170" x2="482" y2="170" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" class="sm-stroke" />
                  </g>

                  <!-- POSE 4: Desk Rest (Both arms resting on anchor desk) -->
                  <g id="sm-arm-pose-desk-rest" class="sm-arm-pose hidden">
                    <!-- Left Arm: resting forward on desk pad -->
                    <path d="M 268 170 L 248 230 L 268 280" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="268" cy="280" r="5" fill="currentColor" class="sm-fill" />
                    
                    <!-- Right Arm: resting forward holding stylus/notes -->
                    <path d="M 332 170 L 352 230 L 332 280" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="332" cy="280" r="5" fill="currentColor" class="sm-fill" />
                  </g>

                  <!-- POSE 5: Expressive Gesture (Speaking & Presenting with palms) -->
                  <g id="sm-arm-pose-gesture" class="sm-arm-pose hidden">
                    <!-- Left Arm: gesturing upward -->
                    <path d="M 268 170 L 240 215 L 225 200" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="225" cy="200" r="5" fill="currentColor" class="sm-fill" />
                    
                    <!-- Right Arm: gesturing upward -->
                    <path d="M 332 170 L 360 215 L 375 200" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="375" cy="200" r="5" fill="currentColor" class="sm-fill" />
                  </g>

                  <!-- POSE 6: Friendly Wave -->
                  <g id="sm-arm-pose-wave" class="sm-arm-pose hidden">
                    <!-- Left Arm: Sideway -->
                    <path d="M 268 170 L 258 230 L 254 290" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <circle cx="254" cy="292" r="4.5" fill="currentColor" class="sm-fill" />
                    
                    <!-- Right Arm: High waving -->
                    <path d="M 332 170 L 375 140 L 395 105" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Open Hand -->
                    <circle cx="395" cy="105" r="6" fill="currentColor" class="sm-fill" />
                  </g>

                  <!-- Dynamic Walking Arm Swing (Used during active walk cycle) -->
                  <g id="sm-arm-pose-walk" class="sm-arm-pose hidden">
                    <!-- Dynamic Left Arm (oppositional swing) -->
                    <path id="sm-walk-arm-l" d="M 268 170 L 258 225 L 252 280" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                    <!-- Dynamic Right Arm (oppositional swing) -->
                    <path id="sm-walk-arm-r" d="M 332 170 L 342 225 L 348 280" fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" class="sm-stroke" />
                  </g>
                </g>

                <!-- ============================================== -->
                <!-- ARTICULATED HEAD, GAZE & FACIAL EXPRESSIONS -->
                <!-- ============================================== -->
                <g 
                  id="sm-head-group" 
                  class="transition-transform duration-200 ease-out origin-[300px_105px]"
                  style="transform-origin: 300px 105px;"
                >
                  <!-- Neck Line -->
                  <line x1="300" y1="140" x2="300" y2="152" stroke="currentColor" stroke-width="6" stroke-linecap="round" class="sm-stroke" />

                  <!-- Head Contour (Clean Vector Circle) -->
                  <circle 
                    id="sm-head-circle" 
                    cx="300" 
                    cy="105" 
                    r="36" 
                    fill="#090d16" 
                    stroke="currentColor" 
                    stroke-width="6" 
                    class="sm-head-base" 
                  />

                  <!-- Dynamic Eyebrows -->
                  <g id="sm-eyebrows-group">
                    <!-- Left Eyebrow -->
                    <path id="sm-brow-left" d="M 280 93 Q 288 91 294 93" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="sm-stroke transition-all duration-200" />
                    <!-- Right Eyebrow -->
                    <path id="sm-brow-right" d="M 306 93 Q 312 91 320 93" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="sm-stroke transition-all duration-200" />
                  </g>

                  <!-- Dynamic Eye Sockets & Moving Pupils (Gaze Controls) -->
                  <g id="sm-eyes-group">
                    <!-- Left Eye Socket -->
                    <circle cx="288" cy="104" r="5" fill="none" stroke="currentColor" stroke-width="1.8" class="sm-stroke" />
                    <!-- Left Pupil (Moves on gaze) -->
                    <circle id="sm-pupil-left" cx="288" cy="104" r="3.2" fill="currentColor" class="sm-fill transition-all duration-150" />

                    <!-- Right Eye Socket -->
                    <circle cx="312" cy="104" r="5" fill="none" stroke="currentColor" stroke-width="1.8" class="sm-stroke" />
                    <!-- Right Pupil (Moves on gaze) -->
                    <circle id="sm-pupil-right" cx="312" cy="104" r="3.2" fill="currentColor" class="sm-fill transition-all duration-150" />

                    <!-- Dynamic Blink Eyelids (Slides down to blink) -->
                    <g id="sm-blink-eyelids" class="opacity-0 transition-opacity duration-75">
                      <line x1="282" y1="104" x2="294" y2="104" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" class="sm-stroke" />
                      <line x1="306" y1="104" x2="318" y2="104" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" class="sm-stroke" />
                    </g>
                  </g>

                  <!-- Dynamic Mouth Shapes (Talking / Expressions) -->
                  <g id="sm-mouth-group">
                    <!-- 1. Neutral Closed Mouth -->
                    <path id="sm-mouth-neutral" d="M 292 125 Q 300 126 308 125" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="sm-stroke sm-mouth-shape" />

                    <!-- 2. Smile Mouth -->
                    <path id="sm-mouth-smile" d="M 290 123 Q 300 133 310 123" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="sm-stroke sm-mouth-shape hidden" />

                    <!-- 3. Serious Straight Mouth -->
                    <line id="sm-mouth-serious" x1="291" y1="126" x2="309" y2="126" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="sm-stroke sm-mouth-shape hidden" />

                    <!-- 4. Surprised Open Mouth (Round O) -->
                    <ellipse id="sm-mouth-surprised" cx="300" cy="126" rx="5.5" ry="7" fill="none" stroke="currentColor" stroke-width="2.8" class="sm-stroke sm-mouth-shape hidden" />

                    <!-- 5. Talking Phoneme: Open Ah -->
                    <path id="sm-mouth-talk-open" d="M 291 123 Q 300 134 309 123 Q 300 126 291 123" fill="currentColor" stroke="currentColor" stroke-width="1.5" class="sm-fill sm-stroke sm-mouth-shape hidden" />

                    <!-- 6. Talking Phoneme: Semi-Open Eh -->
                    <path id="sm-mouth-talk-semi" d="M 292 124 Q 300 130 308 124 Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" class="sm-fill sm-stroke sm-mouth-shape hidden" />

                    <!-- 7. Talking Phoneme: Round Oh -->
                    <circle id="sm-mouth-talk-round" cx="300" cy="126" r="4.5" fill="currentColor" stroke="currentColor" stroke-width="1.5" class="sm-fill sm-stroke sm-mouth-shape hidden" />
                  </g>
                </g>

                <!-- ============================================== -->
                <!-- NEWS ANCHOR DESK (MODULAR TOGGLEABLE LAYER) -->
                <!-- ============================================== -->
                <g id="sm-desk-layer" class="transition-opacity duration-300">
                  <!-- Desk Drop Shadow -->
                  <ellipse cx="300" cy="385" rx="160" ry="20" fill="url(#smFloorShadow)" />

                  <!-- Desk Main Body Polygon (Sleek minimalist news desk) -->
                  <polygon 
                    points="140,285 460,285 435,380 165,380" 
                    fill="#0f172a" 
                    stroke="currentColor" 
                    stroke-width="2.5" 
                    class="sm-desk-body"
                  />
                  
                  <!-- Desk Beveled Top Surface (Glass / Reflection look) -->
                  <polygon 
                    points="130,278 470,278 460,285 140,285" 
                    fill="#1e293b" 
                    stroke="currentColor" 
                    stroke-width="1.5" 
                    class="sm-desk-top"
                  />
                  <!-- Desk Subtle Glow Edge Line -->
                  <line x1="130" y1="278" x2="470" y2="278" stroke="#38bdf8" stroke-width="1.5" opacity="0.7" />

                  <!-- Anchor Studio Gooseneck Microphone -->
                  <path d="M 405 278 Q 395 245 385 235" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="sm-stroke" />
                  <!-- Mic Head with Red Live Indicator Ring -->
                  <rect x="379" y="226" width="12" height="10" rx="3" fill="#334155" stroke="currentColor" stroke-width="1.2" class="sm-stroke" />
                  <circle cx="385" cy="231" r="2" fill="#ef4444" class="animate-pulse" />

                  <!-- Broadcast News Tablet / Papers on Desk -->
                  <polygon points="215,280 255,279 252,284 212,285" fill="#f8fafc" stroke="#94a3b8" stroke-width="1" />
                  <polygon points="220,281 250,280 248,284 218,285" fill="#38bdf8" opacity="0.3" />

                  <!-- Newsroom Digital Emblem / Front Panel Banner -->
                  <rect x="230" y="320" width="140" height="26" rx="6" fill="#020617" stroke="currentColor" stroke-width="1.2" class="sm-desk-badge" />
                  <text 
                    x="300" 
                    y="337" 
                    text-anchor="middle" 
                    font-family="monospace" 
                    font-size="11" 
                    font-weight="900" 
                    letter-spacing="2" 
                    fill="#f8fafc" 
                    class="sm-badge-text"
                  >
                    9JA BEACON
                  </text>
                </g>

              </g>
            </svg>
          </div>
        </div>

        <!-- BOTTOM STAGE OVERLAY: Audio Waveform & Headline Strap -->
        <div class="relative z-20 space-y-2 mt-2">
          <!-- Audio Waveform Visualizer Bar -->
          <div id="sm-waveform-bar" class="flex items-center gap-1 h-3 opacity-30 transition-opacity">
            <span class="w-1 bg-red-500 rounded-full h-1 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-2 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-3 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-1 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-2.5 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-1.5 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-3 sm-wave-bar"></span>
            <span class="w-1 bg-red-500 rounded-full h-2 sm-wave-bar"></span>
            <span class="text-[9px] font-mono text-slate-400 ml-1.5" id="sm-waveform-label">Speech Audio Inactive</span>
          </div>

          <!-- Broadcast Lower-Third Headline Strap -->
          <div class="p-2 sm:p-2.5 rounded-xl bg-slate-900/90 border border-slate-700/80 shadow-lg flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 overflow-hidden">
              <span class="px-2 py-0.5 rounded bg-red-600 text-white font-mono font-black text-[10px] tracking-wider uppercase shrink-0">
                HEADLINE
              </span>
