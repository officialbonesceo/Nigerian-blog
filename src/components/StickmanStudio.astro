          </div>
        </div>

        <!-- SECTION 7: TALKING ANIMATION & SCRIPT -->
        <div class="space-y-3 pb-2">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-1.5">
              <span>🎙️ 7. Talking Lip-Sync & Speech Script</span>
            </h3>
            <button
              id="btn-toggle-talking"
              onclick="toggleStickmanTalkingLoop()"
              class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-[11px] font-bold transition cursor-pointer flex items-center gap-1"
            >
              <span id="sm-talking-pill-icon">▶️</span>
              <span id="sm-talking-pill-text">Toggle Talking Loop</span>
            </button>
          </div>

          <!-- Headline Input -->
          <div>
            <label class="block text-[11px] font-bold text-slate-700 dark:text-slate-300 mb-1">
              Broadcast Lower-Third Headline:
            </label>
            <input 
              type="text" 
              id="sm-input-headline" 
              value="Stickman Anchor Live On Air Across Nigeria" 
              oninput="updateStickmanHeadline(this.value)"
              class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-red-500 font-semibold"
            />
          </div>

          <!-- Script Textarea -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-[11px] font-bold text-slate-700 dark:text-slate-300">
                Anchor Speech Script:
              </label>
              <span id="sm-word-counter" class="text-[10px] font-mono text-slate-500">28 words • ~12s</span>
            </div>
            <textarea 
              id="sm-input-script" 
              rows="3" 
              oninput="handleStickmanScriptInput(this.value)"
              class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-red-500 leading-relaxed font-sans"
            >Good evening Nigeria. This is the 9jaBeacon Newsroom with your Chief Stickman Anchor. Delivering verified national breaking news, economic breakdowns, and live alerts directly to your feed.</textarea>
          </div>

          <!-- Quick Script Presets -->
          <div class="flex flex-wrap items-center gap-1.5 pt-1">
            <span class="text-[10px] font-mono text-slate-500">Presets:</span>
            <button onclick="loadStickmanPreset('breaking')" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-semibold transition cursor-pointer">Breaking</button>
            <button onclick="loadStickmanPreset('economy')" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-semibold transition cursor-pointer">Economy</button>
            <button onclick="loadStickmanPreset('tech')" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-semibold transition cursor-pointer">Technology</button>
            <button onclick="loadStickmanPreset('sports')" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-[10px] font-semibold transition cursor-pointer">Sports</button>
          </div>

          <!-- Export & Workflow Buttons -->
          <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center gap-2">
            <button
              onclick="copyStickmanWorkflowCommand()"
              class="flex-1 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>📋 Copy GitHub CLI Dispatch</span>
            </button>
            <button
              onclick="exportStickmanTimelineJson()"
              class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer"
              title="Download Timeline JSON"
            >
              <span>💾 JSON</span>
            </button>
