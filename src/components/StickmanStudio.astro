        </div>

      </div>

    </div>

  </div>
</div>

<style>
  /* Clean high-contrast vector styling for Stickman Presenter */
  .sm-stroke {
    transition: stroke 0.2s ease;
  }
  .sm-fill {
    transition: fill 0.2s ease;
  }

  /* Dark Theme Default Canvas */
  #sm-svg {
    color: #f8fafc; /* Crisp white line on dark canvas */
  }
  .sm-head-base {
    fill: #090d16;
  }
  .sm-desk-body {
    fill: #090d16;
  }
  .sm-desk-panel {
    fill: #0f172a;
  }
  .sm-desk-top {
    fill: #1e293b;
  }

  /* Light Theme Canvas Overrides */
  .sm-stage-light #sm-svg {
    color: #0f172a; /* Deep black line on light canvas */
  }
  .sm-stage-light .sm-head-base {
    fill: #ffffff;
  }
  .sm-stage-light .sm-desk-body {
    fill: #e2e8f0;
  }
  .sm-stage-light .sm-desk-panel {
    fill: #cbd5e1;
  }
  .sm-stage-light .sm-desk-top {
    fill: #94a3b8;
  }
  .sm-stage-light .sm-badge-text {
    fill: #0f172a;
  }
  .sm-stage-light .sm-desk-badge {
    fill: #ffffff;
    stroke: #94a3b8;
  }

  /* Wave animation for wave pose */
  @keyframes smHandWave {
    0%, 100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-18deg);
    }
  }
  #sm-arm-pose-wave {
    transform-origin: 332px 170px;
    animation: smHandWave 0.8s ease-in-out infinite;
  }
</style>

<script is:inline>
  // ==============================================================
  // SINGLE ARTICULATED STICKMAN PRESENTER CONTROLLER ENGINE
  // ==============================================================
  (function initStickmanEngine() {
    window.smState = {
      isBehindDesk: true,
      framing: 'medium', // 'full' | 'medium' | 'close'
      zoomPercent: 105,
      stageX: 0,
      gaze: 'straight', // 'up' | 'down' | 'left' | 'right' | 'straight' | 'side'
      motion: 'idle', // 'idle' | 'walk_left' | 'walk_right'
      armPose: 'desk-rest', // 'sideway' | 'point-left' | 'point-right' | 'desk-rest' | 'gesture' | 'wave' | 'tablet-read' | 'walk'
      expression: 'neutral', // 'neutral' | 'happy' | 'serious' | 'surprised' | 'concerned'
      isTalking: false,
      isReadingTablet: false,
      tabletReadingCadenceInterval: null,
      talkingInterval: null,
      walkAnimInterval: null,
      walkBob: 0,
      preferDeskAfterWalk: false,
      isPlaying: false,
      timelineInterval: null,
      currentTimeMs: 0,
      totalDurationMs: 12000,
      speechUtterance: null,
      isDarkStage: true
    };

    // 1. DESK TOGGLE (Behind Desk vs Full Screen)
    window.setStickmanDeskMode = function(isBehindDesk) {
      smState.isBehindDesk = isBehindDesk;
      const deskLayer = document.getElementById('sm-desk-layer');
      const chairLayer = document.getElementById('sm-studio-chair');
      const legsStand = document.getElementById('sm-legs-stand');
      const legsSeated = document.getElementById('sm-legs-seated');
      const floorShadow = document.getElementById('sm-floor-shadow');
      const deskStatusPill = document.getElementById('sm-desk-status-pill');
      const badgeMode = document.getElementById('sm-badge-mode');
      const btnOn = document.getElementById('btn-desk-on');
      const btnOff = document.getElementById('btn-desk-off');

      if (isBehindDesk) {
        if (deskLayer) deskLayer.classList.remove('opacity-0', 'pointer-events-none');
        if (chairLayer) chairLayer.classList.remove('opacity-0');
        // Behind desk: Completely hide standing legs! Modesty panel covers everything down to floor.
        if (legsStand) legsStand.classList.add('hidden');
        if (legsSeated) legsSeated.classList.remove('hidden');
        if (floorShadow) floorShadow.classList.add('opacity-0');
        if (deskStatusPill) deskStatusPill.textContent = 'Desk Active (Seated)';
        if (badgeMode) badgeMode.textContent = 'BEHIND DESK';
        
        if (btnOn) btnOn.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-red-600 border-red-500 text-white shadow-sm';
        if (btnOff) btnOff.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400';
        
        if (smState.armPose === 'sideway' && !smState.isReadingTablet) {
          setStickmanArmPose('desk-rest');
        }
      } else {
        // Full screen / full body standing view without desk
        if (deskLayer) deskLayer.classList.add('opacity-0', 'pointer-events-none');
        if (chairLayer) chairLayer.classList.add('opacity-0');
        if (legsStand) legsStand.classList.remove('hidden');
        if (legsSeated) legsSeated.classList.add('hidden');
        if (floorShadow) floorShadow.classList.remove('opacity-0');
        if (deskStatusPill) deskStatusPill.textContent = 'Full Screen (Standing)';
        if (badgeMode) badgeMode.textContent = 'FULL BODY';

        if (btnOff) btnOff.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-red-600 border-red-500 text-white shadow-sm';
        if (btnOn) btnOn.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400';

        if (smState.armPose === 'desk-rest' && !smState.isReadingTablet) {
          setStickmanArmPose('sideway');
        }
      }
      applyCameraFraming();
    };

    // 2. CAMERA FRAMING & DISTANCE (Anchored directly at Face & Tie: 300px, 125px)
    window.setStickmanFraming = function(mode) {
      smState.framing = mode;
      const btnFull = document.getElementById('btn-frame-full');
      const btnMed = document.getElementById('btn-frame-medium');
      const btnClose = document.getElementById('btn-frame-close');
      const zoomSlider = document.getElementById('sm-zoom-slider');

      const inactive = 'px-2.5 py-1.5 rounded-lg border font-semibold text-[11px] text-center transition cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400';
      const active = 'px-2.5 py-1.5 rounded-lg border font-semibold text-[11px] text-center transition cursor-pointer bg-red-600 border-red-500 text-white shadow-sm';

      if (btnFull) btnFull.className = mode === 'full' ? active : inactive;
      if (btnMed) btnMed.className = mode === 'medium' ? active : inactive;
      if (btnClose) btnClose.className = mode === 'close' ? active : inactive;

      if (mode === 'full') {
        smState.zoomPercent = 85;
      } else if (mode === 'medium') {
        smState.zoomPercent = 110;
      } else if (mode === 'close') {
        smState.zoomPercent = 160;
      }

      if (zoomSlider) zoomSlider.value = smState.zoomPercent;
      setStickmanCustomZoom(smState.zoomPercent);
    };

    window.setStickmanCustomZoom = function(val) {
      smState.zoomPercent = parseInt(val, 10);
      const zoomVal = document.getElementById('sm-zoom-val');
      if (zoomVal) zoomVal.textContent = `${smState.zoomPercent}%`;
      applyCameraFraming();
    };

    function applyCameraFraming() {
      const svg = document.getElementById('sm-svg');
      const viewport = document.getElementById('sm-camera-viewport');
      if (!svg) return;
      if (viewport) {
        viewport.style.transform = 'none';
        viewport.style.transformOrigin = 'center center';
      }
      const zoom = Math.max(60, Math.min(220, smState.zoomPercent || 100));
      const scale = zoom / 100;
      const w = 600 / scale;
      const h = 600 / scale;
      // Focus strictly on face (Y=105) and bold red tie (Y=160 to 240)
      const targetFocusY = smState.isBehindDesk ? 135 : (scale > 1.25 ? 120 : 255);
      const minX = 300 - w / 2;
      const minY = targetFocusY - h * (scale > 1.25 ? 0.32 : 0.42);
      svg.setAttribute('viewBox', `${minX.toFixed(1)} ${minY.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`);
    }

    // 3. TABLET READING CADENCE (User Requested)
    window.startTabletReadingCadence = function() {
      smState.isReadingTablet = true;
      const btnPickup = document.getElementById('btn-tablet-pickup');
      const btnPutdown = document.getElementById('btn-tablet-putdown');
      const deskTablet = document.getElementById('sm-desk-tablet');
      const pill = document.getElementById('sm-tablet-mode-pill');

      if (btnPickup) btnPickup.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-red-600 border-red-500 text-white shadow-sm';
      if (btnPutdown) btnPutdown.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400';
      if (deskTablet) deskTablet.classList.add('opacity-0');
      if (pill) {
        pill.className = 'text-[10px] font-mono font-bold text-emerald-500 dark:text-emerald-400';
        pill.textContent = 'Reading Tablet Cadence';
      }

      // Activate tablet-read arm pose
      setStickmanArmPose('tablet-read');
      toggleStickmanTalkingLoop(true);

      if (smState.tabletReadingCadenceInterval) clearInterval(smState.tabletReadingCadenceInterval);

      // Start natural cadence:
      // Alternate between looking down at tablet for 2.8s and looking straight up at audience for 2.8s!
      let lookingDownAtTablet = true;
      setStickmanGaze('down');

      smState.tabletReadingCadenceInterval = setInterval(() => {
        if (!smState.isReadingTablet) return;
        lookingDownAtTablet = !lookingDownAtTablet;
        if (lookingDownAtTablet) {
          setStickmanGaze('down');
        } else {
          setStickmanGaze('straight');
        }
      }, 2800);
    };

    window.putDownTabletToDesk = function() {
      smState.isReadingTablet = false;
      if (smState.tabletReadingCadenceInterval) {
        clearInterval(smState.tabletReadingCadenceInterval);
        smState.tabletReadingCadenceInterval = null;
      }

      const btnPickup = document.getElementById('btn-tablet-pickup');
      const btnPutdown = document.getElementById('btn-tablet-putdown');
      const deskTablet = document.getElementById('sm-desk-tablet');
      const pill = document.getElementById('sm-tablet-mode-pill');

      if (btnPickup) btnPickup.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400';
      if (btnPutdown) btnPutdown.className = 'p-2.5 rounded-xl border text-center transition flex items-center justify-center gap-2 font-bold text-xs cursor-pointer bg-red-600 border-red-500 text-white shadow-sm';
      if (deskTablet) deskTablet.classList.remove('opacity-0');
      if (pill) {
        pill.className = 'text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400';
        pill.textContent = 'Tablet On Desk';
      }

      // Restore desk rest pose and straight gaze
      setStickmanGaze('straight');
      setStickmanArmPose(smState.isBehindDesk ? 'desk-rest' : 'sideway');
    };

    // 4. STAGE HORIZONTAL X-POSITION
    window.setStickmanStageX = function(val) {
      smState.stageX = parseInt(val, 10);
      updateActorTransform();
    };

    window.centerStickmanPosition = function() {
      const slider = document.getElementById('sm-pos-x-slider');
      if (slider) slider.value = 0;
      smState.stageX = 0;
      updateActorTransform();
    };

    function updateActorTransform() {
      const actorGroup = document.getElementById('sm-actor-group');
      if (!actorGroup) return;
      const facing = smState.motion === 'walk_left' ? -1 : 1;
      const bob = (typeof smState.walkBob === 'number') ? smState.walkBob : 0;
      if (facing === -1) {
        actorGroup.setAttribute('transform', `translate(${smState.stageX}, ${bob}) translate(600, 0) scale(-1, 1)`);
      } else {
        actorGroup.setAttribute('transform', `translate(${smState.stageX}, ${bob})`);
      }
    }

    // 5. HEAD GAZE & TILT (Neck-Locked: Skull base 300px, 140px NEVER separates from spine)
    window.setStickmanGaze = function(gaze) {
      smState.gaze = gaze;
      const headGroup = document.getElementById('sm-head-group');
      const pupilL = document.getElementById('sm-pupil-left');
      const pupilR = document.getElementById('sm-pupil-right');
      const gazePill = document.getElementById('sm-gaze-pill');

      // Update button highlights
      ['up', 'down', 'left', 'right', 'straight', 'side'].forEach(g => {
        const btn = document.getElementById('btn-gaze-' + g);
        if (btn) {
          if (g === gaze) {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-red-600 border-red-500 text-white shadow-sm flex items-center justify-center gap-1';
          } else {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1';
          }
        }
      });

      if (gazePill) {
        gazePill.textContent = gaze.charAt(0).toUpperCase() + gaze.slice(1);
      }

      // Eyeball coordinates: Left eye is (288, 104), Right eye is (312, 104)
      let plX = 288, plY = 104, prX = 312, prY = 104;
      let rotAngle = 0;

      // Pure native SVG user-space rotation around skull base (300, 140):
      // Locks the head to the top of the neck line with 100% mechanical precision.
      if (gaze === 'up') {
        plY = 98;
        prY = 98;
        rotAngle = -9;
      } else if (gaze === 'down') {
        plY = 110;
        prY = 110;
        rotAngle = 10;
      } else if (gaze === 'left') {
        plX = 283;
        prX = 307;
        rotAngle = -7;
      } else if (gaze === 'right') {
        plX = 293;
        prX = 317;
        rotAngle = 7;
      } else if (gaze === 'side') {
        plX = 293;
        prX = 316;
        rotAngle = 6;
      } else {
        // straight / camera
        plX = 288;
        plY = 104;
        prX = 312;
        prY = 104;
        rotAngle = 0;
      }

      if (pupilL) { pupilL.setAttribute('cx', String(plX)); pupilL.setAttribute('cy', String(plY)); }
      if (pupilR) { pupilR.setAttribute('cx', String(prX)); pupilR.setAttribute('cy', String(prY)); }
      if (headGroup) { 
        headGroup.style.transformOrigin = '';
        headGroup.style.transform = '';
        headGroup.setAttribute('transform', `rotate(${rotAngle}, 300, 140)`); 
      }
    };

    // 6. HUMAN WALKING & MOTION ENGINE (Clean Bipedal Locomotion)
    window.setStickmanMotion = function(motion) {
      smState.motion = motion;
      const btnIdle = document.getElementById('btn-motion-idle');
      const btnLeft = document.getElementById('btn-motion-walk-left');
      const btnRight = document.getElementById('btn-motion-walk-right');
      const badgeMotion = document.getElementById('sm-badge-motion');
      const locoPill = document.getElementById('sm-loco-pill');

      const inactive = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1';
      const active = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-red-600 border-red-500 text-white shadow-sm flex items-center justify-center gap-1';

      if (btnIdle) btnIdle.className = motion === 'idle' ? active : inactive;
      if (btnLeft) btnLeft.className = motion === 'walk_left' ? active : inactive;
      if (btnRight) btnRight.className = motion === 'walk_right' ? active : inactive;

      if (badgeMotion) badgeMotion.textContent = motion.toUpperCase().replace('_', ' ');
      if (locoPill) locoPill.textContent = motion === 'idle' ? 'Standing' : motion === 'walk_left' ? 'Walking Left' : 'Walking Right';

      // Update facing and actor orientation
      updateActorTransform();

      const legsStand = document.getElementById('sm-legs-stand');
      const legsWalk = document.getElementById('sm-legs-walk');
      const walkArmPose = document.getElementById('sm-arm-pose-walk');

      if (smState.walkAnimInterval) {
        clearInterval(smState.walkAnimInterval);
        smState.walkAnimInterval = null;
      }

      if (motion === 'idle') {
        if (!smState.isBehindDesk) {
          if (legsStand) legsStand.classList.remove('hidden');
        }
        if (legsWalk) legsWalk.classList.add('hidden');
        if (walkArmPose) walkArmPose.classList.add('hidden');
        
        // Restore active arm pose
        setStickmanArmPose(smState.armPose === 'walk' ? (smState.isBehindDesk ? 'desk-rest' : 'sideway') : smState.armPose);
      } else {
        const legsSeated = document.getElementById('sm-legs-seated');
        if (smState.isBehindDesk) {
          smState.preferDeskAfterWalk = true;
          setStickmanDeskMode(false);
        }
        if (legsStand) legsStand.classList.add('hidden');
        if (legsSeated) legsSeated.classList.add('hidden');
        if (legsWalk) legsWalk.classList.remove('hidden');
        document.querySelectorAll('.sm-arm-pose').forEach(el => el.classList.add('hidden'));
        if (walkArmPose) walkArmPose.classList.remove('hidden');
        startHumanWalkCycle();
      }
    };

    function startHumanWalkCycle() {
      const walkLegL = document.getElementById('sm-walk-leg-l');
      const walkLegR = document.getElementById('sm-walk-leg-r');
      const walkArmL = document.getElementById('sm-walk-arm-l');
      const walkArmR = document.getElementById('sm-walk-arm-r');
      const slider = document.getElementById('sm-pos-x-slider');

      let tick = 0;
      smState.walkAnimInterval = setInterval(() => {
        tick += 0.16;
        const phase = tick % (Math.PI * 2);

        // Sinusoidal stride for natural human gait
        const strideL = Math.sin(phase);
        const strideR = Math.sin(phase + Math.PI); // 180 deg out of phase
        
        // Natural knee flexion on passing leg
        const kneeL = Math.max(0, -strideL) * 18;
        const kneeR = Math.max(0, -strideR) * 18;

        // Ground contact coordinates
        const footLX = 280 + (strideL * 40);
        const footLY = 525 - Math.max(0, strideL) * 10;
        const footRX = 320 + (strideR * 40);
        const footRY = 525 - Math.max(0, strideR) * 10;

        if (walkLegL) {
          walkLegL.setAttribute('d', `M 288 310 L ${284 + strideL * 15} ${420 - kneeL} L ${footLX} ${footLY} L ${footLX - 18} ${footLY + 3}`);
        }
        if (walkLegR) {
          walkLegR.setAttribute('d', `M 312 310 L ${316 + strideR * 15} ${420 - kneeR} L ${footRX} ${footRY} L ${footRX + 18} ${footRY + 3}`);
        }

        // Oppositional human arm swings (strict shoulder anchors 268 & 332)
        const armLX = 254 - (strideL * 30);
        const armLY = 280 + Math.abs(strideL) * 6;
        const armRX = 346 - (strideR * 30);
        const armRY = 280 + Math.abs(strideR) * 6;

        if (walkArmL) {
          walkArmL.setAttribute('d', `M 268 170 L ${258 - strideL * 12} 225 L ${armLX} ${armLY}`);
        }
        if (walkArmR) {
          walkArmR.setAttribute('d', `M 332 170 L ${342 - strideR * 12} 225 L ${armRX} ${armRY}`);
        }

        // Advance stage position
        if (smState.motion === 'walk_right') {
          smState.stageX = Math.min(160, smState.stageX + 1.2);
          if (slider) slider.value = smState.stageX;
          updateActorTransform();
          if (smState.stageX >= 160) {
            setStickmanMotion('walk_left'); // Turn around at boundary
          }
        } else if (smState.motion === 'walk_left') {
          smState.stageX = Math.max(-160, smState.stageX - 1.2);
          if (slider) slider.value = smState.stageX;
          updateActorTransform();
          if (smState.stageX <= -160) {
            setStickmanMotion('walk_right'); // Turn around at boundary
          }
        }

      }, 40);
    }

    // 7. ARMS & HAND POSES (Shoulders Anchored: 268 & 332)
    window.setStickmanArmPose = function(poseId) {
      if (smState.motion !== 'idle') {
        setStickmanMotion('idle');
      }

      smState.armPose = poseId;
      const armPill = document.getElementById('sm-arm-pill');
      if (armPill) {
        armPill.textContent = poseId.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase());
      }

      // Hide all arm pose layers
      document.querySelectorAll('.sm-arm-pose').forEach(el => el.classList.add('hidden'));

      // Show requested pose
      const targetPoseEl = document.getElementById('sm-arm-pose-' + poseId);
      if (targetPoseEl) targetPoseEl.classList.remove('hidden');

      // Update button highlights
      ['sideway', 'point-left', 'point-right', 'desk-rest', 'gesture', 'wave', 'tablet-read'].forEach(p => {
        const btn = document.getElementById('btn-arm-' + p);
        if (btn) {
          if (p === poseId) {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-red-600 border-red-500 text-white shadow-sm flex items-center justify-center gap-1';
          } else {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1';
          }
        }
      });
    };

    // 8. FACIAL EXPRESSIONS & BLINK
    window.setStickmanExpression = function(expr) {
      smState.expression = expr;
      const exprPill = document.getElementById('sm-expr-pill');
      if (exprPill) exprPill.textContent = expr.charAt(0).toUpperCase() + expr.slice(1);

      // Hide mouth shapes
      document.querySelectorAll('.sm-mouth-shape').forEach(el => el.classList.add('hidden'));

      const browL = document.getElementById('sm-brow-left');
      const browR = document.getElementById('sm-brow-right');

      if (expr === 'happy') {
        const m = document.getElementById('sm-mouth-smile');
        if (m) m.classList.remove('hidden');
        if (browL) browL.setAttribute('d', 'M 280 90 Q 288 86 294 91');
        if (browR) browR.setAttribute('d', 'M 306 91 Q 312 86 320 90');
      } else if (expr === 'serious') {
        const m = document.getElementById('sm-mouth-serious');
        if (m) m.classList.remove('hidden');
        if (browL) browL.setAttribute('d', 'M 280 95 Q 288 93 294 97');
        if (browR) browR.setAttribute('d', 'M 306 97 Q 312 93 320 95');
      } else if (expr === 'surprised') {
        const m = document.getElementById('sm-mouth-surprised');
        if (m) m.classList.remove('hidden');
        if (browL) browL.setAttribute('d', 'M 278 88 Q 288 83 294 88');
        if (browR) browR.setAttribute('d', 'M 306 88 Q 312 83 322 88');
      } else if (expr === 'concerned') {
        const m = document.getElementById('sm-mouth-neutral');
        if (m) m.classList.remove('hidden');
        if (browL) browL.setAttribute('d', 'M 280 96 Q 288 90 294 92');
        if (browR) browR.setAttribute('d', 'M 306 92 Q 312 90 320 96');
      } else {
        // Neutral
        const m = document.getElementById('sm-mouth-neutral');
        if (m) m.classList.remove('hidden');
        if (browL) browL.setAttribute('d', 'M 280 93 Q 288 91 294 93');
        if (browR) browR.setAttribute('d', 'M 306 93 Q 312 91 320 93');
      }

      // Update button highlights
      ['neutral', 'happy', 'serious', 'surprised', 'concerned'].forEach(e => {
        const btn = document.getElementById('btn-expr-' + e);
        if (btn) {
          if (e === expr) {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-red-600 border-red-500 text-white shadow-sm flex items-center justify-center gap-1';
          } else {
            btn.className = 'px-2.5 py-2 rounded-xl border font-bold text-xs text-center transition cursor-pointer bg-slate-100 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1';
          }
        }
      });
    };

    window.triggerStickmanBlink = function() {
      const blinkEl = document.getElementById('sm-blink-eyelids');
      if (!blinkEl) return;
      blinkEl.classList.remove('opacity-0');
      blinkEl.classList.add('opacity-100');
      setTimeout(() => {
        blinkEl.classList.remove('opacity-100');
        blinkEl.classList.add('opacity-0');
      }, 160);
    };

    // Auto natural periodic human blinking every 4-6 seconds
    setInterval(() => {
      if (Math.random() < 0.7) {
        triggerStickmanBlink();
      }
    }, 4500);

    // 9. TALKING ANIMATION & PHONEMES
    window.toggleStickmanTalkingLoop = function(force) {
      const willTalk = typeof force === 'boolean' ? force : !smState.isTalking;
      smState.isTalking = willTalk;

      const pillText = document.getElementById('sm-talking-pill-text');
      const pillIcon = document.getElementById('sm-talking-pill-icon');
      const waveBar = document.getElementById('sm-waveform-bar');
      const waveLabel = document.getElementById('sm-waveform-label');

      if (pillText) pillText.textContent = willTalk ? 'Talking (Active)' : 'Toggle Talking Loop';
      if (pillIcon) pillIcon.textContent = willTalk ? '⏹️' : '▶️';
      if (waveBar) waveBar.className = willTalk ? 'flex items-center gap-1 h-3 opacity-100 transition-opacity' : 'flex items-center gap-1 h-3 opacity-30 transition-opacity';
      if (waveLabel) waveLabel.textContent = willTalk ? 'Speech Lip-Sync Running' : 'Speech Audio Inactive';

      if (smState.talkingInterval) {
        clearInterval(smState.talkingInterval);
        smState.talkingInterval = null;
      }

      if (!willTalk) {
        setStickmanExpression(smState.expression);
        return;
      }

      // Cycle speech phonemes smoothly
      const phonemes = ['sm-mouth-talk-open', 'sm-mouth-talk-semi', 'sm-mouth-talk-round', 'sm-mouth-neutral', 'sm-mouth-smile'];
      let idx = 0;
      smState.talkingInterval = setInterval(() => {
        document.querySelectorAll('.sm-mouth-shape').forEach(el => el.classList.add('hidden'));
        const activePhoneme = phonemes[idx % phonemes.length];
        const pEl = document.getElementById(activePhoneme);
        if (pEl) pEl.classList.remove('hidden');
        idx++;

        // Random audio bar bounce
        document.querySelectorAll('.sm-wave-bar').forEach(b => {
          b.style.height = `${(4 + Math.random() * 8).toFixed(0)}px`;
        });
      }, 130);
    };

    // 10. BROADCAST SCRIPT & HEADLINE
    window.updateStickmanHeadline = function(text) {
      const strap = document.getElementById('sm-strap-headline');
      if (strap) strap.textContent = text || 'Stickman Anchor Live On Air';
    };

    window.handleStickmanScriptInput = function(text) {
      const words = (text || '').trim().split(/\s+/).filter(Boolean);
      const count = words.length;
      const sec = Math.max(Math.ceil((count / 140) * 60), 3);
      smState.totalDurationMs = sec * 1000;

      const counter = document.getElementById('sm-word-counter');
      if (counter) counter.textContent = `${count} words • ~${sec}s`;
      const scrubTotal = document.getElementById('sm-scrubber-total');
      if (scrubTotal) scrubTotal.textContent = formatMs(smState.totalDurationMs);
    };

    window.loadStickmanPreset = function(presetKey) {
      const presets = {
        breaking: {
          headline: 'URGENT: Major Economic Infrastructure Milestone Ratified in Abuja',
          script: 'Good evening. Breaking news tonight as federal authorities approve a nationwide digital transit roadmap. Early projections confirm substantial economic acceleration across all thirty-six states.'
        },
        economy: {
          headline: 'Forex Reserves Rebound: Naira Demonstrates Strong Stability',
          script: 'From the 9jaBeacon Business Desk, foreign exchange reserves registered substantial expansion this week, bolstered by non-oil export receipts and diaspora remittances. Central authorities forecast sustainable structural stability.'
        },
        tech: {
          headline: 'Nigeria Tech Frontier: Cloud Datacenters Launch in Lagos Hub',
          script: 'Artificial intelligence infrastructure and high-speed fiber interlinks have officially gone live across southwest enterprise zones, providing low-latency compute for hundreds of homegrown tech platforms.'
        },
        sports: {
          headline: 'Super Eagles Secure Crucial Continental Championship Berth',
          script: 'A sensational victory in Uyo tonight as Nigeria delivers an authoritative masterclass on the continental stage. Fans across the nation and the diaspora celebrate an unforgettable performance.'
        }
      };

      const p = presets[presetKey] || presets.breaking;
      const headInput = document.getElementById('sm-input-headline');
      const scriptInput = document.getElementById('sm-input-script');

      if (headInput) { headInput.value = p.headline; updateStickmanHeadline(p.headline); }
      if (scriptInput) { scriptInput.value = p.script; handleStickmanScriptInput(p.script); }
    };

    // 11. TIMELINE & SPEECH SYNTHESIS PLAYBACK
    window.toggleStickmanPlay = function() {
      if (smState.isPlaying) {
        stopStickmanMotion();
      } else {
        startStickmanSpeechAndMotion();
      }
    };

    window.startStickmanSpeechAndMotion = function() {
      smState.isPlaying = true;
      const playLabel = document.getElementById('sm-play-label');
      const playIcon = document.getElementById('sm-play-icon');
      const badgeStatus = document.getElementById('sm-badge-status');

      if (playLabel) playLabel.textContent = 'Pause Motion';
      if (playIcon) playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
      if (badgeStatus) {
        badgeStatus.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-[10px] font-mono font-bold animate-pulse';
        badgeStatus.textContent = 'ON AIR';
      }

      toggleStickmanTalkingLoop(true);

      const script = (document.getElementById('sm-input-script')?.value || '').trim();
      if ('speechSynthesis' in window && script) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(script);
        utter.rate = 1.0;
        utter.pitch = 1.0;
        utter.onend = function() {
          stopStickmanMotion();
        };
        smState.speechUtterance = utter;
        setTimeout(() => window.speechSynthesis.speak(utter), 40);
      }

      const startTime = Date.now() - smState.currentTimeMs;
      if (smState.timelineInterval) clearInterval(smState.timelineInterval);

      smState.timelineInterval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        smState.currentTimeMs = elapsed;

        if (elapsed >= smState.totalDurationMs) {
          stopStickmanMotion();
          return;
        }

        updateScrubberUI(elapsed);
      }, 50);
    };

    window.stopStickmanMotion = function() {
      smState.isPlaying = false;
      smState.currentTimeMs = 0;

      if (smState.timelineInterval) clearInterval(smState.timelineInterval);
      if (smState.talkingInterval) clearInterval(smState.talkingInterval);
      if (smState.tabletReadingCadenceInterval) {
        clearInterval(smState.tabletReadingCadenceInterval);
        smState.tabletReadingCadenceInterval = null;
      }
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();

      toggleStickmanTalkingLoop(false);

      const playLabel = document.getElementById('sm-play-label');
      const playIcon = document.getElementById('sm-play-icon');
      const badgeStatus = document.getElementById('sm-badge-status');

      if (playLabel) playLabel.textContent = 'Play Speech & Motion';
      if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      if (badgeStatus) {
        badgeStatus.className = 'px-2 py-0.5 rounded-md bg-slate-800/90 border border-slate-700 text-slate-300 text-[10px] font-mono font-bold';
        badgeStatus.textContent = 'STANDBY';
      }

      updateScrubberUI(0);
    };

    function updateScrubberUI(currentMs) {
      const timeCode = document.getElementById('sm-time-code');
      const scrubCurrent = document.getElementById('sm-scrubber-current');
      const slider = document.getElementById('sm-timeline-slider');

      if (timeCode) timeCode.textContent = formatMsShort(currentMs);
      if (scrubCurrent) scrubCurrent.textContent = formatMs(currentMs);
      if (slider && smState.totalDurationMs > 0) {
        slider.value = ((currentMs / smState.totalDurationMs) * 100).toFixed(1);
      }
    }

    window.handleTimelineScrub = function(pct) {
      const targetMs = (parseFloat(pct) / 100) * smState.totalDurationMs;
      smState.currentTimeMs = targetMs;
      updateScrubberUI(targetMs);
    };

    function formatMs(ms) {
      const s = Math.max(0, ms) / 1000;
      const m = Math.floor(s / 60);
      const remS = Math.floor(s % 60);
      const remMs = Math.floor(ms % 1000);
      return `${String(m).padStart(2, '0')}:${String(remS).padStart(2, '0')}.${String(remMs).padStart(3, '0')}`;
    }

    function formatMsShort(ms) {
      const s = Math.max(0, ms) / 1000;
      const m = Math.floor(s / 60);
      const remS = Math.floor(s % 60);
      const dec = Math.floor((ms % 1000) / 100);
      return `${String(m).padStart(2, '0')}:${String(remS).padStart(2, '0')}.${dec}`;
    }

    // 12. CHOREOGRAPHED 10s SCENE
    window.playChoreographedNewsScene = function() {
      stopStickmanMotion();
      // Step 1: Start seated behind desk looking down at notes
      setStickmanDeskMode(true);
      setStickmanFraming('medium');
      setStickmanGaze('down');
      setStickmanArmPose('desk-rest');
      setStickmanExpression('serious');
      centerStickmanPosition();

      setTimeout(() => {
        // Step 2 (1.5s): Look straight up to camera, neutral expression, start talking
        setStickmanGaze('straight');
        setStickmanExpression('neutral');
        toggleStickmanTalkingLoop(true);
      }, 1500);

      setTimeout(() => {
        // Step 3 (3.8s): Pick up tablet to read news
        startTabletReadingCadence();
      }, 3800);

      setTimeout(() => {
        // Step 4 (7.0s): Put tablet back down and point right arm towards story charts
        putDownTabletToDesk();
        setStickmanGaze('right');
        setStickmanArmPose('point-right');
        setStickmanExpression('happy');
      }, 7000);

      setTimeout(() => {
        // Step 5 (8.8s): Look straight, hands back on desk, wrap up
        setStickmanGaze('straight');
        setStickmanArmPose('desk-rest');
        setStickmanExpression('happy');
      }, 8800);

      setTimeout(() => {
        // Step 6 (10s): Finished scene
        toggleStickmanTalkingLoop(false);
      }, 10000);
    };

    // 13. CANVAS THEME TOGGLE (Dark vs Light Stage)
    window.toggleStickmanStudioTheme = function() {
      smState.isDarkStage = !smState.isDarkStage;
      const frame = document.getElementById('sm-monitor-frame');
      const icon = document.getElementById('theme-toggle-icon');
      const label = document.getElementById('theme-toggle-label');

      if (smState.isDarkStage) {
        if (frame) {
          frame.classList.remove('bg-slate-100', 'border-slate-300', 'sm-stage-light');
          frame.classList.add('bg-slate-950', 'border-slate-800');
        }
        if (icon) icon.textContent = '🌙';
        if (label) label.textContent = 'Dark Stage';
      } else {
        if (frame) {
          frame.classList.remove('bg-slate-950', 'border-slate-800');
          frame.classList.add('bg-slate-100', 'border-slate-300', 'sm-stage-light');
        }
        if (icon) icon.textContent = '☀️';
        if (label) label.textContent = 'Light Stage';
      }
    };

    // 14. EXPORT HELPERS
    window.copyStickmanWorkflowCommand = function() {
      const headline = (document.getElementById('sm-input-headline')?.value || 'Breaking News').replace(/"/g, '\\"');
      const script = (document.getElementById('sm-input-script')?.value || '').replace(/"/g, '\\"');
      const cmd = `gh workflow run generate-broadcast-video.yml -f presenter_id="presenter_stickman" -f headline="${headline}" -f custom_script="${script}" -f desk_mode="${smState.isBehindDesk}"`;

      navigator.clipboard.writeText(cmd).then(() => {
        alert('Copied GitHub CLI Dispatch Command to clipboard:\n' + cmd);
      }).catch(() => {
        prompt('Copy GitHub CLI Dispatch Command:', cmd);
      });
    };

    window.exportStickmanTimelineJson = function() {
      const headline = document.getElementById('sm-input-headline')?.value || '';
      const script = document.getElementById('sm-input-script')?.value || '';
      const timelineData = {
        anchor: 'Beacon Stickman Presenter (Vector)',
        tie: 'Bold Red Tie',
        deskMode: smState.isBehindDesk,
        framing: smState.framing,
        zoom: smState.zoomPercent,
        gaze: smState.gaze,
        armPose: smState.armPose,
        isReadingTablet: smState.isReadingTablet,
        expression: smState.expression,
        motion: smState.motion,
        headline,
        script,
        durationMs: smState.totalDurationMs,
        exportedAt: new Date().toISOString()
      };

      const blob = new Blob([JSON.stringify(timelineData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `stickman-presenter-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    };

    // Initialize framing on load & re-evaluate when tab becomes active
    setTimeout(() => {
      setStickmanDeskMode(true);
      setStickmanFraming('medium');
      setStickmanGaze('straight');
    }, 100);

    window.addEventListener('resize', applyCameraFraming);
    document.addEventListener('click', (e) => {
      if (e.target && (e.target.closest?.('#tab-btn-presenters') || e.target.id === 'tab-btn-presenters')) {
        setTimeout(applyCameraFraming, 120);
      }
    });

  })();
</script>
