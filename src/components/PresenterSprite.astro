---
import { getPresenterById, presenters } from '../lib/presenters-data';
import type { 
  PresenterPose, 
  PresenterArmState
} from '../lib/types';

interface Props {
  presenterId?: string;
  gesture?: 'idle' | 'point-left' | 'point-right' | 'point-up' | 'explain' | 'emphasize' | 'wave' | 'reading' | string;
  expression?: 'neutral' | 'happy' | 'serious' | 'surprised' | 'concerned' | string;
  gaze?: 'camera' | 'left' | 'right' | 'down' | string;
  mouth?: 'auto' | 'closed' | 'open' | 'wide' | string;
  pose?: PresenterPose;
  armState?: PresenterArmState;
  viewMode?: 'full' | 'closeup';
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'stage';
  interactive?: boolean;
  headline?: string;
  ticker?: string;
  className?: string;
}

const {
  presenterId = 'presenter_femi',
  gesture: propGesture,
  expression: propExpression = 'neutral',
  gaze: propGaze = 'camera',
  mouth: propMouth = 'auto',
  pose = 'idle',
  armState = 'desk_rest',
  viewMode = 'full',
  size = 'md',
  interactive = false,
  headline = 'BREAKING NEWS',
  ticker = 'Live from the studio',
  className = ''
} = Astro.props;

const presenter = getPresenterById(presenterId) || presenters[0];

// Map standard poses or arm states into the user's gesture IDs
const resolveGesture = (): string => {
  if (propGesture) {
    if (propGesture.startsWith('g-')) return propGesture;
    return `g-${propGesture}`;
  }
  if (armState === 'gesture_screen') return 'g-point-right';
  if (armState === 'hold_notes') return 'g-reading';
  if (pose === 'breaking') return 'g-emphasize';
  if (pose === 'wrap') return 'g-wave';
  return 'g-idle';
};

const resolveExpression = (): string => {
  if (propExpression) {
    if (propExpression.startsWith('expr-')) return propExpression;
    return `expr-${propExpression}`;
  }
  if (pose === 'breaking') return 'expr-serious';
  if (pose === 'wrap') return 'expr-happy';
  return 'expr-neutral';
};

const resolveGazeClass = (): string => {
  if (propGaze === 'left' || propGaze === 'gaze_left') return 'gaze-left';
  if (propGaze === 'right' || propGaze === 'gaze_right' || propGaze === 'screen') return 'gaze-right';
  if (propGaze === 'down' || propGaze === 'gaze_down' || propGaze === 'book') return 'gaze-down';
  return '';
};

const activeGesture = resolveGesture();
const activeExpression = resolveExpression();
const activeGazeClass = resolveGazeClass();
const isReading = activeGesture === 'g-reading';

const sizeClasses = {
  sm: 'w-24 h-28 sm:w-28 sm:h-32 rounded-xl',
  md: 'w-48 h-56 sm:w-64 sm:h-72 rounded-2xl',
  lg: 'w-72 h-84 sm:w-88 sm:h-96 rounded-2xl',
  xl: 'w-full max-w-[420px] rounded-2xl',
  stage: 'w-full h-full rounded-2xl'
};

const viewBoxValue = viewMode === 'closeup' ? '100 90 200 310' : '0 0 400 480';
---

<div 
  class={`presenter-user-card relative inline-block select-none max-w-full font-sans ${className}`}
  data-presenter-id={presenter.id}
  data-presenter-name={presenter.name}
  data-current-gesture={activeGesture}
  data-current-expression={activeExpression}
  data-current-gaze={propGaze}
  data-current-mouth={propMouth}
  data-view-mode={viewMode}
>
  <!-- Card Container with Dark/Light Tokens -->
  <div 
    class={`relative overflow-hidden transition-all duration-300 shadow-2xl border border-slate-700/60 dark:border-slate-800 bg-[#ffffff] dark:bg-[#1d2026] text-slate-900 dark:text-slate-100 ${interactive ? 'p-3 sm:p-4 rounded-2xl' : ''}`}
  >
    <!-- SVG Presenter Scene -->
    <svg 
      viewBox={viewBoxValue} 
      class={`w-full h-auto drop-shadow-md select-none ${sizeClasses[size]} ${activeGazeClass} ${isReading ? 'reading' : ''} ${activeExpression === 'expr-surprised' ? 'expr-surprised' : ''}`}
      role="img"
      id={`scene-${presenter.id}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <title>9jaBeacon news presenter — {presenter.name}</title>
      <desc>Modular flat cartoon news anchor with selectable gestures, expressions, head-turn gaze, and lip-sync mouth frames.</desc>

      <defs>
        <!-- Shaded cylindrical neck gradient from user design -->
        <linearGradient id={`neckGrad_${presenter.id}`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#b8734c"/>
          <stop offset="35%" stop-color="#f0b687"/>
          <stop offset="65%" stop-color="#f0b687"/>
          <stop offset="100%" stop-color="#b8734c"/>
        </linearGradient>
      </defs>

      {viewMode === 'full' && (
        <!-- Studio Background -->
        <rect x="0" y="0" width="400" height="480" fill="#152a4d"/>
        <circle cx="340" cy="70" r="120" fill="#1c3560"/>

        <!-- Left Monitor: Line Chart -->
        <g class="studio-monitor-left">
          <rect x="18" y="92" width="92" height="60" rx="4" fill="#1c3560"/>
          <rect x="28" y="100" width="72" height="44" rx="2" fill="#2a4d85"/>
          <path d="M40 130 L54 112 L66 124 L84 106" stroke="#7fa8e0" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </g>

        <!-- Right Monitor: Clock/Dial -->
        <g class="studio-monitor-right">
          <rect x="290" y="92" width="92" height="60" rx="4" fill="#1c3560"/>
          <rect x="300" y="100" width="72" height="44" rx="2" fill="#2a4d85"/>
          <circle cx="336" cy="122" r="14" fill="none" stroke="#7fa8e0" stroke-width="3"/>
          <path d="M336 122 L336 112 M336 122 L344 126" stroke="#7fa8e0" stroke-width="3" stroke-linecap="round"/>
        </g>

        <!-- Red Horizon Accent Line -->
        <rect x="0" y="250" width="400" height="4" fill="#c4372a"/>
      )}

      <!-- Character Bob Group with Preserved Anchor Geometry -->
      <g class="bob" transform="translate(200,219) scale(0.72) translate(-200,-270)">

        <!-- ===== GESTURE LIBRARY (8 Switchable Arm/Hand States) ===== -->

        <!-- 1. g-idle -->
        <g class={`gesture-group ${activeGesture === 'g-idle' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-idle-${presenter.id}`}>
          <path d="M152 344 Q140 392 158 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <path d="M248 344 Q260 392 242 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="166" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <ellipse cx="234" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M152 450 Q166 444 180 450" stroke="#c8875c" stroke-width="2" fill="none" stroke-linecap="round"/>
          <path d="M220 450 Q234 444 248 450" stroke="#c8875c" stroke-width="2" fill="none" stroke-linecap="round"/>
        </g>

        <!-- 2. g-point-left -->
        <g class={`gesture-group ${activeGesture === 'g-point-left' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-point-left-${presenter.id}`}>
          <path d="M152 344 Q140 392 158 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="166" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M248 344 Q190 318 120 298 Q92 290 70 286" stroke="#1c2c4a" stroke-width="30" fill="none" stroke-linecap="round"/>
          <ellipse cx="68" cy="284" rx="15" ry="9" transform="rotate(-14 68 284)" fill="#dc9b6c"/>
          <path d="M56 281 L36 277" stroke="#dc9b6c" stroke-width="7" stroke-linecap="round"/>
        </g>

        <!-- 3. g-point-right (Points to Side Projection Screen) -->
        <g class={`gesture-group ${activeGesture === 'g-point-right' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-point-right-${presenter.id}`}>
          <path d="M248 344 Q260 392 242 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="234" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M152 344 Q210 318 280 298 Q308 290 330 286" stroke="#1c2c4a" stroke-width="30" fill="none" stroke-linecap="round"/>
          <ellipse cx="332" cy="284" rx="15" ry="9" transform="rotate(14 332 284)" fill="#dc9b6c"/>
          <path d="M344 281 L364 277" stroke="#dc9b6c" stroke-width="7" stroke-linecap="round"/>
        </g>

        <!-- 4. g-point-up -->
        <g class={`gesture-group ${activeGesture === 'g-point-up' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-point-up-${presenter.id}`}>
          <path d="M152 344 Q140 392 158 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="166" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M248 344 Q244 280 224 230" stroke="#1c2c4a" stroke-width="28" fill="none" stroke-linecap="round"/>
          <ellipse cx="220" cy="220" rx="12" ry="10" fill="#dc9b6c"/>
          <path d="M220 210 L220 178" stroke="#dc9b6c" stroke-width="8" stroke-linecap="round"/>
        </g>

        <!-- 5. g-explain -->
        <g class={`gesture-group ${activeGesture === 'g-explain' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-explain-${presenter.id}`}>
          <path d="M152 344 Q128 316 138 294" stroke="#1c2c4a" stroke-width="30" fill="none" stroke-linecap="round"/>
          <path d="M248 344 Q272 316 262 294" stroke="#1c2c4a" stroke-width="30" fill="none" stroke-linecap="round"/>
          <ellipse cx="128" cy="288" rx="20" ry="15" fill="#dc9b6c"/>
          <ellipse cx="272" cy="288" rx="20" ry="15" fill="#dc9b6c"/>
          <path d="M118 278 L118 296 M128 276 L128 298 M138 278 L138 296" stroke="#c8875c" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M262 278 L262 296 M272 276 L272 298 M282 278 L282 296" stroke="#c8875c" stroke-width="2.5" stroke-linecap="round"/>
        </g>

        <!-- 6. g-emphasize -->
        <g class={`gesture-group ${activeGesture === 'g-emphasize' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-emphasize-${presenter.id}`}>
          <path d="M152 344 Q140 392 158 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="166" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M248 344 Q232 300 216 266" stroke="#1c2c4a" stroke-width="28" fill="none" stroke-linecap="round"/>
          <ellipse cx="213" cy="258" rx="13" ry="11" fill="#dc9b6c"/>
          <path d="M213 248 L213 222" stroke="#dc9b6c" stroke-width="8" stroke-linecap="round"/>
        </g>

        <!-- 7. g-wave (Sign-off) -->
        <g class={`gesture-group ${activeGesture === 'g-wave' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-wave-${presenter.id}`}>
          <path d="M152 344 Q140 392 158 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="166" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
          <path d="M248 344 Q256 294 230 252" stroke="#1c2c4a" stroke-width="28" fill="none" stroke-linecap="round"/>
          <ellipse cx="226" cy="244" rx="16" ry="14" fill="#dc9b6c"/>
          <path d="M214 230 L208 218" stroke="#dc9b6c" stroke-width="5" stroke-linecap="round"/>
          <path d="M224 226 L222 212" stroke="#dc9b6c" stroke-width="5" stroke-linecap="round"/>
          <path d="M234 228 L238 214" stroke="#dc9b6c" stroke-width="5" stroke-linecap="round"/>
        </g>

        <!-- 8. g-reading (Consulting Briefing Book / Tablet) -->
        <g class={`gesture-group ${activeGesture === 'g-reading' ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} id={`g-reading-${presenter.id}`}>
          <path d="M152 344 Q130 390 165 428" stroke="#1c2c4a" stroke-width="32" fill="none" stroke-linecap="round"/>
          <!-- Dossier Bulletin Sheet -->
          <rect x="150" y="400" width="54" height="38" rx="3" fill="#e9edf2" stroke="#b9c2cc" stroke-width="1.5" transform="rotate(-8 177 419)"/>
          <line x1="156" y1="409" x2="198" y2="403" stroke="#047857" stroke-width="1.5" transform="rotate(-8 177 419)"/>
          <line x1="156" y1="416" x2="194" y2="410" stroke="#64748b" stroke-width="1" transform="rotate(-8 177 419)"/>
          <line x1="156" y1="422" x2="190" y2="416" stroke="#64748b" stroke-width="1" transform="rotate(-8 177 419)"/>
          <ellipse cx="176" cy="434" rx="16" ry="11" fill="#dc9b6c"/>
          <path d="M248 344 Q260 392 242 442" stroke="#1c2c4a" stroke-width="34" fill="none" stroke-linecap="round"/>
          <ellipse cx="234" cy="452" rx="19" ry="13" fill="#dc9b6c"/>
        </g>

        <!-- WARDROBE: Broad Navy Blazer, Inner Collar, Shirt & Crimson Tie -->
        <path d="M70 480 Q75 360 140 332 Q170 322 200 322 Q230 322 260 332 Q325 360 330 480 Z" fill="#1c2c4a"/>
        <path d="M170 335 L200 358 L185 337 Z" fill="#0e1830"/>
        <path d="M230 335 L200 358 L215 337 Z" fill="#0e1830"/>
        <ellipse cx="200" cy="345" rx="20" ry="11" fill="#f4f6f9"/>
        <path d="M192 343 Q200 339 208 343 L205 393 Q200 399 195 393 Z" fill="#c4372a"/>

        <!-- NECK: Cylindrical Shading with Gradient (Remains anchored while head turns) -->
        <path d="M186 300 Q182 314 180 330 Q200 340 220 330 Q218 314 214 300 Q200 308 186 300 Z" fill={`url(#neckGrad_${presenter.id})`}/>

        <!-- ===== HEAD GROUP: Turns and tips together with transform-origin ===== -->
        <g id={`head-group-${presenter.id}`} class="head-group-el transition-transform duration-300" style="transform-origin: 200px 300px;">

          <!-- Ears -->
          <path d="M130 238 Q140 234 142 246 Q144 258 134 264 Q124 260 124 248 Q124 240 130 238 Z" fill="#c8875c"/>
          <path d="M270 238 Q260 234 258 246 Q256 258 266 264 Q276 260 276 248 Q276 240 270 238 Z" fill="#c8875c"/>

          <!-- Head Shape -->
          <path d="M200 130
                   C 246 130 268 168 266 210
                   C 265 248 254 280 238 302
                   C 224 320 212 328 200 328
                   C 188 328 176 320 162 302
                   C 146 280 135 248 134 210
                   C 132 168 154 130 200 130 Z" fill="#dc9b6c"/>
          <path d="M238 200 C 244 240 232 280 210 306 C 232 300 250 268 252 226 C 253 216 246 206 238 200 Z" fill="#c8875c"/>

          <!-- Stylized Dark Hair & Side Tapers -->
          <path d="M130 210
                   C 122 150 158 100 200 100
                   C 242 100 278 150 270 210
                   C 264 190 248 175 228 172
                   C 220 165 210 162 200 162
                   C 190 162 180 165 172 172
                   C 152 175 136 190 130 210 Z" fill="#1c1410"/>
          <path d="M190 165 Q196 150 206 160 Q198 172 190 165 Z" fill="#140d09"/>
          <path d="M214 168 Q222 152 232 164 Q222 176 214 168 Z" fill="#140d09"/>
          <path d="M166 172 Q172 158 182 168 Q174 180 166 172 Z" fill="#140d09"/>
          <path d="M175 155 Q195 140 215 150" stroke="#4a372a" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.6"/>

          <!-- EXPRESSION LIBRARY (Eyebrows) -->
          <g class={`expr-group ${activeExpression === 'expr-neutral' ? 'opacity-100' : 'opacity-0'}`} id={`expr-neutral-${presenter.id}`}>
            <path d="M156 202 Q170 192 186 198" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
            <path d="M214 198 Q230 192 244 202" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
          </g>
          <g class={`expr-group ${activeExpression === 'expr-happy' ? 'opacity-100' : 'opacity-0'}`} id={`expr-happy-${presenter.id}`}>
            <path d="M154 200 Q170 184 188 196" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
            <path d="M212 196 Q230 184 246 200" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
          </g>
          <g class={`expr-group ${activeExpression === 'expr-serious' ? 'opacity-100' : 'opacity-0'}`} id={`expr-serious-${presenter.id}`}>
            <path d="M156 206 Q170 202 186 206" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
            <path d="M214 206 Q230 202 244 206" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
          </g>
          <g class={`expr-group ${activeExpression === 'expr-surprised' ? 'opacity-100' : 'opacity-0'}`} id={`expr-surprised-${presenter.id}`}>
            <path d="M152 190 Q170 172 190 188" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
            <path d="M210 188 Q230 172 248 190" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
          </g>
          <g class={`expr-group ${activeExpression === 'expr-concerned' ? 'opacity-100' : 'opacity-0'}`} id={`expr-concerned-${presenter.id}`}>
            <path d="M156 206 Q170 196 188 192" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
            <path d="M212 192 Q230 196 244 206" stroke="#1c1410" stroke-width="5" fill="none" stroke-linecap="round"/>
          </g>

          <!-- EYES: Outer (expression/reading scale) > Eyelid (blinking) > Sclera + Iris Group (gaze) -->
          <g class="eye-outer transition-transform duration-200" style="transform-origin: 171px 220px;">
            <g class="eye-lid" style="transform-origin: 171px 220px;">
              <ellipse cx="171" cy="220" rx="14" ry="10" fill="#f4f6f9"/>
              <g class="iris-group transition-transform duration-200">
                <circle cx="173" cy="221" r="6.5" fill="#5c3a22"/>
                <circle cx="173" cy="221" r="3" fill="#1c1410"/>
                <circle cx="175.5" cy="218.5" r="1.6" fill="#fff"/>
              </g>
              <path d="M157 220 Q171 210 185 220" stroke="#1c1410" stroke-width="2.4" fill="none" stroke-linecap="round"/>
            </g>
          </g>

          <g class="eye-outer transition-transform duration-200" style="transform-origin: 229px 220px;">
            <g class="eye-lid" style="transform-origin: 229px 220px;">
              <ellipse cx="229" cy="220" rx="14" ry="10" fill="#f4f6f9"/>
              <g class="iris-group transition-transform duration-200">
                <circle cx="227" cy="221" r="6.5" fill="#5c3a22"/>
                <circle cx="227" cy="221" r="3" fill="#1c1410"/>
                <circle cx="229.5" cy="218.5" r="1.6" fill="#fff"/>
              </g>
              <path d="M215 220 Q229 210 243 220" stroke="#1c1410" stroke-width="2.4" fill="none" stroke-linecap="round"/>
            </g>
          </g>

          <!-- Nose -->
          <path d="M198 226 Q191 252 186 262 Q193 267 200 266" stroke="#c8875c" stroke-width="3" fill="none" stroke-linecap="round"/>

          <!-- MOUTH SHAPES: Locked inside Head Group directly above chin (NEVER on neck!) -->
          <g class={`mouth-cluster ${propMouth === 'auto' ? 'mouth-auto-cycle' : 'mouth-static'}`}>
            <!-- Closed -->
            <g id={`mouth-closed-${presenter.id}`} class={`mouth-frame-closed ${propMouth === 'closed' ? 'opacity-100' : ''}`}>
              <path d="M174 292 Q200 300 226 292 Q212 298 200 298 Q188 298 174 292 Z" fill="#8f3f30"/>
            </g>
            <!-- Open with Upper Teeth -->
            <g id={`mouth-open-${presenter.id}`} class={`mouth-frame-open ${propMouth === 'open' ? 'opacity-100' : ''}`}>
              <path d="M178 290 Q200 286 222 290 Q220 304 200 306 Q180 304 178 290 Z" fill="#5c2018"/>
              <path d="M183 291 Q200 288 217 291 Q216 297 200 298 Q184 297 183 291 Z" fill="#fff"/>
            </g>
            <!-- Wide with Upper Teeth and Pink Tongue -->
            <g id={`mouth-wide-${presenter.id}`} class={`mouth-frame-wide ${propMouth === 'wide' ? 'opacity-100' : ''}`}>
              <path d="M168 288 Q200 282 230 288 Q228 310 200 314 Q172 310 168 288 Z" fill="#5c2018"/>
              <path d="M174 290 Q200 285 226 290 Q224 298 200 300 Q176 298 174 290 Z" fill="#fff"/>
              <ellipse cx="200" cy="306" rx="13" ry="6" fill="#c0504d"/>
            </g>
          </g>
        </g>
      </g>

      {viewMode === 'full' && (
        <!-- DESK & BRANDING FOREGROUND -->
        <rect x="0" y="342" width="400" height="14" fill="#1c3560"/>
        <path d="M0 356 L400 356 L400 480 L0 480 Z" fill="#0e1626"/>

        <!-- 9JA BEACON Studio Bug Badge -->
        <rect x="304" y="16" width="80" height="34" rx="4" fill="#c4372a"/>
        <text x="344" y="31" text-anchor="middle" font-family="-apple-system, sans-serif" font-size="11" font-weight="700" fill="#fff">9JA</text>
        <text x="344" y="44" text-anchor="middle" font-family="-apple-system, sans-serif" font-size="10" font-weight="700" fill="#fff">BEACON</text>

        <!-- Lower Third News Straps -->
        <rect x="0" y="442" width="400" height="24" fill="#c4372a"/>
        <text x="16" y="459" font-family="-apple-system, sans-serif" font-size="13" font-weight="700" fill="#fff">{headline}</text>
        <rect x="0" y="466" width="400" height="14" fill="#f4f6f9"/>
        <text x="16" y="477" font-family="-apple-system, sans-serif" font-size="10" font-weight="600" fill="#233a5c">{ticker}</text>
      )}
    </svg>

    {interactive && (
      <!-- Interactive Character Studio Workbench Controls -->
      <div class="user-presenter-controls flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-slate-200 dark:border-slate-800 text-[11px] font-medium justify-center">
        <!-- Gesture Buttons -->
        <div class="w-full flex items-center justify-between text-[10px] uppercase font-mono text-slate-500 font-bold px-1">
          <span>Gestures (8)</span>
          <span class="text-emerald-500">Live SVG Rig</span>
        </div>
        <div class="flex flex-wrap gap-1 justify-center w-full">
          <button type="button" data-set="gesture" data-target={`g-idle-${presenter.id}`} class={`btn-ctrl px-2 py-1 rounded-lg text-xs font-semibold cursor-pointer transition ${activeGesture === 'g-idle' ? 'bg-[#c4372a] text-white' : 'bg-[#1c2c4a] text-slate-200 hover:bg-slate-700'}`}>Idle</button>
          <button type="button" data-set="gesture" data-target={`g-point-left-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Point Left</button>
          <button type="button" data-set="gesture" data-target={`g-point-right-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Point Right</button>
          <button type="button" data-set="gesture" data-target={`g-point-up-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Point Up</button>
          <button type="button" data-set="gesture" data-target={`g-explain-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Explain</button>
          <button type="button" data-set="gesture" data-target={`g-emphasize-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Emphasize</button>
          <button type="button" data-set="gesture" data-target={`g-wave-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Wave</button>
          <button type="button" data-set="gesture" data-target={`g-reading-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Reading</button>
        </div>

        <!-- Expression Buttons -->
        <div class="w-full flex items-center justify-between text-[10px] uppercase font-mono text-slate-500 font-bold px-1 mt-1">
          <span>Expressions (5)</span>
          <span>Brows & Eyes</span>
        </div>
        <div class="flex flex-wrap gap-1 justify-center w-full">
          <button type="button" data-set="expr" data-target={`expr-neutral-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#c4372a] text-white text-xs font-semibold cursor-pointer transition">Neutral</button>
          <button type="button" data-set="expr" data-target={`expr-happy-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Happy</button>
          <button type="button" data-set="expr" data-target={`expr-serious-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Serious</button>
          <button type="button" data-set="expr" data-target={`expr-surprised-${presenter.id}`} data-root-class="expr-surprised" class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Surprised</button>
          <button type="button" data-set="expr" data-target={`expr-concerned-${presenter.id}`} class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Concerned</button>
        </div>

        <!-- Gaze Buttons (Head Turn) -->
        <div class="w-full flex items-center justify-between text-[10px] uppercase font-mono text-slate-500 font-bold px-1 mt-1">
          <span>Gaze & Head Pivot</span>
          <span>Audience / Desk / Screen</span>
        </div>
        <div class="flex flex-wrap gap-1 justify-center w-full">
          <button type="button" data-set="gaze" data-root-class="" class="btn-ctrl px-2 py-1 rounded-lg bg-[#c4372a] text-white text-xs font-semibold cursor-pointer transition">Camera</button>
          <button type="button" data-set="gaze" data-root-class="gaze-left" class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Left</button>
          <button type="button" data-set="gaze" data-root-class="gaze-right" class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Right (Screen)</button>
          <button type="button" data-set="gaze" data-root-class="gaze-down" class="btn-ctrl px-2 py-1 rounded-lg bg-[#1c2c4a] text-slate-200 hover:bg-slate-700 text-xs font-semibold cursor-pointer transition">Down (Book)</button>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  /* Natural Eyelid Blinking */
  .eye-lid { 
    animation: userEyeBlink 4s infinite; 
  }
  @keyframes userEyeBlink {
    0%, 90%, 100% { transform: scaleY(1); }
    92%, 96%      { transform: scaleY(0.05); }
  }

  /* Gentle Studio Anchor Breathing Bob */
  .bob { 
    animation: userAnchorBob 3s ease-in-out infinite; 
    transform-origin: 200px 260px; 
  }
  @keyframes userAnchorBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* Lip-sync cycling when in preview mode */
  .mouth-auto-cycle .mouth-frame-closed { animation: userMouthClosed 4s infinite; }
  .mouth-auto-cycle .mouth-frame-open   { animation: userMouthOpen 4s infinite; }
  .mouth-auto-cycle .mouth-frame-wide   { animation: userMouthWide 4s infinite; }

  @keyframes userMouthClosed {
    0%, 8%    { opacity: 1; }
    10%, 26%  { opacity: 0; }
    28%, 36%  { opacity: 1; }
    38%, 56%  { opacity: 0; }
    58%, 100% { opacity: 1; }
  }
  @keyframes userMouthOpen {
    0%, 10%   { opacity: 0; }
    12%, 24%  { opacity: 1; }
    26%, 100% { opacity: 0; }
  }
  @keyframes userMouthWide {
    0%, 38%   { opacity: 0; }
    40%, 54%  { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* Static explicit mouth frame handling */
  .mouth-static .mouth-frame-closed,
  .mouth-static .mouth-frame-open,
  .mouth-static .mouth-frame-wide {
    animation: none;
    transition: opacity 0.12s ease;
  }

  /* Gaze Iris Shift */
  svg.gaze-left  .iris-group { transform: translateX(-4px); }
  svg.gaze-right .iris-group { transform: translateX(4px); }
  svg.gaze-down  .iris-group { transform: translateY(4px); }

  /* Head Turns with Gaze */
  svg.gaze-left  .head-group-el { transform: rotate(-7deg); }
  svg.gaze-right .head-group-el { transform: rotate(7deg); }

  /* Reading Mode: Head Tips Downward and Eyelids Lower toward Desk Bulletin */
  svg.reading .head-group-el { transform: translateY(9px) rotate(2deg); }
  svg.reading .eye-outer     { transform: scaleY(0.7); }

  /* Surprised Expression: Slightly Scale Eyes */
  svg.expr-surprised .eye-outer { transform: scale(1.18); }
</style>

<script>
  // Client-side interactive buttons handler for PresenterSprite
  document.querySelectorAll('.presenter-user-card').forEach(container => {
    const scene = container.querySelector('svg');
    const controls = container.querySelector('.user-presenter-controls');
    if (!scene || !controls) return;

    controls.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const set = btn.dataset.set;

      controls.querySelectorAll(`button[data-set="${set}"]`).forEach(b => {
        b.classList.remove('bg-[#c4372a]', 'text-white');
        b.classList.add('bg-[#1c2c4a]', 'text-slate-200');
      });
      btn.classList.remove('bg-[#1c2c4a]', 'text-slate-200');
      btn.classList.add('bg-[#c4372a]', 'text-white');

      if (set === 'gesture') {
        const targetId = btn.dataset.target;
        container.querySelectorAll('.gesture-group').forEach(g => {
          g.classList.add('opacity-0', 'pointer-events-none');
          g.classList.remove('opacity-100');
        });
        const targetEl = container.querySelector(`#${targetId}`);
        if (targetEl) {
          targetEl.classList.remove('opacity-0', 'pointer-events-none');
          targetEl.classList.add('opacity-100');
        }

        if (targetId && targetId.includes('g-reading')) {
          scene.classList.remove('gaze-left', 'gaze-right');
          scene.classList.add('gaze-down', 'reading');
          controls.querySelectorAll('button[data-set="gaze"]').forEach(b => {
            b.classList.remove('bg-[#c4372a]', 'text-white');
            b.classList.add('bg-[#1c2c4a]', 'text-slate-200');
          });
          const downBtn = controls.querySelector('button[data-set="gaze"][data-root-class="gaze-down"]');
          if (downBtn) {
            downBtn.classList.remove('bg-[#1c2c4a]', 'text-slate-200');
            downBtn.classList.add('bg-[#c4372a]', 'text-white');
          }
        } else {
          scene.classList.remove('reading');
        }
      }

      if (set === 'expr') {
        const targetId = btn.dataset.target;
        container.querySelectorAll('.expr-group').forEach(g => {
          g.classList.add('opacity-0');
          g.classList.remove('opacity-100');
        });
        const targetEl = container.querySelector(`#${targetId}`);
        if (targetEl) {
          targetEl.classList.remove('opacity-0');
          targetEl.classList.add('opacity-100');
        }
        scene.classList.remove('expr-surprised');
        if (btn.dataset.rootClass) scene.classList.add(btn.dataset.rootClass);
      }

      if (set === 'gaze') {
        scene.classList.remove('gaze-left', 'gaze-right', 'gaze-down');
        if (btn.dataset.rootClass) scene.classList.add(btn.dataset.rootClass);
      }
    });
  });
</script>
