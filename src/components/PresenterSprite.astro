---
import { getPresenterById, presenters } from '../lib/presenters-data';
import type { PresenterPose } from '../lib/types';

interface Props {
  presenterId?: string;
  pose?: PresenterPose;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showBadge?: boolean;
  interactive?: boolean;
  className?: string;
}

const {
  presenterId = 'presenter_femi',
  pose = 'idle',
  size = 'md',
  showBadge = false,
  interactive = false,
  className = ''
} = Astro.props;

const presenter = getPresenterById(presenterId) || presenters[0];

// Fully responsive dimension maps: scales down on mobile screens, scales up on tablets/desktops
const sizeClasses = {
  sm: 'w-12 sm:w-16 h-12 sm:h-16 rounded-xl',
  md: 'w-20 sm:w-28 h-20 sm:h-28 rounded-2xl',
  lg: 'w-32 sm:w-44 h-32 sm:h-44 rounded-2xl sm:rounded-3xl',
  xl: 'w-44 sm:w-64 h-44 sm:h-64 rounded-2xl sm:rounded-3xl'
};

---

<div 
  class={`presenter-sprite-container relative inline-block group select-none max-w-full ${className}`}
  data-presenter-id={presenter.id}
  data-presenter-name={presenter.name}
  data-presenter-gender={presenter.gender}
  data-presenter-pitch={presenter.voice_settings.pitch}
  data-presenter-rate={presenter.voice_settings.rate}
  data-current-pose={pose}
  data-interactive={interactive ? 'true' : 'false'}
>
  <!-- Sprite Frame Viewport (with Option A live breathing micro-motion) -->
  <div 
    class={`presenter-sprite-viewport presenter-viewport-live relative overflow-hidden shadow-md border-2 border-emerald-500/20 dark:border-emerald-500/30 bg-slate-100 dark:bg-slate-800 transition-all duration-300 ${sizeClasses[size]}`}
  >
    <!-- Stable Portrait Anchor Base -->
    <div 
      class="presenter-sprite-image absolute inset-0 w-full h-full bg-cover bg-center transition-transform duration-300"
      style={`background-image: url('${presenter.sprite_url}');`}
      title={`${presenter.name}`}
      role="img"
      aria-label={`${presenter.name} news presenter avatar in ${pose} pose`}
    ></div>

    <!-- Articulated Natural Lip-Sync Aperture Overlay (Opens & closes in rhythm with speech) -->
    <div 
      class={`presenter-mouth-aperture absolute pointer-events-none transition-opacity duration-150 ${pose === 'speaking' ? 'presenter-mouth-active' : 'opacity-0'}`}
      style="left: 50%; top: 55.2%; width: 13.5%; height: 5.8%; transform: translate(-50%, -50%);"
    >
      <svg viewBox="0 0 160 80" class="w-full h-full drop-shadow-xs overflow-visible">
        <defs>
          <linearGradient id={`lipShine_${presenter.id}`} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#6e242d" stop-opacity="0.95" />
            <stop offset="50%" stop-color="#8c2f3b" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#4a151b" stop-opacity="0.95" />
          </linearGradient>
          <radialGradient id={`mouthCavity_${presenter.id}`} cx="50%" cy="65%" r="50%">
            <stop offset="0%" stop-color="#0f0304" />
            <stop offset="60%" stop-color="#24070b" />
            <stop offset="100%" stop-color="#3b1016" />
          </radialGradient>
        </defs>
        <!-- Outer Lip Margin -->
        <path d="M 15 38 Q 80 18 145 38 Q 120 68 80 70 Q 40 68 15 38 Z" fill={`url(#lipShine_${presenter.id})`} />
        <!-- Open Oral Cavity -->
        <path d="M 26 39 Q 80 26 134 39 Q 115 63 80 65 Q 45 63 26 39 Z" fill={`url(#mouthCavity_${presenter.id})`} />
        <!-- Top Teeth Edge -->
        <path d="M 42 38 Q 80 33 118 38 Q 112 46 80 47 Q 48 46 42 38 Z" fill="#f8fafc" opacity="0.92" />
        <!-- Lower tongue pink highlight -->
        <ellipse cx="80" cy="58" rx="28" ry="5" fill="#a83f4d" opacity="0.5" />
      </svg>
    </div>

    <!-- Live On-Air Pill (when speaking or breaking) -->
    <div 
      class={`presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs transition-opacity duration-200 ${
        pose === 'speaking' 
          ? 'bg-emerald-600/90 text-white' 
          : pose === 'breaking'
          ? 'bg-rose-600/90 text-white'
          : 'opacity-0 pointer-events-none'
      }`}
    >
      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
      <span class="indicator-text">{pose === 'speaking' ? 'LIVE' : 'ALERT'}</span>
    </div>

    <!-- Department Mini Badge -->
    {showBadge && (
      <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-1.5 pt-3 text-center">
        <p class="text-[11px] font-bold text-white leading-tight truncate">
          {presenter.name}
        </p>
        <p class="text-[9px] text-emerald-400 font-medium truncate">
          {presenter.role.split('&')[0]}
        </p>
      </div>
    )}
  </div>

  <!-- Interactive Pose & Option A Speech Animation Trigger (when interactive=true) -->
  {interactive && (
    <div class="presenter-pose-switcher mt-2 flex flex-wrap items-center justify-center gap-1 bg-white dark:bg-slate-900 p-1 rounded-xl border border-slate-200 dark:border-slate-800 text-[10px] font-medium shadow-xs max-w-full">
      <button 
        type="button" 
        data-pose="idle" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'idle' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Neutral listening pose"
      >
        Idle
      </button>
      <button 
        type="button" 
        data-pose="speaking" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'speaking' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Reporting / speaking pose"
      >
        Report
      </button>
      <button 
        type="button" 
        data-pose="breaking" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'breaking' ? 'bg-rose-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Breaking news alert pose"
      >
        Alert
      </button>
      <button 
        type="button" 
        data-pose="wrap" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'wrap' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Wrap-up sign-off pose"
      >
        Wrap
      </button>
      <!-- Option A Live Presentation Motion Test Button -->
      <button 
        type="button" 
        class="presenter-motion-test-btn px-2 py-0.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold transition-all border border-emerald-500/30 cursor-pointer flex items-center gap-1"
        title="Option A: Test dynamic speech, lip-sync, and head motion"
      >
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span>Motion</span>
      </button>
    </div>
  )}
</div>

<script>
  // Client-side presenter pose switching and Option A motion controller
  function initPresenterSprites() {
    const containers = document.querySelectorAll('.presenter-sprite-container[data-interactive="true"]');
    
    containers.forEach((container) => {
      if (container.getAttribute('data-wired') === 'true') return;
      container.setAttribute('data-wired', 'true');

      const viewportEl = container.querySelector('.presenter-sprite-viewport') as HTMLElement | null;
      const imageEl = container.querySelector('.presenter-sprite-image') as HTMLElement | null;
      const indicatorEl = container.querySelector('.presenter-live-indicator') as HTMLElement | null;
      const indicatorText = indicatorEl?.querySelector('.indicator-text');
      const poseButtons = container.querySelectorAll('.pose-btn');
      const motionTestBtn = container.querySelector('.presenter-motion-test-btn');

      const mouthAperture = container.querySelector('.presenter-mouth-aperture') as HTMLElement | null;

      const setPose = (targetPose: string) => {
        if (!imageEl) return;
        // Stop speech animation
        mouthAperture?.classList.remove('presenter-mouth-active');
        viewportEl?.classList.remove('presenter-viewport-speaking');

        container.setAttribute('data-current-pose', targetPose);

        if (targetPose === 'speaking') {
          mouthAperture?.classList.add('presenter-mouth-active');
          viewportEl?.classList.add('presenter-viewport-speaking');
        }

        poseButtons.forEach((b) => {
          b.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800';
        });

        const activeBtn = container.querySelector(`.pose-btn[data-pose="${targetPose}"]`);
        if (activeBtn) {
          if (targetPose === 'breaking') {
            activeBtn.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer bg-rose-600 text-white font-bold';
          } else {
            activeBtn.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer bg-emerald-600 text-white font-bold';
          }
        }

        if (indicatorEl && indicatorText) {
          if (targetPose === 'speaking') {
            indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs bg-emerald-600/90 text-white';
            indicatorText.textContent = 'LIVE';
          } else if (targetPose === 'breaking') {
            indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs bg-rose-600/90 text-white';
            indicatorText.textContent = 'ALERT';
          } else {
            indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs opacity-0 pointer-events-none';
          }
        }
      };

      poseButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetPose = btn.getAttribute('data-pose') || 'idle';
          setPose(targetPose);
        });
      });

      // Option A: Live Motion and Lip-Sync Test
      motionTestBtn?.addEventListener('click', () => {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();

        const name = container.getAttribute('data-presenter-name') || 'Presenter';
        const gender = container.getAttribute('data-presenter-gender') || 'male';
        const pitch = parseFloat(container.getAttribute('data-presenter-pitch') || '1.0');
        const rate = parseFloat(container.getAttribute('data-presenter-rate') || '1.0');

        // Activate Natural Lip-Sync & Speaking Head Nod (Zero Body Jump)
        viewportEl?.classList.add('presenter-viewport-speaking');
        mouthAperture?.classList.add('presenter-mouth-active');
        if (indicatorEl && indicatorText) {
          indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs bg-emerald-600/90 text-white';
          indicatorText.textContent = 'LIVE';
        }

        const sampleText = `Hello, I am ${name}. Testing natural broadcast lip-sync. The character remains stable while speech cadence articulates seamlessly.`;
        const utterance = new SpeechSynthesisUtterance(sampleText);
        utterance.pitch = pitch;
        utterance.rate = rate;

        const voices = window.speechSynthesis.getVoices();
        const preferred = voices.find((v) =>
          (gender === 'female'
            ? v.name.toLowerCase().includes('female') || v.name.includes('Zira') || v.name.includes('Samantha')
            : v.name.toLowerCase().includes('male') || v.name.includes('David')) || v.lang.startsWith('en')
        );
        if (preferred) utterance.voice = preferred;

        utterance.onend = () => {
          mouthAperture?.classList.remove('presenter-mouth-active');
          viewportEl?.classList.remove('presenter-viewport-speaking');
          setPose('wrap');
          setTimeout(() => setPose('idle'), 2500);
        };

        utterance.onerror = () => {
          mouthAperture?.classList.remove('presenter-mouth-active');
          viewportEl?.classList.remove('presenter-viewport-speaking');
          setPose('idle');
        };

        setTimeout(() => window.speechSynthesis.speak(utterance), 50);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPresenterSprites);
  } else {
    initPresenterSprites();
  }
  document.addEventListener('astro:page-load', initPresenterSprites);
</script>
