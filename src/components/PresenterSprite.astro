---
import { getPresenterById, presenters } from '../lib/presenters-data';
import type { PresenterPose } from '../lib/types';

interface Props {
  presenterId?: string;
  pose?: PresenterPose;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showBadge?: boolean;
  interactive?: boolean;
  className?: string;
}

const {
  presenterId = 'presenter_femi',
  pose = 'idle',
  size = 'md',
  showBadge = false,
  interactive = false,
  className = ''
} = Astro.props;

const presenter = getPresenterById(presenterId) || presenters[0];

// Dimension maps for the sprite window
const sizeClasses = {
  sm: 'w-16 h-16 rounded-xl',
  md: 'w-28 h-28 rounded-2xl',
  lg: 'w-44 h-44 rounded-3xl',
  xl: 'w-64 h-64 rounded-3xl'
};

// 2x2 sprite grid coordinates
const poseCoords: Record<PresenterPose, string> = {
  idle: '0% 0%',
  speaking: '100% 0%',
  breaking: '0% 100%',
  wrap: '100% 100%'
};

const currentCoord = poseCoords[pose] || '0% 0%';
---

<div 
  class={`presenter-sprite-container relative inline-block group select-none ${className}`}
  data-presenter-id={presenter.id}
  data-current-pose={pose}
  data-interactive={interactive ? 'true' : 'false'}
>
  <!-- Sprite Frame Viewport -->
  <div 
    class={`presenter-sprite-viewport relative overflow-hidden shadow-md border-2 border-emerald-500/20 dark:border-emerald-500/30 bg-slate-100 dark:bg-slate-800 transition-all duration-300 ${sizeClasses[size]}`}
  >
    <!-- Sprite background layer (using 200% x 200% zoom to isolate 1 quadrant of the 2x2 sheet) -->
    <div 
      class="presenter-sprite-image absolute inset-0 w-full h-full bg-no-repeat transition-[background-position] duration-200"
      style={`
        background-image: url('${presenter.sprite_url}');
        background-size: 200% 200%;
        background-position: ${currentCoord};
      `}
      title={`${presenter.name} - ${pose.toUpperCase()} pose`}
      role="img"
      aria-label={`${presenter.name} news presenter avatar in ${pose} pose`}
    ></div>

    <!-- Live On-Air Pill (when speaking or breaking) -->
    <div 
      class={`presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs transition-opacity duration-200 ${
        pose === 'speaking' 
          ? 'bg-emerald-600/90 text-white' 
          : pose === 'breaking'
          ? 'bg-rose-600/90 text-white'
          : 'opacity-0 pointer-events-none'
      }`}
    >
      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
      <span class="indicator-text">{pose === 'speaking' ? 'LIVE' : 'ALERT'}</span>
    </div>

    <!-- Department Mini Badge -->
    {showBadge && (
      <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-1.5 pt-3 text-center">
        <p class="text-[11px] font-bold text-white leading-tight truncate">
          {presenter.name}
        </p>
        <p class="text-[9px] text-emerald-400 font-medium truncate">
          {presenter.role.split('&')[0]}
        </p>
      </div>
    )}
  </div>

  <!-- Optional Interactive Pose Selector Trigger (when interactive=true) -->
  {interactive && (
    <div class="presenter-pose-switcher mt-2 flex items-center justify-center gap-1 bg-white dark:bg-slate-900 p-1 rounded-xl border border-slate-200 dark:border-slate-800 text-[10px] font-medium shadow-xs">
      <button 
        type="button" 
        data-pose="idle" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'idle' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Neutral listening pose"
      >
        Idle
      </button>
      <button 
        type="button" 
        data-pose="speaking" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'speaking' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Reporting / speaking pose"
      >
        Report
      </button>
      <button 
        type="button" 
        data-pose="breaking" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'breaking' ? 'bg-rose-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Breaking news pose"
      >
        Alert
      </button>
      <button 
        type="button" 
        data-pose="wrap" 
        class={`pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer ${pose === 'wrap' ? 'bg-emerald-600 text-white font-bold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'}`}
        title="Wrap-up sign-off pose"
      >
        Sign-off
      </button>
    </div>
  )}
</div>

<script>
  // Client-side presenter pose switching controller
  function initPresenterSprites() {
    const containers = document.querySelectorAll('.presenter-sprite-container[data-interactive="true"]');
    
    containers.forEach((container) => {
      if (container.getAttribute('data-wired') === 'true') return;
      container.setAttribute('data-wired', 'true');

      const imageEl = container.querySelector('.presenter-sprite-image') as HTMLElement | null;
      const indicatorEl = container.querySelector('.presenter-live-indicator') as HTMLElement | null;
      const indicatorText = indicatorEl?.querySelector('.indicator-text');
      const poseButtons = container.querySelectorAll('.pose-btn');

      const coords: Record<string, string> = {
        idle: '0% 0%',
        speaking: '100% 0%',
        breaking: '0% 100%',
        wrap: '100% 100%'
      };

      poseButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetPose = btn.getAttribute('data-pose') || 'idle';
          if (!imageEl) return;

          // Update background position
          imageEl.style.backgroundPosition = coords[targetPose] || '0% 0%';
          container.setAttribute('data-current-pose', targetPose);

          // Update active button state
          poseButtons.forEach((b) => {
            b.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800';
          });
          if (targetPose === 'breaking') {
            btn.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer bg-rose-600 text-white font-bold';
          } else {
            btn.className = 'pose-btn px-1.5 py-0.5 rounded-lg transition-colors cursor-pointer bg-emerald-600 text-white font-bold';
          }

          // Update indicator badge
          if (indicatorEl && indicatorText) {
            if (targetPose === 'speaking') {
              indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs bg-emerald-600/90 text-white';
              indicatorText.textContent = 'LIVE';
            } else if (targetPose === 'breaking') {
              indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs bg-rose-600/90 text-white';
              indicatorText.textContent = 'ALERT';
            } else {
              indicatorEl.className = 'presenter-live-indicator absolute top-1.5 left-1.5 flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider backdrop-blur-xs opacity-0 pointer-events-none';
            }
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPresenterSprites);
  } else {
    initPresenterSprites();
  }
  document.addEventListener('astro:page-load', initPresenterSprites);
</script>
