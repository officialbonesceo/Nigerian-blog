---
interface Props {
  title: string;
  summary?: string;
  readingTimeMinutes?: number;
  categoryId?: string;
}

const { title, summary = '', readingTimeMinutes = 3 } = Astro.props;
---

<div
  class="article-audio-player my-6 p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs transition-all not-prose"
  data-audio-player
  data-article-title={title}
  data-article-summary={summary}
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3.5 min-w-0">
      <button
        type="button"
        class="audio-play-toggle-btn w-12 h-12 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white flex items-center justify-center shrink-0 shadow-sm hover:shadow-emerald-500/25 transition-all cursor-pointer focus:outline-hidden"
        aria-label="Listen to audio version of this report"
      >
        <svg class="play-icon w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        <svg class="pause-icon w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
      </button>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">Audio Report</span>
          <span class="audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">Ready to listen</span>
        </div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate mt-0.5">Listen to this story</h4>
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-mono">
          <span class="audio-time-label">Approx. {readingTimeMinutes} min listen</span>
          <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
          <span class="audio-progress-label">0% completed</span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
      <div class="audio-visualizer hidden items-center gap-1 h-6 px-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
        <span class="w-1 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        <span class="w-1 h-4 bg-emerald-500 rounded-full animate-pulse [animation-delay:150ms]"></span>
        <span class="w-1 h-5 bg-emerald-500 rounded-full animate-pulse [animation-delay:300ms]"></span>
        <span class="w-1 h-3 bg-emerald-500 rounded-full animate-pulse [animation-delay:75ms]"></span>
        <span class="w-1 h-2 bg-emerald-500 rounded-full animate-pulse [animation-delay:200ms]"></span>
      </div>
      <button type="button" class="audio-speed-btn px-2.5 py-1.5 rounded-xl text-xs font-bold font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-hidden" title="Adjust narration speed">1.0x</button>
      <button type="button" class="audio-stop-btn w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-hidden" title="Stop narration" aria-label="Stop audio">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h12v12H6z" /></svg>
      </button>
    </div>
  </div>
  <div class="mt-3.5 w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
    <div class="audio-progress-bar bg-emerald-600 dark:bg-emerald-500 h-full w-0 rounded-full transition-all duration-150"></div>
  </div>
</div>

<script is:inline>
(function () {
  function cleanText(raw) {
    return String(raw || '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/https?:\/\/[^\s]+/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function gatherText() {
    var parts = [];
    var player = document.querySelector('[data-audio-player]');
    if (player) {
      var t = player.getAttribute('data-article-title') || '';
      var s = player.getAttribute('data-article-summary') || '';
      if (t) parts.push(t + '.');
      if (s) parts.push(s + '.');
    }
    var headline = document.querySelector('.article-headline') || document.querySelector('h1');
    if (headline) {
      var ht = cleanText(headline.textContent || '');
      if (ht) parts.push(ht + '.');
    }
    var nodes = document.querySelectorAll(
      '#article-content-body-lead, #article-content-body-middle1, #article-content-body-middle2, #article-content-body-middle3, #article-content-body-conclusion, [itemprop="articleBody"]'
    );
    nodes.forEach(function (container) {
      var clone = container.cloneNode(true);
      clone.querySelectorAll('script, style, iframe, [data-ad-unit], .not-prose, figcaption, button, .article-audio-player').forEach(function (el) {
        el.remove();
      });
      var text = cleanText(clone.innerText || clone.textContent || '');
      if (text) parts.push(text);
    });
    if (parts.join(' ').trim().length < 40) {
      var article = document.querySelector('article');
      if (article) {
        var c = article.cloneNode(true);
        c.querySelectorAll('script, style, iframe, [data-ad-unit], .not-prose, figure, header, button, .article-audio-player, nav').forEach(function (el) {
          el.remove();
        });
        parts.push(cleanText(c.innerText || c.textContent || ''));
      }
    }
    return parts.join(' ').trim().slice(0, 8000);
  }

  function preferredVoice() {
    var voices = window.speechSynthesis.getVoices() || [];
    if (!voices.length) return null;
    var ng = voices.find(function (v) { return v.lang === 'en-NG' || (v.lang && v.lang.indexOf('en_NG') === 0); });
    if (ng) return ng;
    var neural = voices.find(function (v) {
      return v.lang && v.lang.indexOf('en') === 0 && /Natural|Neural|Google|Premium/i.test(v.name || '');
    });
    if (neural) return neural;
    return voices.find(function (v) { return v.lang === 'en-GB' || v.lang === 'en-US' || (v.lang && v.lang.indexOf('en') === 0); }) || voices[0];
  }

  var state = {
    playing: false,
    paused: false,
    total: 0,
    idx: 0,
    speeds: [1.0, 1.25, 1.5, 0.85],
    speedIdx: 0,
    rate: 1.0,
    keepAlive: null,
    hasSpeech: typeof window !== 'undefined' && 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window,
  };

  function setStatus(text, kind) {
    document.querySelectorAll('[data-audio-player] .audio-status-pill').forEach(function (el) {
      el.textContent = text;
      var base = 'audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full font-mono ';
      if (kind === 'play') el.className = base + 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
      else if (kind === 'pause') el.className = base + 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20';
      else if (kind === 'err') el.className = base + 'bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
      else el.className = base + 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400';
    });
  }

  function updateUI(finished) {
    var pct = finished ? 100 : state.total > 0 ? Math.min(100, Math.round((state.idx / state.total) * 100)) : 0;
    document.querySelectorAll('[data-audio-player]').forEach(function (player) {
      var playIcon = player.querySelector('.play-icon');
      var pauseIcon = player.querySelector('.pause-icon');
      var progressLabel = player.querySelector('.audio-progress-label');
      var progressBar = player.querySelector('.audio-progress-bar');
      var visualizer = player.querySelector('.audio-visualizer');
      var speedBtn = player.querySelector('.audio-speed-btn');
      if (speedBtn) speedBtn.textContent = state.rate.toFixed(state.rate === 1 ? 1 : 2).replace(/\.0$/, '.0') + 'x';
      if (state.playing && !state.paused) {
        if (playIcon) playIcon.classList.add('hidden');
        if (pauseIcon) pauseIcon.classList.remove('hidden');
        if (visualizer) { visualizer.classList.remove('hidden'); visualizer.classList.add('flex'); }
        setStatus('Listening now', 'play');
      } else if (state.paused) {
        if (playIcon) playIcon.classList.remove('hidden');
        if (pauseIcon) pauseIcon.classList.add('hidden');
        if (visualizer) { visualizer.classList.add('hidden'); visualizer.classList.remove('flex'); }
        setStatus('Narration paused', 'pause');
      } else if (finished) {
        if (playIcon) playIcon.classList.remove('hidden');
        if (pauseIcon) pauseIcon.classList.add('hidden');
        if (visualizer) { visualizer.classList.add('hidden'); visualizer.classList.remove('flex'); }
        setStatus('Completed', 'play');
      } else {
        if (playIcon) playIcon.classList.remove('hidden');
        if (pauseIcon) pauseIcon.classList.add('hidden');
        if (visualizer) { visualizer.classList.add('hidden'); visualizer.classList.remove('flex'); }
        setStatus('Ready to listen', 'idle');
      }
      if (progressLabel) progressLabel.textContent = pct + '% completed';
      if (progressBar) progressBar.style.width = pct + '%';
    });
  }

  function stopKeepAlive() {
    if (state.keepAlive) clearInterval(state.keepAlive);
    state.keepAlive = null;
  }

  function startKeepAlive() {
    stopKeepAlive();
    state.keepAlive = setInterval(function () {
      if (state.playing && !state.paused && window.speechSynthesis.speaking) {
        window.speechSynthesis.pause();
        window.speechSynthesis.resume();
      }
    }, 10000);
  }

  function stop() {
    if (!state.hasSpeech) return;
    window.speechSynthesis.cancel();
    stopKeepAlive();
    state.playing = false;
    state.paused = false;
    state.idx = 0;
    updateUI(false);
  }

  function togglePlay() {
    if (!state.hasSpeech) {
      setStatus('Voice not supported on this device', 'err');
      return;
    }
    if (state.paused) {
      state.paused = false;
      state.playing = true;
      window.speechSynthesis.resume();
      startKeepAlive();
      updateUI(false);
      return;
    }
    if (state.playing) {
      state.paused = true;
      window.speechSynthesis.pause();
      stopKeepAlive();
      updateUI(false);
      return;
    }
    window.speechSynthesis.cancel();
    stopKeepAlive();
    var text = gatherText();
    if (!text || text.length < 20) {
      setStatus('No article text found', 'err');
      return;
    }
    state.total = text.length;
    state.idx = 0;
    var utterance = new SpeechSynthesisUtterance(text);
    utterance.rate = state.rate;
    utterance.pitch = 1.0;
    var voice = preferredVoice();
    if (voice) utterance.voice = voice;
    utterance.onboundary = function (e) {
      if (e.charIndex !== undefined) {
        state.idx = e.charIndex;
        updateUI(false);
      }
    };
    utterance.onend = function () {
      state.playing = false;
      state.paused = false;
      state.idx = state.total;
      stopKeepAlive();
      updateUI(true);
    };
    utterance.onerror = function (e) {
      if (e.error === 'canceled' || e.error === 'interrupted') return;
      console.warn('[Audio] TTS', e.error);
      state.playing = false;
      state.paused = false;
      stopKeepAlive();
      setStatus('Audio error — try again', 'err');
      updateUI(false);
    };
    state.playing = true;
    state.paused = false;
    startKeepAlive();
    updateUI(false);
    setTimeout(function () {
      try {
        window.speechSynthesis.speak(utterance);
      } catch (err) {
        console.error('[Audio] speak failed', err);
        state.playing = false;
        setStatus('Audio failed — try again', 'err');
        updateUI(false);
      }
    }, 60);
  }

  function cycleSpeed() {
    state.speedIdx = (state.speedIdx + 1) % state.speeds.length;
    state.rate = state.speeds[state.speedIdx];
    if (state.playing && !state.paused) {
      stop();
      togglePlay();
    } else updateUI(false);
  }

  function init() {
    var players = document.querySelectorAll('[data-audio-player]');
    if (!players.length) return;
    if (!state.hasSpeech) {
      players.forEach(function (player) {
        var status = player.querySelector('.audio-status-pill');
        var btn = player.querySelector('.audio-play-toggle-btn');
        if (status) status.textContent = 'Voice not supported on this device';
        if (btn) btn.disabled = true;
      });
      return;
    }
    try {
      window.speechSynthesis.getVoices();
      window.speechSynthesis.onvoiceschanged = function () {
        window.speechSynthesis.getVoices();
      };
    } catch (e) {}
    players.forEach(function (player) {
      if (player.getAttribute('data-wired') === 'true') return;
      player.setAttribute('data-wired', 'true');
      var playBtn = player.querySelector('.audio-play-toggle-btn');
      var stopBtn = player.querySelector('.audio-stop-btn');
      var speedBtn = player.querySelector('.audio-speed-btn');
      if (playBtn) playBtn.addEventListener('click', function (e) { e.preventDefault(); togglePlay(); });
      if (stopBtn) stopBtn.addEventListener('click', function (e) { e.preventDefault(); stop(); });
      if (speedBtn) speedBtn.addEventListener('click', function (e) { e.preventDefault(); cycleSpeed(); });
    });
    updateUI(false);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
  window.addEventListener('beforeunload', stop);
  document.addEventListener('astro:before-swap', stop);
})();
</script>
