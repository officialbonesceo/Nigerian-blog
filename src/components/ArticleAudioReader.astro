---
interface Props {
  title: string;
  summary?: string;
  readingTimeMinutes?: number;
  categoryId?: string;
}

const { title, summary = '', readingTimeMinutes = 3 } = Astro.props;
---

<div 
  class="article-audio-player my-6 p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs transition-all not-prose"
  data-audio-player
  data-article-title={title}
  data-article-summary={summary}
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <!-- Left Section: Play / Stop Button + Status & Progress -->
    <div class="flex items-center gap-3.5 min-w-0">
      <!-- Play / Stop Toggle Button -->
      <button
        type="button"
        class="audio-play-toggle-btn w-12 h-12 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white flex items-center justify-center shrink-0 shadow-sm hover:shadow-emerald-500/25 transition-all cursor-pointer focus:outline-hidden"
        aria-label="Listen to audio version of this report"
      >
        <!-- Play Icon -->
        <svg class="play-icon w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <!-- Pause Icon (hidden by default) -->
        <svg class="pause-icon w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
      </button>

      <!-- Details -->
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">
            Audio Report
          </span>
          <span class="audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">
            Ready to listen
          </span>
        </div>

        <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate mt-0.5">
          Listen to this story
        </h4>

        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-mono">
          <span class="audio-time-label">Approx. {readingTimeMinutes} min listen</span>
          <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
          <span class="audio-progress-label">0% completed</span>
        </div>
      </div>
    </div>

    <!-- Right Controls: Animated Waveform + Speed Toggle + Stop Button -->
    <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
      <!-- Animated Visualizer Waves (active when playing) -->
      <div class="audio-visualizer hidden items-center gap-1 h-6 px-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
        <span class="w-1 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        <span class="w-1 h-4 bg-emerald-500 rounded-full animate-pulse [animation-delay:150ms]"></span>
        <span class="w-1 h-5 bg-emerald-500 rounded-full animate-pulse [animation-delay:300ms]"></span>
        <span class="w-1 h-3 bg-emerald-500 rounded-full animate-pulse [animation-delay:75ms]"></span>
        <span class="w-1 h-2 bg-emerald-500 rounded-full animate-pulse [animation-delay:200ms]"></span>
      </div>

      <!-- Speed Toggle Button -->
      <button
        type="button"
        class="audio-speed-btn px-2.5 py-1.5 rounded-xl text-xs font-bold font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-hidden"
        title="Adjust narration speed"
      >
        1.0x
      </button>

      <!-- Stop / Restart Button -->
      <button
        type="button"
        class="audio-stop-btn w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-hidden"
        title="Stop narration"
        aria-label="Stop audio"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h12v12H6z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Progress Bar Line -->
  <div class="mt-3.5 w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
    <div 
      class="audio-progress-bar bg-emerald-600 dark:bg-emerald-500 h-full w-0 rounded-full transition-all duration-150"
    ></div>
  </div>
</div>

<script>
  // Robust Client-Side Article SpeechSynthesis Engine for 9jaBeacon
  // Implements Section 3 of 9jabeacon-pipeline-fix-v4.md:
  // - Direct user-gesture instantiation
  // - Wait for voices if needed
  // - Delayed speak after cancel (prevents Android Chrome IPC drop)
  // - Real-time word boundary progress updates
  // - Keep-alive heartbeat against Chrome 15s freeze bug
  class ArticleAudioEngine {
    private isPlaying = false;
    private isPaused = false;
    private totalChars = 0;
    private currentCharIdx = 0;
    private speeds = [1.0, 1.25, 1.5, 0.85];
    private speedIdx = 0;
    private currentRate = 1.0;
    private keepAliveTimer: any = null;
    private hasSpeech = typeof window !== 'undefined' && 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;

    public init() {
      const players = document.querySelectorAll('[data-audio-player]');
      if (!players.length) return;

      if (!this.hasSpeech) {
        players.forEach((player) => {
          const statusPill = player.querySelector('.audio-status-pill') as HTMLElement | null;
          const playBtn = player.querySelector('.audio-play-toggle-btn') as HTMLButtonElement | null;
          if (statusPill) statusPill.textContent = 'Voice not supported on this device';
          if (playBtn) playBtn.disabled = true;
        });
        return;
      }

      players.forEach((player) => {
        if (player.getAttribute('data-wired') === 'true') return;
        player.setAttribute('data-wired', 'true');

        const playBtn = player.querySelector('.audio-play-toggle-btn');
        const stopBtn = player.querySelector('.audio-stop-btn');
        const speedBtn = player.querySelector('.audio-speed-btn');

        playBtn?.addEventListener('click', () => this.togglePlay());
        stopBtn?.addEventListener('click', () => this.stop());
        speedBtn?.addEventListener('click', () => this.cycleSpeed());
      });

      // Wire any toolbar quick-listen button
      const quickBtns = document.querySelectorAll('#quick-audio-listen-btn');
      quickBtns.forEach((btn) => {
        if (btn.getAttribute('data-wired') === 'true') return;
        btn.setAttribute('data-wired', 'true');
        btn.addEventListener('click', () => {
          this.togglePlay();
          const playerEl = document.querySelector('[data-audio-player]');
          if (playerEl) {
            const rect = playerEl.getBoundingClientRect();
            if (rect.top < 0 || rect.bottom > window.innerHeight) {
              playerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        });
      });

      this.updateUI();
    }

    private cleanText(raw: string): string {
      return (raw || '')
        .replace(/<[^>]+>/g, ' ')
        .replace(/&nbsp;/g, ' ')
        .replace(/https?:\/\/[^\s]+/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    }

    private gatherArticleText(): string {
      const headlineEl = document.querySelector('.article-headline') || document.querySelector('h1');
      const summaryEl = document.querySelector('.article-summary');
      const contentContainers = document.querySelectorAll(
        '#article-content-body-lead, #article-content-body-middle1, #article-content-body-middle2, #article-content-body-middle3'
      );

      const parts: string[] = [];

      if (headlineEl) {
        const headline = this.cleanText(headlineEl.textContent || '');
        if (headline) parts.push(headline + '.');
      }

      if (summaryEl) {
        const summary = this.cleanText(summaryEl.textContent || '').replace(/executive summary/i, '').trim();
        if (summary) parts.push(summary + '.');
      }

      contentContainers.forEach((container) => {
        const clone = container.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('script, style, iframe, [data-ad-unit], .not-prose, figcaption, button').forEach((el) => el.remove());
        const text = this.cleanText(clone.innerText || clone.textContent || '');
        if (text) parts.push(text);
      });

      if (parts.length <= 1) {
        const mainArticle = document.querySelector('article');
        if (mainArticle) {
          const clone = mainArticle.cloneNode(true) as HTMLElement;
          clone.querySelectorAll('script, style, iframe, [data-ad-unit], .not-prose, figure, header, figcaption, button').forEach((el) => el.remove());
          const text = this.cleanText(clone.innerText || clone.textContent || '');
          if (text) parts.push(text);
        }
      }

      const combined = parts.join(' ').trim();
      // Cap at ~8,000 characters per v4 spec
      return combined.slice(0, 8000);
    }

    private getPreferredVoice(): SpeechSynthesisVoice | null {
      const voices = window.speechSynthesis.getVoices();
      if (!voices || !voices.length) return null;

      // 1. Nigerian English voice if present on device
      const ngVoice = voices.find((v) => v.lang === 'en-NG' || v.lang.startsWith('en_NG'));
      if (ngVoice) return ngVoice;

      // 2. Natural / Neural / Premium English voices
      const neuralVoice = voices.find(
        (v) =>
          v.lang.startsWith('en') &&
          (v.name.includes('Natural') || v.name.includes('Neural') || v.name.includes('Google') || v.name.includes('Premium'))
      );
      if (neuralVoice) return neuralVoice;

      // 3. British English or US English
      const enVoice = voices.find((v) => v.lang === 'en-GB' || v.lang === 'en-US' || v.lang.startsWith('en'));
      return enVoice || voices[0] || null;
    }

    private startKeepAlive() {
      clearInterval(this.keepAliveTimer);
      this.keepAliveTimer = setInterval(() => {
        if (this.isPlaying && !this.isPaused && window.speechSynthesis.speaking) {
          window.speechSynthesis.pause();
          window.speechSynthesis.resume();
        }
      }, 10000);
    }

    private stopKeepAlive() {
      clearInterval(this.keepAliveTimer);
      this.keepAliveTimer = null;
    }

    public togglePlay() {
      if (!this.hasSpeech) return;

      // If paused, resume
      if (this.isPaused) {
        this.isPaused = false;
        this.isPlaying = true;
        window.speechSynthesis.resume();
        this.startKeepAlive();
        this.updateUI();
        return;
      }

      // If playing, pause
      if (this.isPlaying) {
        this.isPaused = true;
        window.speechSynthesis.pause();
        this.stopKeepAlive();
        this.updateUI();
        return;
      }

      // Starting fresh speak: cancel existing queue first
      window.speechSynthesis.cancel();
      this.stopKeepAlive();

      const text = this.gatherArticleText();
      if (!text) return;

      this.totalChars = text.length;
      this.currentCharIdx = 0;

      // Instantiate utterance directly inside user click handler (iOS Safari requirement)
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = this.currentRate;
      utterance.pitch = 1.0;

      const voice = this.getPreferredVoice();
      if (voice) {
        utterance.voice = voice;
      }

      // Boundary event: fires as words are spoken, providing smooth progress tracking
      utterance.onboundary = (e: SpeechSynthesisEvent) => {
        if (e.name === 'word' || e.charIndex !== undefined) {
          this.currentCharIdx = e.charIndex;
          this.updateUI();
        }
      };

      utterance.onend = () => {
        this.isPlaying = false;
        this.isPaused = false;
        this.currentCharIdx = this.totalChars;
        this.stopKeepAlive();
        this.updateUI(true);
      };

      utterance.onerror = (e) => {
        if (e.error === 'canceled' || e.error === 'interrupted') return;
        console.warn('[Audio] TTS warning:', e.error);
        this.isPlaying = false;
        this.isPaused = false;
        this.stopKeepAlive();
        this.updateUI();
      };

      this.isPlaying = true;
      this.isPaused = false;
      this.startKeepAlive();
      this.updateUI();

      // Crucial: 50ms transition delay allows the speech synthesis engine IPC to clear the cancel state
      setTimeout(() => {
        try {
          window.speechSynthesis.speak(utterance);
        } catch (err) {
          console.error('[Audio] SpeechSynthesis speak failed:', err);
          this.isPlaying = false;
          this.isPaused = false;
          this.updateUI();
        }
      }, 50);
    }

    public stop() {
      if (!this.hasSpeech) return;
      window.speechSynthesis.cancel();
      this.stopKeepAlive();
      this.isPlaying = false;
      this.isPaused = false;
      this.currentCharIdx = 0;
      this.updateUI();
    }

    public cycleSpeed() {
      this.speedIdx = (this.speedIdx + 1) % this.speeds.length;
      this.currentRate = this.speeds[this.speedIdx];

      if (this.isPlaying && !this.isPaused && this.hasSpeech) {
        // Restart speech at new rate seamlessly
        this.stop();
        this.togglePlay();
      } else {
        this.updateUI();
      }
    }

    private updateUI(isFinished = false) {
      const players = document.querySelectorAll('[data-audio-player]');
      const pct = isFinished 
        ? 100 
        : this.totalChars > 0 
        ? Math.min(100, Math.round((this.currentCharIdx / this.totalChars) * 100)) 
        : 0;

      // Sync quick listen buttons
      const quickBtns = document.querySelectorAll('#quick-audio-listen-btn');
      quickBtns.forEach((btn) => {
        const qPlay = btn.querySelector('.quick-play-icon');
        const qPause = btn.querySelector('.quick-pause-icon');
        const qText = btn.querySelector('.quick-play-text');
        if (this.isPlaying && !this.isPaused) {
          qPlay?.classList.add('hidden');
          qPause?.classList.remove('hidden');
          if (qText) qText.textContent = 'Pause';
        } else if (this.isPaused) {
          qPlay?.classList.remove('hidden');
          qPause?.classList.add('hidden');
          if (qText) qText.textContent = 'Resume';
        } else {
          qPlay?.classList.remove('hidden');
          qPause?.classList.add('hidden');
          if (qText) qText.textContent = 'Listen';
        }
      });

      players.forEach((player) => {
        const playIcon = player.querySelector('.play-icon');
        const pauseIcon = player.querySelector('.pause-icon');
        const statusPill = player.querySelector('.audio-status-pill') as HTMLElement | null;
        const progressLabel = player.querySelector('.audio-progress-label') as HTMLElement | null;
        const progressBar = player.querySelector('.audio-progress-bar') as HTMLElement | null;
        const visualizer = player.querySelector('.audio-visualizer');
        const speedBtn = player.querySelector('.audio-speed-btn');

        if (speedBtn) {
          speedBtn.textContent = `${this.currentRate.toFixed(this.currentRate === 1 ? 1 : 2).replace(/\.0$/, '.0')}x`;
        }

        if (this.isPlaying && !this.isPaused) {
          playIcon?.classList.add('hidden');
          pauseIcon?.classList.remove('hidden');
          visualizer?.classList.remove('hidden');
          visualizer?.classList.add('flex');
          if (statusPill) {
            statusPill.textContent = 'Listening now';
            statusPill.className = 'audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 font-mono';
          }
        } else if (this.isPaused) {
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
          visualizer?.classList.add('hidden');
          visualizer?.classList.remove('flex');
          if (statusPill) {
            statusPill.textContent = 'Narration paused';
            statusPill.className = 'audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 font-mono';
          }
        } else if (isFinished) {
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
          visualizer?.classList.add('hidden');
          visualizer?.classList.remove('flex');
          if (statusPill) {
            statusPill.textContent = 'Completed';
            statusPill.className = 'audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 font-mono';
          }
        } else {
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
          visualizer?.classList.add('hidden');
          visualizer?.classList.remove('flex');
          if (statusPill) {
            statusPill.textContent = 'Ready to listen';
            statusPill.className = 'audio-status-pill text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono';
          }
        }

        if (progressLabel) progressLabel.textContent = `${pct}% completed`;
        if (progressBar) progressBar.style.width = `${pct}%`;
      });
    }
  }

  const globalObj = window as any;
  if (!globalObj.__9b_audio_engine) {
    globalObj.__9b_audio_engine = new ArticleAudioEngine();
  }

  function initGlobalAudio() {
    globalObj.__9b_audio_engine?.init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobalAudio);
  } else {
    initGlobalAudio();
  }
  document.addEventListener('astro:page-load', initGlobalAudio);

  window.addEventListener('beforeunload', () => {
    globalObj.__9b_audio_engine?.stop();
  });
  document.addEventListener('astro:before-swap', () => {
    globalObj.__9b_audio_engine?.stop();
  });
</script>
