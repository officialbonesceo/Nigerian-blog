---
/**
 * Low-Profile Compact Daily Currency Trends Strip
 * Placed in the bottom section of the homepage.
 * Features verified live rates with automatic client-side updates.
 */
import { getVerifiedMarketRates } from '../lib/market-rates';

const marketData = await getVerifiedMarketRates();
const primaryRates = marketData.rates.slice(0, 4); // USD, GBP, EUR, USDT
const nowStr = new Date().toLocaleTimeString('en-NG', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Africa/Lagos',
  hour12: true,
});
---

<section
  id="currency-mini-strip"
  aria-label="Daily Naira Exchange Rates & Currency Trends"
  itemscope
  itemtype="https://schema.org/FinancialService"
  class="my-6 p-3 sm:p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs transition-colors"
>
  <meta itemprop="name" content="9jaBeacon Daily Naira FX & Currency Trends" />
  <meta itemprop="currenciesAccepted" content="NGN, USD, GBP, EUR, USDT, CAD" />

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <!-- Left: Title & Quick Rate Pills -->
    <div class="flex items-center gap-2.5 flex-wrap">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-black text-slate-900 dark:text-white font-mono tracking-tight">
          Naira FX Trends
        </span>
        <span id="mini-strip-time" class="text-[9px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-mono">
          {nowStr} WAT
        </span>
      </div>

      <!-- Compact Rate Badges -->
      <div id="mini-strip-rates" class="flex items-center gap-1.5 flex-wrap">
        {primaryRates.map((r) => (
          <div data-rate-code={r.id} class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-50 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-[11px] font-mono">
            <span class="text-xs">{r.flag}</span>
            <span class="font-bold text-slate-700 dark:text-slate-300">{r.id.toUpperCase()}:</span>
            <span class="rate-val font-extrabold text-slate-900 dark:text-white">₦{Math.round(r.officialSell).toLocaleString()}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: High-Converting Button to Full Wire Page -->
    <a
      href="/market-rates"
      class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition shadow-xs whitespace-nowrap active:scale-95 shrink-0"
    >
      <span>Explore All FX Rates</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<script is:inline>
  (function () {
    function refreshMiniStrip() {
      var strip = document.getElementById('currency-mini-strip');
      if (!strip) return;

      fetch('/api/market-rates', { cache: 'no-store' })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (data) {
          if (!data || !data.success || !Array.isArray(data.rates)) return;
          data.rates.forEach(function (r) {
            var badge = strip.querySelector('[data-rate-code="' + r.id + '"]');
            if (badge) {
              var valEl = badge.querySelector('.rate-val');
              if (valEl && r.officialSell) {
                valEl.textContent = '₦' + Math.round(r.officialSell).toLocaleString();
              }
            }
          });
        })
        .catch(function () {});
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', refreshMiniStrip);
    } else {
      refreshMiniStrip();
    }
    document.addEventListener('astro:page-load', refreshMiniStrip);
  })();
</script>
