---
import type { Category } from '../lib/types';

interface Props {
  siteName?: string;
  settings?: Record<string, string>;
  categories?: Category[];
}

const { siteName = '9jaBeacon', settings = {}, categories = [] } = Astro.props;

const fbUrl = settings.social_facebook_url || 'https://facebook.com/9jabeacon';
const blueskyUrl = settings.social_bluesky_url || 'https://bsky.app/profile/9jabeacon.bsky.social';
const ytUrl = settings.social_youtube_url || 'https://youtube.com/@9jabeacon';
const waChannelUrl =
  settings.social_whatsapp_channel_url ||
  'https://whatsapp.com/channel/0029Vb99qfRJZg451r58zq00';
---

<footer id="site-footer" class="mt-16 border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-950 transition-colors max-w-full overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-6 space-y-3">
        <a href="/" class="inline-flex items-center gap-2 group" title={siteName}>
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white shadow-sm shadow-emerald-500/20">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
              <circle cx="12" cy="12" r="3" fill="currentColor" />
            </svg>
          </div>
          <span class="text-xl font-black tracking-tight text-slate-900 dark:text-white font-sans">
            9ja<span class="text-emerald-600 dark:text-emerald-500">Beacon</span>
          </span>
        </a>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          A Nigerian news blog covering politics, money, sports, and everyday stories — in plain language.
        </p>
        <a
          id="footer-whatsapp-channel"
          href={waChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 mt-1 px-3.5 py-2.5 rounded-xl bg-[#25D366]/10 border border-[#25D366]/40 hover:bg-[#25D366]/20 text-slate-900 dark:text-white transition-colors group max-w-full"
        >
          <span class="w-8 h-8 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.053-1.11-.079-.267-.085-.595-.213-1.042-.407-1.895-.824-3.125-2.735-3.218-2.862-.095-.125-.768-1.021-.768-1.947 0-.925.485-1.38.658-1.57.172-.189.376-.236.501-.236.126 0 .252.002.361.007.116.006.27-.044.423.324.157.377.534 1.303.58 1.398.047.095.078.206.016.332-.063.127-.094.206-.188.316-.094.111-.198.248-.282.333-.095.095-.193.198-.083.388.11.189.489.807 1.05 1.307.724.644 1.334.844 1.523.938.189.095.3.079.412-.047.11-.127.472-.55.598-.739.125-.189.25-.157.422-.094.172.063 1.096.517 1.284.611.189.095.314.142.361.221.046.079.046.457-.098.862z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.113 1.523 5.837L.057 23.31a.5.5 0 00.612.612l5.58-1.463A11.95 11.95 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.71 9.71 0 01-4.95-1.35l-.355-.21-3.71.973.99-3.63-.23-.37A9.69 9.69 0 012.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
            </svg>
          </span>
          <span class="min-w-0 text-left">
            <span class="block text-xs font-black tracking-wide">Follow on WhatsApp</span>
            <span class="block text-[10px] text-slate-500 dark:text-slate-400 truncate">9jaBeacon channel · free updates</span>
          </span>
          <span class="ml-auto text-[10px] font-bold uppercase tracking-wider text-[#128C7E] shrink-0">Join</span>
        </a>
      </div>

      <div class="md:col-span-6 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Social
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Updates and short clips on our channels:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
          <a id="footer-social-wa" href={waChannelUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 p-2.5 rounded-xl border border-[#25D366]/30 bg-[#25D366]/5 hover:bg-[#25D366]/10 text-slate-800 dark:text-slate-200 transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.053-1.11-.079-.267-.085-.595-.213-1.042-.407-1.895-.824-3.125-2.735-3.218-2.862-.095-.125-.768-1.021-.768-1.947 0-.925.485-1.38.658-1.57.172-.189.376-.236.501-.236.126 0 .252.002.361.007.116.006.27-.044.423.324.157.377.534 1.303.58 1.398.047.095.078.206.016.332-.063.127-.094.206-.188.316-.094.111-.198.248-.282.333-.095.095-.193.198-.083.388.11.189.489.807 1.05 1.307.724.644 1.334.844 1.523.938.189.095.3.079.412-.047.11-.127.472-.55.598-.739.125-.189.25-.157.422-.094.172.063 1.096.517 1.284.611.189.095.314.142.361.221.046.079.046.457-.098.862z"/></svg></div>
            <div class="min-w-0"><div class="text-xs font-bold text-slate-900 dark:text-white truncate">WhatsApp</div><div class="text-[10px] text-slate-500 truncate">Channel</div></div>
          </a>
          <a id="footer-social-fb" href={fbUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 p-2.5 rounded-xl border border-blue-500/20 bg-blue-500/5 hover:bg-blue-500/10 text-slate-800 dark:text-slate-200 transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-[#1877F2] text-white flex items-center justify-center shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg></div>
            <div class="min-w-0"><div class="text-xs font-bold text-slate-900 dark:text-white truncate">Facebook</div><div class="text-[10px] text-slate-500 truncate">@9jaBeacon</div></div>
          </a>
          <a id="footer-social-bluesky" href={blueskyUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 p-2.5 rounded-xl border border-blue-500/20 bg-blue-500/5 hover:bg-blue-500/10 text-slate-800 dark:text-slate-200 transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-[#0085FF] text-white flex items-center justify-center shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 568 501"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-198.21C491.56 3.12 568-19.46 568 59.957c0 15.897-9.08 133.567-14.407 152.597-18.528 66.196-85.922 83.18-146.593 72.846 105.992 18.069 132.85 88.04 74.654 147.78-109.972 112.92-167.348-28.327-197.654-88.89-30.306 60.563-87.682 201.81-197.654 88.89-58.196-59.74-31.338-129.711 74.654-147.78C99.329 295.734 31.935 278.75 13.407 212.554 8.08 193.524 0 75.854 0 59.957 0-19.46 76.44 3.12 123.121 33.664z" /></svg></div>
            <div class="min-w-0"><div class="text-xs font-bold text-slate-900 dark:text-white truncate">Bluesky</div><div class="text-[10px] text-slate-500 truncate">@9jabeacon</div></div>
          </a>
          <a id="footer-social-yt" href={ytUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 p-2.5 rounded-xl border border-red-500/20 bg-red-500/5 hover:bg-red-500/10 text-slate-800 dark:text-slate-200 transition-colors group">
            <div class="w-7 h-7 rounded-lg bg-[#FF0000] text-white flex items-center justify-center shrink-0"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" /></svg></div>
            <div class="min-w-0"><div class="text-xs font-bold text-slate-900 dark:text-white truncate">YouTube</div><div class="text-[10px] text-slate-500 truncate">@9jabeacon</div></div>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Categories</div>
      <div class="flex flex-wrap gap-2">
        {categories.map((cat) => (
          <a href={`/category/${cat.slug}`} class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${cat.color || '#008751'}`}></span>
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span>© {new Date().getFullYear()} 9jaBeacon</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs font-medium">
        <a id="footer-link-about" href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-semibold text-slate-900 dark:text-white">About</a>
        <a id="footer-link-contact" href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Contact</a>
        <a id="footer-link-terms" href="/terms" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Terms</a>
        <a id="footer-link-privacy" href="/privacy" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Privacy</a>
        <a id="footer-link-disclaimer" href="/disclaimer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Disclaimer</a>
        <a id="footer-link-saved" href="/saved" class="hover:text-slate-900 dark:hover:text-white transition-colors">Saved</a>
        <a id="footer-link-sitemap" href="/sitemap.xml" class="hover:text-slate-900 dark:hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>

    <div class="meziem-foot" aria-label="Studio">
      <span class="meziem-logo" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="currentColor" opacity="0.15"/>
          <path d="M8 22V10l8 8 8-8v12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="meziem-text">© {new Date().getFullYear()} 9jaBeacon · <strong>Meziem</strong></span>
    </div>
  </div>
</footer>

<style>
.meziem-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  margin: 0.65rem 0 0.25rem;
  font-size: 0.72rem;
  opacity: 0.75;
  letter-spacing: 0.02em;
}
.meziem-logo { display: inline-flex; color: inherit; }
.meziem-text strong { font-weight: 800; letter-spacing: 0.04em; }
</style>
