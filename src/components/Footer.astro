---
import type { Category } from '../lib/types';

interface Props {
  siteName?: string;
  settings?: Record<string, string>;
  categories?: Category[];
}

const { siteName = '9jaBeacon', settings = {}, categories = [] } = Astro.props;

const fbUrl = settings.social_facebook_url || 'https://facebook.com/9jabeacon';
const tiktokUrl = settings.social_tiktok_url || 'https://tiktok.com/@9jabeacon';
const ytUrl = settings.social_youtube_url || 'https://youtube.com/@9jabeacon';
---

<footer id="site-footer" class="mt-16 border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-950 transition-colors max-w-full overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-10">
    <!-- Top Section: Brand & Social Channels -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Brand & Mission -->
      <div class="md:col-span-6 space-y-3">
        <a href="/" class="inline-flex items-center gap-2 group" title={siteName}>
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white shadow-sm shadow-emerald-500/20">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
              <circle cx="12" cy="12" r="3" fill="currentColor" />
            </svg>
          </div>
          <span class="text-xl font-black tracking-tight text-slate-900 dark:text-white font-sans">
            9ja<span class="text-emerald-600 dark:text-emerald-500">Beacon</span>
          </span>
        </a>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          Nigeria's independent, verified digital newsroom. Delivering fast, factual coverage across national affairs, economy, sports, and regional developments.
        </p>
      </div>

      <!-- Visible Social Communities: Facebook, TikTok, YouTube -->
      <div class="md:col-span-6 space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white font-mono flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Connect on Social Channels
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Watch video bulletins, breaking clips, and community discussions on our verified channels:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
          <!-- Facebook -->
          <a
            id="footer-social-fb"
            href={fbUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 p-2.5 rounded-xl border border-blue-500/20 bg-blue-500/5 hover:bg-blue-500/10 text-slate-800 dark:text-slate-200 transition-colors group"
          >
            <div class="w-7 h-7 rounded-lg bg-[#1877F2] text-white flex items-center justify-center shrink-0 shadow-xs">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">Facebook</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">@9jaBeacon</div>
            </div>
          </a>

          <!-- TikTok -->
          <a
            id="footer-social-tiktok"
            href={tiktokUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 p-2.5 rounded-xl border border-pink-500/20 bg-pink-500/5 hover:bg-pink-500/10 text-slate-800 dark:text-slate-200 transition-colors group"
          >
            <div class="w-7 h-7 rounded-lg bg-black text-white flex items-center justify-center shrink-0 border border-slate-700 shadow-xs">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-pink-500 truncate">TikTok</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">@9jaBeacon</div>
            </div>
          </a>

          <!-- YouTube -->
          <a
            id="footer-social-yt"
            href={ytUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 p-2.5 rounded-xl border border-red-500/20 bg-red-500/5 hover:bg-red-500/10 text-slate-800 dark:text-slate-200 transition-colors group"
          >
            <div class="w-7 h-7 rounded-lg bg-[#FF0000] text-white flex items-center justify-center shrink-0 shadow-xs">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-red-500 truncate">YouTube</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">9jaBeacon TV</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Category Desks Quick Grid -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 font-mono">
        Editorial Desks
      </div>
      <div class="flex flex-wrap gap-2">
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors flex items-center gap-1.5"
          >
            <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${cat.color || '#008751'}`}></span>
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Attribution & Standards -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span>© {new Date().getFullYear()} 9jaBeacon. All rights reserved.</span>
      </div>

      <!-- Legal Compliance Links -->
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs font-medium">
        <a id="footer-link-contact" href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Contact & Advertise</a>
        <a id="footer-link-terms" href="/terms" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Terms of Service</a>
        <a id="footer-link-privacy" href="/privacy" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Privacy Policy</a>
        <a id="footer-link-disclaimer" href="/disclaimer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Disclaimer & Attribution</a>
        <a id="footer-link-saved" href="/saved" class="hover:text-slate-900 dark:hover:text-white transition-colors">Saved Reads</a>
        <a id="footer-link-sitemap" href="/sitemap.xml" class="hover:text-slate-900 dark:hover:text-white transition-colors">Sitemap</a>
        <a id="footer-link-admin" href="/bonesceo/admin" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Editorial Portal</a>
      </div>
    </div>
  </div>
</footer>
