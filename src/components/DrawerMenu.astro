---
import type { Category } from '../lib/types';

interface Props {
  siteName?: string;
  categories: Category[];
  settings?: Record<string, string>;
}

const { siteName = '9jaBeacon', categories = [], settings = {} } = Astro.props;

const fbUrl = settings.social_facebook_url || 'https://facebook.com/9jabeacon';
const tiktokUrl = settings.social_tiktok_url || 'https://tiktok.com/@9jabeacon';
const ytUrl = settings.social_youtube_url || 'https://youtube.com/@9jabeacon';
---

<!-- Drawer Backdrop -->
<div
  id="drawer-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden transition-opacity duration-300"
></div>

<!-- Drawer Menu Panel -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-white dark:bg-slate-950 border-l border-slate-200 dark:border-slate-800 z-50 transform translate-x-full invisible pointer-events-none transition-all duration-300 ease-out flex flex-col shadow-2xl safe-area-top safe-area-bottom"
>
  <!-- Drawer Header -->
  <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" />
        </svg>
      </div>
      <span class="font-bold text-slate-900 dark:text-white tracking-tight">{siteName} Menu</span>
    </div>
    <button
      id="btn-close-drawer"
      aria-label="Close menu"
      class="p-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body -->
  <div class="flex-1 overflow-y-auto p-4 space-y-6">
    <!-- Theme Switcher in Menu -->
    <div class="p-3 bg-slate-100 dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800 space-y-2">
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Display Theme</h4>
      <div class="grid grid-cols-2 gap-1.5 pt-1">
        <button
          id="btn-drawer-theme-light"
          type="button"
          onclick="setDrawerTheme('light')"
          class="py-2 px-3 text-xs font-bold rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          Light Mode
        </button>
        <button
          id="btn-drawer-theme-dark"
          type="button"
          onclick="setDrawerTheme('dark')"
          class="py-2 px-3 text-xs font-bold rounded-lg bg-slate-800 text-white border border-slate-700 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          Dark Mode
        </button>
      </div>
    </div>

    <!-- Video Hub Primary Action -->
    <a
      href="/videos"
      class="flex items-center justify-between p-3 rounded-xl bg-red-500/10 dark:bg-red-500/20 border border-red-500/30 text-red-600 dark:text-red-400 hover:bg-red-500/20 transition-all font-bold group"
    >
      <span class="text-sm flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
        Video Broadcast Hub
      </span>
      <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded-md bg-red-600 text-white font-black">
        Watch Live
      </span>
    </a>

    <!-- Categories List -->
    <div>
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5">Explore Categories</h4>

      <div class="space-y-1">
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors group"
          >
            <span class="text-sm font-medium flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full" style={`background-color: ${cat.color || '#008751'}`}></span>
              {cat.name}
            </span>
            <span class="text-xs text-slate-400 dark:text-slate-500 font-mono group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
              {cat.follower_count ? `${(cat.follower_count / 1000).toFixed(1)}k` : ''}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Reading Preferences -->
    <div class="p-3 bg-slate-100 dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800 space-y-2">
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Article Font Size</h4>
      <div class="grid grid-cols-3 gap-1.5 pt-1">
        <button
          onclick="setFontScale('sm')"
          class="py-1.5 text-xs font-semibold rounded bg-white dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-transparent transition-colors cursor-pointer"
        >
          Small
        </button>
        <button
          onclick="setFontScale('md')"
          class="py-1.5 text-xs font-semibold rounded bg-emerald-600 text-white transition-colors cursor-pointer"
        >
          Standard
        </button>
        <button
          onclick="setFontScale('lg')"
          class="py-1.5 text-xs font-semibold rounded bg-white dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-transparent transition-colors cursor-pointer"
        >
          Large
        </button>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="space-y-1 text-sm text-slate-700 dark:text-slate-300">
      <a href="/saved" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-900">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
        Saved Reading List
      </a>
      <a href="/search" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-900">
        <svg class="w-4 h-4 text-sky-600 dark:text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search & Archives
      </a>
      <div class="pt-2 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 flex flex-wrap gap-x-3 gap-y-1.5 px-2">
        <a href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-semibold text-slate-800 dark:text-slate-200">About Us</a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors font-medium">Contact & Ads</a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Terms</a>
        <span>&bull;</span>
        <a href="/privacy" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Privacy</a>
        <span>&bull;</span>
        <a href="/disclaimer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Disclaimer</a>
      </div>
    </div>

    <!-- Social Media Community -->
    <div class="p-3 bg-slate-100 dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800 space-y-2.5">
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Join Our Community</h4>
      <div class="grid grid-cols-3 gap-2">
        <a
          href={fbUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-500/50 transition-colors group"
        >
          <div class="w-6 h-6 rounded-md bg-[#1877F2] text-white flex items-center justify-center mb-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </div>
          <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-blue-600 dark:group-hover:text-blue-400">Facebook</span>
        </a>
        <a
          href={tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-pink-500/50 transition-colors group"
        >
          <div class="w-6 h-6 rounded-md bg-black text-white flex items-center justify-center mb-1 border border-slate-700">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </div>
          <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-pink-500">TikTok</span>
        </a>
        <a
          href={ytUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-red-500/50 transition-colors group"
        >
          <div class="w-6 h-6 rounded-md bg-[#FF0000] text-white flex items-center justify-center mb-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </div>
          <span class="text-[10px] font-bold text-slate-700 dark:text-slate-300 group-hover:text-red-500">YouTube</span>
        </a>
      </div>
    </div>

    <!-- About 9jaBeacon & Editorial Standards -->
    <div class="pt-4 border-t border-slate-200 dark:border-slate-800 text-[11px] text-slate-500 leading-relaxed space-y-1.5">
      <p class="font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        About 9jaBeacon
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-normal">
        Nigeria's trusted digital newsroom. Delivering fast, factual coverage, verified national reporting, investigative journalism, politics, economy, and culture.
      </p>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
    <span>© {new Date().getFullYear()} 9jaBeacon. All rights reserved.</span>
    <span class="text-[10px] bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded font-mono">Verified News</span>
  </div>
</aside>

<script is:inline>
  const openBtn = document.getElementById('btn-open-drawer');
  const closeBtn = document.getElementById('btn-close-drawer');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  function openDrawer() {
    drawer?.classList.remove('invisible', 'pointer-events-none');
    // slight delay or next frame so transition animates smoothly
    requestAnimationFrame(() => {
      drawer?.classList.remove('translate-x-full');
      backdrop?.classList.remove('hidden');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('translate-x-full');
    backdrop?.classList.add('hidden');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (drawer?.classList.contains('translate-x-full')) {
        drawer?.classList.add('invisible', 'pointer-events-none');
      }
    }, 310);
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.setDrawerTheme = function(mode) {
    if (mode === 'dark') {
      document.documentElement.classList.add('dark');
      localStorage.setItem('9jabeacon_theme', 'dark');
      localStorage.setItem('naijapulse_theme', 'dark');
      window.showToast?.('Dark mode activated', 'info');
    } else {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('9jabeacon_theme', 'light');
      localStorage.setItem('naijapulse_theme', 'light');
      window.showToast?.('Light mode activated', 'info');
    }
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: mode } }));
  };

  window.setFontScale = function(size) {
    localStorage.setItem('9jabeacon_font_size', size);
    document.documentElement.setAttribute('data-font-size', size);
    window.showToast?.(`Font set to ${size.toUpperCase()}`, 'success');
  };
</script>
