---
import type { Category } from '../lib/types';

interface Props {
  categories: Category[];
}

const { categories = [] } = Astro.props;
---

<!-- Drawer Backdrop -->
<div
  id="drawer-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden transition-opacity duration-300"
></div>

<!-- Drawer Menu Panel -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-slate-950 border-l border-slate-800 z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-2xl safe-area-top safe-area-bottom"
>
  <!-- Drawer Header -->
  <div class="p-4 border-b border-slate-800 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded bg-emerald-600 flex items-center justify-center text-white">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
        </svg>
      </div>
      <span class="font-bold text-white tracking-tight">NaijaPulse Menu</span>
    </div>
    <button
      id="btn-close-drawer"
      aria-label="Close menu"
      class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition-colors"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body -->
  <div class="flex-1 overflow-y-auto p-4 space-y-6">
    <!-- Categories List -->
    <div>
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2.5">Explore Categories</h4>
      <div class="space-y-1">
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}`}
            class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-900 text-slate-300 hover:text-white transition-colors group"
          >
            <span class="text-sm font-medium flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full" style={`background-color: ${cat.color || '#008751'}`}></span>
              {cat.name}
            </span>
            <span class="text-xs text-slate-500 font-mono group-hover:text-emerald-400">
              {cat.follower_count ? `${(cat.follower_count / 1000).toFixed(1)}k` : ''}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Reading Preferences -->
    <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 space-y-2">
      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Article Font Size</h4>
      <div class="grid grid-cols-3 gap-1.5 pt-1">
        <button
          onclick="setFontScale('sm')"
          class="py-1.5 text-xs font-semibold rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
        >
          Small
        </button>
        <button
          onclick="setFontScale('md')"
          class="py-1.5 text-xs font-semibold rounded bg-emerald-600 text-white transition-colors"
        >
          Standard
        </button>
        <button
          onclick="setFontScale('lg')"
          class="py-1.5 text-xs font-semibold rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
        >
          Large
        </button>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="space-y-1 text-sm text-slate-300">
      <a href="/saved" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-900">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
        Saved Reading List
      </a>
      <a href="/search" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-900">
        <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search & Archives
      </a>
      <a href="/admin" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-900 text-emerald-400 font-semibold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Admin & RSS Sources Control
      </a>
    </div>

    <!-- Editorial Disclaimer & Standards -->
    <div class="pt-4 border-t border-slate-800 text-[11px] text-slate-500 leading-relaxed space-y-1">
      <p class="font-semibold text-slate-400">Journalistic Integrity & Attribution</p>
      <p>NaijaPulse indexes official government announcements and permitted Nigerian news feeds with full source credit, canonical URLs, and copyright respect.</p>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div class="p-4 border-t border-slate-800 bg-slate-900/40 text-xs text-slate-400 flex items-center justify-between">
    <span>© 2025 NaijaPulse.ng</span>
    <span class="text-[10px] bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded font-mono">v1.0 D1</span>
  </div>
</aside>

<script is:inline>
  const openBtn = document.getElementById('btn-open-drawer');
  const closeBtn = document.getElementById('btn-close-drawer');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  function openDrawer() {
    drawer?.classList.remove('translate-x-full');
    backdrop?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('translate-x-full');
    backdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  window.setFontScale = function(size) {
    localStorage.setItem('naijapulse_font_size', size);
    document.documentElement.setAttribute('data-font-size', size);
    window.showToast?.(`Font set to ${size.toUpperCase()}`, 'success');
  };
</script>
