---
import type { Article } from '../lib/types';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../lib/fallback-image';

interface Props {
  article: Article;
}

const { article } = Astro.props;

// Format publish date
const rawDate = article.published_at ? new Date(article.published_at) : new Date();
const formattedDate = !isNaN(rawDate.getTime())
  ? rawDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Today';

const imageUrl = article.image_url || DEFAULT_FALLBACK_IMAGE_URL;
---

<article class="relative w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 bg-slate-900 group">
  <a href={`/news/${article.slug}`} class="block relative aspect-[16/10] sm:aspect-[21/9] w-full overflow-hidden">
    <!-- Image with Fallback -->
    <img
      src={imageUrl}
      alt={article.title}
      loading="eager"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.onerror=null;this.src='/fallback-image.svg'"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>

    <!-- Content Overlay -->
    <div class="absolute inset-0 p-4 sm:p-6 flex flex-col justify-between overflow-hidden">
      <!-- Top Badge -->
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-extrabold uppercase tracking-wider shadow-sm shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
          Top Story
        </span>

        {article.category_name && (
          <span class="px-2 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-xs text-slate-300 text-[10px] font-bold uppercase tracking-wider border border-slate-700/50 truncate max-w-[140px]">
            {article.category_name}
          </span>
        )}
      </div>

      <!-- Bottom Headline & Meta -->
      <div class="space-y-2 overflow-hidden">
        <h2 class="text-base sm:text-2xl font-extrabold text-white leading-snug group-hover:text-emerald-300 transition-colors line-clamp-3 break-words">
          {article.title}
        </h2>

        <div class="flex items-center gap-3 text-xs text-slate-300 font-medium">
          <span>{formattedDate}</span>
          <span class="w-1 h-1 rounded-full bg-slate-500 shrink-0"></span>
          <span class="flex items-center gap-1 shrink-0">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {article.reading_time_minutes || 4} min read
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
