---
/**
 * Hero carousel: news slides + one Adsterra 300x250 banner slide (no fake cards).
 */
import type { Article } from '../lib/types';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../lib/fallback-image';
import { getD1, getSiteSettings } from '../lib/runtime-db';

interface Props {
  slides: Article[];
  adsterraContainerId?: string;
  adsterraScriptUrl?: string;
  smartLinkUrl?: string;
}

const { slides } = Astro.props;

let bannerKey = '6605a898998325cc0d10c2c5c77a29d8';
try {
  const db = getD1(Astro.locals);
  const settings = await getSiteSettings(db);
  if (settings.ad_banner_300x250_key) bannerKey = settings.ad_banner_300x250_key;
} catch {}

const srcDoc300x250 = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;background:#0f172a;overflow:hidden;min-height:100%;}</style></head><body><script>atOptions={'key':'${bannerKey}','format':'iframe','height':250,'width':300,'params':{}};<\/script><script src="https://www.highrevenueformat.com/${bannerKey}/invoke.js"><\/script></body></html>`;

const newsCount = slides.length;
const total = newsCount + 1;
---

<section
  id="hero-carousel"
  class="relative w-full rounded-2xl overflow-hidden shadow-xl border border-slate-200 dark:border-slate-800 bg-slate-900 mb-6"
  data-news-ms="4500"
  data-ad-ms="8000"
  data-news-count={String(newsCount)}
  data-total={String(total)}
  aria-roledescription="carousel"
  aria-label="Top stories"
>
  <div class="relative aspect-[16/10] sm:aspect-[21/9] w-full">
    {slides.map((article, i) => {
      const imageUrl = article.image_url || DEFAULT_FALLBACK_IMAGE_URL;
      const rawDate = article.published_at ? new Date(article.published_at) : new Date();
      const formattedDate = !isNaN(rawDate.getTime())
        ? rawDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : 'Today';
      return (
        <a
          href={`/news/${article.slug}`}
          class={`hero-slide absolute inset-0 block group transition-opacity duration-500 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
          data-index={String(i)}
          data-kind="news"
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <img
            src={imageUrl}
            alt={article.title}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.onerror=null;this.src='/fallback-image.svg'"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/55 to-transparent"></div>
          <div class="absolute inset-0 p-4 sm:p-6 flex flex-col justify-between overflow-hidden">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-extrabold uppercase tracking-wider shadow-sm shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                {article.category_name || 'Top Story'}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-slate-900/80 backdrop-blur-xs text-slate-300 text-[10px] font-bold uppercase tracking-wider border border-slate-700/50">
                Latest in desk
              </span>
            </div>
            <div class="space-y-2 overflow-hidden">
              <h2 class="text-base sm:text-2xl font-extrabold text-white leading-snug group-hover:text-emerald-300 transition-colors line-clamp-3 break-words">
                {article.title}
              </h2>
              <div class="flex items-center gap-3 text-xs text-slate-300 font-medium">
                <span>{formattedDate}</span>
                <span class="w-1 h-1 rounded-full bg-slate-500 shrink-0"></span>
                <span class="flex items-center gap-1 shrink-0">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {article.reading_time_minutes || 4} min read
                </span>
              </div>
            </div>
          </div>
        </a>
      );
    })}

    <!-- Adsterra 300x250 banner slide -->
    <div
      class={`hero-slide absolute inset-0 transition-opacity duration-500 opacity-0 z-0 pointer-events-none`}
      data-index={String(newsCount)}
      data-kind="ad"
      aria-hidden="true"
      role="group"
      aria-label="Sponsored"
    >
      <div class="w-full h-full bg-slate-950 flex flex-col items-center justify-center p-3 sm:p-4">
        <div class="flex items-center justify-between w-full max-w-[300px] mb-2 shrink-0">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-500 text-slate-950 text-[10px] font-extrabold uppercase tracking-wider">
            Sponsored
          </span>
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Adsterra</span>
        </div>
        <div class="w-[300px] h-[250px] min-w-[300px] min-h-[250px] overflow-hidden rounded-xl border border-slate-700/60 bg-slate-900 flex items-center justify-center">
          <iframe
            srcdoc={srcDoc300x250}
            width="300"
            height="250"
            loading="lazy"
            title="Sponsored Advertisement"
            class="border-0 w-[300px] h-[250px] overflow-hidden block"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-3 left-0 right-0 z-20 flex items-center justify-between px-3 sm:px-4 pointer-events-none">
    <button type="button" class="hero-prev pointer-events-auto w-8 h-8 rounded-full bg-slate-950/70 border border-slate-600/60 text-white flex items-center justify-center hover:bg-slate-900 transition" aria-label="Previous slide">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <div class="hero-dots flex items-center gap-1.5 pointer-events-auto" role="tablist" aria-label="Slides">
      {Array.from({ length: total }).map((_, i) => (
        <button
          type="button"
          class={`hero-dot w-2 h-2 rounded-full transition ${i === 0 ? 'bg-emerald-400 scale-110' : 'bg-white/40 hover:bg-white/70'}`}
          data-index={String(i)}
          aria-label={`Go to slide ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        />
      ))}
    </div>
    <button type="button" class="hero-next pointer-events-auto w-8 h-8 rounded-full bg-slate-950/70 border border-slate-600/60 text-white flex items-center justify-center hover:bg-slate-900 transition" aria-label="Next slide">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</section>

<script is:inline>
  (function () {
    function initHero() {
      var root = document.getElementById('hero-carousel');
      if (!root || root.getAttribute('data-hero-bound') === '1') return;
      root.setAttribute('data-hero-bound', '1');

      var newsMs = parseInt(root.getAttribute('data-news-ms') || '4500', 10);
      var adMs = parseInt(root.getAttribute('data-ad-ms') || '8000', 10);
      var total = parseInt(root.getAttribute('data-total') || '1', 10);
      if (total < 1) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
      var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));
      var idx = 0;
      var timer = null;
      var paused = false;

      function show(i) {
        idx = ((i % total) + total) % total;
        slides.forEach(function (el, n) {
          var on = n === idx;
          el.classList.toggle('opacity-100', on);
          el.classList.toggle('z-10', on);
          el.classList.toggle('opacity-0', !on);
          el.classList.toggle('z-0', !on);
          el.classList.toggle('pointer-events-none', !on);
          el.setAttribute('aria-hidden', on ? 'false' : 'true');
        });
        dots.forEach(function (d, n) {
          var on = n === idx;
          d.classList.toggle('bg-emerald-400', on);
          d.classList.toggle('scale-110', on);
          d.classList.toggle('bg-white/40', !on);
          d.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        schedule();
      }

      function schedule() {
        if (timer) clearTimeout(timer);
        if (paused) return;
        var el = slides[idx];
        var kind = el && el.getAttribute('data-kind');
        var wait = kind === 'ad' ? adMs : newsMs;
        timer = setTimeout(function () { show(idx + 1); }, wait);
      }

      var prev = root.querySelector('.hero-prev');
      var next = root.querySelector('.hero-next');
      if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); show(idx - 1); });
      if (next) next.addEventListener('click', function (e) { e.preventDefault(); show(idx + 1); });
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          show(parseInt(d.getAttribute('data-index') || '0', 10));
        });
      });

      root.addEventListener('mouseenter', function () { paused = true; if (timer) clearTimeout(timer); });
      root.addEventListener('mouseleave', function () { paused = false; schedule(); });
      root.addEventListener('focusin', function () { paused = true; if (timer) clearTimeout(timer); });
      root.addEventListener('focusout', function () { paused = false; schedule(); });

      show(0);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHero);
    else initHero();
    document.addEventListener('astro:page-load', initHero);
  })();
</script>
