---
import type { Article } from '../lib/types';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../lib/fallback-image';

interface Props {
  article: Article;
  showCategory?: boolean;
}

const { article, showCategory = true } = Astro.props;

// Calculate relative time (e.g. "2h ago")
function getRelativeTime(dateStr: string): string {
  if (!dateStr) return 'Just now';
  const diff = Date.now() - new Date(dateStr).getTime();
  const minutes = Math.floor(diff / 60000);
  if (minutes < 60) return `${Math.max(1, minutes)}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}

const timeAgo = getRelativeTime(article.published_at);
const imageUrl = article.image_url || DEFAULT_FALLBACK_IMAGE_URL;
---

<article class="p-3 sm:p-4 rounded-xl bg-white dark:bg-slate-900/40 hover:bg-slate-50 dark:hover:bg-slate-900/80 border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700/80 shadow-xs dark:shadow-none transition-all duration-200 group overflow-hidden">
  <div class="flex items-start justify-between gap-3 sm:gap-4">
    <!-- Left Details -->
    <div class="flex-1 min-w-0 space-y-1.5 overflow-hidden">
      {showCategory && (
        <a
          href={`/category/${article.category_slug || 'naija-news'}`}
          class="inline-block text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 font-mono truncate max-w-full"
        >
          {article.category_name || 'Naija News'}
        </a>
      )}

      <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 leading-snug line-clamp-2 transition-colors break-words">
        <a href={`/news/${article.slug}`}>
          {article.title}
        </a>
      </h3>

      <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400 pt-0.5">
        <span>{timeAgo}</span>
        <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600 shrink-0"></span>
        <span class="shrink-0">{article.reading_time_minutes || 4} min read</span>
      </div>
    </div>

    <!-- Right Image Thumbnail with Fallback -->
    <a href={`/news/${article.slug}`} class="shrink-0 relative w-20 h-20 sm:w-24 sm:h-24 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-800/60">
      <img
        src={imageUrl}
        alt={article.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  </div>
</article>
