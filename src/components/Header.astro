---
import type { Category } from '../lib/types';

interface Props {
  siteName: string;
  categories: Category[];
}

const { siteName = 'NaijaPulse', categories = [] } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
    <!-- Menu Drawer Trigger (Mobile) -->
    <button
      id="btn-open-drawer"
      aria-label="Open mobile menu"
      class="p-2 -ml-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/50 transition-colors flex items-center justify-center focus:outline-none"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Logo Branding -->
    <a href="/" class="flex flex-col items-center group cursor-pointer select-none" title={siteName}>
      <div class="flex items-center gap-1.5">
        <div class="w-6 h-6 rounded-md bg-emerald-600 flex items-center justify-center text-white shadow-sm shadow-emerald-500/20">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </div>
        <span class="text-lg font-black tracking-tight text-white flex items-center font-sans">
          Naija<span class="text-emerald-500">Pulse</span>
        </span>
      </div>
      <span class="text-[9px] tracking-wider text-slate-400 font-medium -mt-1 hidden sm:block">
        Your Pulse. Our Nation.
      </span>
    </a>

    <!-- Right Action Items: Search Shortcut & Theme -->
    <div class="flex items-center gap-1 -mr-2">
      <a
        href="/search"
        aria-label="Search news"
        class="p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/50 transition-colors flex items-center justify-center"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Quick Admin Link -->
      <a
        href="/admin"
        aria-label="Admin Dashboard"
        class="p-2 text-slate-400 hover:text-emerald-400 rounded-lg hover:bg-slate-800/50 transition-colors flex items-center justify-center text-xs font-semibold"
        title="Admin Control"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Desktop Quick Category Header Line -->
  <div class="hidden md:flex max-w-4xl mx-auto px-6 py-1.5 border-t border-slate-800/40 items-center gap-5 text-xs font-medium text-slate-400 overflow-x-auto no-scrollbar">
    <a href="/" class="hover:text-emerald-400 transition-colors whitespace-nowrap text-emerald-500 font-semibold">Home</a>
    {categories.map((cat) => (
      <a href={`/category/${cat.slug}`} class="hover:text-emerald-400 transition-colors whitespace-nowrap">
        {cat.name}
      </a>
    ))}
    <a href="/saved" class="hover:text-emerald-400 transition-colors whitespace-nowrap text-slate-300 ml-auto flex items-center gap-1">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
      Saved
    </a>
  </div>
</header>
