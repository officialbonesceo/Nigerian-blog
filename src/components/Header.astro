---
import type { Category } from '../lib/types';

interface Props {
  siteName: string;
  categories?: Category[];
}

const { siteName = '9jaBeacon' } = Astro.props;
---

<header class="sticky top-0 z-40 w-full bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-200/90 dark:border-slate-800/80 transition-colors overflow-hidden">
  <div class="max-w-4xl mx-auto px-3 sm:px-6 h-14 flex items-center justify-between gap-2 sm:gap-3">
    <!-- Menu Drawer Trigger (Mobile) -->
    <button
      id="btn-open-drawer"
      aria-label="Open mobile menu"
      class="p-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-center focus:outline-none cursor-pointer shrink-0"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Logo Branding: 9jaBeacon -->
    <a href="/" class="flex flex-col items-center group cursor-pointer select-none shrink-0" title={siteName}>
      <div class="flex items-center gap-1.5">
        <div class="w-6 h-6 rounded-md bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-white shadow-sm shadow-emerald-500/20">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Lighthouse / Beacon Signal Icon -->
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
            <circle cx="12" cy="12" r="3" fill="currentColor" />
          </svg>
        </div>
        <span class="text-lg font-black tracking-tight text-slate-900 dark:text-white flex items-center font-sans">
          9ja<span class="text-emerald-600 dark:text-emerald-500">Beacon</span>
        </span>
      </div>
      <span class="text-[9px] tracking-wider text-slate-500 dark:text-slate-400 font-medium -mt-1 hidden sm:block">
        Your Trusted Light on Nigerian News
      </span>
    </a>

    <!-- Right Action Items: Social Links, Notifications, Search Shortcut & Theme Toggle -->
    <div class="flex items-center gap-1 shrink-0">
      <!-- High-Visibility Community Socials (Facebook, TikTok, YouTube) - visible on tablet/desktop, in Drawer on mobile -->
      <div class="hidden sm:flex items-center gap-1 mr-1 border-r border-slate-200 dark:border-slate-800 pr-1.5 sm:pr-2">
        <a
          href="https://facebook.com/9jabeacon"
          target="_blank"
          rel="noopener noreferrer"
          title="Follow 9jaBeacon on Facebook"
          class="w-7 h-7 rounded-lg bg-[#1877F2]/10 hover:bg-[#1877F2] text-[#1877F2] hover:text-white transition-colors flex items-center justify-center cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>
        <a
          href="https://tiktok.com/@9jabeacon"
          target="_blank"
          rel="noopener noreferrer"
          title="Follow 9jaBeacon on TikTok"
          class="w-7 h-7 rounded-lg bg-slate-900/10 dark:bg-white/10 hover:bg-black dark:hover:bg-white text-slate-900 dark:text-white dark:hover:text-black hover:text-white transition-colors flex items-center justify-center cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
          </svg>
        </a>
        <a
          href="https://youtube.com/@9jabeacon"
          target="_blank"
          rel="noopener noreferrer"
          title="Subscribe to 9jaBeacon on YouTube"
          class="w-7 h-7 rounded-lg bg-[#FF0000]/10 hover:bg-[#FF0000] text-[#FF0000] hover:text-white transition-colors flex items-center justify-center cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>

      <!-- Notification Center Bell Trigger -->
      <button
        id="btn-notifications-bell"
        type="button"
        aria-label="Topic Sphere Alerts"
        title="Breaking & Followed Alerts"
        class="relative p-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-center cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
        <!-- Unread Badge Indicator -->
        <span id="notification-badge" class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-emerald-500 rounded-full ring-2 ring-white dark:ring-slate-950 animate-pulse"></span>
      </button>

      <a
        href="/search"
        aria-label="Search news"
        class="p-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-center"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Theme Switcher Button -->
      <button
        id="btn-theme-toggle"
        type="button"
        aria-label="Toggle light or dark theme"
        title="Toggle Theme"
        class="p-2 text-slate-600 dark:text-slate-400 hover:text-amber-500 dark:hover:text-amber-400 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-center cursor-pointer"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Desktop Quick Category Header Line (5 Primary Tabs) -->
  <div class="hidden md:flex max-w-4xl mx-auto px-6 py-2 border-t border-slate-200/80 dark:border-slate-800/40 items-center gap-6 text-xs font-semibold text-slate-600 dark:text-slate-400 overflow-x-auto no-scrollbar">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap">Home</a>
    <a href="/category/naija-news" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap">Naija News</a>
    <a href="/category/business" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap">Business</a>
    <a href="/category/sports" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap">Sports</a>
    <a href="/category/world" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap">World</a>
    <a href="/saved" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors whitespace-nowrap text-slate-700 dark:text-slate-300 ml-auto flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
      </svg>
      Saved
    </a>
  </div>
</header>

<!-- TOPIC SPHERE & NOTIFICATION CENTER MODAL / POPUP -->
<div id="notification-center-modal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-xs flex items-start justify-center sm:justify-end sm:pr-6 sm:pt-16 p-4">
  <div id="notification-card-container" class="w-full sm:w-96 max-h-[82vh] bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Modal Header -->
    <div class="p-4 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between bg-slate-50/70 dark:bg-slate-950/50 shrink-0">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-emerald-600/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white font-sans">Topic Sphere Alerts</h3>
      </div>

      <div class="flex items-center gap-1">
        <button
          id="btn-mark-all-read"
          class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 hover:underline px-2 py-1 cursor-pointer"
        >
          Mark all read
        </button>
        <button
          id="btn-close-notifications"
          class="p-1 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Notification Permission Action Banner -->
    <div id="push-permission-banner" class="p-3 bg-emerald-50 dark:bg-emerald-950/40 border-b border-emerald-100 dark:border-emerald-900/50 flex items-center justify-between gap-2 text-xs shrink-0">
      <div class="flex items-center gap-1.5 text-emerald-900 dark:text-emerald-300">
        <span class="text-sm">🔔</span>
        <span>Receive breaking news on your device?</span>
      </div>
      <button
        id="btn-enable-push"
        class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[11px] cursor-pointer shadow-xs"
      >
        Enable
      </button>
    </div>

    <!-- Quick Follow Topic Spheres -->
    <div class="p-3 bg-slate-50/50 dark:bg-slate-950/30 border-b border-slate-100 dark:border-slate-800/80 shrink-0">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 font-mono block mb-2">Followed Topic Spheres</span>
      <div class="flex flex-wrap gap-1.5" id="topic-sphere-pills">
        <button data-sphere="naija-news" class="sphere-pill px-2.5 py-1 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
          Naija News <span class="sphere-icon ml-0.5">+</span>
        </button>
        <button data-sphere="business" class="sphere-pill px-2.5 py-1 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
          Business <span class="sphere-icon ml-0.5">+</span>
        </button>
        <button data-sphere="sports" class="sphere-pill px-2.5 py-1 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
          Sports <span class="sphere-icon ml-0.5">+</span>
        </button>
        <button data-sphere="world" class="sphere-pill px-2.5 py-1 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer">
          World <span class="sphere-icon ml-0.5">+</span>
        </button>
      </div>
    </div>

    <!-- Cached Notifications Stream -->
    <div id="notifications-list" class="overflow-y-auto max-h-72 p-2 divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
      <!-- Injected via JavaScript -->
    </div>

  </div>
</div>

<script is:inline>
  // Topic Sphere & Notification System Manager
  function initNotificationCenter() {
    const modal = document.getElementById('notification-center-modal');
    const bellBtn = document.getElementById('btn-notifications-bell');
    const closeBtn = document.getElementById('btn-close-notifications');
    const markReadBtn = document.getElementById('btn-mark-all-read');
    const enablePushBtn = document.getElementById('btn-enable-push');
    const pushBanner = document.getElementById('push-permission-banner');
    const badge = document.getElementById('notification-badge');
    const list = document.getElementById('notifications-list');

    // Toggle Modal
    bellBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      modal?.classList.remove('hidden');
      renderNotifications();
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Check Notification Permission
    try {
      if (typeof Notification !== 'undefined' && Notification.permission) {
        if (Notification.permission === 'granted' || Notification.permission === 'denied') {
          pushBanner?.classList.add('hidden');
        }
      } else {
        pushBanner?.classList.add('hidden');
      }
    } catch {}

    enablePushBtn?.addEventListener('click', async () => {
      try {
        if (typeof Notification !== 'undefined' && typeof Notification.requestPermission === 'function') {
          const perm = await Notification.requestPermission();
          pushBanner?.classList.add('hidden');
          if (perm === 'granted') {
            window.showToast?.('Device alerts enabled for followed topics!', 'success');
            try {
              new Notification('⚡ 9jaBeacon Active', {
                body: 'You will receive instant breaking news updates from your followed topic spheres.',
                icon: '/favicon.ico'
              });
            } catch {}
          } else {
            window.showToast?.('In-app alerts are active for your followed topic spheres.', 'info');
          }
        } else {
          pushBanner?.classList.add('hidden');
          window.showToast?.('In-app alerts active for followed topics!', 'success');
        }
      } catch {
        pushBanner?.classList.add('hidden');
        window.showToast?.('In-app alerts enabled!', 'success');
      }
    });

    // Sphere Pills Follow Toggle
    const pills = document.querySelectorAll('.sphere-pill');
    pills.forEach((pill) => {
      const sphere = pill.getAttribute('data-sphere');
      if (!sphere) return;

      const isFollowed = localStorage.getItem(`following_sphere_${sphere}`) === 'true';
      updatePillUI(pill, isFollowed);

      pill.addEventListener('click', () => {
        const curr = localStorage.getItem(`following_sphere_${sphere}`) === 'true';
        const next = !curr;
        localStorage.setItem(`following_sphere_${sphere}`, next ? 'true' : 'false');
        updatePillUI(pill, next);
        if (next) {
          window.showToast?.(`Following ${pill.textContent?.trim()} news sphere`, 'success');
          // Dispatch sample cached alert for this sphere
          addNotification({
            id: 'notif_' + sphere + '_' + Date.now(),
            title: `Subscribed to ${pill.textContent?.trim()}`,
            summary: `You will now receive top stories and verified wire updates for this topic.`,
            url: `/category/${sphere}`,
            time: 'Just now',
            unread: true
          });
        } else {
          window.showToast?.(`Unfollowed ${pill.textContent?.trim()}`);
        }
        renderNotifications();
      });
    });

    function updatePillUI(el, active) {
      const icon = el.querySelector('.sphere-icon');
      if (active) {
        el.className = 'sphere-pill px-2.5 py-1 rounded-full text-xs font-bold border border-emerald-500 bg-emerald-600 text-white shadow-xs transition-colors cursor-pointer';
        if (icon) icon.textContent = '✓';
      } else {
        el.className = 'sphere-pill px-2.5 py-1 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer';
        if (icon) icon.textContent = '+';
      }
    }

    // Real Database-Backed Notifications
    let cachedNotifications = [];

    async function loadDatabaseNotifications() {
      try {
        const res = await fetch('/api/notifications');
        if (res.ok) {
          const data = await res.json();
          if (data.success && Array.isArray(data.notifications)) {
            const readIds = new Set(JSON.parse(localStorage.getItem('9jabeacon_read_notifications') || '[]'));
            cachedNotifications = data.notifications.map(item => ({
              ...item,
              unread: !readIds.has(item.id)
            }));
            updateBadge();
            renderNotifications();
            return;
          }
        }
      } catch (err) {
        console.warn('Error fetching real-time notifications:', err);
      }
      // Fallback if network offline
      renderNotifications();
    }

    function addNotification(item) {
      cachedNotifications.unshift(item);
      updateBadge();
      renderNotifications();
    }

    function updateBadge() {
      const unreadCount = cachedNotifications.filter(n => n.unread).length;
      if (badge) {
        if (unreadCount > 0) {
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    }

    function renderNotifications() {
      if (!list) return;
      if (cachedNotifications.length === 0) {
        list.innerHTML = `<div class="p-6 text-center text-slate-500 dark:text-slate-400">Loading verified updates from 9jaBeacon desk...</div>`;
        return;
      }

      list.innerHTML = cachedNotifications.map(item => `
        <a href="${item.url}" class="p-3 block rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors ${item.unread ? 'bg-emerald-50/40 dark:bg-emerald-950/20' : ''}">
          <div class="flex items-start justify-between gap-2">
            <h4 class="font-bold text-slate-900 dark:text-white line-clamp-1">${item.title}</h4>
            <span class="text-[10px] text-slate-400 font-mono shrink-0">${item.time || 'Recent'}</span>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px] line-clamp-2 mt-0.5">${item.summary || ''}</p>
        </a>
      `).join('');
    }

    markReadBtn?.addEventListener('click', () => {
      const readIds = new Set(JSON.parse(localStorage.getItem('9jabeacon_read_notifications') || '[]'));
      cachedNotifications.forEach(n => readIds.add(n.id));
      localStorage.setItem('9jabeacon_read_notifications', JSON.stringify(Array.from(readIds)));
      cachedNotifications = cachedNotifications.map(n => ({ ...n, unread: false }));
      updateBadge();
      renderNotifications();
      window.showToast?.('All notifications marked as read');
    });

    loadDatabaseNotifications();
  }

  // Bind to DOM ready and page navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNotificationCenter);
  } else {
    initNotificationCenter();
  }

  document.addEventListener('astro:page-load', () => {
    initNotificationCenter();
  });
</script>
