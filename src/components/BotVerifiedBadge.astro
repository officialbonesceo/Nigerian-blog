---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg';
  showLabel?: boolean;
  class?: string;
}

const { size = 'sm', showLabel = false, class: className = '' } = Astro.props;

const sizeMap = {
  xs: { icon: 'w-3 h-3', text: 'text-[9px]' },
  sm: { icon: 'w-4 h-4', text: 'text-[10px]' },
  md: { icon: 'w-5 h-5', text: 'text-xs' },
  lg: { icon: 'w-6 h-6', text: 'text-sm' },
};

const current = sizeMap[size] || sizeMap.sm;
---

<span
  class={`inline-flex items-center gap-1.5 align-middle select-none group relative ${className}`}
  title="9jaBeacon editorial desk"
>
  <span class="relative inline-flex items-center justify-center shrink-0">
    <svg
      class={`${current.icon} text-[#1877F2] drop-shadow-xs transition-transform duration-200 group-hover:scale-110`}
      viewBox="0 0 24 24"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="9jaBeacon editorial desk"
    >
      <path
        d="M12 1.5l1.6 1.7 2.3-.4.8 2.2 2.3.6 0 2.4 2 1.3-.8 2.2 1.4 1.9-1.4 1.9.8 2.2-2 1.3 0 2.4-2.3.6-.8 2.2-2.3-.4L12 22.5l-1.6-1.7-2.3.4-.8-2.2-2.3-.6 0-2.4-2-1.3.8-2.2-1.4-1.9 1.4-1.9-.8-2.2 2-1.3 0-2.4 2.3-.6.8-2.2 2.3.4L12 1.5z"
      />
      <path
        d="M9.5 12.5l2 2 4.5-4.5"
        stroke="#ffffff"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  </span>

  {showLabel && (
    <span class={`font-semibold tracking-tight text-[#1877F2] dark:text-blue-400 ${current.text}`}>
      Editorial desk
    </span>
  )}

  <span
    class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 hidden group-hover:flex items-center px-2 py-1 rounded bg-slate-900 text-white text-[10px] whitespace-nowrap shadow-lg border border-slate-700 z-50 transition-opacity font-medium"
  >
    9jaBeacon editorial desk
  </span>
</span>
