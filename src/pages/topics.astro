---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';
import { NIGERIAN_TOPIC_SPHERES } from '../lib/topics-data';

export const prerender = false;

const d1 = getD1(Astro.locals);
const settings = await getSiteSettings(d1);
const rawSiteBase = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteBase = rawSiteBase === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteBase;
const canonicalUrl = `${siteBase}/topics`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': canonicalUrl,
    'name': 'Nigerian News Topic Spheres & Investigative Hubs',
    'description': 'Directory of high-priority Nigerian news topics: economy, politics, monetary policy, Dangote refinery, sports, and energy security.',
    'url': canonicalUrl,
    'publisher': {
      '@type': 'NewsMediaOrganization',
      'name': settings.site_name || '9jaBeacon',
      'url': siteBase,
      'logo': {
        '@type': 'ImageObject',
        'url': `${siteBase}/favicon.svg`,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': siteBase,
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Topic Spheres',
        'item': canonicalUrl,
      },
    ],
  },
];
---

<Layout
  title="Topic Spheres - High-Impact Nigerian News Coverage | 9jaBeacon"
  description="Explore comprehensive topic clusters covering Nigerian monetary policy, Dangote refinery, FX market, politics, security, sports, and energy updates."
  canonicalUrl={canonicalUrl}
  activeNav="topics"
>
  <!-- Schema.org Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Breadcrumb Bar -->
  <nav class="flex items-center gap-1.5 py-2 mb-3 text-xs text-slate-500 dark:text-slate-400">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span class="text-slate-300 dark:text-slate-700">/</span>
    <span class="text-slate-800 dark:text-slate-200 font-semibold">Topic Spheres</span>
  </nav>

  <!-- Hero Header -->
  <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-100 via-white to-slate-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 space-y-3 mb-6 shadow-xs">
    <div class="inline-flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">
        Editorial Topic Taxonomy
      </span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
      Nigerian News Topic Spheres
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
      Curated cluster hubs tracking Nigeria's highest-searched stories, institutional decisions, market indices, and verified national developments.
    </p>
  </div>

  <!-- Topics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {NIGERIAN_TOPIC_SPHERES.map((topic) => (
      <a
        href={`/topic/${topic.slug}`}
        class="group p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 shadow-xs hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
              {topic.categorySlug.toUpperCase()}
            </span>
            <span class="text-xs text-slate-400 group-hover:text-emerald-500 transition-colors">
              &rarr;
            </span>
          </div>

          <h2 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-1">
            {topic.name}
          </h2>

          <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
            {topic.tagline}
          </p>
        </div>

        <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500">
          <span class="font-medium">Explore Hub</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold group-hover:underline">
            View Reports &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>
</Layout>
