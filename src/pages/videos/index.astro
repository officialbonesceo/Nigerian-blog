---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { getD1, getVideoArticles, getCategories } from '../../lib/runtime-db';
import type { VideoArticle } from '../../lib/types';

const db = getD1(Astro.locals);

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || undefined;
const searchQuery = url.searchParams.get('q') || undefined;

const [videoResult, categories] = await Promise.all([
  getVideoArticles(db, {
    categoryId: selectedCategory,
    search: searchQuery,
    limit: 30,
    status: 'published'
  }),
  getCategories(db)
]);

const videos: VideoArticle[] = videoResult.videos || [];
const featuredVideo = videos.find(v => v.is_featured) || videos[0] || null;
const regularVideos = featuredVideo ? videos.filter(v => v.id !== featuredVideo.id) : videos;

function formatDuration(sec: number): string {
  if (!sec || sec <= 0) return '0:00';
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${m}:${s < 10 ? '0' : ''}${s}`;
}

function timeAgo(dateString: string): string {
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);
  if (diffInSeconds < 60) return 'Just now';
  if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)}m ago`;
  if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)}h ago`;
  if (diffInSeconds < 604800) return `${Math.floor(diffInSeconds / 86400)}d ago`;
  return date.toLocaleDateString('en-NG', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Generate VideoObject JSON-LD for rich Google Video snippets
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "9jaBeacon Video News - Verified Nigerian Broadcasts",
  "description": "Watch verified Nigerian news broadcasts, presidential briefings, economic analyses, and sports highlights on 9jaBeacon.",
  "url": "https://www.9jabeacon.name.ng/videos",
  "hasPart": videos.slice(0, 10).map((v) => ({
    "@type": "VideoObject",
    "name": v.title,
    "description": v.summary,
    "thumbnailUrl": [v.thumbnail_url],
    "uploadDate": v.published_at,
    "duration": `PT${Math.floor(v.duration_seconds / 60)}M${v.duration_seconds % 60}S`,
    "contentUrl": `https://www.9jabeacon.name.ng/videos/${v.slug}`,
    "embedUrl": v.video_url,
    "publisher": {
      "@type": "NewsMediaOrganization",
      "name": "9jaBeacon",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.9jabeacon.name.ng/favicon.svg"
      }
    }
  }))
};
---

<Layout
  title="9jaBeacon Video Hub - Verified Nigerian News & Live Broadcasts"
  description="Watch verified Nigerian video reports, presidential addresses, CBN briefings, sports highlights, and investigative broadcasts."
  activeNav="videos"
>
  <!-- Schema.org Rich Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />


  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-4 space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-200 dark:border-slate-800">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20 uppercase tracking-wider font-mono">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            Video Desk
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
            {videos.length} Verified Broadcasts
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mt-1">
          9jaBeacon <span class="text-emerald-600 dark:text-emerald-500">Video Hub</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
          Curated broadcasts, press conferences, and investigative reports from Nigeria's top verified channels.
        </p>
      </div>

      <!-- Quick Search Form -->
      <form action="/videos" method="GET" class="relative sm:w-64">
        <input
          type="text"
          name="q"
          value={searchQuery || ''}
          placeholder="Search videos..."
          class="w-full pl-9 pr-4 py-2 text-xs rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-500/40"
        />
        <svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </form>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
      <a
        href="/videos"
        class={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap cursor-pointer ${
          !selectedCategory
            ? 'bg-emerald-600 text-white shadow-sm shadow-emerald-600/30'
            : 'bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200/80 dark:border-slate-800'
        }`}
      >
        All Videos
      </a>

      {categories.map((cat) => (
        <a
          href={`/videos?category=${cat.id}`}
          class={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap cursor-pointer ${
            selectedCategory === cat.id
              ? 'bg-emerald-600 text-white shadow-sm shadow-emerald-600/30'
              : 'bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200/80 dark:border-slate-800'
          }`}
        >
          {cat.name}
        </a>
      ))}
    </div>

    <!-- Featured Broadcast Hero -->
    {featuredVideo && (
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider font-mono">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            Featured Spotlight
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
            {timeAgo(featuredVideo.published_at)}
          </span>
        </div>

        <VideoPlayer
          videoUrl={featuredVideo.video_url}
          videoType={featuredVideo.video_type}
          title={featuredVideo.title}
          thumbnailUrl={featuredVideo.thumbnail_url}
          durationSeconds={featuredVideo.duration_seconds}
        />

        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-bold border border-emerald-200/60 dark:border-emerald-800/60">
              {featuredVideo.category_name || 'Naija News'}
            </span>
            <span class="text-slate-400">•</span>
            <span class="font-semibold text-slate-700 dark:text-slate-300">
              {featuredVideo.source_name}
            </span>
            <span class="text-slate-400">•</span>
            <span class="text-slate-500 dark:text-slate-400 font-mono">
              {featuredVideo.views_count.toLocaleString()} views
            </span>
          </div>

          <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
            <a href={`/videos/${featuredVideo.slug}`}>
              {featuredVideo.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {featuredVideo.summary}
          </p>

          <div class="pt-2 flex items-center justify-between">
            <a
              href={`/videos/${featuredVideo.slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline"
            >
              Watch Full Video & Key Takeaways
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <span class="text-[11px] font-mono text-slate-400">
              HD Broadcast
            </span>
          </div>
        </div>
      </div>
    )}

    <!-- Regular Videos Grid -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">
          Latest Video Reports ({regularVideos.length})
        </h3>
      </div>

      {regularVideos.length === 0 && !featuredVideo ? (
        <div class="p-8 text-center rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <p class="text-slate-600 dark:text-slate-400 text-sm">No video reports found in this category.</p>
          <a href="/videos" class="inline-block mt-3 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">
            View All Videos
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {regularVideos.map((video) => (
            <article class="flex flex-col rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-xs hover:border-emerald-500/50 hover:shadow-md transition-all group">
              <!-- Thumbnail with Duration Badge -->
              <a href={`/videos/${video.slug}`} class="relative aspect-video w-full overflow-hidden bg-slate-950 block">
                <img
                  src={video.thumbnail_url}
                  alt={video.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>

                <!-- Play Icon Badge -->
                <div class="absolute inset-0 flex items-center justify-center opacity-90 group-hover:opacity-100 transition-opacity">
                  <div class="w-10 h-10 rounded-xl bg-emerald-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>

                <!-- Duration Pill -->
                {video.duration_seconds > 0 && (
                  <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-md bg-black/80 text-white text-[10px] font-mono font-bold backdrop-blur-xs">
                    {formatDuration(video.duration_seconds)}
                  </span>
                )}

                <!-- Source Tag -->
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md bg-slate-900/80 text-white text-[10px] font-bold backdrop-blur-xs flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                  {video.source_name}
                </span>
              </a>

              <!-- Card Details -->
              <div class="p-3.5 flex-1 flex flex-col justify-between space-y-2">
                <div>
                  <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                    <span class="font-bold text-emerald-600 dark:text-emerald-400">
                      {video.category_name || 'News'}
                    </span>
                    <span>•</span>
                    <span>{timeAgo(video.published_at)}</span>
                  </div>

                  <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 line-clamp-2 mt-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                    <a href={`/videos/${video.slug}`}>
                      {video.title}
                    </a>
                  </h4>

                  <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                    {video.summary}
                  </p>
                </div>

                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                  <span class="font-mono">
                    {video.views_count.toLocaleString()} views
                  </span>
                  <a
                    href={`/videos/${video.slug}`}
                    class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-0.5"
                  >
                    Watch Now
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
