---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import ShareBar from '../../components/ShareBar.astro';
import { getD1, getArticleBySlug, getRelatedArticles, getSiteSettings } from '../../lib/runtime-db';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../../lib/fallback-image';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const d1 = getD1(Astro.locals);
const article = await getArticleBySlug(d1, slug);
if (!article) return Astro.redirect('/404');

const [relatedArticles, siteSettings] = await Promise.all([
  getRelatedArticles(d1, article.id, article.category_id, 4),
  getSiteSettings(d1)
]);

const siteUrl = (siteSettings.site_url || 'https://9jabeacon.pages.dev').replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}/news/${article.slug}`;
const imageUrl = article.image_url || DEFAULT_FALLBACK_IMAGE_URL;

// Safe date parsing
const rawPub = article.published_at ? new Date(article.published_at) : new Date();
const publishedDate = !isNaN(rawPub.getTime())
  ? rawPub.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Today';

const rawUp = article.updated_at ? new Date(article.updated_at) : null;
const updatedDate = rawUp && !isNaN(rawUp.getTime())
  ? rawUp.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : null;

const isUpdated = Boolean(updatedDate && article.updated_at !== article.published_at);

// Structured Data (Schema.org NewsArticle)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "description": article.summary || article.title,
  "image": [imageUrl],
  "datePublished": article.published_at,
  "dateModified": article.updated_at || article.published_at,
  "author": [{
    "@type": "Person",
    "name": article.author_name || "9jaBeacon Editorial Team"
  }],
  "publisher": {
    "@type": "Organization",
    "name": siteSettings.site_name || "9jaBeacon",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<Layout
  title={`${article.title} - 9jaBeacon`}
  description={article.summary || article.title}
  image={imageUrl}
  canonicalUrl={canonicalUrl}
  article={{
    publishedTime: article.published_at,
    modifiedTime: article.updated_at,
    author: article.author_name,
    section: article.category_name,
  }}
  activeNav="home"
>
  <!-- NewsArticle JSON-LD Script -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Top Action & Navigation Bar -->
  <nav class="flex items-center justify-between py-2.5 mb-4 border-b border-slate-200/70 dark:border-slate-800/60">
    <a href="/" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-emerald-400 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Back to Headlines</span>
    </a>

    <!-- Reader Controls & Actions -->
    <div class="flex items-center gap-1.5">
      <div class="hidden sm:flex items-center gap-1 bg-slate-900 border border-slate-800 rounded-lg p-0.5 text-xs text-slate-400">
        <button id="btn-font-serif" class="px-2 py-0.5 rounded hover:text-white transition-colors" title="Serif font">Serif</button>
        <button id="btn-font-sans" class="px-2 py-0.5 rounded font-bold text-white bg-slate-800 transition-colors" title="Sans-serif font">Sans</button>
        <span class="w-px h-3 bg-slate-700"></span>
        <button id="btn-size-dec" class="px-1.5 py-0.5 rounded hover:text-white" title="Decrease font size">A-</button>
        <button id="btn-size-inc" class="px-1.5 py-0.5 rounded hover:text-white" title="Increase font size">A+</button>
      </div>
      <BookmarkButton article={article} />
    </div>
  </nav>

  <!-- Main Article Body -->
  <article id="reading-container" class="reader-sans reader-size-md space-y-6">
    <!-- Category & Status Badge -->
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={`/category/${article.category_slug || 'naija-news'}`}
        class="px-3 py-1 rounded-full bg-emerald-600/10 text-emerald-400 border border-emerald-500/20 text-xs font-black uppercase tracking-wider font-mono hover:bg-emerald-600/20 transition-colors"
      >
        {article.category_name || 'General News'}
      </a>
      {article.is_breaking === 1 && (
        <span class="px-2.5 py-0.5 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider animate-pulse">
          Breaking News
        </span>
      )}
      {article.is_top_story === 1 && (
        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] font-black uppercase tracking-wider">
          Top Story
        </span>
      )}
    </div>

    <!-- Title -->
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight tracking-tight">
      {article.title}
    </h1>

    <!-- Author & Published Metadata Card -->
    <div class="py-3 px-4 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <img
          src={article.author_avatar || '/editorial/naija-news-team.svg'}
          alt={article.author_name || '9jaBeacon Desk'}
          class="w-10 h-10 rounded-full object-cover bg-slate-800 border border-slate-700"
          loading="lazy"
        />
        <div>
          <div class="text-sm font-bold text-white">{article.author_name || '9jaBeacon Editorial Team'}</div>
          <div class="text-xs text-slate-400">{article.author_role || 'Editorial Desk'}</div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400">
        <span>Published {publishedDate}</span>
        {isUpdated && <span>· Updated {updatedDate}</span>}
        <span>· {article.reading_time_minutes || 4} min read</span>
        <span>· {(article.views_count ?? 0).toLocaleString()} reads</span>
      </div>
    </div>

    <!-- Hero Image & Caption -->
    <figure class="rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 shadow-lg">
      <img
        src={imageUrl}
        alt={article.title}
        class="w-full aspect-[16/9] object-cover"
        loading="eager"
        decoding="async"
      />
      {(article.image_caption || article.image_credit) && (
        <figcaption class="p-3 text-xs text-slate-400 bg-slate-900/90 border-t border-slate-800/80">
          {article.image_caption || article.title}
          {article.image_credit && <span class="text-slate-500"> · Photo / Wire: {article.image_credit}</span>}
        </figcaption>
      )}
    </figure>

    <!-- Top Shareable URL Bar -->
    <ShareBar title={article.title} url={canonicalUrl} summary={article.summary} />

    <!-- Editorial Executive Summary -->
    {article.summary && (
      <aside class="p-4 sm:p-5 rounded-2xl bg-emerald-950/30 border border-emerald-500/20 text-sm sm:text-base text-emerald-100 font-medium leading-relaxed">
        <div class="text-xs font-black uppercase text-emerald-400 tracking-wider mb-1 font-mono">Executive Summary</div>
        {article.summary}
      </aside>
    )}

    <!-- Story Content Body -->
    <div
      id="article-content-body"
      class="prose prose-invert prose-emerald max-w-none text-base sm:text-lg leading-relaxed space-y-4 pt-2"
      set:html={article.content || '<p>Report details are being finalized by the 9jaBeacon Editorial Desk.</p>'}
    />

    <!-- Original Attribution Link -->
    {article.source_original_url && (
      <div class="p-3.5 rounded-xl bg-slate-900/40 border border-slate-800/80 text-xs text-slate-400 flex items-center justify-between gap-3">
        <span>Verified News Wire Attribution: <strong class="text-slate-200">{article.source_name || 'Wire Partner'}</strong></span>
        <a
          href={article.source_original_url}
          rel="nofollow noopener noreferrer"
          target="_blank"
          class="text-emerald-400 hover:text-emerald-300 font-bold shrink-0 inline-flex items-center gap-1"
        >
          <span>Original Source</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}

    <!-- Bottom Share Bar -->
    <div class="pt-4">
      <ShareBar title={article.title} url={canonicalUrl} summary={article.summary} />
    </div>
  </article>

  <!-- Related Stories -->
  {relatedArticles.length > 0 && (
    <section class="mt-12 pt-8 border-t border-slate-800/80 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-black text-white tracking-tight flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Related Stories
        </h2>
        <a href={`/category/${article.category_slug || 'naija-news'}`} class="text-xs font-bold text-emerald-400 hover:underline">
          More in {article.category_name || 'News'} →
        </a>
      </div>
      <div class="space-y-3">
        {relatedArticles.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  // Dynamic font and size toggles for reader mode
  const container = document.getElementById('reading-container');
  const btnSerif = document.getElementById('btn-font-serif');
  const btnSans = document.getElementById('btn-font-sans');
  const btnDec = document.getElementById('btn-size-dec');
  const btnInc = document.getElementById('btn-size-inc');

  if (container) {
    btnSerif?.addEventListener('click', () => {
      container.classList.remove('reader-sans');
      container.classList.add('reader-serif');
      btnSerif.classList.add('font-bold', 'text-white', 'bg-slate-800');
      btnSans?.classList.remove('font-bold', 'text-white', 'bg-slate-800');
    });

    btnSans?.addEventListener('click', () => {
      container.classList.remove('reader-serif');
      container.classList.add('reader-sans');
      btnSans.classList.add('font-bold', 'text-white', 'bg-slate-800');
      btnSerif?.classList.remove('font-bold', 'text-white', 'bg-slate-800');
    });

    let currentSize = 1; // 0: sm, 1: md, 2: lg
    const sizeClasses = ['reader-size-sm', 'reader-size-md', 'reader-size-lg'];

    btnDec?.addEventListener('click', () => {
      if (currentSize > 0) {
        container.classList.remove(sizeClasses[currentSize]);
        currentSize--;
        container.classList.add(sizeClasses[currentSize]);
      }
    });

    btnInc?.addEventListener('click', () => {
      if (currentSize < sizeClasses.length - 1) {
        container.classList.remove(sizeClasses[currentSize]);
        currentSize++;
        container.classList.add(sizeClasses[currentSize]);
      }
    });
  }
</script>
