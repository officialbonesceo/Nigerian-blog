---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import { getD1, getArticleBySlug, getRelatedArticles, getSiteSettings } from '../../lib/runtime-db';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../../lib/fallback-image';
export const prerender = false;
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
const d1 = getD1(Astro.locals);
const article = await getArticleBySlug(d1, slug);
if (!article) return Astro.redirect('/404');
const [relatedArticles, siteSettings] = await Promise.all([getRelatedArticles(d1, article.id, article.category_id, 3), getSiteSettings(d1)]);
const siteUrl = (siteSettings.site_url || 'https://9jabeacon.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/news/${article.slug}`;
const publishedDate = new Date(article.published_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
const updatedDate = new Date(article.updated_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
const isUpdated = !!article.updated_at && article.updated_at !== article.published_at;
---
<Layout title={`${article.title} - 9jaBeacon`} description={article.summary} image={article.image_url || DEFAULT_FALLBACK_IMAGE_URL} canonicalUrl={canonicalUrl} article={{publishedTime:article.published_at,modifiedTime:article.updated_at,author:article.author_name,section:article.category_name}} activeNav="home">
  <nav class="flex items-center justify-between py-2.5 mb-3 border-b border-slate-200/70 dark:border-slate-800/60"><a href="/" class="text-xs font-bold text-slate-500 hover:text-emerald-600">← All Headlines</a><div class="flex items-center gap-2"><button id="btn-font-serif" class="px-2 py-1 rounded bg-slate-100 text-xs font-bold">Serif</button><button id="btn-font-sans" class="px-2 py-1 rounded bg-slate-100 text-xs">Sans</button><button id="btn-size-dec" class="px-2 py-1 rounded bg-slate-100 text-xs">A-</button><button id="btn-size-inc" class="px-2 py-1 rounded bg-slate-100 text-xs">A+</button><button id="btn-native-share" data-title={article.title} data-url={canonicalUrl} class="p-1.5 rounded bg-slate-100 text-xs">Share</button><BookmarkButton article={article} /></div></nav>
  <article id="reading-container" class="reader-serif reader-size-md space-y-5"><div class="flex flex-wrap items-center gap-2"><a href={`/category/${article.category_slug || 'naija-news'}`} class="px-2.5 py-1 rounded-md bg-emerald-600/10 text-emerald-700 text-xs font-black uppercase">{article.category_name || 'News'}</a>{article.is_breaking === 1 && <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-black">BREAKING</span>}</div><h1 class="text-2xl sm:text-3xl lg:text-[2.6rem] font-black text-slate-900 dark:text-white leading-tight tracking-tight">{article.title}</h1><div class="py-3 px-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><img src={article.author_avatar || '/editorial/naija-news-team.svg'} alt={article.author_name || '9jaBeacon Editorial Team'} class="w-10 h-10 rounded-full object-cover"/><div><div class="text-sm font-bold text-slate-900 dark:text-white">{article.author_name || '9jaBeacon Editorial Team'}</div><div class="text-xs text-slate-500">{article.author_role || 'Editorial Desk'}</div></div></div><div class="flex flex-wrap gap-3 text-xs text-slate-500"><span>Published {publishedDate}</span>{isUpdated && <span>Updated {updatedDate}</span>}<span>{article.reading_time_minutes || 4} min read</span></div></div><figure class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-900"><img src={article.image_url || DEFAULT_FALLBACK_IMAGE_URL} alt={article.title} class="w-full aspect-[16/9] object-cover" loading="eager"/>{(article.image_caption || article.image_credit) && <figcaption class="p-3 text-xs text-slate-500">{article.image_caption || article.title}{article.image_credit && ` · Credit: ${article.image_credit}`}</figcaption>}</figure>{article.summary && <aside class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-sm font-medium">{article.summary}</aside>}<div class="prose prose-slate dark:prose-invert max-w-none text-base leading-8" set:html={article.content || '<p>No article content available.</p>'}></div>{article.source_original_url && <div class="pt-4 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-500">Source reference: <a href={article.source_original_url} rel="nofollow noopener" target="_blank" class="text-emerald-600">{article.source_name || 'Original source'}</a></div>}</article>
  {relatedArticles.length > 0 && <section class="mt-10 space-y-3"><h2 class="text-lg font-black text-slate-900 dark:text-white">Related Stories</h2><div class="space-y-2.5">{relatedArticles.map((art) => <ArticleCard article={art} />)}</div></section>}
</Layout>
