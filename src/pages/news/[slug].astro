---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import ShareBar from '../../components/ShareBar.astro';
import AdSlot from '../../components/AdSlot.astro';
import ArticleComments from '../../components/ArticleComments.astro';
import ArticleAudioReader from '../../components/ArticleAudioReader.astro';
import { getD1, getArticleBySlug, getRelatedArticles, getSiteSettings } from '../../lib/runtime-db';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../../lib/fallback-image';
import { cleanAndFormatArticleHtml, partitionArticleForAds } from '../../lib/content-formatter';
import { readingMinutes } from '../../lib/editorial-pipeline';
import { detectTopicsForArticle } from '../../lib/topics-data';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const d1 = getD1(Astro.locals);
const article = await getArticleBySlug(d1, slug);
if (!article) return Astro.redirect('/404');

// 301 Permanent Redirect if accessed via legacy/un-normalized slug to preserve SEO authority
if (article.slug && article.slug !== slug) {
  return Astro.redirect(`/news/${article.slug}`, 301);
}

const [relatedArticles, siteSettings] = await Promise.all([
  getRelatedArticles(d1, article.id, article.category_id, 5),
  getSiteSettings(d1)
]);

const rawSiteUrl = (siteSettings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteUrl = rawSiteUrl === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteUrl;
const canonicalUrl = `${siteUrl}/news/${article.slug}`;
const imageUrl = article.image_url || DEFAULT_FALLBACK_IMAGE_URL;

// Safe date parsing
const rawPub = article.published_at ? new Date(article.published_at) : new Date();
const publishedDate = !isNaN(rawPub.getTime())
  ? rawPub.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Today';

const rawUp = article.updated_at ? new Date(article.updated_at) : null;
const updatedDate = rawUp && !isNaN(rawUp.getTime())
  ? rawUp.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : null;

const isUpdated = Boolean(updatedDate && article.updated_at !== article.published_at);

// Clean and sanitize content (removes raw markdown asterisks, ensures bold/italics and valid HTML structure)
const formattedArticleContent = cleanAndFormatArticleHtml(article.content);

// Partition content for well-spaced ad distribution in-between long news
const articleParts = partitionArticleForAds(formattedArticleContent);

const plainTextArticle = formattedArticleContent.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const estimatedWordCount = plainTextArticle ? plainTextArticle.split(/\s+/).filter(Boolean).length : 300;
const displayReadingTime = article.reading_time_minutes && article.reading_time_minutes > 0
  ? article.reading_time_minutes
  : readingMinutes(estimatedWordCount);

const matchedTopics = detectTopicsForArticle(article.title, formattedArticleContent, article.summary || '');
const articleKeywords = Array.from(new Set([
  ...matchedTopics.map((t) => t.name),
  article.category_name,
  'Nigeria news',
  'breaking news',
  'verified reporting'
])).filter(Boolean).join(', ');

// Structured Data (Schema.org NewsArticle & BreadcrumbList for rich SERP snippets)
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": article.title,
    "description": article.summary || article.title,
    "image": [imageUrl],
    "datePublished": article.published_at,
    "dateModified": article.updated_at || article.published_at,
    "inLanguage": "en-NG",
    "articleSection": article.category_name || "Naija News",
    "wordCount": estimatedWordCount,
    "isAccessibleForFree": "True",
    "keywords": articleKeywords,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".article-headline", ".article-summary"]
    },
    "author": [{
      "@type": "Person",
      "name": article.author_name || "9jaBeacon Editorial Team",
      "jobTitle": article.author_role || "Investigative Reporter"
    }],
    "publisher": {
      "@type": "NewsMediaOrganization",
      "name": siteSettings.site_name || "9jaBeacon",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/favicon.svg`
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": article.category_name || "News",
        "item": `${siteUrl}/category/${article.category_slug === 'money-hustle' ? 'business' : (article.category_slug || 'naija-news')}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": article.title,
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={`${article.title} - 9jaBeacon`}
  description={article.summary || article.title}
  image={imageUrl}
  canonicalUrl={canonicalUrl}
  article={{
    publishedTime: article.published_at,
    modifiedTime: article.updated_at,
    author: article.author_name,
    section: article.category_name,
  }}
  activeNav="home"
>
  <!-- NewsArticle JSON-LD Script -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Top Action & Navigation Bar -->
  <nav class="flex flex-wrap items-center justify-between gap-2 py-2.5 mb-4 border-b border-slate-200 dark:border-slate-800 text-xs">
    <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400 overflow-x-auto whitespace-nowrap max-w-full">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <a href={`/category/${article.category_slug === 'money-hustle' ? 'business' : (article.category_slug || 'naija-news')}`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
        {article.category_name === 'Money Hustle' ? 'Business' : (article.category_name || 'News')}
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-[200px] sm:max-w-[340px]">{article.title}</span>
    </div>

    <!-- Reader Controls & Actions -->
    <div class="flex items-center gap-1.5">
      <div class="hidden sm:flex items-center gap-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-0.5 text-xs text-slate-600 dark:text-slate-400">
        <button id="btn-font-serif" class="px-2 py-0.5 rounded hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer" title="Serif font">Serif</button>
        <button id="btn-font-sans" class="px-2 py-0.5 rounded font-bold text-slate-900 dark:text-white bg-white dark:bg-slate-800 shadow-xs transition-colors cursor-pointer" title="Sans-serif font">Sans</button>
        <span class="w-px h-3 bg-slate-300 dark:bg-slate-700"></span>
        <button id="btn-size-dec" class="px-1.5 py-0.5 rounded hover:text-slate-900 dark:hover:text-white cursor-pointer" title="Decrease font size">A-</button>
        <button id="btn-size-inc" class="px-1.5 py-0.5 rounded hover:text-slate-900 dark:hover:text-white cursor-pointer" title="Increase font size">A+</button>
      </div>
      <button
        id="quick-audio-listen-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25 text-xs font-bold hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-all cursor-pointer shadow-2xs active:scale-95 focus:outline-hidden"
        title="Listen to this article"
      >
        <svg class="quick-play-icon w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
        <svg class="quick-pause-icon w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
        <span class="quick-play-text">Listen</span>
      </button>
      <BookmarkButton article={article} />
    </div>
  </nav>

  <!-- Main Article Body -->
  <article 
    id="reading-container" 
    data-article-id={article.id}
    data-article-slug={article.slug}
    data-article-title={article.title}
    data-article-category={article.category_name}
    data-article-image={imageUrl}
    class="reader-sans reader-size-md space-y-6 max-w-full min-w-0 overflow-hidden"
  >
    <!-- Category & Status Badge -->
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={`/category/${article.category_slug === 'money-hustle' ? 'business' : (article.category_slug || 'naija-news')}`}
        class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-black uppercase tracking-wider font-mono hover:bg-emerald-500/20 transition-colors"
      >
        {article.category_name === 'Money Hustle' ? 'Business' : (article.category_name || 'General News')}
      </a>
      {article.is_breaking === 1 && (
        <span class="px-2.5 py-0.5 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider animate-pulse">
          Breaking News
        </span>
      )}
      {article.is_top_story === 1 && (
        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30 text-[10px] font-black uppercase tracking-wider">
          Top Story
        </span>
      )}
    </div>

    <!-- Title -->
    <h1 class="article-headline text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight break-words">
      {article.title}
    </h1>

    <!-- Author & Published Metadata Card -->
    <div class="py-3 px-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm border border-emerald-500/20 shrink-0">
          9B
        </div>
        <div>
          <div class="text-sm font-bold text-slate-900 dark:text-white">{article.author_name || '9jaBeacon Editorial Team'}</div>
          <div class="text-xs text-slate-500 dark:text-slate-400">{article.author_role || 'Editorial Desk'}</div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span>Published {publishedDate}</span>
        {isUpdated && <span>· Updated {updatedDate}</span>}
        <span>· {displayReadingTime} min read</span>
        {Boolean(article.views_count && article.views_count > 0) && (
          <span>· {article.views_count.toLocaleString()} verified reads</span>
        )}
      </div>
    </div>

    <!-- Hero Image & Caption -->
    <figure class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md">
      <img
        src={imageUrl}
        alt={article.title}
        class="w-full aspect-[16/9] object-cover"
        loading="eager"
        decoding="async"
      />
      {(article.image_caption || article.image_credit) && (
        <figcaption class="p-3 text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-200 dark:border-slate-800/80">
          {article.image_caption || article.title}
          {article.image_credit && <span class="text-slate-400 dark:text-slate-500"> · Photo / Wire: {article.image_credit}</span>}
        </figcaption>
      )}
    </figure>

    <!-- Top Shareable URL Bar -->
    <ShareBar title={article.title} url={canonicalUrl} summary={article.summary} />

    <!-- Editorial Executive Summary -->
    {article.summary && (
      <aside class="article-summary p-4 sm:p-5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-500/20 text-sm sm:text-base text-emerald-900 dark:text-emerald-100 font-medium leading-relaxed break-words">
        <div class="text-xs font-black uppercase text-emerald-600 dark:text-emerald-400 tracking-wider mb-1 font-mono">Executive Summary</div>
        {article.summary}
      </aside>
    )}

    <!-- Top Horizontal Ad Banner (Eager loading to eliminate delayed display) -->
    <AdSlot format="banner-320x50" loading="eager" />

    <!-- Story Content Body (Sanitized, Semantic Paragraphs, with In-Between Native Ads) -->
    <div class="space-y-6 max-w-full min-w-0">
      <div
        id="article-content-body-lead"
        class="prose prose-slate dark:prose-invert prose-emerald max-w-none text-base sm:text-lg leading-relaxed space-y-4 pt-2 text-slate-800 dark:text-slate-200 break-words [overflow-wrap:anywhere]"
        set:html={articleParts.lead}
      />

      <!-- Contextual Curiosity Smartlink Callout (High CTR, policy compliant) -->
      <AdSlot format="read-also" />

      {articleParts.middle1 && (
        <>
          <!-- Banner 2 of 3: Primary Mid-Article Native 300x250 Banner -->
          <AdSlot format="banner-300x250" />

          <div
            id="article-content-body-middle1"
            class="prose prose-slate dark:prose-invert prose-emerald max-w-none text-base sm:text-lg leading-relaxed space-y-4 text-slate-800 dark:text-slate-200 break-words [overflow-wrap:anywhere]"
            set:html={articleParts.middle1}
          />
        </>
      )}

      {articleParts.middle2 && (
        <>
          <!-- High-Converting Native Smartlink Editorial Dispatch (Native card, not a banner) -->
          <AdSlot format="smartlink" />

          <div
            id="article-content-body-middle2"
            class="prose prose-slate dark:prose-invert prose-emerald max-w-none text-base sm:text-lg leading-relaxed space-y-4 text-slate-800 dark:text-slate-200 break-words [overflow-wrap:anywhere]"
            set:html={articleParts.middle2}
          />
        </>
      )}

      {articleParts.middle3 && (
        <div
          id="article-content-body-middle3"
          class="prose prose-slate dark:prose-invert prose-emerald max-w-none text-base sm:text-lg leading-relaxed space-y-4 text-slate-800 dark:text-slate-200 break-words [overflow-wrap:anywhere]"
          set:html={articleParts.middle3}
        />
      )}
    </div>

    <!-- Client-Side Audio Reader with Presenter Sprite (Under Article Content) -->
    <ArticleAudioReader 
      title={article.title} 
      summary={article.summary} 
      readingTimeMinutes={displayReadingTime} 
      categoryId={article.category_id}
    />

    <!-- Original Attribution Link -->
    {article.source_original_url && (
      <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 text-xs text-slate-600 dark:text-slate-400 flex items-center justify-between gap-3">
        <span>Verified News Wire Attribution: <strong class="text-slate-900 dark:text-slate-200">{article.source_name || 'Wire Partner'}</strong></span>
        <a
          href={article.source_original_url}
          rel="nofollow noopener noreferrer"
          target="_blank"
          class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 font-bold shrink-0 inline-flex items-center gap-1"
        >
          <span>Original Source</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}

    <!-- Related Topic Spheres & Entity Clusters -->
    {matchedTopics.length > 0 && (
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 space-y-2.5 not-prose">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">
            Topic Spheres & Coverage Hubs
          </span>
          <a href="/topics" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
            All Spheres &rarr;
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          {matchedTopics.map((topic) => (
            <a
              href={`/topic/${topic.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/40 transition-all shadow-2xs"
            >
              <span class="w-2 h-2 rounded-full" style={`background-color: ${topic.color || '#008751'}`}></span>
              <span>#{topic.shortName}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom Share Bar -->
    <div class="pt-4">
      <ShareBar title={article.title} url={canonicalUrl} summary={article.summary} />
    </div>
  </article>

  <!-- Contextual FAQ & Fact-Check Card (Google FAQPage Rich Snippet) -->
  <section class="my-8 p-5 sm:p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 shadow-xs not-prose">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': `What are the core verified facts of: ${article.title}?`,
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': article.summary
          }
        },
        {
          '@type': 'Question',
          'name': 'How is this report verified?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': `Our newsroom corroborates facts through official institutional communications, regulatory filings, primary sources, and verified news desk partners.`
          }
        }
      ]
    })} />

    <div class="flex items-center gap-2 mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 font-mono">
        Story Fact-Check & Key Insights FAQ
      </h3>
    </div>
    
    <div class="space-y-2.5">
      <details class="group rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5">
        <summary class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 cursor-pointer list-none flex items-center justify-between gap-2">
          <span>What are the key verified facts in this dispatch?</span>
          <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 pt-2 border-t border-slate-100 dark:border-slate-800 leading-relaxed">
          {article.summary}
        </p>
      </details>

      <details class="group rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5">
        <summary class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 cursor-pointer list-none flex items-center justify-between gap-2">
          <span>How is this report verified?</span>
          <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 pt-2 border-t border-slate-100 dark:border-slate-800 leading-relaxed">
          Our newsroom corroborates facts through official institutional communications, regulatory filings, primary sources, and verified news desk partners.
        </p>
      </details>
    </div>
  </section>

  <!-- Native Ad Banner (Under Article / Above Community Perspectives) -->
  <AdSlot format="banner-300x250" />

  <!-- Trending Opportunities Grid (Smartlink High-Intent Grid) -->
  <AdSlot format="opportunities-grid" />

  <!-- Reader Opinions & Perspectives -->
  <ArticleComments articleSlug={article.slug} articleTitle={article.title} />

  <!-- Recommended News Section (5 items + See More button) -->
  {relatedArticles.length > 0 && (
    <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-5">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            Recommended News
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Top stories curated for Nigerian readers</p>
        </div>
        <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 rounded-lg border border-emerald-200 dark:border-emerald-800/40">
          5 Stories
        </span>
      </div>

      <div class="space-y-3">
        {relatedArticles.slice(0, 5).map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>

      <!-- See More Button -->
      <div class="pt-2 text-center">
        <a
          href={`/category/${article.category_slug === 'money-hustle' ? 'business' : (article.category_slug || 'naija-news')}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white text-sm font-bold transition-all shadow-xs hover:shadow-sm active:scale-98 w-full sm:w-auto cursor-pointer"
        >
          <span>See More in {article.category_name === 'Money Hustle' ? 'Business' : (article.category_name || 'News')}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </section>
  )}
</Layout>

<script>
  import { recordArticleView } from '../../lib/firebase';

  function initSlugPage() {
    const el = document.getElementById('reading-container');
    if (!el) return;

    const articleSlug = el.getAttribute('data-article-slug') || '';
    const articleTitle = el.getAttribute('data-article-title') || '';
    const articleCategory = el.getAttribute('data-article-category') || '';
    const articleImage = el.getAttribute('data-article-image') || '';
    const articleId = el.getAttribute('data-article-id') || '';

    // Track genuine article read once per session in both analytics and Firestore Weekly Analytics
    try {
      if (articleSlug) {
        const readKey = 'art_read_' + articleSlug;
        if (!sessionStorage.getItem(readKey)) {
          sessionStorage.setItem(readKey, '1');

          // 1. Record authentic weekly view in Firebase Firestore
          recordArticleView({
            slug: articleSlug,
            title: articleTitle,
            category: articleCategory,
            imageUrl: articleImage,
          }).catch((err) => {
            console.warn('[Firestore] View tracking skipped:', err);
          });

          // 2. Track internal analytics beacon
          let sid = sessionStorage.getItem('9ja_sess_id');
          if (!sid) {
            sid = 'sess_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
            sessionStorage.setItem('9ja_sess_id', sid);
          }
          const payload = JSON.stringify({
            session_id: sid,
            page_path: window.location.pathname,
            article_id: articleId,
            referrer: document.referrer || null,
            device_type: window.innerWidth < 768 ? 'mobile' : 'desktop',
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/analytics/track', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/analytics/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
            }).catch(() => {});
          }
        }
      }
    } catch (e) {}

    // Ensure real canonical URL and locator sync using window.location
    if (typeof window !== 'undefined' && window.location) {
      const currentHref = window.location.href;
      const urlDisplays = document.querySelectorAll('#canonical-url-display');
      urlDisplays.forEach((disp) => {
        if (disp && currentHref) disp.textContent = currentHref;
      });
      const copyBtns = document.querySelectorAll('#btn-copy-canonical-url');
      copyBtns.forEach((btn) => {
        if (btn && currentHref) btn.setAttribute('data-url', currentHref);
      });
      const shareBtns = document.querySelectorAll('#btn-native-web-share');
      shareBtns.forEach((btn) => {
        if (btn && currentHref) btn.setAttribute('data-url', currentHref);
      });
    }

    // Dynamic font and size toggles for reader mode
    const container = document.getElementById('reading-container');
    const btnSerif = document.getElementById('btn-font-serif');
    const btnSans = document.getElementById('btn-font-sans');
    const btnDec = document.getElementById('btn-size-dec');
    const btnInc = document.getElementById('btn-size-inc');

    if (container && !container.dataset.readerBound) {
      container.dataset.readerBound = 'true';

      btnSerif?.addEventListener('click', () => {
        container.classList.remove('reader-sans');
        container.classList.add('reader-serif');
        btnSerif.classList.add('font-bold', 'text-slate-900', 'dark:text-white', 'bg-white', 'dark:bg-slate-800');
        btnSans?.classList.remove('font-bold', 'text-slate-900', 'dark:text-white', 'bg-white', 'dark:bg-slate-800');
      });

      btnSans?.addEventListener('click', () => {
        container.classList.remove('reader-serif');
        container.classList.add('reader-sans');
        btnSans.classList.add('font-bold', 'text-slate-900', 'dark:text-white', 'bg-white', 'dark:bg-slate-800');
        btnSerif?.classList.remove('font-bold', 'text-slate-900', 'dark:text-white', 'bg-white', 'dark:bg-slate-800');
      });

      let currentSize = 1; // 0: sm, 1: md, 2: lg
      const sizeClasses = ['reader-size-sm', 'reader-size-md', 'reader-size-lg'];

      btnDec?.addEventListener('click', () => {
        if (currentSize > 0) {
          container.classList.remove(sizeClasses[currentSize]);
          currentSize--;
          container.classList.add(sizeClasses[currentSize]);
        }
      });

      btnInc?.addEventListener('click', () => {
        if (currentSize < sizeClasses.length - 1) {
          container.classList.remove(sizeClasses[currentSize]);
          currentSize++;
          container.classList.add(sizeClasses[currentSize]);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlugPage);
  } else {
    initSlugPage();
  }
  document.addEventListener('astro:page-load', initSlugPage);
</script>
