---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import { getArticleBySlug, getRelatedArticles, getArticles, getSiteSettings } from '../../lib/db';
import { DEFAULT_FALLBACK_IMAGE_URL } from '../../lib/fallback-image';

export async function getStaticPaths() {
  const articles = getArticles({ limit: 1000 });
  return articles.map((art) => ({
    params: { slug: art.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const article = getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

const siteSettings = getSiteSettings();
const siteUrl = (siteSettings.site_url || 'https://9jabeacon.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/news/${article.slug}`;

const relatedArticles = getRelatedArticles(article.id, article.category_id, 3);

// Format date strings
const publishedDate = new Date(article.published_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const updatedDate = new Date(article.updated_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const isUpdated = article.updated_at && article.updated_at !== article.published_at;

// Format content to dynamically enrich subheadings into rhyming, rhythmic power headers
let formattedContent = article.content || '';
formattedContent = formattedContent
  .replace(/<h3>\s*What Happened\s*<\/h3>/gi, '<div class="editorial-section-tag tag-scoop"><span class="tag-icon">⚡</span><h3>The Scoop</h3><span class="tag-subtitle">The Breaking Event</span></div>')
  .replace(/<h3>\s*The Scoop\s*<\/h3>/gi, '<div class="editorial-section-tag tag-scoop"><span class="tag-icon">⚡</span><h3>The Scoop</h3><span class="tag-subtitle">The Breaking Event</span></div>')
  .replace(/<h3>\s*Why It Matters\s*<\/h3>/gi, '<div class="editorial-section-tag tag-stakes"><span class="tag-icon">🎯</span><h3>The Stakes</h3><span class="tag-subtitle">Why It Matters & Public Impact</span></div>')
  .replace(/<h3>\s*The Stakes\s*<\/h3>/gi, '<div class="editorial-section-tag tag-stakes"><span class="tag-icon">🎯</span><h3>The Stakes</h3><span class="tag-subtitle">Why It Matters & Public Impact</span></div>')
  .replace(/<h3>\s*What We Know\s*<\/h3>/gi, '<div class="editorial-section-tag tag-stats"><span class="tag-icon">📊</span><h3>The Stats</h3><span class="tag-subtitle">Verified Data & Timeline</span></div>')
  .replace(/<h3>\s*The Stats\s*<\/h3>/gi, '<div class="editorial-section-tag tag-stats"><span class="tag-icon">📊</span><h3>The Stats</h3><span class="tag-subtitle">Verified Data & Timeline</span></div>');
---

<Layout
  title={`${article.title} - 9jaBeacon`}
  description={article.summary}
  image={article.image_url}
  canonicalUrl={canonicalUrl}
  article={{
    publishedTime: article.published_at,
    modifiedTime: article.updated_at,
    author: article.author_name,
    section: article.category_name,
  }}
  activeNav="home"
>
  <!-- 1. NAVIGATION & TOP UTILITY BAR -->
  <nav class="flex items-center justify-between py-2.5 mb-2 border-b border-slate-200/70 dark:border-slate-800/60">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group font-sans"
    >
      <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      All Headlines
    </a>

    <!-- Reader Customization & Action Controls -->
    <div class="flex items-center gap-1.5">
      <!-- Font Family Switcher -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-900 rounded-lg p-0.5 border border-slate-200 dark:border-slate-800 text-xs">
        <button
          id="btn-font-serif"
          class="px-2 py-1 rounded font-editorial font-bold text-xs transition-colors bg-white dark:bg-slate-800 text-emerald-700 dark:text-emerald-400 shadow-xs cursor-pointer"
          title="Switch to Editorial Serif"
        >
          Serif
        </button>
        <button
          id="btn-font-sans"
          class="px-2 py-1 rounded font-sans font-medium text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
          title="Switch to Clean Sans"
        >
          Sans
        </button>
      </div>

      <!-- Font Size Adjusters -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-900 rounded-lg p-0.5 border border-slate-200 dark:border-slate-800 text-xs">
        <button
          id="btn-size-dec"
          class="px-2 py-1 rounded font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors cursor-pointer"
          title="Decrease text size"
        >
          A-
        </button>
        <button
          id="btn-size-inc"
          class="px-2 py-1 rounded font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors cursor-pointer"
          title="Increase text size"
        >
          A+
        </button>
      </div>

      <!-- Share Button -->
      <button
        id="btn-native-share"
        data-title={article.title}
        data-url={canonicalUrl}
        class="p-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        title="Share article"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      </button>

      <!-- Bookmark Button -->
      <BookmarkButton article={article} />
    </div>
  </nav>

  <!-- 2. ARTICLE CORE CONTAINER -->
  <article id="reading-container" class="reader-serif reader-size-md space-y-5 pt-1">
    
    <!-- Category & Status Badge Header -->
    <div class="flex flex-wrap items-center gap-2">
      {article.category_name && (
        <a
          href={`/category/${article.category_slug || 'business'}`}
          class="px-2.5 py-1 rounded-md bg-emerald-600/10 dark:bg-emerald-500/15 border border-emerald-600/25 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-xs font-black uppercase tracking-wider font-mono hover:bg-emerald-600/20 transition-colors inline-flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          {article.category_name}
        </a>
      )}

      {article.is_breaking === 1 && (
        <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-black uppercase tracking-wider font-mono">
          BREAKING REPORT
        </span>
      )}

      <span class="text-[11px] font-mono text-slate-400 dark:text-slate-500 ml-auto hidden sm:inline-block">
        /news/{article.slug}
      </span>
    </div>

    <!-- Main Headline with Distinctive Editorial Display Font -->
    <h1 class="text-2xl sm:text-3xl lg:text-[2.6rem] font-black text-slate-900 dark:text-white leading-[1.22] tracking-tight font-display">
      {article.title}
    </h1>

    <!-- Author Byline & Publishing Metadata Strip with Follow Desk -->
    <div class="py-3 px-4 rounded-xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-xs flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <img
          src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80'}
          alt={article.author_name}
          class="w-10 h-10 rounded-full object-cover border-2 border-emerald-500/40 shrink-0 shadow-xs"
        />
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="text-sm font-bold text-slate-900 dark:text-white font-sans truncate">
              {article.author_name || '9jaBeacon Editorial Bureau'}
            </span>
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="flex items-center gap-2">
            <p class="text-xs text-slate-500 dark:text-slate-400 font-sans truncate">{article.author_role || 'Verified Investigative Desk'}</p>
            <button
              id="btn-follow-author"
              data-author={article.author_name || '9jaBeacon Desk'}
              class="px-2 py-0.5 rounded-full text-[10px] font-bold border border-emerald-500/40 bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-600 hover:text-white transition-colors cursor-pointer shrink-0 inline-flex items-center gap-1"
            >
              <span id="follow-author-text">Follow Desk +</span>
            </button>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-slate-600 dark:text-slate-400 font-sans">
        <div>
          <span class="text-slate-400 dark:text-slate-500">Published:</span>
          <strong class="text-slate-800 dark:text-slate-200 font-semibold ml-1">{publishedDate}</strong>
        </div>
        {isUpdated && (
          <div class="text-emerald-700 dark:text-emerald-400">
            <span>Updated:</span>
            <strong class="font-semibold ml-1">{updatedDate}</strong>
          </div>
        )}
        <div class="flex items-center gap-1 font-mono text-[11px] bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded-md">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{article.reading_time_minutes || 4} min read</span>
        </div>
      </div>
    </div>

    <!-- 3. FEATURED MEDIA HERO -->
    <figure class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 shadow-md">
      <img
        src={article.image_url || DEFAULT_FALLBACK_IMAGE_URL}
        alt={article.title}
        class="w-full aspect-[16/9] object-cover"
        loading="eager"
      />
      {(article.image_caption || article.image_credit) && (
        <figcaption class="p-3 text-xs text-slate-600 dark:text-slate-400 bg-slate-50/95 dark:bg-slate-950/90 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
          <span class="font-sans italic">{article.image_caption || article.title}</span>
          {article.image_credit && (
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono shrink-0">
              Source Credit: {article.image_credit}
            </span>
          )}
        </figcaption>
      )}
    </figure>

    <!-- 4. AT A GLANCE EXECUTIVE SUMMARY CALLOUT BOX -->
    {article.summary && (
      <aside class="p-4.5 sm:p-5 rounded-2xl bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-transparent border border-emerald-500/25 dark:border-emerald-500/20 shadow-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-800 dark:text-emerald-400 font-mono flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Executive Summary
          </span>
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-mono">
            Key Highlights
          </span>
        </div>
        <p class="text-slate-800 dark:text-slate-200 text-sm sm:text-base leading-relaxed font-sans font-medium">
          {article.summary}
        </p>
      </aside>
    )}

    <!-- 5. SMART AUDIO NARRATION PLAYER WITH SPEECH SYNTHESIS -->
    <div class="p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3">
        <button
          id="btn-play-audio"
          class="w-10 h-10 rounded-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white flex items-center justify-center shadow-sm cursor-pointer transition-all shrink-0"
          aria-label="Listen to article"
        >
          <svg id="icon-play" class="w-5 h-5 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg id="icon-pause" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>

        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white font-sans">
              Listen to Audio Narration
            </span>
            <!-- Waveform Animation -->
            <div id="soundwave-anim" class="hidden items-center gap-0.5 h-3">
              <span class="w-0.5 h-full bg-emerald-500 animate-pulse"></span>
              <span class="w-0.5 h-2/3 bg-emerald-500 animate-pulse delay-75"></span>
              <span class="w-0.5 h-full bg-emerald-500 animate-pulse delay-150"></span>
              <span class="w-0.5 h-1/2 bg-emerald-500 animate-pulse delay-100"></span>
            </div>
          </div>
          <span class="text-[11px] text-slate-500 dark:text-slate-400 font-sans block">
            AI synthesized voice reader (~{article.reading_time_minutes || 4} mins)
          </span>
        </div>
      </div>

      <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0">
        <!-- Speed Toggle -->
        <button
          id="btn-audio-speed"
          class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-[11px] font-mono font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
          title="Audio speed"
        >
          1.0x
        </button>

        <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 font-mono">
          <span id="audio-time" class="font-bold text-slate-900 dark:text-white">0:00</span>
          <span>/</span>
          <span>{article.reading_time_minutes || 4}:00</span>
        </div>
      </div>
    </div>

    <!-- 6. RICH STRUCTURED ARTICLE CONTENT (THE SCOOP, THE STAKES, THE STATS) -->
    <div id="article-body-text" class="article-content text-slate-800 dark:text-slate-200 text-base sm:text-lg leading-relaxed pt-2">
      <Fragment set:html={formattedContent} />
    </div>

    <!-- 7. EDITORIAL SOURCING & CREDENTIALS BOX -->
    <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2.5">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-800 dark:text-slate-200 font-mono flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Primary Source & Attribution
        </h3>
        {article.image_license && (
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-mono bg-emerald-100/70 dark:bg-emerald-950/70 border border-emerald-300 dark:border-emerald-800 px-2 py-0.5 rounded">
            {article.image_license}
          </span>
        )}
      </div>

      <div class="space-y-2 text-xs font-sans">
        <div class="flex items-center justify-between">
          <span class="text-slate-500 dark:text-slate-400">Reporting Authority:</span>
          <strong class="text-slate-900 dark:text-white font-bold">{article.source_name || 'Central Bank of Nigeria'}</strong>
        </div>

        {article.source_original_url && (
          <div class="pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <span class="text-slate-500 dark:text-slate-400">Official Release URL:</span>
            <a
              href={article.source_original_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 underline font-mono text-[11px] break-all inline-flex items-center gap-1"
            >
              {article.source_original_url}
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- 8. VIRAL SHARING BAR WITH CANONICAL ACCURACY -->
    <div class="mt-6 p-4 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800/80 shadow-xs flex flex-wrap items-center justify-between gap-3">
      <span class="text-xs font-bold text-slate-700 dark:text-slate-300 font-sans flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        Share this story with your network:
      </span>
      <div class="flex items-center gap-2">
        <!-- WhatsApp -->
        <a
          id="btn-share-whatsapp"
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - Read more on 9jaBeacon: ' + canonicalUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 px-3 rounded-lg bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-700 dark:text-emerald-400 text-xs font-bold flex items-center gap-1.5 transition-colors"
        >
          WhatsApp
        </a>

        <!-- X (Twitter) -->
        <a
          id="btn-share-x"
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(canonicalUrl)}&via=9jaBeacon`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 px-3 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors"
        >
          X (Twitter)
        </a>

        <!-- Copy Link -->
        <button
          id="btn-copy-url"
          data-canonical-url={canonicalUrl}
          class="p-2 px-3 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors cursor-pointer"
        >
          Copy Link
        </button>

        <!-- Report Story Button -->
        <button
          id="btn-open-report-modal"
          class="p-2 px-3 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5"
          title="Report inaccuracy, copyright, or issue"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Report
        </button>
      </div>
    </div>
  </article>

  <!-- Reader Report Article Modal -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center font-bold">
            !
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Report Story to Editorial Desk</h3>
            <p class="text-[11px] text-slate-500">Flags review in the BonesCEO Admin Hub</p>
          </div>
        </div>
        <button id="btn-close-report" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-white cursor-pointer">✕</button>
      </div>

      <form id="article-report-form" class="space-y-3">
        <input type="hidden" name="article_id" value={article.id} />
        <input type="hidden" name="article_title" value={article.title} />
        <input type="hidden" name="article_slug" value={article.slug} />

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Reason for report</label>
          <select name="reason" required class="w-full h-10 px-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 outline-none">
            <option value="Factual Inaccuracy">Factual Inaccuracy / Verification Error</option>
            <option value="Source Attribution / Copyright">Source Attribution / Wire Copyright Issue</option>
            <option value="Outdated Information">Outdated Information</option>
            <option value="Formatting / AI Glitch">Formatting / AI Glitch</option>
            <option value="Other">Other Inquiry</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Additional details (Optional)</label>
          <textarea name="details" rows="3" placeholder="Describe the issue or correct fact..." class="w-full p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 outline-none resize-none"></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Your email (Optional)</label>
          <input type="email" name="reporter_email" placeholder="you@example.com" class="w-full h-10 px-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 outline-none" />
        </div>

        <button type="submit" id="btn-submit-report" class="w-full h-11 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition-all flex items-center justify-center cursor-pointer shadow-md">
          Submit Report to Admin
        </button>
      </form>
    </div>
  </div>

  <!-- 9. RELATED ARTICLES DISCOVERY -->
  {relatedArticles.length > 0 && (
    <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2 font-display">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          Related Stories in {article.category_name || 'News'}
        </h2>
        <a href={`/category/${article.category_slug || 'business'}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
          View all &rarr;
        </a>
      </div>
      <div class="space-y-3">
        {relatedArticles.map((rel) => (
          <ArticleCard article={rel} showCategory={false} />
        ))}
      </div>
    </section>
  )}
</Layout>

<style is:global>
  /* Rich Editorial Subheading Cards */
  .editorial-section-tag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    margin-top: 2.2rem;
    margin-bottom: 1.2rem;
    border-radius: 0.75rem;
    border-left-width: 4px;
  }
  .editorial-section-tag h3 {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    font-family: 'Outfit', sans-serif !important;
    letter-spacing: -0.01em !important;
  }
  .editorial-section-tag .tag-icon {
    font-size: 1.15rem;
  }
  .editorial-section-tag .tag-subtitle {
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-left: auto;
    opacity: 0.8;
  }

  /* The Scoop (Green / Emerald) */
  .tag-scoop {
    background: rgba(16, 185, 129, 0.08);
    border-color: #10b981;
    color: #065f46;
  }
  html.dark .tag-scoop {
    background: rgba(16, 185, 129, 0.12);
    border-color: #10b981;
    color: #6ee7b7;
  }

  /* The Stakes (Amber / Gold) */
  .tag-stakes {
    background: rgba(245, 158, 11, 0.08);
    border-color: #f59e0b;
    color: #92400e;
  }
  html.dark .tag-stakes {
    background: rgba(245, 158, 11, 0.12);
    border-color: #f59e0b;
    color: #fcd34d;
  }

  /* The Stats (Cyan / Teal / Slate) */
  .tag-stats {
    background: rgba(6, 182, 212, 0.08);
    border-color: #06b6d4;
    color: #155e75;
  }
  html.dark .tag-stats {
    background: rgba(6, 182, 212, 0.12);
    border-color: #06b6d4;
    color: #67e8f9;
  }
</style>

<script is:inline>
  // 1. Reading Progress Bar Syncer
  window.addEventListener('scroll', () => {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight > 0) {
      const progress = (window.scrollY / totalHeight) * 100;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  });

  // 2. Reader Mode Controls (Serif / Sans Switcher & Size Adjuster)
  const readingContainer = document.getElementById('reading-container');
  const btnSerif = document.getElementById('btn-font-serif');
  const btnSans = document.getElementById('btn-font-sans');
  const btnSizeDec = document.getElementById('btn-size-dec');
  const btnSizeInc = document.getElementById('btn-size-inc');

  const sizes = ['reader-size-sm', 'reader-size-md', 'reader-size-lg', 'reader-size-xl'];
  let currentSizeIdx = 1; // Default is reader-size-md

  btnSerif?.addEventListener('click', () => {
    readingContainer?.classList.remove('reader-sans');
    readingContainer?.classList.add('reader-serif');
    btnSerif.className = "px-2 py-1 rounded font-editorial font-bold text-xs transition-colors bg-white dark:bg-slate-800 text-emerald-700 dark:text-emerald-400 shadow-xs cursor-pointer";
    btnSans.className = "px-2 py-1 rounded font-sans font-medium text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer";
    localStorage.setItem('9jabeacon_font_mode', 'serif');
  });

  btnSans?.addEventListener('click', () => {
    readingContainer?.classList.remove('reader-serif');
    readingContainer?.classList.add('reader-sans');
    btnSans.className = "px-2 py-1 rounded font-sans font-bold text-xs transition-colors bg-white dark:bg-slate-800 text-emerald-700 dark:text-emerald-400 shadow-xs cursor-pointer";
    btnSerif.className = "px-2 py-1 rounded font-editorial font-medium text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer";
    localStorage.setItem('9jabeacon_font_mode', 'sans');
  });

  btnSizeDec?.addEventListener('click', () => {
    if (currentSizeIdx > 0) {
      readingContainer?.classList.remove(sizes[currentSizeIdx]);
      currentSizeIdx--;
      readingContainer?.classList.add(sizes[currentSizeIdx]);
    }
  });

  btnSizeInc?.addEventListener('click', () => {
    if (currentSizeIdx < sizes.length - 1) {
      readingContainer?.classList.remove(sizes[currentSizeIdx]);
      currentSizeIdx++;
      readingContainer?.classList.add(sizes[currentSizeIdx]);
    }
  });

  // Restore saved reader preference
  const savedFont = localStorage.getItem('9jabeacon_font_mode');
  if (savedFont === 'sans') {
    btnSans?.click();
  }

  // 2b. Author Desk Follow Manager
  const followAuthorBtn = document.getElementById('btn-follow-author');
  const followAuthorText = document.getElementById('follow-author-text');
  const authorName = followAuthorBtn?.getAttribute('data-author');

  if (authorName) {
    const isFollowingAuthor = localStorage.getItem(`following_author_${authorName}`) === 'true';
    if (isFollowingAuthor && followAuthorText) {
      followAuthorText.textContent = 'Following Desk ✓';
      followAuthorBtn?.classList.add('bg-emerald-600', 'text-white');
    }

    followAuthorBtn?.addEventListener('click', () => {
      const current = localStorage.getItem(`following_author_${authorName}`) === 'true';
      if (current) {
        localStorage.setItem(`following_author_${authorName}`, 'false');
        if (followAuthorText) followAuthorText.textContent = 'Follow Desk +';
        followAuthorBtn?.classList.remove('bg-emerald-600', 'text-white');
        window.showToast?.(`Unfollowed ${authorName}`);
      } else {
        localStorage.setItem(`following_author_${authorName}`, 'true');
        if (followAuthorText) followAuthorText.textContent = 'Following Desk ✓';
        followAuthorBtn?.classList.add('bg-emerald-600', 'text-white');
        window.showToast?.(`Following ${authorName} news reports!`, 'success');
      }
    });
  }

  // 3. Share & Copy Handlers
  const shareBtn = document.getElementById('btn-native-share');
  shareBtn?.addEventListener('click', async () => {
    const title = shareBtn.getAttribute('data-title') || document.title;
    const url = shareBtn.getAttribute('data-url') || window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      navigator.clipboard?.writeText(url);
      window.showToast?.('Canonical link copied to clipboard!', 'success');
    }
  });

  const copyBtn = document.getElementById('btn-copy-url');
  copyBtn?.addEventListener('click', () => {
    const canonical = copyBtn.getAttribute('data-canonical-url') || window.location.href;
    navigator.clipboard?.writeText(canonical);
    window.showToast?.('Canonical news link copied to clipboard!', 'success');
  });

  // 4. Audio Narration Player & Speech Synthesis
  let isPlaying = false;
  let audioTimer = null;
  let audioSeconds = 0;
  let speechRate = 1.0;
  const playBtn = document.getElementById('btn-play-audio');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const timeDisplay = document.getElementById('audio-time');
  const soundwave = document.getElementById('soundwave-anim');
  const speedBtn = document.getElementById('btn-audio-speed');

  const speeds = [1.0, 1.25, 1.5];
  let speedIdx = 0;

  speedBtn?.addEventListener('click', () => {
    speedIdx = (speedIdx + 1) % speeds.length;
    speechRate = speeds[speedIdx];
    speedBtn.textContent = `${speechRate.toFixed(1)}x`;
    if (isPlaying && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      startSpeech();
    }
  });

  function startSpeech() {
    if ('speechSynthesis' in window) {
      const bodyText = document.getElementById('article-body-text')?.innerText || '';
      const utterance = new SpeechSynthesisUtterance(bodyText);
      utterance.rate = speechRate;
      utterance.onend = () => {
        stopAudio();
      };
      window.speechSynthesis.speak(utterance);
    }
  }

  function stopAudio() {
    isPlaying = false;
    iconPlay?.classList.remove('hidden');
    iconPause?.classList.add('hidden');
    soundwave?.classList.add('hidden');
    soundwave?.classList.remove('flex');
    if (audioTimer) clearInterval(audioTimer);
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
  }

  playBtn?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    if (isPlaying) {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      soundwave?.classList.remove('hidden');
      soundwave?.classList.add('flex');
      window.showToast?.('Playing audio narration...', 'info');

      startSpeech();

      audioTimer = setInterval(() => {
        audioSeconds++;
        const mins = Math.floor(audioSeconds / 60);
        const secs = audioSeconds % 60;
        if (timeDisplay) timeDisplay.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }, 1000);
    } else {
      stopAudio();
      window.showToast?.('Audio paused');
    }
  });

  // 5. Reader Report Modal Handlers
  const reportModal = document.getElementById('report-modal');
  const openReportBtn = document.getElementById('btn-open-report-modal');
  const closeReportBtn = document.getElementById('btn-close-report');
  const reportForm = document.getElementById('article-report-form');

  openReportBtn?.addEventListener('click', () => {
    reportModal?.classList.remove('hidden');
  });

  closeReportBtn?.addEventListener('click', () => {
    reportModal?.classList.add('hidden');
  });

  reportModal?.addEventListener('click', (e) => {
    if (e.target === reportModal) {
      reportModal.classList.add('hidden');
    }
  });

  reportForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('btn-submit-report');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting report...';
    }

    const formData = new FormData(reportForm);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        window.showToast?.('Report sent to editorial desk for review!', 'success');
        reportModal?.classList.add('hidden');
        reportForm.reset();
      } else {
        window.showToast?.('Failed to submit report. Please try again.');
      }
    } catch {
      window.showToast?.('Network error sending report.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Report to Admin';
      }
    }
  });
</script>
