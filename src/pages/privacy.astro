---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';

export const prerender = false;

const db = getD1(Astro.locals);
const settings = await getSiteSettings(db);

const siteName = settings.site_name || '9jaBeacon';
const rawSiteUrl = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteUrl = rawSiteUrl === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteUrl;
const contactEmail = settings.contact_email || settings.admin_email || 'officialbonesceo@gmail.com';
const lastUpdated = 'November 10, 2026';
---

<Layout
  title={`Privacy | ${siteName}`}
  description={`How ${siteName} handles basic visitor information.`}
  canonicalUrl={`${siteUrl}/privacy`}
>
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span>/</span>
    <span class="text-slate-800 dark:text-slate-200">Privacy</span>
  </nav>

  <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 shadow-xs space-y-6 transition-colors">
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <p class="text-xs text-slate-500">Updated: {lastUpdated}</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        Privacy
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Short version: we collect as little as we can, and we do not sell your personal details.
      </p>
    </header>

    <div class="space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">1. What we collect</h2>
        <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400">
          <li>If you email us, we see your email and message so we can reply.</li>
          <li>Our host may log basic technical data (browser type, approximate location, page requests) to keep the site online and safe.</li>
          <li>Your device may store simple preferences (like dark mode or saved articles) only on your phone or computer.</li>
        </ul>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">2. Ads</h2>
        <p>
          The site may show ads from third-party networks so the blog can stay free. Those networks may use their own cookies. You can block cookies in your browser if you prefer.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">3. We do not sell your data</h2>
        <p>
          We do not sell personal information to data brokers. We only share what is needed with basic hosting or security providers, or if the law requires it.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">4. Contact</h2>
        <p>
          Questions about privacy: <a href={`mailto:${contactEmail}`} class="text-emerald-600 dark:text-emerald-400 font-semibold underline">{contactEmail}</a>
        </p>
      </section>
    </div>
  </article>
</Layout>
