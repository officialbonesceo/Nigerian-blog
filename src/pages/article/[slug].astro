---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import { getArticleBySlug, getRelatedArticles, getArticles } from '../../lib/db';

export async function getStaticPaths() {
  const articles = getArticles({ limit: 1000 });
  return articles.map((art) => ({
    params: { slug: art.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const article = getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

const relatedArticles = getRelatedArticles(article.id, article.category_id, 3);

// Format date strings
const publishedDate = new Date(article.published_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const updatedDate = new Date(article.updated_at).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<Layout
  title={`${article.title} - 9jaBeacon News`}
  description={article.summary}
  image={article.image_url}
  article={{
    publishedTime: article.published_at,
    modifiedTime: article.updated_at,
    author: article.author_name,
    section: article.category_name,
  }}
  activeNav="home"
>
  <!-- Back Button & Breadcrumbs Navigation -->
  <nav class="flex items-center justify-between py-2 mb-2">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to headlines
    </a>

    <!-- Share & Bookmark Action Tools -->
    <div class="flex items-center gap-1">
      <button
        id="btn-native-share"
        data-title={article.title}
        data-url={Astro.url.href}
        class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center justify-center cursor-pointer"
        title="Share article"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      </button>

      <BookmarkButton article={article} />
    </div>
  </nav>

  <!-- Article Container -->
  <article class="space-y-4">
    <!-- Category Pill Tag -->
    {article.category_name && (
      <a
        href={`/category/${article.category_slug || 'politics'}`}
        class="inline-block px-2.5 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider font-mono hover:bg-emerald-500/20 transition-colors"
      >
        {article.category_name}
      </a>
    )}

    <!-- Main Headline -->
    <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white leading-tight sm:leading-snug tracking-tight font-sans">
      {article.title}
    </h1>

    <!-- Author & Publication Details -->
    <div class="flex items-center justify-between py-2 border-y border-slate-200 dark:border-slate-800/80 gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Author Avatar -->
        <img
          src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80'}
          alt={article.author_name}
          class="w-10 h-10 rounded-full object-cover border border-slate-300 dark:border-slate-700 shrink-0"
        />
        
        <!-- Author Name & Verification Badge -->
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate">{article.author_name}</span>
            <span class="text-emerald-600 dark:text-emerald-400" title="Verified Journalist">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">{article.author_role}</p>
        </div>
      </div>

      <!-- Publication Times & Read Time -->
      <div class="text-right text-[11px] text-slate-500 dark:text-slate-400 shrink-0 space-y-0.5">
        <div>{publishedDate}</div>
        {article.updated_at && article.updated_at !== article.published_at && (
          <div class="text-[10px] text-emerald-600 dark:text-emerald-400">Updated: {updatedDate}</div>
        )}
        <div class="flex items-center justify-end gap-1 text-slate-500 dark:text-slate-400">
          <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {article.reading_time_minutes} min read
        </div>
      </div>
    </div>

    <!-- Featured Image Area with Caption & Legal Credit -->
    <figure class="rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
      <img
        src={article.image_url}
        alt={article.title}
        class="w-full aspect-[16/9] object-cover"
        loading="eager"
      />
      {(article.image_caption || article.image_credit) && (
        <figcaption class="p-3 text-xs text-slate-600 dark:text-slate-400 bg-slate-50/90 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
          <span>{article.image_caption || article.title}</span>
          {article.image_credit && (
            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">
              Credit: {article.image_credit}
            </span>
          )}
        </figcaption>
      )}
    </figure>

    <!-- Audio Narration Simulation Bar -->
    <div class="p-3 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3 shadow-xs dark:shadow-none">
      <div class="flex items-center gap-3">
        <button
          id="btn-play-audio"
          class="w-8 h-8 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center shadow-sm cursor-pointer transition-all active:scale-95"
          aria-label="Listen to article"
        >
          <svg id="icon-play" class="w-4 h-4 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg id="icon-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>
        <div>
          <span class="text-xs font-bold text-slate-900 dark:text-white block">Listen to this story</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400">Audio playback (~{article.reading_time_minutes} mins)</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-mono">
        <span id="audio-time">0:00</span>
        <span>/</span>
        <span>{article.reading_time_minutes}:00</span>
      </div>
    </div>

    <!-- Article Body with Android Optimized Typography -->
    <div id="article-body-text" class="article-content text-slate-800 dark:text-slate-200 text-base sm:text-lg leading-relaxed pt-2">
      <Fragment set:html={article.content} />
    </div>

    <!-- Transparent Source & Reference Attribution Box -->
    <div class="mt-8 p-4 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xs dark:shadow-none space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">Source & Reference</span>
        {article.image_license && (
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400/80 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/40 px-2 py-0.5 rounded font-mono">
            {article.image_license}
          </span>
        )}
      </div>

      <div class="flex items-center justify-between gap-3 text-sm">
        <div>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-medium">Source: <span class="text-slate-900 dark:text-white font-bold">{article.source_name || 'Direct Editorial'}</span></p>
          {article.source_original_url && (
            <a
              href={article.source_original_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 underline break-all inline-flex items-center gap-1 mt-0.5"
            >
              {article.source_original_url}
              <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Share Buttons Bar -->
    <div class="mt-6 p-4 rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 shadow-xs dark:shadow-none flex flex-wrap items-center justify-between gap-3">
      <span class="text-xs font-bold text-slate-600 dark:text-slate-400 font-sans">Share this story:</span>
      <div class="flex items-center gap-2">
        <!-- WhatsApp -->
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' ' + Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-700 dark:text-emerald-400 text-xs font-semibold flex items-center gap-1 transition-colors"
        >
          WhatsApp
        </a>

        <!-- X (Twitter) -->
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(Astro.url.href)}&via=9jaBeacon`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold transition-colors"
        >
          X
        </a>

        <!-- Copy Link -->
        <button
          id="btn-copy-url"
          class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold transition-colors cursor-pointer"
        >
          Copy Link
        </button>
      </div>
    </div>
  </article>

  <!-- Related Articles Grid -->
  {relatedArticles.length > 0 && (
    <section class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight mb-4 flex items-center gap-2 font-sans">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Related Articles
      </h2>
      <div class="space-y-3">
        {relatedArticles.map((rel) => (
          <ArticleCard article={rel} showCategory={false} />
        ))}
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  // Native Share Handler
  const shareBtn = document.getElementById('btn-native-share');
  shareBtn?.addEventListener('click', async () => {
    const title = shareBtn.getAttribute('data-title') || document.title;
    const url = shareBtn.getAttribute('data-url') || window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      navigator.clipboard?.writeText(url);
      window.showToast?.('Link copied to clipboard!', 'success');
    }
  });

  // Copy URL button
  document.getElementById('btn-copy-url')?.addEventListener('click', () => {
    navigator.clipboard?.writeText(window.location.href);
    window.showToast?.('Article link copied to clipboard!', 'success');
  });

  // Audio simulation player
  let isPlaying = false;
  let audioTimer = null;
  let seconds = 0;
  const playBtn = document.getElementById('btn-play-audio');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const timeDisplay = document.getElementById('audio-time');

  playBtn?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    if (isPlaying) {
      iconPlay?.classList.add('hidden');
      iconPause?.classList.remove('hidden');
      window.showToast?.('Playing audio narration...', 'info');
      audioTimer = setInterval(() => {
        seconds++;
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        if (timeDisplay) timeDisplay.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }, 1000);
    } else {
      iconPlay?.classList.remove('hidden');
      iconPause?.classList.add('hidden');
      if (audioTimer) clearInterval(audioTimer);
      window.showToast?.('Audio paused');
    }
  });
</script>
