---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Story or Page Not Found - 9jaBeacon" noIndex={true}>
  <div class="py-16 text-center space-y-4 max-w-md mx-auto">
    <div class="w-16 h-16 rounded-2xl bg-emerald-950/60 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-2xl font-black font-mono">
      404
    </div>
    <h1 class="text-xl font-bold text-white">Story or Page Not Found</h1>
    <p class="text-xs text-slate-400">
      The news article or category you requested may have moved or been updated.
    </p>
    <a
      href="/"
      class="inline-block px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors"
    >
      Return to Homepage
    </a>
  </div>
</Layout>
