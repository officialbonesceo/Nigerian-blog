---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';

export const prerender = false;

const db = getD1(Astro.locals);
const settings = await getSiteSettings(db);

const siteName = settings.site_name || '9jaBeacon';
const rawSiteUrl = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteUrl = rawSiteUrl === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteUrl;
const contactEmail = settings.contact_email || settings.admin_email || 'officialbonesceo@gmail.com';
const lastUpdated = 'November 10, 2026';
---

<Layout
  title={`Terms of Use | ${siteName}`}
  description={`Simple terms for using ${siteName}, a Nigerian news blog.`}
  canonicalUrl={`${siteUrl}/terms`}
>
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span>/</span>
    <span class="text-slate-800 dark:text-slate-200">Terms of Use</span>
  </nav>

  <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 shadow-xs space-y-6 transition-colors">
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <p class="text-xs text-slate-500">Updated: {lastUpdated}</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        Terms of Use
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        By using {siteName}, you agree to these simple rules.
      </p>
    </header>

    <div class="space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">1. The site</h2>
        <p>
          {siteName} ({siteUrl}) is an independent blog that posts news-style articles for general reading. It is not a bank, government service, or law firm.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">2. Content</h2>
        <p>
          Articles may summarise or discuss information that other websites, newspapers, or public bodies have already published. We try to name those sources in plain language. We do not claim ownership of other people’s original reporting.
        </p>
        <p>
          You may share links and short quotes with credit. Please do not copy whole articles for your own commercial site without permission.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">3. If something is yours</h2>
        <p>
          Email <a href={`mailto:${contactEmail}`} class="text-emerald-600 dark:text-emerald-400 font-semibold underline">{contactEmail}</a> with the page link and what you want (credit change or removal). We will review requests in good faith.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">4. No guarantees</h2>
        <p>
          The site is provided “as is.” News moves fast and details can be incomplete. Do not treat posts as professional advice of any kind.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">5. Links</h2>
        <p>
          We may link to other sites. We are not responsible for what those sites say or do.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">6. Contact</h2>
        <p>
          <a href={`mailto:${contactEmail}`} class="text-emerald-600 dark:text-emerald-400 font-semibold underline">{contactEmail}</a>
        </p>
      </section>
    </div>
  </article>
</Layout>
