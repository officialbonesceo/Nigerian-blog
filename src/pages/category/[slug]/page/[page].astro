---
export const prerender = false;
const { slug, page } = Astro.params;
if (!slug) return Astro.redirect('/', 301);
if (slug === 'money-hustle' || slug === 'money' || slug === 'hustle') {
  return Astro.redirect('/category/business', 301);
}
const n = Math.max(1, parseInt(String(page || '1'), 10) || 1);
if (n <= 1) return Astro.redirect(`/category/${slug}`, 301);
// Internal rewrite — fromPath=1 prevents middleware bounce
return Astro.rewrite(`/category/${slug}?page=${n}&fromPath=1`);
---
