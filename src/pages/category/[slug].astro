---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopStoryCard from '../../components/TopStoryCard.astro';
import { getCategoryBySlug, getArticles, getCategories } from '../../lib/db';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const category = getCategoryBySlug(slug);

if (!category) {
  return Astro.redirect('/404');
}

const allCategories = getCategories();
const categoryArticles = getArticles({ categorySlug: slug, limit: 12 });
const topCatArticle = categoryArticles[0];
const remainingArticles = categoryArticles.slice(1);
---

<Layout
  title={`${category.name} News - 9jaBeacon`}
  description={category.description}
  activeNav="category"
>
  <!-- Category Header Hero -->
  <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-100 via-white to-slate-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 shadow-xs dark:shadow-none space-y-3 relative overflow-hidden mb-5">
    <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="flex items-start justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="w-3 h-3 rounded-full" style={`background-color: ${category.color || '#008751'}`}></span>
          {category.name}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg leading-relaxed">
          {category.description}
        </p>
      </div>

      <!-- Follow Category Button -->
      <button
        id="btn-follow-category"
        data-cat-id={category.id}
        class="shrink-0 px-3.5 py-1.5 rounded-full bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 text-xs font-bold transition-colors flex items-center gap-1 cursor-pointer"
      >
        <span id="follow-text">Follow +</span>
      </button>
    </div>

    <!-- Category Switcher Carousel -->
    <div class="flex items-center gap-2 pt-2 overflow-x-auto no-scrollbar -mx-2 px-2">
      {allCategories.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors ${
            c.slug === slug
              ? 'bg-emerald-600 text-white font-bold shadow-xs'
              : 'bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-300 dark:hover:bg-slate-800'
          }`}
        >
          {c.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Category Story Feed -->
  {topCatArticle && (
    <div class="mb-5">
      <TopStoryCard article={topCatArticle} />
    </div>
  )}

  <section class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider font-mono">
        All {category.name} Stories ({categoryArticles.length})
      </h2>
    </div>

    {remainingArticles.length > 0 ? (
      <div class="space-y-2.5">
        {remainingArticles.map((art) => (
          <ArticleCard article={art} showCategory={false} />
        ))}
      </div>
    ) : (
      <div class="p-8 text-center bg-white dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs">
        No more stories in this category yet. New articles sync automatically via Cloudflare D1.
      </div>
    )}
  </section>
</Layout>

<script is:inline>
  const followBtn = document.getElementById('btn-follow-category');
  const followText = document.getElementById('follow-text');
  const catId = followBtn?.getAttribute('data-cat-id');

  if (catId) {
    const isFollowing = localStorage.getItem(`following_cat_${catId}`) === 'true';
    if (isFollowing && followText) {
      followText.textContent = 'Following ✓';
      followBtn?.classList.add('bg-emerald-600', 'text-white');
    }

    followBtn?.addEventListener('click', () => {
      const current = localStorage.getItem(`following_cat_${catId}`) === 'true';
      if (current) {
        localStorage.setItem(`following_cat_${catId}`, 'false');
        if (followText) followText.textContent = 'Follow +';
        followBtn?.classList.remove('bg-emerald-600', 'text-white');
        window.showToast?.('Unfollowed category updates');
      } else {
        localStorage.setItem(`following_cat_${catId}`, 'true');
        if (followText) followText.textContent = 'Following ✓';
        followBtn?.classList.add('bg-emerald-600', 'text-white');
        window.showToast?.('Following category updates', 'success');
      }
    });
  }
</script>
