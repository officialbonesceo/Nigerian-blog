---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopStoryCard from '../../components/TopStoryCard.astro';
import { getD1, getCategoryBySlug, getArticles, getCategories } from '../../lib/runtime-db';
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
const d1 = getD1(Astro.locals);
const category = await getCategoryBySlug(d1, slug);
if (!category) return Astro.redirect('/404');
const [allCategories, categoryArticles] = await Promise.all([getCategories(d1), getArticles(d1, { categorySlug: slug, limit: 12 })]);
const topCatArticle = categoryArticles[0];
const remainingArticles = categoryArticles.slice(1);
---
<Layout title={`${category.name} News - 9jaBeacon`} description={category.description} activeNav={slug}>
  <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-100 via-white to-slate-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 space-y-3 mb-5">
    <div class="flex items-start justify-between gap-4"><div><h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">{category.name}</h1><p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg mt-1">{category.description}</p></div><button id="btn-follow-category" data-cat-id={category.id} class="shrink-0 px-3.5 py-1.5 rounded-full bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 text-xs font-bold"><span id="follow-text">Follow +</span></button></div>
    <div class="flex items-center gap-2 pt-2 overflow-x-auto no-scrollbar">{allCategories.map((c) => <a href={`/category/${c.slug}`} class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap ${c.slug === slug ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-400'}`}>{c.name}</a>)}</div>
  </div>
  {topCatArticle && <div class="mb-5"><TopStoryCard article={topCatArticle} /></div>}
  <section class="space-y-3"><h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider">All {category.name} Stories ({categoryArticles.length})</h2>{remainingArticles.length ? <div class="space-y-2.5">{remainingArticles.map((art) => <ArticleCard article={art} showCategory={false} />)}</div> : <div class="p-8 text-center rounded-xl border border-slate-200 dark:border-slate-800 text-slate-500 text-xs">No more stories in this category yet.</div>}</section>
</Layout>
<script is:inline>const b=document.getElementById('btn-follow-category');const t=document.getElementById('follow-text');const id=b?.getAttribute('data-cat-id');if(id){const f=localStorage.getItem(`following_cat_${id}`)==='true';if(f)t.textContent='Following ✓';b?.addEventListener('click',()=>{const n=localStorage.getItem(`following_cat_${id}`)!=='true';localStorage.setItem(`following_cat_${id}`,String(n));t.textContent=n?'Following ✓':'Follow +';});}</script>
