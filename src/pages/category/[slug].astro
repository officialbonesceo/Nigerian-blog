---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopStoryCard from '../../components/TopStoryCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getD1, getCategoryBySlug, getArticles, getCategories } from '../../lib/runtime-db';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
const d1 = getD1(Astro.locals);
const category = await getCategoryBySlug(d1, slug);
if (!category) return Astro.redirect('/404');

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const pageSize = 8;
const offset = (page - 1) * pageSize;

// Fetch current page articles plus one extra to determine if next page exists
const [allCategories, fetchedArticles] = await Promise.all([
  getCategories(d1),
  getArticles(d1, { categorySlug: slug, limit: pageSize + 1, offset }),
]);

const hasNextPage = fetchedArticles.length > pageSize;
const categoryArticles = fetchedArticles.slice(0, pageSize);
const isFirstPage = page === 1;
const topCatArticle = isFirstPage ? categoryArticles[0] : null;
const listArticles = isFirstPage ? categoryArticles.slice(1) : categoryArticles;

const siteBase = 'https://www.9jabeacon.name.ng';
const prevUrl = page > 1 ? (page === 2 ? `${siteBase}/category/${slug}` : `${siteBase}/category/${slug}?page=${page - 1}`) : undefined;
const nextUrl = hasNextPage ? `${siteBase}/category/${slug}?page=${page + 1}` : undefined;
---

<Layout
  title={page > 1 ? `${category.name} News (Page ${page}) - 9jaBeacon` : `${category.name} News - Verified Updates | 9jaBeacon`}
  description={category.description}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  activeNav={slug}
>
  <!-- Category Header Hero -->
  <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-slate-100 via-white to-slate-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 space-y-4 mb-5 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 mb-1.5">
          <span class="w-3 h-3 rounded-full" style={`background-color: ${category.color || '#008751'}`}></span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono">Category Wire</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">{category.name}</h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg mt-1">{category.description}</p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button id="btn-follow-category" data-cat-id={category.id} class="px-4 py-2 rounded-full bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 text-xs font-bold transition-colors cursor-pointer">
          <span id="follow-text">Follow Topic Sphere +</span>
        </button>
      </div>
    </div>

    <!-- Category Pill Links -->
    <div class="flex items-center gap-2 pt-2 overflow-x-auto no-scrollbar border-t border-slate-200/60 dark:border-slate-800/60">
      {allCategories.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-colors ${
            c.slug === slug
              ? 'bg-emerald-600 text-white shadow-xs'
              : 'bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-400 hover:bg-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          {c.name}
        </a>
      ))}
    </div>
  </div>

  <!-- Social Media Connect Banner -->
  <div class="mb-5 p-3.5 sm:p-4 rounded-xl bg-gradient-to-r from-slate-900 to-slate-800 text-white border border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm">
    <div class="flex items-center gap-2.5 text-center sm:text-left">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div>
        <div class="text-xs font-bold text-white">Join the 9jaBeacon Community on Socials</div>
        <div class="text-[11px] text-slate-300">Instant breaking news, citizen debates, and fast video wire updates.</div>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href="https://facebook.com/9jabeacon"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg bg-[#1877F2] hover:bg-[#1877F2]/90 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>
        <span>Facebook</span>
      </a>

      <a
        href="https://bsky.app/profile/9jabeacon.bsky.social"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg bg-[#0085FF] hover:bg-[#0085FF]/90 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 568 501">
          <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-198.21C491.56 3.12 568-19.46 568 59.957c0 15.897-9.08 133.567-14.407 152.597-18.528 66.196-85.922 83.18-146.593 72.846 105.992 18.069 132.85 88.04 74.654 147.78-109.972 112.92-167.348-28.327-197.654-88.89-30.306 60.563-87.682 201.81-197.654 88.89-58.196-59.74-31.338-129.711 74.654-147.78C99.329 295.734 31.935 278.75 13.407 212.554 8.08 193.524 0 75.854 0 59.957 0-19.46 76.44 3.12 123.121 33.664z" />
        </svg>
        <span>Bluesky</span>
      </a>

      <a
        href="https://youtube.com/@9jabeacon"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg bg-[#FF0000] hover:bg-[#FF0000]/90 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
        <span>YouTube</span>
      </a>
    </div>
  </div>

  {topCatArticle && (
    <div class="mb-5">
      <TopStoryCard article={topCatArticle} />
    </div>
  )}

  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{category.name} Reports {page > 1 ? `(Page ${page})` : ''}</span>
      </h2>
      <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
        Showing {categoryArticles.length} stories
      </span>
    </div>

    {listArticles.length > 0 ? (
      <div class="space-y-3">
        {listArticles.map((art, idx) => (
          <>
            <ArticleCard article={art} showCategory={false} />
            {(idx === 2 || (idx === 6 && listArticles.length >= 7)) && (
              <AdSlot format="feed" />
            )}
          </>
        ))}
      </div>
    ) : (
      <div class="p-8 text-center rounded-xl border border-slate-200 dark:border-slate-800 text-slate-500 text-xs">
        No more stories in this category yet.
      </div>
    )}

    <!-- Trending Opportunities Around The Web (Smartlink Grid) -->
    <AdSlot format="opportunities-grid" />

    <!-- Category Pagination Bar -->
    <div class="pt-4 pb-2 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
      {page > 1 ? (
        <a
          href={`/category/${slug}?page=${page - 1}`}
          class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center gap-1.5 shadow-xs"
        >
          <span>&larr;</span>
          <span>Previous</span>
        </a>
      ) : (
        <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
          &larr; Previous
        </span>
      )}

      <!-- Quick Page Badges -->
      <div class="flex items-center gap-1.5">
        {page > 1 && (
          <a
            href={`/category/${slug}`}
            class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition"
          >
            1
          </a>
        )}
        {page > 2 && <span class="text-xs text-slate-400 font-mono">..</span>}
        <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white text-xs font-bold font-mono flex items-center justify-center shadow-xs">
          {page}
        </span>
        {hasNextPage && (
          <a
            href={`/category/${slug}?page=${page + 1}`}
            class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition"
          >
            {page + 1}
          </a>
        )}
      </div>

      {hasNextPage ? (
        <a
          href={`/category/${slug}?page=${page + 1}`}
          class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-xs"
        >
          <span>Next</span>
          <span>&rarr;</span>
        </a>
      ) : (
        <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
          Next &rarr;
        </span>
      )}
    </div>
  </section>
</Layout>

<script is:inline>
  const b = document.getElementById('btn-follow-category');
  const t = document.getElementById('follow-text');
  const id = b?.getAttribute('data-cat-id');
  if (id) {
    const f = localStorage.getItem(`following_cat_${id}`) === 'true';
    if (f && t) t.textContent = 'Following ✓';
    b?.addEventListener('click', () => {
      const n = localStorage.getItem(`following_cat_${id}`) !== 'true';
      localStorage.setItem(`following_cat_${id}`, String(n));
      if (t) t.textContent = n ? 'Following ✓' : 'Follow Topic Sphere +';
      window.showToast?.(n ? 'Subscribed to topic sphere alerts' : 'Unfollowed topic sphere');
    });
  }
</script>
