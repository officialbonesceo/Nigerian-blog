---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopStoryCard from '../../components/TopStoryCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getD1, getCategoryBySlug, getArticles, getCategories } from '../../lib/runtime-db';
import { getCategorySeo } from '../../lib/category-seo';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
if (slug === 'money-hustle' || slug === 'money' || slug === 'hustle') {
  return Astro.redirect('/category/business', 301);
}
const d1 = getD1(Astro.locals);
const category = await getCategoryBySlug(d1, slug);
if (!category) {
  return new Response(`<!doctype html><html lang="en"><head><meta charset="utf-8"/><title>Category Not Found - 9jaBeacon</title><meta name="robots" content="noindex, follow"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body style="background:#020617;color:#f8fafc;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:20px;text-align:center;"><div style="max-width:440px;"><div style="width:64px;height:64px;border-radius:16px;background:rgba(6,78,59,0.5);border:1px solid rgba(16,185,129,0.3);color:#34d399;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:24px;font-weight:900;">404</div><h1 style="font-size:22px;margin:0 0 8px;">Category Not Found</h1><p style="color:#94a3b8;font-size:14px;margin:0 0 24px;">That category is not available.</p><a href="/" style="display:inline-block;background:#059669;color:#fff;padding:12px 24px;border-radius:12px;text-decoration:none;font-weight:bold;font-size:14px;">Home</a></div></body></html>`, {
    status: 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const pageSize = 8;
const offset = (page - 1) * pageSize;
const catSeo = getCategorySeo(slug);

const [allCategories, fetchedArticles] = await Promise.all([
  getCategories(d1),
  getArticles(d1, { categorySlug: slug, limit: pageSize + 1, offset }),
]);

const hasNextPage = fetchedArticles.length > pageSize;
const categoryArticles = fetchedArticles.slice(0, pageSize);
const isFirstPage = page === 1;
const topCatArticle = isFirstPage ? categoryArticles[0] : null;
const listArticles = isFirstPage ? categoryArticles.slice(1) : categoryArticles;

const siteBase = 'https://www.9jabeacon.name.ng';
const pageHref = (n: number) =>
  n <= 1 ? `${siteBase}/category/${slug}` : `${siteBase}/category/${slug}/page/${n}`;
const prevUrl = page > 1 ? pageHref(page - 1) : undefined;
const nextUrl = hasNextPage ? pageHref(page + 1) : undefined;

const title =
  page > 1
    ? `${category.name} news — more stories | 9jaBeacon`
    : `${category.name} - 9jaBeacon`;
// Prefer the long SEO description; pad short DB descriptions
const baseDesc = (catSeo.description || category.description || `${category.name} news on 9jaBeacon`).trim();
const description =
  page > 1
    ? `More ${category.name} stories for Nigerian readers on 9jaBeacon. ${baseDesc.slice(0, 100)}`
    : baseDesc.length >= 120
      ? baseDesc
      : `${baseDesc} Clear updates from 9jaBeacon for everyday Nigerian readers.`;
---

<Layout
  title={title}
  description={description}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  activeNav={slug}
>
  <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-slate-100 via-white to-slate-100 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 space-y-4 mb-5 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 mb-1.5">
          <span class="w-3 h-3 rounded-full" style={`background-color: ${category.color || '#008751'}`}></span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Category</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">{category.name}</h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-lg mt-1">{category.description || catSeo.description}</p>
      </div>
    </div>

    <div class="flex items-center gap-2 pt-2 overflow-x-auto no-scrollbar border-t border-slate-200/60 dark:border-slate-800/60">
      {allCategories.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-colors ${
            c.slug === slug
              ? 'bg-emerald-600 text-white shadow-xs'
              : 'bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-400 hover:bg-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          {c.name}
        </a>
      ))}
    </div>
  </div>

  {topCatArticle && (
    <div class="mb-5">
      <TopStoryCard article={topCatArticle} />
    </div>
  )}

  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{category.name}{page > 1 ? ' — more' : ''}</span>
      </h2>
      <span class="text-xs text-slate-500 dark:text-slate-400">
        {categoryArticles.length} stories
      </span>
    </div>

    {listArticles.length > 0 ? (
      <div class="space-y-3">
        {listArticles.map((art, idx) => (
          <>
            <ArticleCard article={art} showCategory={false} />
            {idx === 2 && <AdSlot format="feed" index={1} />}
          </>
        ))}
      </div>
    ) : (
      <div class="p-8 text-center rounded-xl border border-slate-200 dark:border-slate-800 text-slate-500 text-xs">
        No more stories in this category yet.
      </div>
    )}

    <div class="pt-4 pb-2 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
      {page > 1 ? (
        <a href={page === 2 ? `/category/${slug}` : `/category/${slug}/page/${page - 1}`} class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300">← Previous</a>
      ) : (
        <span class="px-4 py-2 rounded-xl text-xs text-slate-400">← Previous</span>
      )}
      {hasNextPage ? (
        <a href={`/category/${slug}/page/${page + 1}`} class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">Next →</a>
      ) : (
        <span class="px-4 py-2 rounded-xl text-xs text-slate-400">Next →</span>
      )}
    </div>
  </section>
</Layout>
