---
import Layout from '../layouts/Layout.astro';
import TrendingBar from '../components/TrendingBar.astro';
import TopStoryCard from '../components/TopStoryCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MostReadSection from '../components/MostReadSection.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import AdsterraNativeBanner from '../components/AdsterraNativeBanner.astro';
import MarketRatesTicker from '../components/MarketRatesTicker.astro';
import {
  getD1,
  getTopStory,
  getArticles,
  getMostReadArticles,
  getBreakingArticles,
  getSiteSettings,
  getCategories,
} from '../lib/runtime-db';

import type { Article, Category } from '../lib/types';

export const prerender = false;

const d1 = getD1(Astro.locals);

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const pageSize = 10;
const offset = (page - 1) * pageSize;

let topStory: Article | null = null;
let latestArticles: Article[] = [];
let mostRead: Article[] = [];
let breakingNews: Article[] = [];
let categories: Category[] = [];
let siteSettings: Record<string, string> = {};
let heroSlides: Article[] = [];

try {
  const [top, latest, read, breaking, settings, cats] = await Promise.all([
    page === 1 ? getTopStory(d1) : Promise.resolve(null),
    getArticles(d1, { limit: pageSize + 1, offset }),
    getMostReadArticles(d1, 5),
    page === 1 ? getBreakingArticles(d1, 1) : Promise.resolve([]),
    getSiteSettings(d1),
    page === 1 ? getCategories(d1) : Promise.resolve([]),
  ]);
  topStory = top;
  latestArticles = latest || [];
  mostRead = read || [];
  breakingNews = breaking || [];
  siteSettings = settings || {};
  categories = cats || [];

  if (page === 1 && categories.length > 0) {
    const perCat = await Promise.all(
      categories.map((c) => getArticles(d1, { categoryId: c.id, limit: 1 }))
    );
    const seen = new Set<string>();
    for (const list of perCat) {
      const a = list?.[0];
      if (a && a.id && !seen.has(a.id)) {
        seen.add(a.id);
        heroSlides.push(a);
      }
    }
  }
} catch (e) {
  console.error('[index.astro] Error loading articles:', e);
}

const hasNextPage = latestArticles.length > pageSize;
// Always show full page of stories in the list (including ones also in the carousel)
const currentFeed = latestArticles.slice(0, pageSize);

const rawSiteBase = (siteSettings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteBase = rawSiteBase === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteBase;
const prevUrl = page > 1 ? (page === 2 ? `${siteBase}/` : `${siteBase}/?page=${page - 1}`) : undefined;
const nextUrl = hasNextPage ? `${siteBase}/?page=${page + 1}` : undefined;

let effectiveTopStory: Article | null = null;
if (page === 1) {
  const heroCandidatePool: Article[] = [];
  const seenIds = new Set<string>();
  const poolSources = [
    topStory,
    ...breakingNews,
    ...mostRead.slice(0, 3),
    ...currentFeed.slice(0, 4),
  ].filter((art): art is Article => Boolean(art && art.id));
  for (const art of poolSources) {
    if (!seenIds.has(art.id)) {
      seenIds.add(art.id);
      heroCandidatePool.push(art);
    }
  }
  if (heroCandidatePool.length > 0) {
    heroCandidatePool.sort((a, b) => {
      const timeA = a.published_at ? new Date(a.published_at).getTime() : 0;
      const timeB = b.published_at ? new Date(b.published_at).getTime() : 0;
      return timeB - timeA;
    });
    effectiveTopStory = heroCandidatePool[0];
  }
}

const carouselEnabled = (siteSettings.hero_carousel_enabled ?? '1') !== '0';
const useCarousel = page === 1 && carouselEnabled && heroSlides.length > 0;

const DEFAULT_ADSTERRA_CONTAINER = 'container-4e5de78ab786afbf822590e03b1b657e';
const DEFAULT_ADSTERRA_SCRIPT =
  'https://pl31396495.profitableratecpmnetwork.com/4e5de78ab786afbf822590e03b1b657e/invoke.js';
const heroAdContainer =
  siteSettings.hero_adsterra_container_id ||
  siteSettings.adsterra_container_id ||
  DEFAULT_ADSTERRA_CONTAINER;
const heroAdScript =
  siteSettings.hero_adsterra_script_url ||
  siteSettings.adsterra_script_url ||
  DEFAULT_ADSTERRA_SCRIPT;
const smartLink =
  siteSettings.ad_smartlink_url ||
  'https://www.profitableratecpmnetwork.com/ip0y1pan?key=406d5b2ea65353486dc2e9a7547d5ead';
---

<Layout
  title={page > 1 ? `9jaBeacon - Verified Nigerian News (Page ${page})` : '9jaBeacon - Your Trusted Light on Nigerian News'}
  description={page > 1 ? `Explore page ${page} of verified Nigerian news, politics, business, tech, and cultural dispatches on 9jaBeacon.` : siteSettings.site_tagline || "Nigeria's independent digital newsroom. Delivering fast, verified Nigerian news, politics, business, tech, and cultural updates."}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  activeNav="home"
>
  {page === 1 && breakingNews[0] && (
    <div class="mb-3 p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 flex items-center gap-2">
      <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[9px] font-black uppercase tracking-wider shrink-0 animate-pulse">
        BREAKING
      </span>
      <a href={`/news/${breakingNews[0].slug}`} class="text-xs font-semibold text-red-200 truncate hover:text-white transition-colors">
        {breakingNews[0].title}
      </a>
    </div>
  )}

  {page === 1 && <TrendingBar />}

  <div class="my-3 p-3 sm:p-3.5 rounded-xl bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white border border-slate-700/80 flex flex-col sm:flex-row items-center justify-between gap-2.5 shadow-sm">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-bold text-white block">Follow 9jaBeacon Official Community</span>
        <span class="text-[10px] text-slate-300 block sm:inline">Join thousands of Nigerians for verified wire alerts and debates.</span>
      </div>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <a href="https://facebook.com/9jabeacon" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-[#1877F2] text-white text-[11px] font-bold">Facebook</a>
      <a href="https://bsky.app/profile/9jabeacon.bsky.social" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-[#0085FF] text-white text-[11px] font-bold">Bluesky</a>
      <a href="https://youtube.com/@9jabeacon" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-[#FF0000] text-white text-[11px] font-bold">YouTube</a>
    </div>
  </div>

  {page === 1 && useCarousel && (
    <HeroCarousel
      slides={heroSlides}
      adsterraContainerId={heroAdContainer}
      adsterraScriptUrl={heroAdScript}
      smartLinkUrl={smartLink}
    />
  )}
  {page === 1 && !useCarousel && effectiveTopStory && (
    <div class="mt-2 mb-6">
      <TopStoryCard article={effectiveTopStory} />
    </div>
  )}

  {currentFeed.length > 0 ? (
    <section class="mt-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{page === 1 ? 'Latest News' : `News Archive (Page ${page})`}</span>
        </h2>
        <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
          {page > 1 ? `Page ${page}` : `${currentFeed.length} stories`}
        </span>
      </div>
      <div class="space-y-2.5">
        {currentFeed.map((article, idx) => (
          <>
            <ArticleCard article={article} />
            {((currentFeed.length <= 3 && idx === 1) || (currentFeed.length > 3 && idx === 2)) && (
              <AdSlot format="feed" index={1} />
            )}
            {currentFeed.length > 4 && idx === 4 && (
              <AdSlot format="breaking-teaser" index={2} />
            )}
          </>
        ))}
      </div>

      <div class="pt-4 pb-2 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        {page > 1 ? (
          <a href={page === 2 ? '/' : `/?page=${page - 1}`} class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition">&larr; Previous</a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">&larr; Previous</span>
        )}
        <div class="flex items-center gap-1.5">
          {page > 1 && <a href="/" class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono flex items-center justify-center">1</a>}
          {page > 2 && <span class="text-xs text-slate-400 font-mono">..</span>}
          <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white text-xs font-bold font-mono flex items-center justify-center">{page}</span>
          {hasNextPage && <a href={`/?page=${page + 1}`} class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono flex items-center justify-center">{page + 1}</a>}
        </div>
        {hasNextPage ? (
          <a href={`/?page=${page + 1}`} class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition">Next &rarr;</a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">Next &rarr;</span>
        )}
      </div>
    </section>
  ) : (
    <div class="mt-4 mb-6 p-8 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-3">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">End of Stories</h2>
      <a href="/" class="inline-block px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">Return to Front Page</a>
    </div>
  )}

  <AdsterraNativeBanner className="my-6" />

  {mostRead.length > 0 && (
    <MostReadSection articles={mostRead} />
  )}

  {/* Full FX wire: official + parallel + live calculator */}
  {page === 1 && <MarketRatesTicker />}

  <FAQSection />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "name": "9jaBeacon Daily Naira FX & Exchange Rate Intelligence",
    "description": "Daily verified exchange rates for USD to NGN, GBP to Naira, Euro to NGN, and USDT P2P parallel street rates in Nigeria.",
    "url": `${siteBase}/market-rates`,
    "areaServed": "NG",
    "currenciesAccepted": "NGN, USD, GBP, EUR, CAD, USDT",
    "provider": { "@type": "NewsMediaOrganization", "name": "9jaBeacon", "url": siteBase }
  })} />
</Layout>
