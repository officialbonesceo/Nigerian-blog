---
import Layout from '../layouts/Layout.astro';
import TrendingBar from '../components/TrendingBar.astro';
import TopStoryCard from '../components/TopStoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MostReadSection from '../components/MostReadSection.astro';
import { getD1, getTopStory, getArticles, getMostReadArticles, getBreakingArticles } from '../lib/runtime-db';

const d1 = getD1(Astro.locals);
const [topStory, latestArticles, mostRead, breakingNews] = await Promise.all([
  getTopStory(d1), getArticles(d1, { limit: 8 }), getMostReadArticles(d1, 4), getBreakingArticles(d1, 1)
]);
const filteredLatest = latestArticles.filter((art) => art.id !== topStory?.id).slice(0, 5);
---
<Layout title="9jaBeacon - Your Trusted Light on Nigerian News" activeNav="home">
  {breakingNews[0] && <div class="mb-3 p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 flex items-center gap-2"><span class="px-2 py-0.5 rounded bg-red-600 text-white text-[9px] font-black uppercase">BREAKING</span><a href={`/news/${breakingNews[0].slug}`} class="text-xs font-semibold text-red-200 truncate">{breakingNews[0].title}</a></div>}
  <TrendingBar />
  {topStory && <div class="mt-2 mb-6"><TopStoryCard article={topStory} /></div>}
  <section class="mt-4 space-y-3"><div class="flex items-center justify-between"><h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">Latest News</h2><a href="/category/naija-news" class="text-xs font-semibold text-emerald-600">View all →</a></div><div class="space-y-2.5">{filteredLatest.map((article) => <ArticleCard article={article} />)}</div></section>
  <MostReadSection articles={mostRead} />
  <section class="mt-10 p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3"><h3 class="text-sm font-bold text-slate-900 dark:text-white">Why 9jaBeacon?</h3><p class="text-xs text-slate-500 dark:text-slate-400">Fast. Verified. Built for Nigerian readers. News is delivered directly from our Cloudflare D1 database.</p></section>
</Layout>
