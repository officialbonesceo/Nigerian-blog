---
import Layout from '../layouts/Layout.astro';
import TrendingBar from '../components/TrendingBar.astro';
import TopStoryCard from '../components/TopStoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MostReadSection from '../components/MostReadSection.astro';
import AdSlot from '../components/AdSlot.astro';
import {
  getD1,
  getTopStory,
  getArticles,
  getMostReadArticles,
  getBreakingArticles,
  getSiteSettings,
} from '../lib/runtime-db';

import type { Article } from '../lib/types';

export const prerender = false;

const d1 = getD1(Astro.locals);

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const pageSize = 8;
const offset = (page - 1) * pageSize;

let topStory: Article | null = null;
let latestArticles: Article[] = [];
let mostRead: Article[] = [];
let breakingNews: Article[] = [];

let siteSettings: Record<string, string> = {};

try {
  const [top, latest, read, breaking, settings] = await Promise.all([
    page === 1 ? getTopStory(d1) : Promise.resolve(null),
    getArticles(d1, { limit: pageSize + 1, offset }),
    getMostReadArticles(d1, 5),
    page === 1 ? getBreakingArticles(d1, 1) : Promise.resolve([]),
    getSiteSettings(d1),
  ]);
  topStory = top;
  latestArticles = latest || [];
  mostRead = read || [];
  breakingNews = breaking || [];
  siteSettings = settings || {};
} catch (e) {
  console.error('[index.astro] Error loading articles:', e);
}

const isMonetagEnabled = siteSettings.monetag_enabled === '1' || siteSettings.monetag_enabled === 'true';
const monetagInArticleZoneId = siteSettings.monetag_in_article_zone || '';
const monetagAdCode = siteSettings.monetag_ad_code || '';
const monetagSmartLink = siteSettings.monetag_smartlink_url || '';

const hasNextPage = latestArticles.length > pageSize;
const currentFeed = latestArticles.slice(0, pageSize);

// Ensure there is always an effective top story on page 1 if any articles exist
const effectiveTopStory = page === 1 ? (topStory || (currentFeed.length > 0 ? currentFeed[0] : null)) : null;
const filteredLatest = page === 1
  ? currentFeed.filter((art) => art.id !== effectiveTopStory?.id).slice(0, 6)
  : currentFeed;
---

<Layout title={`9jaBeacon - Your Trusted Light on Nigerian News ${page > 1 ? `(Page ${page})` : ''}`} activeNav="home">
  <!-- Breaking News Ticker (Page 1) -->
  {page === 1 && breakingNews[0] && (
    <div class="mb-3 p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 flex items-center gap-2">
      <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[9px] font-black uppercase tracking-wider shrink-0 animate-pulse">
        BREAKING
      </span>
      <a href={`/news/${breakingNews[0].slug}`} class="text-xs font-semibold text-red-200 truncate hover:text-white transition-colors">
        {breakingNews[0].title}
      </a>
    </div>
  )}

  {page === 1 && <TrendingBar />}

  <!-- High-Visibility Community Socials Ribbon -->
  <div class="my-3 p-3 sm:p-3.5 rounded-xl bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white border border-slate-700/80 flex flex-col sm:flex-row items-center justify-between gap-2.5 shadow-sm">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-bold text-white block">Follow 9jaBeacon Official Community</span>
        <span class="text-[10px] text-slate-300 block sm:inline">Join thousands of Nigerians for verified wire alerts and debates.</span>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href="https://facebook.com/9jabeacon"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 rounded-lg bg-[#1877F2] hover:bg-[#1877F2]/90 text-white text-[11px] font-bold flex items-center gap-1.5 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>
        <span>Facebook</span>
      </a>

      <a
        href="https://tiktok.com/@9jabeacon"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 rounded-lg bg-black hover:bg-slate-950 text-white text-[11px] font-bold flex items-center gap-1.5 border border-slate-700 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        </svg>
        <span>TikTok</span>
      </a>

      <a
        href="https://youtube.com/@9jabeacon"
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 rounded-lg bg-[#FF0000] hover:bg-[#FF0000]/90 text-white text-[11px] font-bold flex items-center gap-1.5 shadow-xs transition-transform active:scale-95"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
        <span>YouTube</span>
      </a>
    </div>
  </div>

  <!-- Top Story Spotlight (Page 1) -->
  {page === 1 && effectiveTopStory && (
    <div class="mt-2 mb-6">
      <TopStoryCard article={effectiveTopStory} />
    </div>
  )}

  <!-- Latest News Feed -->
  {filteredLatest.length > 0 ? (
    <section class="mt-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{page === 1 ? 'Latest News' : `News Archive (Page ${page})`}</span>
        </h2>
        <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">
          {page > 1 ? `Page ${page}` : 'Live Updates'}
        </span>
      </div>
      <div class="space-y-2.5">
        {filteredLatest.map((article, idx) => (
          <>
            <ArticleCard article={article} />
            {(idx === 2 || (idx === 6 && filteredLatest.length >= 7)) && (
              <AdSlot
                format="feed"
                isMonetagEnabled={isMonetagEnabled}
                inArticleZoneId={monetagInArticleZoneId}
                adCodeSnippet={monetagAdCode}
                smartLinkUrl={monetagSmartLink}
              />
            )}
          </>
        ))}
      </div>

      <!-- Feed Pagination Controls -->
      <div class="pt-4 pb-2 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        {page > 1 ? (
          <a
            href={page === 2 ? '/' : `/?page=${page - 1}`}
            class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center gap-1.5 shadow-xs"
          >
            <span>&larr;</span>
            <span>Previous</span>
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
            &larr; Previous
          </span>
        )}

        <!-- Quick Page Badges -->
        <div class="flex items-center gap-1.5">
          {page > 1 && (
            <a
              href="/"
              class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition"
            >
              1
            </a>
          )}
          {page > 2 && <span class="text-xs text-slate-400 font-mono">..</span>}
          <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white text-xs font-bold font-mono flex items-center justify-center shadow-xs">
            {page}
          </span>
          {hasNextPage && (
            <a
              href={`/?page=${page + 1}`}
              class="w-8 h-8 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold font-mono text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition"
            >
              {page + 1}
            </a>
          )}
        </div>

        {hasNextPage ? (
          <a
            href={`/?page=${page + 1}`}
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-xs"
          >
            <span>Next</span>
            <span>&rarr;</span>
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
            Next &rarr;
          </span>
        )}
      </div>
    </section>
  ) : (
    <div class="mt-4 mb-6 p-8 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center space-y-3 shadow-xs">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">End of Stories</h2>
      <p class="text-xs text-slate-600 dark:text-slate-400 max-w-md mx-auto">
        You have reached the end of the news catalog.
      </p>
      <a href="/" class="inline-block px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">
        Return to Front Page
      </a>
    </div>
  )}

  <!-- Most Read Section -->
  {mostRead.length > 0 && (
    <MostReadSection articles={mostRead} />
  )}
</Layout>

