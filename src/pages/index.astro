---
import Layout from '../layouts/Layout.astro';
import TrendingBar from '../components/TrendingBar.astro';
import TopStoryCard from '../components/TopStoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MostReadSection from '../components/MostReadSection.astro';
import { getTopStory, getArticles, getMostReadArticles, getBreakingArticles } from '../lib/db';

const topStory = getTopStory();
const latestArticles = getArticles({ limit: 8 });
// Filter out the top story from latest list so it doesn't appear twice
const filteredLatest = latestArticles.filter((art) => art.id !== topStory?.id).slice(0, 5);
const mostRead = getMostReadArticles(4);
const breakingNews = getBreakingArticles(1);
---

<Layout title="9jaBeacon - Your Trusted Light on Nigerian News" activeNav="home">
  <!-- Breaking News Alert Banner (if active) -->
  {breakingNews.length > 0 && (
    <div class="mb-3 p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 flex items-center justify-between gap-2.5 animate-fade-in">
      <div class="flex items-center gap-2 min-w-0">
        <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[9px] font-black uppercase tracking-wider shrink-0 animate-pulse font-mono">
          BREAKING
        </span>
        <a href={`/article/${breakingNews[0].slug}`} class="text-xs font-semibold text-red-200 hover:text-white truncate">
          {breakingNews[0].title}
        </a>
      </div>
      <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  )}

  <!-- Trending Pills Bar -->
  <TrendingBar />

  <!-- Top Story Hero Card -->
  {topStory && (
    <div class="mt-2 mb-6">
      <TopStoryCard article={topStory} />
    </div>
  )}

  <!-- Latest News Feed -->
  <section class="mt-4 space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2 font-sans">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Latest News
      </h2>
      <a href="/category/politics" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors flex items-center gap-1">
        View all
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="space-y-2.5">
      {filteredLatest.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

  <!-- Most Read Section -->
  <MostReadSection articles={mostRead} />

  <!-- Why 9jaBeacon Value Proposition Banner -->
  <section class="mt-10 p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xs dark:shadow-none space-y-4">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-black text-xs">
        🇳🇬
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Why 9jaBeacon?</h3>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">Fast. Verified. Unbiased Nigerian Journalism.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-1">
        <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Built for Speed
        </span>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
          Optimized for lightning-fast loading on mobile and Android devices.
        </p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-1">
        <span class="text-sky-600 dark:text-sky-400 font-bold text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Trusted Sources
        </span>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
          Full attribution and citation of official government & permitted media.
        </p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-1">
        <span class="text-amber-600 dark:text-amber-400 font-bold text-xs flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Always Up-to-Date
        </span>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
          Periodic automated synchronization powered by Cloudflare Workers & D1.
        </p>
      </div>
    </div>
  </section>
</Layout>
