---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';

export const prerender = false;

const db = getD1(Astro.locals);
const settings = await getSiteSettings(db);

const siteName = settings.site_name || '9jaBeacon';
const siteUrl = (settings.site_url || 'https://9jabeacon.name.ng').replace(/\/+$/, '');
const contactEmail = settings.contact_email || settings.admin_email || 'officialbonesceo@gmail.com';
const twitterHandle = settings.twitter_handle || '@9jaBeacon';
---

<Layout
  title={`Contact Us & Advertising | ${siteName}`}
  description={`Get in touch with ${siteName}'s editorial newsroom for news tips, partnership proposals, brand advertising, and press releases.`}
  canonicalUrl={`${siteUrl}/contact`}
>
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span>/</span>
    <span class="text-slate-800 dark:text-slate-200">Contact & Advertising</span>
  </nav>

  <article class="bg-white dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xs space-y-10">
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Editorial Desk & Partner Inquiries</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
        Contact & Advertising
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl">
        Connect with our independent newsroom for editorial scoops, press releases, sponsored partnerships, or media inquiries.
      </p>
    </header>

    <!-- 3 Core Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Advertising & Partnerships -->
      <div id="advertise" class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-200 dark:border-emerald-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Advertising & Media</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Reach thousands of verified Nigerian business leaders, tech founders, and policymakers. In-feed banners and sponsored articles.
        </p>
        <div class="pt-2">
          <a href={`mailto:${contactEmail}?subject=Advertising%20Inquiry%20-%209jaBeacon`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
            {contactEmail} &rarr;
          </a>
        </div>
      </div>

      <!-- Editorial News Tips -->
      <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-200 dark:border-emerald-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Editorial & News Tips</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Got a verified breaking news tip or confidential story lead? Our reporting desk protects confidential sources rigorously.
        </p>
        <div class="pt-2">
          <a href={`mailto:${contactEmail}?subject=News%20Tip%20-%20Confidential`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
            Send confidential tip &rarr;
          </a>
        </div>
      </div>

      <!-- Social & Community -->
      <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center border border-emerald-200 dark:border-emerald-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Social Channels</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Follow breaking bulletins and direct messages on our official Twitter / X desk and video channels.
        </p>
        <div class="pt-2">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
            {twitterHandle}
          </span>
        </div>
      </div>
    </div>

    <!-- Interactive Contact & Advertising Form -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 space-y-6">
      <div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Send Us a Direct Message</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Our team reviews submissions continuously and replies within 24 business hours.
        </p>
      </div>

      <form id="contactForm" class="space-y-4 max-w-xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="contactName" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Your Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="contactName"
              name="name"
              required
              placeholder="e.g. Adebayo Adeleke"
              class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:outline-hidden focus:border-emerald-500 dark:focus:border-emerald-500 text-slate-900 dark:text-white"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contactEmailInput" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Email Address <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="contactEmailInput"
              name="email"
              required
              placeholder="e.g. name@company.com"
              class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:outline-hidden focus:border-emerald-500 dark:focus:border-emerald-500 text-slate-900 dark:text-white"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="contactSubject" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Inquiry Type
          </label>
          <select
            id="contactSubject"
            name="subject"
            class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:outline-hidden focus:border-emerald-500 dark:focus:border-emerald-500 text-slate-900 dark:text-white"
          >
            <option value="advertising">Advertising, Sponsored Article or Banner Placement</option>
            <option value="tip">Verified Editorial News Tip</option>
            <option value="partnership">Media Partnership / Syndication</option>
            <option value="general">General Inquiries</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="contactMessage" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Message Details <span class="text-red-500">*</span>
          </label>
          <textarea
            id="contactMessage"
            name="message"
            rows="5"
            required
            placeholder="Provide brief details on your campaign budget, target launch date, or news lead..."
            class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:outline-hidden focus:border-emerald-500 dark:focus:border-emerald-500 text-slate-900 dark:text-white"
          ></textarea>
        </div>

        <div id="contactStatus" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

        <button
          type="submit"
          id="contactSubmitBtn"
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white text-xs font-bold transition-all shadow-xs inline-flex items-center gap-2"
        >
          <span>Send Inquiry</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>
    </div>
  </article>

  <script is:inline>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const status = document.getElementById('contactStatus');
      const btn = document.getElementById('contactSubmitBtn');
      if (!status || !btn) return;

      btn.disabled = true;
      btn.textContent = 'Sending...';

      setTimeout(() => {
        status.className = 'p-3.5 rounded-xl text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
        status.textContent = 'Thank you! Your message has been received by our editorial desk. We will respond within 24 business hours.';
        status.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Message Sent';
        document.getElementById('contactForm').reset();
      }, 600);
    });
  </script>
</Layout>
