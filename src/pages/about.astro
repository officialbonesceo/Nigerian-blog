---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';

export const prerender = false;

const db = getD1(Astro.locals);
const settings = await getSiteSettings(db);

const siteName = settings.site_name || '9jaBeacon';
const rawSiteUrl = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteUrl = rawSiteUrl === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteUrl;
const contactEmail = settings.contact_email || settings.admin_email || 'officialbonesceo@gmail.com';
const lastUpdated = 'November 23, 2026';
---

<Layout
  title={`About | ${siteName}`}
  description={`${siteName} is a Nigerian news site. We report politics, business, sports, and world stories in plain language, with sources named.`}
  canonicalUrl={`${siteUrl}/about`}
  activeNav="about"
>
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span>/</span>
    <span class="text-slate-800 dark:text-slate-200">About</span>
  </nav>

  <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 shadow-xs space-y-8 transition-colors">
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <p class="text-xs text-slate-500">Updated: {lastUpdated}</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        About {siteName}
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        {siteName} is a <strong class="text-slate-800 dark:text-slate-200">Nigerian news site</strong>.
        We publish short, clear reports on politics, money, sports, and world stories for readers in Nigeria and the diaspora.
      </p>
    </header>

    <div class="space-y-6 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">What we are</h2>
        <p>
          We are a <strong>news site</strong> — not a personal diary blog and not a formal newspaper company.
          Our job is to take public information and explain it in plain English so people can stay informed.
        </p>
        <p>
          Like most online news sites, we use advertising and partner links to help cover costs.
          That does not change our goal: clear reporting with sources named.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Where stories come from</h2>
        <p>
          Reports are based on information that is already public — newspaper reports, official statements,
          and other open sources. When we use a story, we name the source (for example, “According to Punch…”).
        </p>
        <p>
          Other outlets can make mistakes and later update their own reports. We correct ours when we notice an error.
          We do not claim to be the original investigators of every story we cover.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Images</h2>
        <p>
          We do not republish copyrighted photos from other newspapers.
          Article images come from free licensed sources (Unsplash or Wikimedia Commons)
          or from our own 9jaBeacon editorial graphics.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">What we cover</h2>
        <ul class="list-disc pl-5 space-y-1 text-slate-600 dark:text-slate-400">
          <li>Nigeria news and politics</li>
          <li>Money, markets, and business</li>
          <li>Sports</li>
          <li>World stories that matter to Nigerian readers</li>
        </ul>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Corrections and contact</h2>
        <p>
          If something is wrong, or you need a credit fixed, email us. We will look at it as soon as we can.
        </p>
        <p>
          <a href={`mailto:${contactEmail}`} class="text-emerald-600 dark:text-emerald-400 font-semibold hover:underline">{contactEmail}</a>
          · <a href={siteUrl} class="text-emerald-600 dark:text-emerald-400 font-semibold hover:underline">{siteUrl}</a>
        </p>
      </section>
    </div>
  </article>
</Layout>
