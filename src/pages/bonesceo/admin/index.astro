      const startIndex = (adminRejectedCurrentPage - 1) * adminRejectedPageSize;
      const endIndex = Math.min(startIndex + adminRejectedPageSize, total);

      items.forEach((item, idx) => {
        item.style.display = idx >= startIndex && idx < endIndex ? '' : 'none';
