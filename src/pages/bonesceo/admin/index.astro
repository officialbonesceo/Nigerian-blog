                &larr; Prev
              </button>
              <span id="rejected-page-indicator" class="font-mono text-slate-400 px-2">
                Page 1
              </span>
              <button
                id="rejected-next-btn"
                onclick="changeRejectedPage(1)"
                class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
              >
                Next &rarr;
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

