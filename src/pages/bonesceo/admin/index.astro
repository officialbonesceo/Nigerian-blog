                  <span>Sitemap.xml</span>
                  <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                <a
                  href="/rss.xml"
                  target="_blank"
                  class="p-2 rounded-lg bg-slate-950 border border-slate-800 hover:border-slate-700 text-slate-300 text-center flex items-center justify-center gap-1 text-[11px]"
                >
                  <span>RSS Feed</span>
                  <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                <a
                  href="/robots.txt"
                  target="_blank"
                  class="p-2 rounded-lg bg-slate-950 border border-slate-800 hover:border-slate-700 text-slate-300 text-center flex items-center justify-center gap-1 text-[11px]"
                >
                  <span>Robots.txt</span>
                  <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>

              <!-- Buttons: Save & Live Test -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                <button
                  type="submit"
                  class="w-full py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition cursor-pointer shadow-md shadow-emerald-500/10 flex items-center justify-center gap-1.5"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>Save SEO & Verification</span>
                </button>
                <button
                  type="button"
                  onclick="checkLiveVerificationTags()"
                  class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition cursor-pointer border border-slate-700 flex items-center justify-center gap-1.5"
                >
                  <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Verify Live &lt;head&gt; Status</span>
                </button>
              </div>

              <!-- Live Head Verification Scan Results Box -->
              <div id="seoVerificationCheckResult" class="hidden p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-xs"></div>
            </form>

            <!-- SEO Submission Directory Accordion Guide -->
            <details class="group mt-4 rounded-xl bg-slate-950/80 border border-slate-800 p-3.5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer font-bold text-xs text-slate-200 hover:text-white">
                <span class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <span>Top Sites to Submit 9jaBeacon for High SEO & Traffic</span>
                </span>
                <span class="transition group-open:rotate-180 text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </span>
              </summary>

              <div class="mt-3.5 space-y-3 pt-3 border-t border-slate-800/80 text-[11px] text-slate-300">
                <!-- Group 1: Global Search Engines -->
                <div>
                  <div class="font-bold text-xs text-white mb-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Major Search Engines
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <a href="https://webmaster.yandex.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-red-500/50 block group">
                      <div class="font-semibold text-red-400 group-hover:underline">1. Yandex Webmaster</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Submit site & sitemap. Huge global search engine & rapid indexer.</p>
                    </a>
                    <a href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-blue-500/50 block group">
                      <div class="font-semibold text-blue-400 group-hover:underline">2. Google Search Console</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">95%+ market share in Nigeria. Essential for organic traffic & sitemaps.</p>
                    </a>
                    <a href="https://www.bing.com/webmasters" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-teal-500/50 block group">
                      <div class="font-semibold text-teal-400 group-hover:underline">3. Bing Webmaster Tools</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Powers Bing, Yahoo, DuckDuckGo, and Copilot AI summaries.</p>
                    </a>
                    <a href="https://www.indexnow.org/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-cyan-500/50 block group">
                      <div class="font-semibold text-cyan-400 group-hover:underline">4. IndexNow Protocol</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Instantly notifies Bing, Yandex, and Seznam when stories publish.</p>
                    </a>
                  </div>
                </div>

                <!-- Group 2: News Media Aggregators -->
                <div>
                  <div class="font-bold text-xs text-white mb-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> News Publishers & Aggregators
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <a href="https://publishercenter.google.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-emerald-500/50 block group">
                      <div class="font-semibold text-emerald-400 group-hover:underline">5. Google News Publisher Center</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Submit your RSS feed (<code class="text-slate-300 font-mono">/rss.xml</code>) to appear in Google News carousels.</p>
                    </a>
                    <a href="https://partner.msn.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-blue-400/50 block group">
                      <div class="font-semibold text-blue-300 group-hover:underline">6. Microsoft Start Partner Hub</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Powers Windows 11 desktop news widgets and Microsoft Edge feeds.</p>
                    </a>
                    <a href="https://scoopernews.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-amber-400/50 block group">
                      <div class="font-semibold text-amber-300 group-hover:underline">7. Scooper & Opera News</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Dominant mobile browser aggregators in Nigeria. Feed: <code class="text-slate-300 font-mono">/scooper-feed.xml</code>.</p>
                    </a>
                    <a href="https://business.pinterest.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-rose-400/50 block group">
                      <div class="font-semibold text-rose-300 group-hover:underline">8. Pinterest Business</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Claim domain for Rich Article Pins and viral visual search traffic.</p>
                    </a>
                  </div>
                </div>

                <!-- Group 3: Verification & Auditing -->
                <div>
                  <div class="font-bold text-xs text-white mb-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span> Social Verification & SEO Auditing
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <a href="https://business.facebook.com/" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-indigo-400/50 block group">
                      <div class="font-semibold text-indigo-300 group-hover:underline">9. Meta / Facebook Business</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">Verify domain to enable link previews, ads, and prevent false spam flagging.</p>
                    </a>
                    <a href="https://ahrefs.com/webmaster-tools" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-orange-400/50 block group">
                      <div class="font-semibold text-orange-400 group-hover:underline">10. Ahrefs Webmaster Tools</div>
                      <p class="text-[10px] text-slate-400 mt-0.5">100% Free: Monitor backlinks, indexing health, and keyword rankings.</p>
                    </a>
                  </div>
                </div>
              </div>
            </details>
          </div>

          <!-- Diagnostics & Live Pipeline Output -->
          <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
            <div>
              <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                <span>Editorial Pipeline Diagnostic Test</span>
              </h3>
              <p class="text-xs text-slate-400 mt-1">
                Runs a sample Nigerian business lead through the cascade and verifies each tier's response time and schema validity.
              </p>

              <div id="aiTestResultBox" class="mt-4 p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs text-slate-300">
                <div class="text-slate-500">// Press "Test Pipeline" to execute live end-to-end multi-tier test...</div>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 text-xs space-y-2">
              <div class="font-bold text-slate-300">Why Automated Fallback Matters:</div>
              <p class="text-slate-400 text-[11px] leading-relaxed">
                If internet access fluctuates or cloud quotas expire, your local downloaded small models (e.g. Qwen 2.5 3B / Ollama) step in without crashing the news pipeline.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: SOURCES -->
    <div id="tab-content-sources" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-white">Configured Nigerian & Global RSS Sources</h2>
            <p class="text-xs text-slate-400">Manage wire feeds, toggle ingestion status, and test feed responsiveness.</p>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="p-3">Source Name</th>
                <th class="p-3">Feed URL</th>
                <th class="p-3">Default Category</th>
                <th class="p-3">Last Fetched</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {sources.map(s => (
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="p-3 font-bold text-white whitespace-nowrap">{s.name}</td>
                  <td class="p-3 text-slate-400 font-mono text-[11px] max-w-xs truncate">{s.feed_url}</td>
                  <td class="p-3 text-slate-300">{s.category_name || 'General'}</td>
                  <td class="p-3 text-slate-400 whitespace-nowrap">{s.last_fetched_at ? new Date(s.last_fetched_at).toLocaleTimeString() : 'Never'}</td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                      s.is_enabled ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-400'
                    }`}>
                      {s.is_enabled ? 'ACTIVE' : 'DISABLED'}
                    </span>
                  </td>
                  <td class="p-3 text-right whitespace-nowrap">
                    <button
                      onclick={`triggerCrawlForSingleSource('${s.id}')`}
                      class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[11px] font-semibold transition"
                    >
                      Fetch Now
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 5: PUBLISHED ARTICLES -->
    <div id="tab-content-articles" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>Published Articles Inventory</span>
              <span id="admin-articles-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-950 text-emerald-300 border border-emerald-800">
                {articles.length} total
              </span>
            </h2>
            <p class="text-xs text-slate-400">All stories currently live on 9jaBeacon with synthesis attributions and verified pagination.</p>
          </div>

          <!-- Controls: Search & Category Filter -->
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="text"
              id="admin-articles-search"
              placeholder="Filter by title or wire..."
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 w-44 sm:w-56"
            />
            <select
              id="admin-articles-category"
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="">All Categories</option>
              <option value="naija-news">Naija News</option>
              <option value="business">Business</option>
              <option value="sports">Sports</option>
              <option value="world">World</option>
            </select>
            <select
              id="admin-articles-pagesize"
              class="px-2.5 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="8">8 / page</option>
              <option value="16" selected>16 / page</option>
              <option value="32">32 / page</option>
            </select>
          </div>
        </div>

        <!-- Quality Control & AI Health Maintenance Banner -->
        <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-xs font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Content Quality & Image Health</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">
              Instantly purge old boilerplate text, fix blurry AI images with crisp vector SVG cards, or check database integrity.
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onclick="scanCorruptedArticles()"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition cursor-pointer"
            >
              Scan Health
            </button>
            <button
              type="button"
              onclick="fixAllBadImages()"
              title="Replace any blurry AI images or publisher logos with vector SVG cards"
              class="px-3 py-1.5 rounded-lg bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-300 border border-emerald-800 text-xs font-semibold transition cursor-pointer"
            >
              Clean Blurry Images &rarr; SVG
            </button>
            <button
              type="button"
              onclick="purgeCorruptedArticles()"
              title="Purge articles with old fake template boilerplate"
              class="px-3 py-1.5 rounded-lg bg-red-950/50 hover:bg-red-900/70 text-red-300 border border-red-900/60 text-xs font-semibold transition cursor-pointer"
            >
              Purge Corrupted News
            </button>
          </div>
        </div>

        {articles.length === 0 ? (
          <div class="p-8 text-center rounded-xl bg-slate-950 border border-slate-800 text-slate-400 text-xs space-y-2">
            <div>No articles found in the database.</div>
            <button onclick="triggerCrawlWorkflow()" class="px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold text-xs cursor-pointer hover:bg-emerald-400">
              Run AI Ingestion Workflow Now
            </button>
          </div>
        ) : (
          <div>
            <div id="admin-articles-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {articles.map((a, idx) => (
                <div
                  id={`article-card-${a.id}`}
                  class="admin-article-card p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2.5"
                  data-index={idx}
                  data-id={a.id}
                  data-title={(a.title || '').toLowerCase()}
                  data-cat={(a.category_slug || a.category_id || '').toLowerCase()}
                  data-source={(a.source_name || '').toLowerCase()}
                >
                  <div class="flex items-start justify-between gap-2">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-900 text-emerald-400 border border-slate-800">
                      {a.category_name || a.category_id}
                    </span>
                    <span class="text-[10px] text-slate-500 font-mono">{a.views_count || 0} reads</span>
                  </div>
                  <h3 class="font-bold text-sm text-white line-clamp-2 hover:text-emerald-400 transition" id={`article-title-${a.id}`}>
                    <a href={`/news/${a.slug}`} target="_blank">{a.title}</a>
                  </h3>
                  <p class="text-xs text-slate-400 line-clamp-2" id={`article-summary-${a.id}`}>{a.summary}</p>
                  
                  <div class="pt-2 flex items-center justify-between text-[10px] text-slate-500 border-t border-slate-900">
                    <span>Wire: {a.source_name || 'Direct'}</span>
                    <span class="text-slate-400 font-mono">{a.published_at ? new Date(a.published_at).toLocaleDateString() : 'Recent'}</span>
                  </div>

                  <!-- Article Actions: View, Edit, AI Rewrite, Delete -->
                  <div class="pt-2 flex items-center justify-between gap-2 border-t border-slate-900/80">
                    <a
                      href={`/news/${a.slug}`}
                      target="_blank"
                      class="px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white text-[11px] font-medium transition inline-flex items-center gap-1"
                    >
                      <span>View</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>

                    <div class="flex items-center gap-1.5">
                      <button
                        type="button"
                        onclick={`openEditArticleModal('${a.id}')`}
                        title="Edit Article Content, Headline & Metadata"
                        class="px-2.5 py-1 rounded-lg bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 text-[11px] font-bold transition inline-flex items-center gap-1 cursor-pointer"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        <span>Edit</span>
                      </button>

                      <button
                        type="button"
                        onclick={`openAiRewriteModal('${a.id}', '${encodeURIComponent(a.title.replace(/'/g, "\\'"))}', '${encodeURIComponent(a.source_name || 'Verified Wire')}')`}
                        title="AI Rewrite & Resynthesize (Fresh from headline or full rewrite)"
                        class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold transition inline-flex items-center gap-1 cursor-pointer"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <span>AI Rewrite</span>
                      </button>

                      <button
                        type="button"
                        onclick={`deleteAdminArticle('${a.id}', this)`}
                        title="Delete Article"
                        class="p-1 rounded-lg bg-red-950/40 hover:bg-red-900/60 text-red-400 border border-red-900/50 transition cursor-pointer"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Admin Pagination Controls Bar -->
            <div class="mt-4 pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
              <span id="admin-pagination-info" class="text-slate-400 font-mono">
                Showing 1 - {Math.min(articles.length, 16)} of {articles.length} articles
              </span>

              <div class="flex items-center gap-2">
                <button
                  id="admin-prev-page-btn"
                  onclick="changeAdminArticlePage(-1)"
                  class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-40 disabled:cursor-not-allowed font-semibold transition cursor-pointer"
                >
                  &larr; Previous
                </button>

                <span id="admin-page-indicator" class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 font-mono">
                  Page 1 of {Math.max(1, Math.ceil(articles.length / 16))}
                </span>

                <button
                  id="admin-next-page-btn"
                  onclick="changeAdminArticlePage(1)"
                  class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-40 disabled:cursor-not-allowed font-semibold transition cursor-pointer"
                >
                  Next &rarr;
                </button>
              </div>
            </div>
          </div>
        )}

        <!-- AI Article Rewriter Modal Dialog -->
        <div
          id="aiRewriteModal"
          class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
        >
          <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden p-6 space-y-4 my-8">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-white">AI Article Resynthesizer</h3>
                  <p class="text-[11px] text-slate-400">Rewrite corrupted news, fix errors, or restart from headline</p>
                </div>
              </div>
              <button
                type="button"
                onclick="closeAiRewriteModal()"
                class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>

            <div class="space-y-3">
              <div>
                <label class="block text-[11px] font-medium text-slate-400 mb-1">Target Headline:</label>
                <div id="modalArticleTitle" class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs font-bold text-slate-200"></div>
                <input type="hidden" id="modalArticleId" value="" />
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Rewrite Mode:</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-emerald-500/50 transition">
                    <input type="radio" name="modalRewriteMode" value="fresh_from_headline" checked class="mt-0.5 text-emerald-500 focus:ring-emerald-500" />
                    <div>
                      <span class="block text-xs font-bold text-white">Fresh From Headline</span>
                      <span class="block text-[10px] text-slate-400 mt-0.5">Discards any previous text/jargon and writes 500-700 words strictly grounded in the headline.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-emerald-500/50 transition">
                    <input type="radio" name="modalRewriteMode" value="full" class="mt-0.5 text-emerald-500 focus:ring-emerald-500" />
                    <div>
                      <span class="block text-xs font-bold text-white">Refine & Resynthesize</span>
                      <span class="block text-[10px] text-slate-400 mt-0.5">Re-reads existing lead notes and refines vocabulary and journalistic flow.</span>
                    </div>
                  </label>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Custom Editorial Guidance (Optional):</label>
                <textarea
                  id="modalCustomInstruction"
                  rows="2"
                  placeholder="e.g. Focus specifically on the economic impact on SME businesses, or emphasize official CBN statements..."
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
                ></textarea>
              </div>

              <div id="modalRewriteStatus" class="hidden p-3 rounded-xl text-xs"></div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
              <button
                type="button"
                onclick="closeAiRewriteModal()"
                class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="button"
                id="modalSubmitRewriteBtn"
                onclick="executeModalRewrite()"
                class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-500/20"
              >
                <svg id="modalRewriteSpinner" class="w-3.5 h-3.5 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span id="modalSubmitText">Execute AI Rewrite</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Manual Edit Article Modal Dialog -->
        <div
          id="editArticleModal"
          class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
        >
          <div class="bg-slate-900 border border-slate-800 w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden p-6 space-y-4 my-8 max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 shrink-0">
              <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-blue-500/10 text-blue-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-white">Direct Article Editor</h3>
                  <p class="text-[11px] text-slate-400">Manually edit headline, text body, category, source, and publishing flags</p>
                </div>
              </div>
              <button
                type="button"
                onclick="closeEditArticleModal()"
                class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>

            <div class="overflow-y-auto space-y-3.5 pr-1 flex-1">
              <input type="hidden" id="editModalArticleId" value="" />

              <!-- Headline -->
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 mb-1">Headline / Title:</label>
                <input
                  type="text"
                  id="editModalTitle"
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500"
                  placeholder="Enter article headline..."
                />
              </div>

              <!-- Slug & Category -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Slug URL:</label>
                  <input
                    type="text"
                    id="editModalSlug"
                    class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 font-mono focus:outline-none focus:border-blue-500"
                    placeholder="article-slug"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Category:</label>
                  <select
                    id="editModalCategory"
                    class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-500"
                  >
                    {categories.map((c: any) => (
                      <option value={c.id}>{c.name}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Status, Source, Reading Time -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Status:</label>
                  <select
                    id="editModalStatus"
                    class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-500"
                  >
                    <option value="published">Published</option>
                    <option value="draft">Draft</option>
                    <option value="archived">Archived</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Source Wire:</label>
                  <input
                    type="text"
                    id="editModalSource"
                    class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500"
                    placeholder="e.g. Verified Wire"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Read Time (min):</label>
                  <input
                    type="number"
                    id="editModalReadingTime"
                    min="1"
                    max="60"
                    class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-500"
                  />
                </div>
              </div>

              <!-- Image URL -->
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 mb-1">Featured Image URL / SVG:</label>
                <input
                  type="text"
                  id="editModalImageUrl"
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 font-mono focus:outline-none focus:border-blue-500"
                  placeholder="https://... or /generated-..."
                />
              </div>

              <!-- Placement Flags -->
              <div class="flex items-center gap-5 p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs">
                <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-300 hover:text-white">
                  <input type="checkbox" id="editModalIsTopStory" class="rounded text-blue-500 focus:ring-blue-500" />
                  <span>Top Story</span>
                </label>
                <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-300 hover:text-white">
                  <input type="checkbox" id="editModalIsTrending" class="rounded text-blue-500 focus:ring-blue-500" />
                  <span>Trending</span>
                </label>
                <label class="inline-flex items-center gap-1.5 cursor-pointer text-slate-300 hover:text-white">
                  <input type="checkbox" id="editModalIsBreaking" class="rounded text-blue-500 focus:ring-blue-500" />
                  <span>Breaking</span>
                </label>
              </div>

              <!-- Summary / Excerpt -->
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 mb-1">Summary / Lead Excerpt:</label>
                <textarea
                  id="editModalSummary"
                  rows="2"
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500"
                  placeholder="2-3 sentence overview..."
                ></textarea>
              </div>

              <!-- Full Article Body -->
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 mb-1 flex items-center justify-between">
                  <span>Full Article Body (HTML or Paragraphs):</span>
                  <span class="text-[10px] text-slate-500 font-normal">Supports &lt;p&gt;, &lt;h2&gt;, &lt;blockquote&gt; or plain paragraphs</span>
                </label>
                <textarea
                  id="editModalContent"
                  rows="10"
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 leading-relaxed"
                  placeholder="Enter full article body..."
                ></textarea>
              </div>

              <!-- Status Alert Feedback -->
              <div id="editModalStatusBox" class="hidden p-3 rounded-xl text-xs"></div>
            </div>

            <!-- Modal Footer Controls -->
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800 shrink-0">
              <button
                type="button"
                onclick="closeEditArticleModal()"
                class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="button"
                id="editModalSubmitBtn"
                onclick="executeSaveArticleEdit()"
                class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-blue-500/20"
              >
                <svg id="editModalSpinner" class="w-3.5 h-3.5 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span id="editModalSubmitText">Save Changes</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: VIDEO BROADCASTS DESK -->
    <div id="tab-content-videos" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span>Video News & Autonomous Broadcasts</span>
              <span id="admin-videos-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-red-950 text-red-300 border border-red-800">
                {videos.length} broadcasts
              </span>
            </h2>
            <p class="text-xs text-slate-400">Manage video news reports, live broadcast feeds, and YouTube syndicate channels.</p>
          </div>

          <!-- Controls: Add Video & Fetch YouTube News -->
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onclick="fetchLatestYouTubeVideos()"
              id="btn-fetch-yt-videos"
              class="px-3.5 py-1.5 rounded-xl bg-red-600/90 hover:bg-red-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-red-950/40"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              <span>Fetch YouTube News</span>
            </button>

            <button
              type="button"
              onclick="openVideoModal(null)"
              class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-950/40"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>+ Add Video</span>
            </button>
          </div>
        </div>

        <!-- Filter Bar -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-800">
          <input
            type="text"
            id="admin-videos-search"
            oninput="filterAdminVideos()"
            placeholder="Search by title, source, or slug..."
            class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-red-500 w-52 sm:w-64"
          />
          <select
            id="admin-videos-category-filter"
            onchange="filterAdminVideos()"
            class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-red-500"
          >
            <option value="">All Categories</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Videos Table -->
        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-3">Video / Title</th>
                <th class="p-3">Source Channel</th>
                <th class="p-3">Category</th>
                <th class="p-3">Duration & Views</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="admin-videos-tbody" class="divide-y divide-slate-800/60 font-sans">
              {videos.map((vid) => (
                <tr class="hover:bg-slate-800/40 transition-colors admin-video-row" data-video-id={vid.id} data-video-category={vid.category_id} data-video-title={vid.title.toLowerCase()} data-video-source={vid.source_name.toLowerCase()}>
                  <td class="p-3">
                    <div class="flex items-center gap-3">
                      <div class="relative w-20 h-12 rounded-lg overflow-hidden bg-slate-950 shrink-0 border border-slate-700/60">
                        <img src={vid.thumbnail_url} alt="" class="w-full h-full object-cover" loading="lazy" />
                        <span class="absolute bottom-0.5 right-0.5 px-1 rounded bg-black/80 text-white text-[9px] font-mono font-bold">
                          {Math.floor(vid.duration_seconds / 60)}:{(vid.duration_seconds % 60).toString().padStart(2, '0')}
                        </span>
                      </div>
                      <div class="min-w-0 max-w-sm">
                        <div class="font-bold text-white line-clamp-1 hover:text-emerald-400">
                          <a href={`/videos/${vid.slug}`} target="_blank">{vid.title}</a>
                        </div>
                        <div class="text-[11px] text-slate-500 font-mono truncate mt-0.5">
                          slug: {vid.slug}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                      {vid.source_name}
                    </span>
                    <div class="text-[10px] text-slate-500 uppercase font-mono mt-0.5">
                      {vid.video_type}
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">
                      {vid.category_name || vid.category_id}
                    </span>
                  </td>
                  <td class="p-3 font-mono text-[11px] text-slate-400">
                    <div>{vid.views_count.toLocaleString()} views</div>
                    <div class="text-[10px] text-slate-500">{new Date(vid.published_at).toLocaleDateString()}</div>
                  </td>
                  <td class="p-3">
                    <div class="flex items-center gap-1.5">
                      <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase font-mono ${
                        vid.status === 'published'
                          ? 'bg-emerald-950 text-emerald-400 border border-emerald-800'
                          : 'bg-amber-950 text-amber-400 border border-amber-800'
                      }`}>
                        {vid.status}
                      </span>
                      {vid.is_featured ? (
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
                          Featured
                        </span>
                      ) : null}
                    </div>
                  </td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <a
                        href={`/videos/${vid.slug}`}
                        target="_blank"
                        class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition"
                        title="View Public Video"
                      >
