---
import Layout from '../../../layouts/Layout.astro';
import { getD1,getAdminDashboardStats,getSources,getArticles,getAnalyticsMetrics } from '../../../lib/runtime-db';
const db=getD1(Astro.locals);
const [stats,sources,articles,analytics]=await Promise.all([getAdminDashboardStats(db),getSources(db),getArticles(db,{limit:20,status:'published'}),getAnalyticsMetrics(db)]);
const cookie=Astro.request.headers.get('cookie')||'';
if(!cookie.includes('bonesceo_session=')) return Astro.redirect('/bonesceo/admin/login');
---
<Layout title="9jaBeacon Admin" activeNav="menu">
<div class="space-y-5">
<header class="p-5 rounded-2xl bg-slate-900 border border-slate-800"><p class="text-xs text-emerald-400 font-bold uppercase tracking-wider">9jaBeacon Command Hub</p><h1 class="text-2xl font-black mt-1">Editorial Admin</h1><p class="text-xs text-slate-400 mt-2">Live data from Cloudflare D1. No repository database.</p></header>
<div class="grid grid-cols-2 sm:grid-cols-5 gap-2">{[['Published',stats.publishedArticles],['Sources',stats.enabledSources],['Pending reports',stats.pendingReports],['Rejected',stats.rejectedArticles],['Article views',stats.articleViews]].map(([label,value])=><div class="p-3 rounded-xl bg-slate-900 border border-slate-800"><div class="text-xl font-black">{value}</div><div class="text-[10px] text-slate-500">{label}</div></div>)}</div>
<section class="p-4 rounded-2xl bg-slate-900 border border-slate-800"><h2 class="font-bold mb-3">Latest published</h2><div class="space-y-2">{articles.map(a=><a href={`/news/${a.slug}`} class="block p-3 rounded-xl bg-slate-950 hover:bg-slate-800"><div class="text-sm font-semibold">{a.title}</div><div class="text-[10px] text-slate-500 mt-1">{a.source_name||'9jaBeacon'} · {a.published_at}</div></a>)}</div></section>
<section class="p-4 rounded-2xl bg-slate-900 border border-slate-800"><h2 class="font-bold mb-3">Sources</h2><div class="grid gap-2">{sources.map(s=><div class="flex items-center justify-between p-2 rounded-lg bg-slate-950"><span class="text-xs">{s.name}</span><span class="text-[10px] text-emerald-400">{s.is_enabled?'Enabled':'Disabled'}</span></div>)}</div></section>
<section class="p-4 rounded-2xl bg-slate-900 border border-slate-800"><h2 class="font-bold">Analytics</h2><p class="text-xs text-slate-400 mt-2">Today: {analytics.todayVisits} · Total events: {analytics.totalVisits} · Unique sessions: {analytics.uniqueVisitors}</p></section>
</div>
</Layout>
