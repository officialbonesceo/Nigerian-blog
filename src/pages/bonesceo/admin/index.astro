              type="button"
              onclick="resetComposeForm()"
              class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition cursor-pointer"
            >
              Clear Form
            </button>
            <button
              type="button"
              onclick="submitArticle('published')"
              id="compose-post-now-btn"
              class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-md active:scale-95 cursor-pointer"
            >
              <span>🚀 Post Now</span>
            </button>
          </div>
        </div>

        <!-- Post Status Feedback Alert -->
        <div id="compose-feedback" class="hidden p-3.5 rounded-xl text-xs font-medium border"></div>

        <!-- Main Form Grid -->
        <form id="compose-article-form" onsubmit="event.preventDefault(); submitArticle('published');" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Left 2 Columns: Headline, Summary, Content -->
          <div class="lg:col-span-2 space-y-5">
            <!-- Title -->
            <div class="space-y-1.5">
              <label for="compose-title" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center justify-between">
                <span>Article Headline / Title *</span>
                <span id="compose-title-count" class="text-[10px] text-slate-500">0 / 140</span>
              </label>
              <input
                type="text"
                id="compose-title"
                required
                placeholder="e.g. Central Bank of Nigeria Announces Expanded Foreign Exchange Guidelines..."
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-sm font-semibold text-white placeholder-slate-500 focus:outline-hidden focus:border-emerald-500 transition shadow-inner"
                oninput="handleTitleInput(this.value)"
              />
            </div>

            <!-- Slug -->
            <div class="space-y-1.5">
              <label for="compose-slug" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center justify-between">
                <span>URL Slug (Canonical) *</span>
                <span class="text-[10px] text-slate-500 font-normal">/news/[slug]</span>
              </label>
              <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500 font-mono select-none hidden sm:inline">https://www.9jabeacon.name.ng/news/</span>
                <input
                  type="text"
                  id="compose-slug"
                  required
                  placeholder="article-headline-slug"
                  class="flex-1 px-3.5 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-emerald-400 focus:outline-hidden focus:border-emerald-500"
                />
              </div>
            </div>

            <!-- Lead Summary -->
            <div class="space-y-1.5">
              <label for="compose-summary" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono flex items-center justify-between">
                <span>Lead Summary / Wire Excerpt *</span>
                <span id="compose-summary-count" class="text-[10px] text-slate-500">0 / 300</span>
              </label>
              <textarea
                id="compose-summary"
                required
                rows="3"
                placeholder="Concise 2-3 sentence overview highlighting the who, what, when, and significance of the story..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-hidden focus:border-emerald-500 leading-relaxed"
                oninput="document.getElementById('compose-summary-count').textContent = this.value.length + ' / 300'"
              ></textarea>
            </div>

            <!-- Full Body Content -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="compose-content" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">
                  Full Article Body (HTML / Paragraphs) *
                </label>
                <!-- Quick Formatting Helpers -->
                <div class="flex items-center gap-1.5 text-[10px]">
                  <button type="button" onclick="insertTagIntoBody('p')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono">&lt;p&gt;</button>
                  <button type="button" onclick="insertTagIntoBody('h3')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono">&lt;h3&gt;</button>
                  <button type="button" onclick="insertTagIntoBody('blockquote')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono">&lt;quote&gt;</button>
                  <button type="button" onclick="insertTagIntoBody('strong')" class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono">&lt;bold&gt;</button>
                </div>
              </div>
              <textarea
                id="compose-content"
                required
                rows="12"
                placeholder="<p>Full article paragraphs...</p><p>Official statements and context...</p>"
                class="w-full p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 font-mono leading-relaxed focus:outline-hidden focus:border-emerald-500"
              ></textarea>
            </div>
          </div>

          <!-- Right Column: Metadata, Author Profile, Image, Publishing Flags -->
          <div class="space-y-5">
            <!-- Author Profile Selector -->
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
              <div class="flex items-center justify-between">
                <label for="compose-author" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">
                  Author Profile *
                </label>
                <button
                  type="button"
                  onclick="toggleNewProfileBox()"
                  class="text-[10px] text-emerald-400 hover:underline font-mono"
                >
                  + Add/Edit Profile
                </button>
              </div>

              <select
                id="compose-author"
                class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 font-medium"
                onchange="handleAuthorChange(this.value)"
              >
                <option value="pub_bones_ceo" selected>⭐ BonesCEO (Editor-in-Chief)</option>
                {publishers.map((p) => (
                  <option value={p.id}>{p.name} ({p.role})</option>
                ))}
              </select>

              <!-- Inline Profile Creator (Collapsible) -->
              <div id="inline-profile-box" class="hidden p-3 rounded-lg bg-slate-900 border border-slate-800 space-y-2 mt-2">
                <div class="text-[11px] font-bold text-emerald-400">Create / Custom Persona</div>
                <input
                  type="text"
                  id="new-profile-name"
                  placeholder="Full Name (e.g. BonesCEO)"
                  class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                />
                <input
                  type="text"
                  id="new-profile-role"
                  placeholder="Role (e.g. Editor-in-Chief)"
                  class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                />
                <input
                  type="text"
                  id="new-profile-avatar"
                  placeholder="Avatar Image URL"
                  class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
                />
                <button
                  type="button"
                  onclick="saveCustomPublisherProfile()"
                  class="w-full py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold"
                >
                  Save Profile to Database
                </button>
              </div>
            </div>

            <!-- Category -->
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
              <label for="compose-category" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">
                Category *
              </label>
              <select
                id="compose-category"
                required
                class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500"
              >
                <option value="cat_naija_news" selected>🇳🇬 Naija News</option>
                <option value="cat_money_hustle">📈 Business & FX</option>
                <option value="cat_sports">🦅 Sports</option>
                <option value="cat_world">🌍 World</option>
              </select>
            </div>

            <!-- Featured Image & Presets -->
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
              <label for="compose-image-url" class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">
                Featured Cover Image *
              </label>
              <input
                type="url"
                id="compose-image-url"
                required
                placeholder="https://images.unsplash.com/..."
                value="https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1200&q=80"
                class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 font-mono"
                oninput="updateImagePreview(this.value)"
              />

              <!-- 1-Click Verified Image Presets -->
              <div>
                <div class="text-[10px] text-slate-500 uppercase font-mono mb-1">1-Click Photography Presets:</div>
                <div class="flex flex-wrap gap-1">
                  <button type="button" onclick="setPresetImage('finance')" class="px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-[10px] text-slate-300 border border-slate-800">🏦 Finance</button>
                  <button type="button" onclick="setPresetImage('governance')" class="px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-[10px] text-slate-300 border border-slate-800">🏛️ Politics</button>
                  <button type="button" onclick="setPresetImage('energy')" class="px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-[10px] text-slate-300 border border-slate-800">⚡ Energy</button>
                  <button type="button" onclick="setPresetImage('sports')" class="px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-[10px] text-slate-300 border border-slate-800">⚽ Sports</button>
                  <button type="button" onclick="setPresetImage('tech')" class="px-2 py-1 rounded bg-slate-900 hover:bg-slate-800 text-[10px] text-slate-300 border border-slate-800">📱 Tech</button>
                </div>
              </div>

              <!-- Live Image Preview -->
              <div class="w-full h-32 rounded-lg overflow-hidden bg-slate-900 border border-slate-800 relative">
                <img
                  id="compose-image-preview"
                  src="https://images.unsplash.com/photo-1559526324-4b87b5e36e44?auto=format&fit=crop&w=1200&q=80"
                  alt="Preview"
                  class="w-full h-full object-cover"
                />
              </div>

              <div class="grid grid-cols-2 gap-2">
                <input
                  type="text"
                  id="compose-image-caption"
                  placeholder="Caption..."
                  value="Newsroom photo wire."
                  class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-white"
                />
                <input
                  type="text"
                  id="compose-image-credit"
                  placeholder="Photo Credit..."
                  value="Editorial Desk"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-white"
                />
              </div>
            </div>

            <!-- Publishing Flags -->
            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2.5">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono mb-1">Display Badges</div>
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                <input type="checkbox" id="compose-is-top" class="rounded bg-slate-900 border-slate-800 text-emerald-600 focus:ring-0" />
                <span>Feature as <strong>Top Story</strong> (Hero Spotlight)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                <input type="checkbox" id="compose-is-breaking" class="rounded bg-slate-900 border-slate-800 text-red-600 focus:ring-0" />
                <span>Feature in <strong>Breaking News Ticker</strong></span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                <input type="checkbox" id="compose-is-trending" checked class="rounded bg-slate-900 border-slate-800 text-emerald-600 focus:ring-0" />
                <span>Display in <strong>Trending List</strong></span>
              </label>
            </div>

            <!-- Publish Actions -->
            <div class="space-y-2 pt-2">
              <button
                type="button"
                onclick="submitArticle('published')"
                class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition shadow-lg shadow-emerald-950/50 flex items-center justify-center gap-2 cursor-pointer active:scale-98"
              >
                <span>🚀 Post Now & Publish Live</span>
              </button>
              <button
                type="button"
                onclick="submitArticle('draft')"
                class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition cursor-pointer"
              >
                <span>💾 Save as Draft</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- TAB: DATABASE CAPACITY & ANALYTICS DASHBOARD -->
    <!-- TAB 5: PUBLISHED ARTICLES & DUAL-STORY WORKSTATION -->
    <div id="tab-content-articles" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>Published Articles Inventory</span>
              <span id="admin-articles-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-950 text-emerald-300 border border-emerald-800">
                {articles.length} total
              </span>
            </h2>
            <p class="text-xs text-slate-400">All stories currently live on 9jaBeacon with synthesis attributions and verified pagination.</p>
          </div>

          <!-- Quick Action to Compose New Article -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick="switchAdminTab('compose')"
              class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm active:scale-95 cursor-pointer"
            >
              <span>✍️ Write New Article</span>
            </button>
          </div>

          <!-- Controls: Search & Category Filter -->
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="text"
              id="admin-articles-search"
              placeholder="Filter by title or wire..."
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 w-44 sm:w-56"
            />
            <select
              id="admin-articles-category"
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="">All Categories</option>
              <option value="naija-news">Naija News</option>
              <option value="business">Business</option>
              <option value="sports">Sports</option>
              <option value="world">World</option>
            </select>
            <select
              id="admin-articles-pagesize"
              class="px-2.5 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="8">8 / page</option>
              <option value="16" selected>16 / page</option>
              <option value="32">32 / page</option>
            </select>
          </div>
        </div>

        <!-- Quality Control & AI Health Maintenance Banner -->
        <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-xs font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Content Quality & Image Health</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">
              Instantly purge old boilerplate text, fix blurry AI images with crisp vector SVG cards, or check database integrity.
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onclick="scanCorruptedArticles()"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition cursor-pointer"
            >
              Scan Health
            </button>
            <button
              type="button"
              onclick="fixAllBadImages()"
              title="Replace any blurry AI images or publisher logos with vector SVG cards"
              class="px-3 py-1.5 rounded-lg bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-300 border border-emerald-800 text-xs font-semibold transition cursor-pointer"
            >
              Clean Blurry Images &rarr; SVG
            </button>
            <button
              type="button"
              onclick="purgeCorruptedArticles()"
              title="Purge articles with old fake template boilerplate"
              class="px-3 py-1.5 rounded-lg bg-red-950/50 hover:bg-red-900/70 text-red-300 border border-red-900/60 text-xs font-semibold transition cursor-pointer"
            >
              Purge Corrupted News
            </button>
          </div>
        </div>

        {articles.length === 0 ? (
          <div class="p-8 text-center rounded-xl bg-slate-950 border border-slate-800 text-slate-400 text-xs space-y-2">
            <div>No articles found in the database.</div>
            <button onclick="triggerCrawlWorkflow()" class="px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold text-xs cursor-pointer hover:bg-emerald-400">
              Run AI Ingestion Workflow Now
            </button>
          </div>
        ) : (
          <div>
            <div id="admin-articles-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {articles.map((a, idx) => (
                <div
                  id={`article-card-${a.id}`}
                  class="admin-article-card p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition space-y-2.5"
                  data-index={idx}
                  data-id={a.id}
                  data-title={(a.title || '').toLowerCase()}
                  data-cat={(a.category_slug || a.category_id || '').toLowerCase()}
                  data-source={(a.source_name || '').toLowerCase()}
                >
                  <div class="flex items-start justify-between gap-2">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-900 text-emerald-400 border border-slate-800">
                      {a.category_name || a.category_id}
                    </span>
                    <span class="text-[10px] text-slate-500 font-mono">{a.views_count || 0} reads</span>
                  </div>
                  <h3 class="font-bold text-sm text-white line-clamp-2 hover:text-emerald-400 transition" id={`article-title-${a.id}`}>
                    <a href={`/news/${a.slug}`} target="_blank">{a.title}</a>
                  </h3>
                  <p class="text-xs text-slate-400 line-clamp-2" id={`article-summary-${a.id}`}>{a.summary}</p>
                  
                  <div class="pt-2 flex items-center justify-between text-[10px] text-slate-500 border-t border-slate-900">
                    <span>Wire: {a.source_name || 'Direct'}</span>
                    <span class="text-slate-400 font-mono">{a.published_at ? new Date(a.published_at).toLocaleDateString() : 'Recent'}</span>
                  </div>

                  <!-- Article Actions: View, Edit, AI Rewrite, Delete -->
                  <div class="pt-2 flex items-center justify-between gap-2 border-t border-slate-900/80">
                    <a
                      href={`/news/${a.slug}`}
                      target="_blank"
                      class="px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white text-[11px] font-medium transition inline-flex items-center gap-1"
                    >
                      <span>View</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>

                    <div class="flex items-center gap-1.5">
                      <button
                        type="button"
                        onclick={`openEditArticleModal('${a.id}')`}
                        title="Open Dual-Story Workstation: 1 in Database, 1 Live from Source"
                        class="px-2.5 py-1 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold transition inline-flex items-center gap-1 cursor-pointer"
                      >
                        <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        <span>2 Articles View</span>
                      </button>

                      <button
                        type="button"
                        onclick={`openAiRewriteModal('${a.id}', '${encodeURIComponent(a.title.replace(/'/g, "\\'"))}', '${encodeURIComponent(a.source_name || 'Verified Wire')}')`}
                        title="AI Rewrite & Resynthesize (Fresh from headline or full rewrite)"
                        class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold transition inline-flex items-center gap-1 cursor-pointer"
                      >
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <span>AI Rewrite</span>
                      </button>

                      <button
                        type="button"
                        onclick={`openBlueskyStudioModal('${a.id}')`}
                        title="Craft algorithmic hook & post to Bluesky"
                        class="px-2.5 py-1 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 text-[11px] font-bold transition inline-flex items-center gap-1 cursor-pointer"
                      >
                        <svg class="w-3 h-3 text-[#0085FF]" viewBox="0 0 568 501" fill="currentColor">
                          <path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-198.21C491.56 3.12 568-19.46 568 59.957c0 15.897-9.08 133.567-14.407 152.597-18.528 66.196-85.922 83.18-146.593 72.846 105.992 18.069 132.85 88.04 74.654 147.78-109.972 112.92-167.348-28.327-197.654-88.89-30.306 60.563-87.682 201.81-197.654 88.89-58.196-59.74-31.338-129.711 74.654-147.78C99.329 295.734 31.935 278.75 13.407 212.554 8.08 193.524 0 75.854 0 59.957 0-19.46 76.44 3.12 123.121 33.664z"/>
                        </svg>
                        <span>Bluesky</span>
                      </button>

                      <button
                        type="button"
                        onclick={`deleteAdminArticle('${a.id}', this)`}
                        title="Delete Article"
                        class="p-1 rounded-lg bg-red-950/40 hover:bg-red-900/60 text-red-400 border border-red-900/50 transition cursor-pointer"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </div>
                  </div>
