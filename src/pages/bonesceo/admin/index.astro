    // Admin Articles Pagination & Search Filtering Logic
    let adminCurrentPage = 1;
    let adminPageSize = 16;
    let adminFilteredCards = [];

    function updateAdminArticlesView() {
      const search = (document.getElementById('admin-articles-search')?.value || '').toLowerCase().trim();
      const cat = (document.getElementById('admin-articles-category')?.value || '').toLowerCase().trim();
      const pSizeVal = document.getElementById('admin-articles-pagesize')?.value;
      if (pSizeVal) adminPageSize = parseInt(pSizeVal, 10);

      const allCards = Array.from(document.querySelectorAll('.admin-article-card'));
      adminFilteredCards = allCards.filter(card => {
        const title = card.getAttribute('data-title') || '';
        const cardCat = card.getAttribute('data-cat') || '';
        const source = card.getAttribute('data-source') || '';
        const matchesSearch = !search || title.includes(search) || source.includes(search);
        const matchesCat = !cat || cardCat.includes(cat);
        return matchesSearch && matchesCat;
      });

      const total = adminFilteredCards.length;
      const totalPages = Math.max(1, Math.ceil(total / adminPageSize));
      if (adminCurrentPage > totalPages) adminCurrentPage = totalPages;
      if (adminCurrentPage < 1) adminCurrentPage = 1;

      const startIndex = (adminCurrentPage - 1) * adminPageSize;
      const endIndex = Math.min(startIndex + adminPageSize, total);

      // Hide all first
      allCards.forEach(card => card.style.display = 'none');

      // Show only current page items
      for (let i = startIndex; i < endIndex; i++) {
        if (adminFilteredCards[i]) {
          adminFilteredCards[i].style.display = '';
        }
      }

      // Update UI indicators
      const infoEl = document.getElementById('admin-pagination-info');
      if (infoEl) {
        infoEl.textContent = total === 0 ? 'No matching articles found' : `Showing ${startIndex + 1} - ${endIndex} of ${total} articles`;
      }
      const pageEl = document.getElementById('admin-page-indicator');
      if (pageEl) {
        pageEl.textContent = `Page ${adminCurrentPage} of ${totalPages}`;
      }
      const prevBtn = document.getElementById('admin-prev-page-btn');
      if (prevBtn) prevBtn.disabled = adminCurrentPage <= 1;
      const nextBtn = document.getElementById('admin-next-page-btn');
      if (nextBtn) nextBtn.disabled = adminCurrentPage >= totalPages;
      const badge = document.getElementById('admin-articles-total-badge');
      if (badge) badge.textContent = `${total} matching`;
    }

    function changeAdminArticlePage(delta) {
      adminCurrentPage += delta;
      updateAdminArticlesView();
    }
    window.changeAdminArticlePage = changeAdminArticlePage;

    document.getElementById('admin-articles-search')?.addEventListener('input', () => {
      adminCurrentPage = 1;
      updateAdminArticlesView();
    });
    document.getElementById('admin-articles-category')?.addEventListener('change', () => {
      adminCurrentPage = 1;
      updateAdminArticlesView();
    });
    document.getElementById('admin-articles-pagesize')?.addEventListener('change', () => {
