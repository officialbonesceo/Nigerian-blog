    function autoDetectYtThumbnail(url) {
      if (!url) return;
      const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/i);
      const thumbInput = document.getElementById('videoModalInputThumb');
      if (match && thumbInput && !thumbInput.value) {
        thumbInput.value = `https://i.ytimg.com/vi/${match[1]}/hqdefault.jpg`;
      }
    }

