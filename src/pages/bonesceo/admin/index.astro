  <script is:inline>
    function switchAdminTab(tabName) {
      document.querySelectorAll('.admin-tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.admin-tab-btn').forEach(btn => {
        btn.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
        btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
      });

      const targetContent = document.getElementById('tab-content-' + tabName);
      const targetBtn = document.getElementById('tab-btn-' + tabName);

      if (targetContent) targetContent.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-800');
        targetBtn.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      }
    }
    window.switchAdminTab = switchAdminTab;

    // --- Video Deletion Handler (Early Global Definition) ---
    async function deleteVideoItem(id) {
      if (!confirm('Are you sure you want to permanently delete this video broadcast?')) return;
      try {
        const res = await fetch(`/api/admin/videos?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const data = await res.json();
        if (data.success) {
          const row = document.querySelector(`[data-video-id="${id}"]`);
          if (row) {
            row.style.transition = 'all 0.3s ease';
            row.style.opacity = '0';
            row.style.transform = 'scale(0.95)';
            setTimeout(() => row.remove(), 300);
          }
          // Update count badge in tab
          const tabBtn = document.getElementById('tab-btn-videos');
          if (tabBtn) {
            const countSpan = tabBtn.querySelector('span');
            if (countSpan && countSpan.textContent.includes('Video News')) {
              const current = parseInt(countSpan.textContent.match(/\d+/)?.[0] || '0', 10);
              if (current > 0) countSpan.textContent = `Video News (${current - 1})`;
            }
          }
        } else {
          alert('Delete failed: ' + (data.error || 'Server error'));
        }
      } catch (err) {
        alert('Error deleting video: ' + (err.message || 'Network error'));
      }
    }
    window.deleteVideoItem = deleteVideoItem;

    // --- AI Publishers & Editorial Team Handlers ---
    async function togglePublisherStatus(id, isActive) {
      const statusText = document.querySelector(`.pub-status-text-${id}`);
      try {
        const res = await fetch('/api/admin/publishers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle', id, is_active: isActive ? 1 : 0 }),
        });
        const data = await res.json();
        if (data.success) {
          if (statusText) {
            statusText.textContent = isActive ? 'ACTIVE' : 'OFF';
            statusText.className = `ml-2 text-[10px] font-bold pub-status-text-${id} ${isActive ? 'text-emerald-400' : 'text-slate-500'}`;
          }
          const checkboxes = document.querySelectorAll('#admin-publishers-tbody input[type="checkbox"]');
          let activeCount = 0;
          checkboxes.forEach(cb => { if (cb.checked) activeCount++; });
          const activeEl = document.getElementById('metric-active-publishers-count');
          const inactiveEl = document.getElementById('metric-inactive-publishers-count');
          if (activeEl) activeEl.textContent = String(activeCount);
          if (inactiveEl) inactiveEl.textContent = String(checkboxes.length - activeCount);
        } else {
          alert('Toggle failed: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Network error updating publisher status: ' + err.message);
      }
    }
    window.togglePublisherStatus = togglePublisherStatus;

    async function setCoreFivePublishers() {
      const coreIds = [
        'pub_damilola_adeyemi',
        'pub_chidiemma_okonkwo',
        'pub_farouk_danjuma',
        'pub_ngozi_eze',
        'pub_babatunde_lawal'
      ];
      if (!confirm('Activate the 5 core correspondents (Damilola, Chidiemma, Farouk, Ngozi, Babatunde) and set remaining 10 to reserve?')) return;
      const btn = document.getElementById('btn-set-core-5');
      if (btn) btn.disabled = true;
      try {
        const rows = document.querySelectorAll('#admin-publishers-tbody tr[data-pub-id]');
        for (const row of rows) {
          const id = row.getAttribute('data-pub-id');
          const shouldBeActive = coreIds.includes(id);
          const cb = row.querySelector('input[type="checkbox"]');
          if (cb) cb.checked = shouldBeActive;
          await fetch('/api/admin/publishers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'toggle', id, is_active: shouldBeActive ? 1 : 0 }),
          });
          const statusText = row.querySelector(`.pub-status-text-${id}`);
          if (statusText) {
            statusText.textContent = shouldBeActive ? 'ACTIVE' : 'OFF';
            statusText.className = `ml-2 text-[10px] font-bold pub-status-text-${id} ${shouldBeActive ? 'text-emerald-400' : 'text-slate-500'}`;
          }
        }
        const activeEl = document.getElementById('metric-active-publishers-count');
        const inactiveEl = document.getElementById('metric-inactive-publishers-count');
        if (activeEl) activeEl.textContent = '5';
        if (inactiveEl) inactiveEl.textContent = '10';
        alert('✔ 5 Core Profiles activated successfully!');
      } catch (err) {
        alert('Error setting core profiles: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    }
    window.setCoreFivePublishers = setCoreFivePublishers;

    function openPublisherModal() {
      const modal = document.getElementById('publisherModal');
      const title = document.getElementById('publisherModalTitle');
      const form = document.getElementById('publisherModalForm');
      if (!modal || !form) return;
      form.reset();
      document.getElementById('pubModalInputId').value = '';
      document.getElementById('pubModalInputSchool').value = 'MUA';
      if (title) {
        const span = title.querySelector('span');
        if (span) span.textContent = 'Add New Correspondent';
      }
      modal.classList.remove('hidden');
    }
    window.openPublisherModal = openPublisherModal;

    function closePublisherModal() {
      const modal = document.getElementById('publisherModal');
      if (modal) modal.classList.add('hidden');
    }
    window.closePublisherModal = closePublisherModal;

    function editPublisherModal(pub) {
      const modal = document.getElementById('publisherModal');
      const title = document.getElementById('publisherModalTitle');
      if (!modal) return;
      document.getElementById('pubModalInputId').value = pub.id || '';
      document.getElementById('pubModalInputName').value = pub.name || '';
      document.getElementById('pubModalInputSlug').value = pub.slug || '';
      document.getElementById('pubModalInputRole').value = pub.role || '';
      document.getElementById('pubModalInputSchool').value = pub.school || 'MUA';
      document.getElementById('pubModalInputCategory').value = pub.category_specialty || 'cat_naija_news';
      document.getElementById('pubModalInputActive').value = pub.is_active ? '1' : '0';
      document.getElementById('pubModalInputAvatar').value = pub.avatar_url || '';
      document.getElementById('pubModalInputBio').value = pub.bio || '';
      if (title) {
        const span = title.querySelector('span');
        if (span) span.textContent = `Edit Profile: ${pub.name}`;
      }
      modal.classList.remove('hidden');
    }
    window.editPublisherModal = editPublisherModal;

    async function deletePublisherItem(id) {
      if (!confirm('Are you sure you want to delete this publisher profile?')) return;
      try {
        const res = await fetch(`/api/admin/publishers?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const data = await res.json();
        if (data.success) {
          const row = document.querySelector(`tr[data-pub-id="${id}"]`);
          if (row) row.remove();
        } else {
          alert('Delete failed: ' + (data.error || 'Server error'));
        }
      } catch (err) {
        alert('Error deleting publisher: ' + err.message);
      }
    }
    window.deletePublisherItem = deletePublisherItem;

    async function savePublisherModalForm(e) {
      e.preventDefault();
      const id = document.getElementById('pubModalInputId').value.trim();
      const name = document.getElementById('pubModalInputName').value.trim();
      const slug = document.getElementById('pubModalInputSlug').value.trim();
      const role = document.getElementById('pubModalInputRole').value.trim();
      const school = document.getElementById('pubModalInputSchool').value.trim() || 'MUA';
      const category_specialty = document.getElementById('pubModalInputCategory').value;
      const is_active = parseInt(document.getElementById('pubModalInputActive').value, 10);
      const avatar_url = document.getElementById('pubModalInputAvatar').value.trim();
      const bio = document.getElementById('pubModalInputBio').value.trim();

      const btn = document.getElementById('pubModalSubmitBtn');
      const btnText = document.getElementById('pubModalSubmitText');
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Saving...';

      try {
        const res = await fetch('/api/admin/publishers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save',
            publisher: {
              id: id || undefined,
              name,
              slug,
              role,
              school,
              category_specialty,
              is_active,
              avatar_url,
              bio,
            }
          }),
        });
        const data = await res.json();
        if (data.success) {
          closePublisherModal();
          window.location.reload();
        } else {
          alert('Save failed: ' + (data.error || 'Server error'));
        }
      } catch (err) {
        alert('Network error saving publisher: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = 'Save Correspondent';
      }
    }
    window.savePublisherModalForm = savePublisherModalForm;

    // Auto-select tab if passed in URL query e.g. ?tab=presenters
    document.addEventListener('DOMContentLoaded', () => {
      const qTab = new URLSearchParams(window.location.search).get('tab');
      if (qTab) switchAdminTab(qTab);
    });

    window.adminAuditionVoice = function(name, gender, pitch, rate) {
      if (!('speechSynthesis' in window)) {
        alert('Browser SpeechSynthesis is not supported on this device.');
        return;
      }
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(`Hello, this is ${name} reporting for the 9jaBeacon digital newsroom. Audio engine and sprite mapping are verified.`);
      utterance.pitch = pitch || 1.0;
      utterance.rate = rate || 1.0;

      const voices = window.speechSynthesis.getVoices();
      const preferred = voices.find(v => 
        (gender === 'female' ? v.name.toLowerCase().includes('female') || v.name.includes('Zira') || v.name.includes('Samantha') : v.name.toLowerCase().includes('male') || v.name.includes('David')) ||
        v.lang.startsWith('en')
      );
      if (preferred) utterance.voice = preferred;

      setTimeout(() => window.speechSynthesis.speak(utterance), 50);
    };

