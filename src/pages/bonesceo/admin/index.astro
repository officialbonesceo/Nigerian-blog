    async function triggerCrawlWorkflow() {
      const btn = document.getElementById('startCrawlBtn');
      const spinner = document.getElementById('crawlSpinner');
      const btnText = document.getElementById('crawlBtnText');
      const statusText = document.getElementById('workflowStatusText');
      const sourceSelect = document.getElementById('crawlSourceSelect');
      const batchSelect = document.getElementById('crawlBatchSize');

      const sourceId = sourceSelect ? sourceSelect.value : '';
      const limit = batchSelect ? Number(batchSelect.value) : 4;

      if (btn) btn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Running Ingestion & Multi-LLM Rewrite...';
      if (statusText) {
        statusText.textContent = 'Executing AI Synthesis Waterfall...';
        statusText.className = 'font-bold text-amber-400 animate-pulse';
      }

      appendTerminal(`🚀 Launching workflow: Source=${sourceId || 'ALL'} | Limit=${limit} leads/feed`, 'info');

      try {
        const res = await fetch('/api/admin/trigger-crawl', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ source_id: sourceId || undefined, limit_per_source: limit }),
        });

        const data = await res.json();
        if (data.success) {
          appendTerminal(`✅ Ingestion Complete in ${data.durationSeconds || 0}s! Published: ${data.totalIngested} articles, Rejected: ${data.totalRejectedNoAi}`, 'success');

          if (data.logs && Array.isArray(data.logs)) {
            data.logs.forEach(l => {
              appendTerminal(`[${l.action}] ${l.message}`, l.status === 'error' ? 'error' : l.status === 'warning' ? 'warning' : 'info');
            });
          }

          if (statusText) {
            statusText.textContent = `Completed! ${data.totalIngested} published.`;
            statusText.className = 'font-bold text-emerald-400';
          }
        } else {
          appendTerminal(`❌ Ingestion error: ${data.error}`, 'error');
          if (statusText) {
            statusText.textContent = `Error: ${data.error}`;
            statusText.className = 'font-bold text-red-400';
          }
        }
      } catch (err) {
        appendTerminal(`❌ Network exception: ${err.message}`, 'error');
        if (statusText) {
          statusText.textContent = `Failed: ${err.message}`;
          statusText.className = 'font-bold text-red-400';
        }
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Execute Editorial Workflow';
      }
    }

