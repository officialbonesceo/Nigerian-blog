  <script is:inline>
    function switchAdminTab(tabName) {
      document.querySelectorAll('.admin-tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.admin-tab-btn').forEach(btn => {
        btn.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
        btn.classList.add('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
      });

      const targetContent = document.getElementById('tab-content-' + tabName);
      const targetBtn = document.getElementById('tab-btn-' + tabName);

      if (targetContent) targetContent.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.classList.remove('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
        targetBtn.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      }
    }

    function appendTerminal(msg, type = 'info') {
      const term = document.getElementById('workflowTerminal');
      if (!term) return;
      const timeStr = new Date().toLocaleTimeString();
      const div = document.createElement('div');
      div.className = 'text-[11px] flex items-start gap-2';

      let colorClass = 'text-slate-300';
      if (type === 'success') colorClass = 'text-emerald-400 font-semibold';
      else if (type === 'error') colorClass = 'text-red-400 font-bold';
      else if (type === 'warning') colorClass = 'text-amber-400';

      div.innerHTML = `<span class="text-slate-500 whitespace-nowrap">[${timeStr}]</span> <span class="${colorClass}">${msg}</span>`;
      term.appendChild(div);
      term.scrollTop = term.scrollHeight;
    }

    function clearTerminalLog() {
      const term = document.getElementById('workflowTerminal');
      if (term) term.innerHTML = '<div class="text-slate-500">// Console cleared.</div>';
    }

    async function triggerCrawlWorkflow() {
      const btn = document.getElementById('startCrawlBtn');
      const spinner = document.getElementById('crawlSpinner');
      const btnText = document.getElementById('crawlBtnText');
      const statusText = document.getElementById('workflowStatusText');
      const sourceSelect = document.getElementById('crawlSourceSelect');
      const batchSelect = document.getElementById('crawlBatchSize');

      const sourceId = sourceSelect ? sourceSelect.value : '';
      const limit = batchSelect ? Number(batchSelect.value) : 4;

      if (btn) btn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Running Ingestion & Multi-LLM Rewrite...';
      if (statusText) {
        statusText.textContent = 'Executing AI Synthesis Waterfall...';
        statusText.className = 'font-bold text-amber-400 animate-pulse';
      }

      appendTerminal(`🚀 Launching workflow: Source=${sourceId || 'ALL'} | Limit=${limit} leads/feed`, 'info');

      try {
        const res = await fetch('/api/admin/trigger-crawl', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ source_id: sourceId || undefined, limit_per_source: limit }),
        });

        const data = await res.json();
        if (data.success) {
          appendTerminal(`✅ Ingestion Complete in ${data.durationSeconds || 0}s! Published: ${data.totalIngested} articles, Rejected: ${data.totalRejectedNoAi}`, 'success');

          if (data.logs && Array.isArray(data.logs)) {
            data.logs.forEach(l => {
              appendTerminal(`[${l.action}] ${l.message}`, l.status === 'error' ? 'error' : l.status === 'warning' ? 'warning' : 'info');
            });
          }

          if (statusText) {
            statusText.textContent = `Completed! ${data.totalIngested} published.`;
            statusText.className = 'font-bold text-emerald-400';
          }
        } else {
          appendTerminal(`❌ Ingestion error: ${data.error}`, 'error');
          if (statusText) {
            statusText.textContent = `Error: ${data.error}`;
            statusText.className = 'font-bold text-red-400';
          }
        }
      } catch (err) {
        appendTerminal(`❌ Network exception: ${err.message}`, 'error');
        if (statusText) {
          statusText.textContent = `Failed: ${err.message}`;
          statusText.className = 'font-bold text-red-400';
        }
      } finally {
        if (btn) btn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Execute Editorial Workflow';
      }
    }

    async function triggerCrawlForSingleSource(sourceId) {
      const sel = document.getElementById('crawlSourceSelect');
      if (sel) sel.value = sourceId;
      switchAdminTab('crawler');
      triggerCrawlWorkflow();
    }
    window.triggerCrawlForSingleSource = triggerCrawlForSingleSource;

    async function saveAiConfig(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const settings = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'automation', settings }),
        });
        const data = await res.json();
        if (data.success) {
          alert('AI and Local Model Configuration saved successfully!');
        } else {
          alert('Error saving settings: ' + data.error);
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }
    document.getElementById('aiSettingsForm')?.addEventListener('submit', saveAiConfig);

    async function runAiDiagnostics() {
      const box = document.getElementById('aiTestResultBox');
      if (!box) return;

      box.innerHTML = '<div class="text-amber-400 animate-pulse">// Querying Multi-LLM Waterfall (Cloudflare -> OpenRouter -> Local Qwen -> Pollinations -> Editorial Core)...</div>';

      try {
        const res = await fetch('/api/admin/test-ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        });
        const data = await res.json();

        if (data.success) {
          let traceHtml = (data.traceLogs || []).map(t => `<div class="text-[10px] text-slate-400">&bull; ${t}</div>`).join('');
          box.innerHTML = `
            <div class="text-emerald-400 font-bold">✔ AI Synthesis Succeeded in ${data.durationMs}ms</div>
            <div class="text-xs text-white font-bold mt-1">Provider: <span class="text-cyan-400">${data.provider}</span> (${data.modelUsed})</div>
            <div class="text-xs text-slate-300 mt-1">Classified Category: <span class="text-emerald-400 font-bold">${data.category}</span></div>
            <div class="text-xs text-slate-200 mt-1">Generated Title: "${data.headline}"</div>
            <div class="mt-2 pt-2 border-t border-slate-800 space-y-1">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Execution Trace:</div>
              ${traceHtml}
            </div>
          `;
        } else {
          box.innerHTML = `<div class="text-red-400 font-bold">✖ AI Synthesis Failed</div><div class="text-xs text-slate-300 mt-1">${data.error}</div>`;
        }
      } catch (err) {
        box.innerHTML = `<div class="text-red-400 font-bold">✖ Network Error</div><div class="text-xs text-slate-300 mt-1">${err.message}</div>`;
      }
    }

    async function refreshLogsView() {
      try {
        const res = await fetch('/api/admin/logs?limit=80');
        const data = await res.json();
        if (data.success && data.logs) {
          const tbody = document.querySelector('#logsTable tbody');
          if (tbody) {
            tbody.innerHTML = data.logs.map(l => `
              <tr class="hover:bg-slate-800/40 transition">
                <td class="p-3 text-slate-400 whitespace-nowrap text-[11px]">${new Date(l.created_at).toLocaleTimeString()}</td>
                <td class="p-3 font-semibold text-white whitespace-nowrap">${l.event_type || 'EVENT'}</td>
                <td class="p-3 text-slate-300 whitespace-nowrap">${l.source_name || 'System'}</td>
                <td class="p-3 text-slate-200">${l.message}</td>
                <td class="p-3 whitespace-nowrap">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    l.level === 'error' ? 'bg-red-950 text-red-400 border border-red-800' :
                    l.level === 'warning' ? 'bg-amber-950 text-amber-400 border border-amber-800' :
                    'bg-emerald-950 text-emerald-400 border border-emerald-800'
                  }">
                    ${(l.level || 'info').toUpperCase()}
                  </span>
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Failed to refresh logs:', err);
      }
    }

    async function clearAllLogsFromDb() {
      if (!confirm('Are you sure you want to clear all automation logs?')) return;
      try {
        const res = await fetch('/api/admin/logs', { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          refreshLogsView();
          clearTerminalLog();
        }
      } catch (err) {
        alert('Failed to clear logs: ' + err.message);
      }
    }

    function filterLogsTable() {
      const q = (document.getElementById('logSearchInput')?.value || '').toLowerCase();
      const rows = document.querySelectorAll('#logsTable tbody tr');
      rows.forEach(r => {
        const text = r.textContent?.toLowerCase() || '';
        r.style.display = text.includes(q) ? '' : 'none';
      });
    }

    async function saveAdminCredentials(e) {
      e.preventDefault();
      const email = document.getElementById('secAdminEmail')?.value?.trim();
      const password = document.getElementById('secAdminPassword')?.value?.trim();
      const statusBox = document.getElementById('credSaveStatus');
      const btn = document.getElementById('saveCredsBtn');

      if (!email) {
        alert('Admin email is required.');
        return;
      }

      const payload = { admin_email: email };
      if (password) {
        payload.admin_password = password;
      }

      try {
        if (btn) btn.textContent = 'Updating D1 Database...';
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'site', settings: payload }),
        });
        const data = await res.json();
        if (data.success) {
          if (statusBox) {
            statusBox.textContent = '✅ Administrator credentials updated successfully in Cloudflare D1 database!';
            statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-emerald-950/80 border border-emerald-800 text-emerald-300 block';
          }
          if (document.getElementById('secAdminPassword')) {
            document.getElementById('secAdminPassword').value = '';
          }
        } else {
          if (statusBox) {
            statusBox.textContent = '❌ Update failed: ' + (data.error || 'Unknown error');
            statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-red-950/80 border border-red-800 text-red-300 block';
          }
        }
      } catch (err) {
        if (statusBox) {
          statusBox.textContent = '❌ Network error: ' + err.message;
          statusBox.className = 'p-3 rounded-xl text-xs font-semibold bg-red-950/80 border border-red-800 text-red-300 block';
        }
      } finally {
        if (btn) btn.textContent = 'Update Credentials in D1 Database';
      }
    }
    window.saveAdminCredentials = saveAdminCredentials;
    document.getElementById('adminCredentialsForm')?.addEventListener('submit', saveAdminCredentials);

    async function logoutAdmin() {
      if (!confirm('Are you sure you want to sign out of the Admin Hub?')) return;
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch {}
      localStorage.removeItem('bonesceo_auth_token');
      localStorage.removeItem('bonesceo_auth_user');
      window.location.href = '/bonesceo/admin/login';
    }

    // Auto-verify session and ensure cookie is synced
    (async function syncAdminAuth() {
      const token = localStorage.getItem('bonesceo_auth_token');
      if (token) {
        try {
          await fetch('/api/admin/verify-session?token=' + encodeURIComponent(token));
        } catch {}
      }
    })();
  </script>
</Layout>
