    async function openBlueskyStudioModal(articleId) {
      const modal = document.getElementById('blueskyStudioModal');
      const loading = document.getElementById('bskyStudioLoading');
      const content = document.getElementById('bskyStudioContent');
      const statusBox = document.getElementById('bskyModalStatusBox');
      const idInput = document.getElementById('bskyStudioArticleId');

      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      if (loading) loading.classList.remove('hidden');
      if (content) content.classList.add('hidden');
      if (statusBox) statusBox.classList.add('hidden');
      if (idInput) idInput.value = articleId;

      try {
        const res = await fetch('/api/admin/bluesky/generate-hook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ article_id: articleId }),
        });

        const data = await res.json();
        if (!res.ok || !data.success || !data.data) {
          throw new Error(data.error || 'Failed to craft algorithmic hooks');
        }

        currentBlueskyDraft = data.data;

        // Populate article meta header
        const cardPrev = currentBlueskyDraft.cardPreview || {};
        const titleEl = document.getElementById('bskyStudioArticleTitle');
        const thumbEl = document.getElementById('bskyStudioThumb');
        const cardThumb = document.getElementById('bskyCardPreviewThumb');
        const cardTitle = document.getElementById('bskyCardPreviewTitle');
        const cardDesc = document.getElementById('bskyCardPreviewDesc');
        const urlInput = document.getElementById('bskyStudioArticleUrl');

        if (titleEl) titleEl.textContent = cardPrev.title || 'Untitled Article';
        if (cardTitle) cardTitle.textContent = cardPrev.title || '';
        if (cardDesc) cardDesc.textContent = cardPrev.description || '';
        if (urlInput) urlInput.value = cardPrev.url || '';

        if (cardPrev.imageUrl && !cardPrev.imageUrl.includes('placeholder')) {
          if (thumbEl) { thumbEl.src = cardPrev.imageUrl; thumbEl.classList.remove('hidden'); }
          if (cardThumb) { cardThumb.src = cardPrev.imageUrl; cardThumb.classList.remove('hidden'); }
        } else {
          if (thumbEl) thumbEl.classList.add('hidden');
          if (cardThumb) cardThumb.classList.add('hidden');
        }

        // Render Hook Cards
        const hookCardsContainer = document.getElementById('bskyHookCards');
        if (hookCardsContainer && Array.isArray(currentBlueskyDraft.hooks)) {
          hookCardsContainer.innerHTML = currentBlueskyDraft.hooks.map((h, i) => `
            <div
              onclick="selectBlueskyHook('${encodeURIComponent(h.text)}', this)"
              class="p-2.5 rounded-xl border border-slate-800 bg-slate-950/70 hover:bg-slate-800/80 hover:border-blue-500/50 cursor-pointer transition flex flex-col gap-1 ${i === 0 ? 'ring-1 ring-blue-500 border-blue-500 bg-blue-950/20' : ''}"
            >
              <div class="flex items-center justify-between text-[10px]">
                <span class="font-bold text-white flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full ${i === 0 ? 'bg-blue-400' : 'bg-slate-500'}"></span>
                  ${h.style}
                </span>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20">${h.badge}</span>
              </div>
              <p class="text-xs text-slate-300 font-sans line-clamp-2 leading-relaxed whitespace-pre-line">${h.text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
            </div>
          `).join('');
        }

        // Set default text in textarea to first hook
        const textArea = document.getElementById('bskyPostText');
        if (textArea && currentBlueskyDraft.hooks[0]) {
          textArea.value = currentBlueskyDraft.hooks[0].text;
          updateBlueskyCharCounter();
        }

        // Render hashtag chips
        const tagsContainer = document.getElementById('bskyHashtagsContainer');
        if (tagsContainer && Array.isArray(currentBlueskyDraft.hashtags)) {
          tagsContainer.innerHTML = currentBlueskyDraft.hashtags.map(t => `
            <button
              type="button"
              onclick="addBlueskyHashtag('#${t}')"
              class="px-2 py-0.5 rounded-md bg-slate-800 hover:bg-blue-600 hover:text-white text-[11px] font-mono text-blue-400 transition cursor-pointer border border-slate-700 hover:border-blue-500"
            >
              #${t}
            </button>
          `).join('');
        }

        // Render Image Idea
        const imageIdeaEl = document.getElementById('bskyImageIdeaText');
        if (imageIdeaEl && currentBlueskyDraft.imageIdea) {
          imageIdeaEl.innerHTML = `
            <div><strong>Visual Concept:</strong> ${currentBlueskyDraft.imageIdea.concept}</div>
            <div class="mt-1"><strong>Overlay Headline:</strong> <span class="text-amber-300 font-medium">"${currentBlueskyDraft.imageIdea.suggestedOverlayText}"</span></div>
            <div class="mt-0.5 text-slate-400 text-[10px]"><strong>Layout Guidance:</strong> ${currentBlueskyDraft.imageIdea.styleDirection}</div>
          `;
        }

        if (loading) loading.classList.add('hidden');
        if (content) content.classList.remove('hidden');
      } catch (err) {
        if (loading) loading.classList.add('hidden');
        if (content) content.classList.remove('hidden');
        showBlueskyModalStatus('✖ Error crafting algorithmic hooks: ' + err.message, 'error');
      }
    }
    window.openBlueskyStudioModal = openBlueskyStudioModal;

    function closeBlueskyStudioModal() {
      const modal = document.getElementById('blueskyStudioModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }
    window.closeBlueskyStudioModal = closeBlueskyStudioModal;

    function selectBlueskyHook(encodedText, cardEl) {
      const text = decodeURIComponent(encodedText);
      const textArea = document.getElementById('bskyPostText');
      if (textArea) {
        textArea.value = text;
        updateBlueskyCharCounter();
      }

      const hookCards = document.querySelectorAll('#bskyHookCards > div');
      hookCards.forEach(c => {
        c.classList.remove('ring-1', 'ring-blue-500', 'border-blue-500', 'bg-blue-950/20');
      });
      if (cardEl) {
        cardEl.classList.add('ring-1', 'ring-blue-500', 'border-blue-500', 'bg-blue-950/20');
      }
    }
    window.selectBlueskyHook = selectBlueskyHook;

    function addBlueskyHashtag(tag) {
      const textArea = document.getElementById('bskyPostText');
      if (!textArea) return;
      const current = textArea.value.trim();
      if (current.includes(tag)) return;

      if (current.length + tag.length + 1 > 300) {
        showBlueskyModalStatus(`⚠ Adding ${tag} would exceed Bluesky's 300 character limit!`, 'warning');
        return;
      }

      textArea.value = `${current} ${tag}`;
      updateBlueskyCharCounter();
    }
    window.addBlueskyHashtag = addBlueskyHashtag;

    function updateBlueskyCharCounter() {
      const textArea = document.getElementById('bskyPostText');
      const counter = document.getElementById('bskyCharCounter');
      if (!textArea || !counter) return;

      const len = textArea.value.length;
      counter.textContent = `${len} / 300`;

      if (len > 300) {
        counter.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-red-950/80 text-red-300 border border-red-800 font-bold';
      } else if (len > 280) {
        counter.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 border border-amber-800';
      } else {
        counter.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-emerald-400';
      }
    }
    window.updateBlueskyCharCounter = updateBlueskyCharCounter;

    async function executeBlueskyPublish() {
      const publishBtn = document.getElementById('bskyPublishBtn');
      const spinner = document.getElementById('bskyPublishSpinner');
      const btnText = document.getElementById('bskyPublishBtnText');
      const articleId = document.getElementById('bskyStudioArticleId')?.value;
      const text = document.getElementById('bskyPostText')?.value?.trim();

      if (!text) {
        showBlueskyModalStatus('⚠ Post text cannot be empty.', 'warning');
        return;
      }

      if (text.length > 300) {
        showBlueskyModalStatus('✖ Post exceeds Bluesky 300-grapheme ceiling. Please shorten before publishing.', 'error');
        return;
      }

      if (publishBtn) publishBtn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Broadcasting to AT Protocol...';

      const isForce = Boolean(document.getElementById('bskyForcePublish')?.checked);

      try {
        const res = await fetch('/api/admin/bluesky/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            article_id: articleId,
            customText: text,
            force: isForce,
          }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          if (data.alreadyPublished) {
            showBlueskyModalStatus(`ℹ Deduplication: ${data.message}`, 'warning');
          } else {
            showBlueskyModalStatus(`✔ Dispatched to Bluesky! Post is live: ${data.postUrl || ''}`, 'success');
          }
          if (data.postUrl) {
            const statusBox = document.getElementById('bskyModalStatusBox');
            if (statusBox) {
              const link = document.createElement('a');
              link.href = data.postUrl;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.className = 'block mt-2 underline font-bold text-blue-400 hover:text-blue-300 text-xs';
              link.textContent = '↗ Open Post on Bluesky (bsky.app)';
              statusBox.appendChild(link);
            }
          }
        } else {
          showBlueskyModalStatus(`✖ Publishing issue: ${data.error || 'Check Bluesky credentials or rate limits.'}`, 'error');
        }
      } catch (err) {
        showBlueskyModalStatus('✖ Network error: ' + err.message, 'error');
      } finally {
        if (publishBtn) publishBtn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Publish to Bluesky Now';
      }
    }
    window.executeBlueskyPublish = executeBlueskyPublish;

    async function publishArticleToBluesky(articleId, _btnEl) {
      openBlueskyStudioModal(articleId);
    }
    window.publishArticleToBluesky = publishArticleToBluesky;

    function showBlueskyModalStatus(msg, type = 'info') {
      const box = document.getElementById('bskyModalStatusBox');
      if (!box) return;
      box.classList.remove('hidden', 'bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300', 'bg-red-950/80', 'border-red-800', 'text-red-300', 'bg-amber-950/80', 'border-amber-800', 'text-amber-300', 'bg-slate-900', 'border-slate-800', 'text-slate-300');

      if (type === 'success') {
        box.classList.add('bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300');
      } else if (type === 'error') {
        box.classList.add('bg-red-950/80', 'border-red-800', 'text-red-300');
      } else if (type === 'warning') {
        box.classList.add('bg-amber-950/80', 'border-amber-800', 'text-amber-300');
      } else {
        box.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-300');
      }

      box.textContent = msg;
    }

    // Auto-check connection and load realtime Bluesky analytics on page load
    window.addEventListener('DOMContentLoaded', () => {
      fetchBlueskyAnalytics();
      testBlueskyAuth();
    });
  </script>
</Layout>
