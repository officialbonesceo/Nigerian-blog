    async function saveVideoModalForm(e) {
      e.preventDefault();
      const id = document.getElementById('videoModalId')?.value;
      const title = document.getElementById('videoModalInputTitle')?.value;
      const video_url = document.getElementById('videoModalInputUrl')?.value;
      const thumbnail_url = document.getElementById('videoModalInputThumb')?.value;
      const category_id = document.getElementById('videoModalInputCategory')?.value;
      const duration_seconds = parseInt(document.getElementById('videoModalInputDuration')?.value || '0', 10);
      const source_name = document.getElementById('videoModalInputSource')?.value;
      const summary = document.getElementById('videoModalInputSummary')?.value;
      const is_featured = document.getElementById('videoModalInputFeatured')?.checked ? 1 : 0;
      const status = document.getElementById('videoModalInputStatus')?.value;

      const btn = document.getElementById('videoModalSubmitBtn');
      const btnText = document.getElementById('videoModalSubmitText');
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Saving...';

      try {
        const payload = { title, video_url, thumbnail_url, category_id, duration_seconds, source_name, summary, is_featured, status };
        let res;
        if (id) {
          res = await fetch('/api/admin/videos', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, ...payload })
          });
        } else {
          res = await fetch('/api/admin/videos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        }

        const data = await res.json();
        if (data.success) {
          closeVideoModal();
          window.location.reload();
        } else {
          alert('Save failed: ' + (data.error || 'Unknown error'));
