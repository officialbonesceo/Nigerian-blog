    function filterAdminVideos() {
      const q = (document.getElementById('admin-videos-search')?.value || '').toLowerCase().trim();
      const cat = (document.getElementById('admin-videos-category-filter')?.value || '').trim();
      const rows = document.querySelectorAll('.admin-video-row');

      rows.forEach(r => {
        const title = r.dataset.videoTitle || '';
        const source = r.dataset.videoSource || '';
        const category = r.dataset.videoCategory || '';

        const matchText = !q || title.includes(q) || source.includes(q);
        const matchCat = !cat || category === cat;

        if (matchText && matchCat) {
          r.classList.remove('hidden');
        } else {
          r.classList.add('hidden');
        }
      });
    }

