    window.setWorkbenchGaze = function(targetGaze) {
      const scene = document.getElementById('wb-scene-svg');
      const gazeBadge = document.getElementById('wb-gaze-badge');
      if (scene) {
        scene.classList.remove('gaze-left', 'gaze-right', 'gaze-down');
        if (targetGaze === 'left') {
          scene.classList.add('gaze-left');
        } else if (targetGaze === 'right' || targetGaze === 'screen') {
          scene.classList.add('gaze-right');
        } else if (targetGaze === 'down' || targetGaze === 'book') {
          scene.classList.add('gaze-down');
        }
      }
      if (gazeBadge) {
        gazeBadge.textContent = (targetGaze === 'book' || targetGaze === 'down') ? 'Gaze: Notes / Book' :
          (targetGaze === 'screen' || targetGaze === 'right') ? 'Gaze: Side Screen' :
          targetGaze === 'left' ? 'Gaze: Left' : 'Gaze: Camera';
      }
      // Update gaze button styles
      ['camera', 'left', 'right', 'down'].forEach(g => {
        const btn = document.getElementById('btn-wb-gaze-' + g);
        if (btn) {
          if ((targetGaze === 'screen' && g === 'right') || (targetGaze === 'book' && g === 'down') || targetGaze === g || (!targetGaze && g === 'camera')) {
            btn.className = 'px-2 py-0.5 rounded bg-emerald-600 text-white font-bold transition cursor-pointer';
          } else {
            btn.className = 'px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition cursor-pointer';
          }
        }
      });
    };

    window.setWorkbenchGesture = function(targetGesture) {
      const scene = document.getElementById('wb-scene-svg');
      const poseLabel = document.getElementById('wb-pose-label');
      const projContainer = document.getElementById('wb-projection-container');

      // Hide all gestures
      document.querySelectorAll('.wb-gesture-group').forEach(el => {
        el.classList.add('opacity-0', 'pointer-events-none');
        el.classList.remove('opacity-100');
      });

      // Normalize ID
      const normId = targetGesture.startsWith('g-') ? targetGesture : 'g-' + targetGesture;
      const targetEl = document.getElementById('wb-' + normId);
      if (targetEl) {
        targetEl.classList.remove('opacity-0', 'pointer-events-none');
        targetEl.classList.add('opacity-100');
      }

      // If reading, trigger reading mode (head tips down and eyelids lower)
      if (normId === 'g-reading') {
        if (scene) {
          scene.classList.remove('gaze-left', 'gaze-right');
          scene.classList.add('gaze-down', 'reading');
        }
        setWorkbenchGaze('down');
      } else {
        if (scene) scene.classList.remove('reading');
      }

      // If pointing right or explaining, highlight side projection screen
      if (normId === 'g-point-right' || normId === 'g-explain') {
        if (projContainer) projContainer.classList.add('ring-2', 'ring-emerald-500/80', 'scale-[1.02]');
      } else {
        if (projContainer) projContainer.classList.remove('ring-2', 'ring-emerald-500/80', 'scale-[1.02]');
      }

      if (poseLabel) {
        const cleanName = normId.replace('g-', '').replace('-', ' ').toUpperCase();
        poseLabel.textContent = `Pose: ${cleanName}`;
      }

      // Update button highlights
      ['idle', 'point-left', 'point-right', 'point-up', 'explain', 'emphasize', 'wave', 'reading'].forEach(g => {
        const btn = document.getElementById('btn-wb-g-' + g);
        if (btn) {
          if (normId === 'g-' + g) {
            btn.className = 'px-2 py-0.5 rounded bg-emerald-600 text-white font-bold transition cursor-pointer';
          } else {
            btn.className = 'px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition cursor-pointer';
          }
        }
      });
    };

