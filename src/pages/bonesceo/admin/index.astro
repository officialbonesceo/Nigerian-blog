    let adminLogsCurrentPage = 1;
    let adminLogsPageSize = 30;

    function updateLogsPagination() {
      const q = (document.getElementById('logSearchInput')?.value || '').toLowerCase();
      const allRows = Array.from(document.querySelectorAll('#logsTable tbody tr'));
      const matchedRows = allRows.filter(r => {
        const text = r.textContent?.toLowerCase() || '';
        return text.includes(q);
      });

      const total = matchedRows.length;
      const totalPages = Math.max(1, Math.ceil(total / adminLogsPageSize));
      if (adminLogsCurrentPage > totalPages) adminLogsCurrentPage = totalPages;
      if (adminLogsCurrentPage < 1) adminLogsCurrentPage = 1;

      const startIndex = (adminLogsCurrentPage - 1) * adminLogsPageSize;
      const endIndex = Math.min(startIndex + adminLogsPageSize, total);

      allRows.forEach(r => (r.style.display = 'none'));
      matchedRows.slice(startIndex, endIndex).forEach(r => (r.style.display = ''));

      const infoEl = document.getElementById('logs-pagination-info');
      if (infoEl) {
        infoEl.textContent = total === 0 ? 'No logs matching filter' : `Showing ${startIndex + 1} - ${endIndex} of ${total} logs`;
      }
      const pageEl = document.getElementById('logs-page-indicator');
      if (pageEl) {
        pageEl.textContent = `Page ${adminLogsCurrentPage} of ${totalPages}`;
      }
      const prevBtn = document.getElementById('logs-prev-btn');
      if (prevBtn) prevBtn.disabled = adminLogsCurrentPage <= 1;
      const nextBtn = document.getElementById('logs-next-btn');
      if (nextBtn) nextBtn.disabled = adminLogsCurrentPage >= totalPages;
    }

    function changeLogsPage(delta) {
      adminLogsCurrentPage += delta;
      updateLogsPagination();
    }
    window.changeLogsPage = changeLogsPage;

    function changeLogsPageSize() {
      const sel = document.getElementById('logs-pagesize');
      if (sel) {
        adminLogsPageSize = parseInt(sel.value, 10) || 30;
        adminLogsCurrentPage = 1;
        updateLogsPagination();
      }
    }
    window.changeLogsPageSize = changeLogsPageSize;

