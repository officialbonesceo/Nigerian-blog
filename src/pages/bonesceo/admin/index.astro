    async function sendBlueskyTestPost() {
      const sendBtn = document.getElementById('sendTestBlueskyBtn');
      const identifier = document.getElementById('bluesky_identifier')?.value?.trim() || '';
      const appPassword = document.getElementById('bluesky_app_password')?.value?.trim() || '';

      if (!identifier || !appPassword) {
        showBlueskyResult('⚠ Please save your Bluesky credentials before broadcasting.', 'warning');
        return;
      }

      if (!confirm('Broadcast a live test ping to your Bluesky account now?')) return;

      if (sendBtn) {
        sendBtn.disabled = true;
        sendBtn.innerText = 'Posting...';
      }

      try {
        const res = await fetch('/api/admin/bluesky/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier, appPassword }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showBlueskyResult(`✔ Broadcast Successful! Live AT Protocol post created: ${data.postUrl}`, 'success');
          const box = document.getElementById('bluesky-result-box');
          if (box && data.postUrl) {
            const link = document.createElement('a');
            link.href = data.postUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.className = 'block mt-1 underline font-bold text-blue-400 hover:text-blue-300';
            link.textContent = '↗ View Live Post on Bluesky';
            box.appendChild(link);
          }
          fetchBlueskyAnalytics();
        } else {
          showBlueskyResult(`✖ Post dispatch failed: ${data.error || 'Server error'}`, 'error');
        }
      } catch (err) {
        showBlueskyResult('✖ Network error while posting to Bluesky: ' + err.message, 'error');
      } finally {
        if (sendBtn) {
          sendBtn.disabled = false;
          sendBtn.innerText = 'Send Test Post';
        }
      }
    }
    window.sendBlueskyTestPost = sendBlueskyTestPost;

    function showBlueskyResult(msg, type = 'info') {
      const box = document.getElementById('bluesky-result-box');
      if (!box) return;
      box.classList.remove('hidden', 'bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300', 'bg-red-950/80', 'border-red-800', 'text-red-300', 'bg-amber-950/80', 'border-amber-800', 'text-amber-300', 'bg-slate-900', 'border-slate-800', 'text-slate-300');

      if (type === 'success') {
        box.classList.add('bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300');
      } else if (type === 'error') {
        box.classList.add('bg-red-950/80', 'border-red-800', 'text-red-300');
      } else if (type === 'warning') {
        box.classList.add('bg-amber-950/80', 'border-amber-800', 'text-amber-300');
      } else {
        box.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-300');
      }

      box.textContent = msg;
    }

    // -------------------------------------------------------------
    // META (FACEBOOK & THREADS) PAGE ID & TOKEN INSPECTION
    // -------------------------------------------------------------
    async function inspectMetaTokens() {
      const userTokenInput = document.getElementById('fb_user_token_input');
      const appIdInput = document.getElementById('fb_app_id_input');
      const appSecretInput = document.getElementById('fb_app_secret_input');
      const inspectBtn = document.getElementById('inspectFbBtn');
      const resultsBox = document.getElementById('fb-inspect-results');

      const userToken = userTokenInput?.value?.trim();
      const appId = appIdInput?.value?.trim();
      const appSecret = appSecretInput?.value?.trim();

      if (!resultsBox) return;

      if (!userToken) {
        resultsBox.classList.remove('hidden', 'bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300', 'bg-slate-900', 'border-slate-800');
        resultsBox.classList.add('bg-red-950/80', 'border-red-800', 'text-red-300');
        resultsBox.innerHTML = '<strong>✖ Missing Token:</strong> Please paste a User Access Token or Page Token from Graph API Explorer.';
        return;
      }

      if (inspectBtn) {
        inspectBtn.disabled = true;
        inspectBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Connecting to Meta Graph API...
        `;
      }

      resultsBox.classList.remove('hidden');
      resultsBox.className = 'p-3 rounded-lg border bg-slate-900 border-slate-700 text-slate-300 text-xs space-y-2';
      resultsBox.innerHTML = '<div class="flex items-center gap-2"><span>Querying Meta v21.0 accounts endpoint...</span></div>';

      try {
        const res = await fetch('/api/admin/facebook/inspect-pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_access_token: userToken,
            app_id: appId,
            app_secret: appSecret,
          }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          resultsBox.className = 'p-3.5 rounded-lg border bg-red-950/80 border-red-800 text-red-200 text-xs space-y-2';
          let errHtml = `<div><strong class="text-white">✖ Meta Error:</strong> ${escapeHtml(data.error || 'Request failed')}</div>`;
          if (data.tip) {
            errHtml += `<div class="p-2 rounded bg-red-900/40 text-amber-200 text-[11px]">${escapeHtml(data.tip)}</div>`;
          }
          if (data.instructions) {
            errHtml += '<div class="space-y-1 text-[11px] text-slate-300 pt-1">';
            for (const step of data.instructions) {
              errHtml += `<div>${escapeHtml(step)}</div>`;
            }
            errHtml += '</div>';
          }
          resultsBox.innerHTML = errHtml;
          return;
        }

        resultsBox.className = 'p-4 rounded-xl border bg-slate-900/90 border-slate-700 text-xs space-y-3';
        let html = '';

        if (data.longLivedNotice) {
          html += `<div class="p-2 rounded-lg bg-emerald-950/60 border border-emerald-800/80 text-emerald-300 text-[11px] flex items-center gap-1.5">
            <span>✔ ${escapeHtml(data.longLivedNotice)}</span>
          </div>`;
        }

        html += `<div class="flex items-center justify-between pb-2 border-b border-slate-800">
          <div>
            <span class="text-slate-400">Authenticated Meta User:</span>
            <strong class="text-white ml-1 font-semibold">${escapeHtml(data.user?.name || 'Authorized')}</strong>
            <span class="text-slate-500 font-mono text-[10px] ml-1">(ID: ${escapeHtml(data.user?.id || '')})</span>
          </div>
          <span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 font-bold text-[10px]">
            ${data.pageCount} ${data.pageCount === 1 ? 'Page' : 'Pages'} Discovered
          </span>
        </div>`;

        if (!data.pages || data.pages.length === 0) {
          html += `<div class="p-3 rounded-lg bg-amber-950/50 border border-amber-800/60 text-amber-200 text-[11px] space-y-1.5">
            <div class="font-bold">⚠️ No Facebook Pages associated with this account</div>
            <p>${escapeHtml(data.help || 'Make sure your Facebook account is an Admin/Editor of at least one Facebook Page.')}</p>
          </div>`;
        } else {
          html += '<div class="space-y-3 pt-1">';
          for (const page of data.pages) {
            html += `<div class="p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-2">
              <div class="flex items-center justify-between">
                <div class="font-bold text-white text-sm flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span>${escapeHtml(page.name)}</span>
                  <span class="text-slate-500 font-normal text-xs">(${escapeHtml(page.category)})</span>
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold ${page.is_published ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400'}">
                  ${page.is_published ? 'Published' : 'Unpublished / Draft'}
                </span>
              </div>

              <!-- Numerical Page ID -->
              <div class="flex items-center justify-between gap-2 p-2 rounded bg-slate-900 border border-slate-800">
                <div class="min-w-0">
                  <span class="text-[10px] uppercase font-bold text-slate-400 block">Facebook Page ID:</span>
                  <code class="text-emerald-400 font-mono text-xs select-all font-bold">${escapeHtml(page.id)}</code>
                </div>
                <button
                  type="button"
                  onclick="copyTextToClipboard('${escapeHtml(page.id)}', this)"
                  class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-medium transition-colors whitespace-nowrap"
                >
                  Copy Page ID
                </button>
              </div>

              <!-- Permanent Page Access Token -->
              <div class="flex items-center justify-between gap-2 p-2 rounded bg-slate-900 border border-slate-800">
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] uppercase font-bold text-slate-400 block">Permanent Page Access Token:</span>
                  <code class="text-blue-300 font-mono text-[10px] truncate block select-all">${escapeHtml(page.masked_token)}</code>
                </div>
                <button
                  type="button"
                  onclick="copyTextToClipboard('${escapeHtml(page.page_access_token)}', this)"
                  class="px-2.5 py-1 rounded bg-[#1877F2] hover:bg-[#1877F2]/90 text-white text-[10px] font-bold transition-colors whitespace-nowrap"
                >
                  Copy Permanent Token
                </button>
              </div>
            </div>`;
          }
          html += '</div>';
        }

        resultsBox.innerHTML = html;
      } catch (netErr) {
        resultsBox.className = 'p-3.5 rounded-lg border bg-red-950/80 border-red-800 text-red-200 text-xs';
        resultsBox.innerHTML = `<strong>✖ Network Error:</strong> ${escapeHtml(netErr.message || String(netErr))}`;
      } finally {
        if (inspectBtn) {
          inspectBtn.disabled = false;
          inspectBtn.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Inspect & Extract My Pages & Tokens</span>
          `;
        }
      }
    }
    window.inspectMetaTokens = inspectMetaTokens;

