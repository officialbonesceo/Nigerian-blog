---
import Layout from '../../../layouts/Layout.astro';
import {
  getAdminDashboardStats,
  getSources,
  getArticles,
  getAutomationSettings,
  getSiteSettings,
  getAutomationLogs,
  getArticleReports,
  getRejectedArticles,
  getAnalyticsMetrics,
} from '../../../lib/db';

const stats = getAdminDashboardStats();
const sources = getSources();
const articles = getArticles({ limit: 100, status: 'published' });
const automationSettings = getAutomationSettings();
const siteSettings = getSiteSettings();
const logs = getAutomationLogs(35);
const reports = getArticleReports(undefined, 50);
const rejectedArticles = getRejectedArticles(50);
const analytics = getAnalyticsMetrics();

const autoSettingsMap: Record<string, string> = {};
for (const s of automationSettings) {
  autoSettingsMap[s.key] = s.value;
}
---

<Layout title="BonesCEO Command Hub - 9jaBeacon">
  <div id="admin-root" class="space-y-6">
    <!-- Top Admin Header -->
    <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900 to-slate-950 border border-slate-800 shadow-xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight font-display">BonesCEO Intelligence Hub</h1>
          <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 font-mono text-[10px] font-bold border border-emerald-500/20">Secure Portal</span>
        </div>
        <p class="text-xs text-slate-400">Authenticated strictly for <span class="text-emerald-400 font-mono font-semibold">officialbonesceo@gmail.com</span> | Real-Time News & Automation Ops</p>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-trigger-all-crawl"
          class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-md flex items-center gap-2 cursor-pointer active:scale-95"
        >
          <svg class="w-4 h-4 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Fetch All Feeds Now</span>
        </button>

        <button
          id="btn-admin-logout"
          class="p-2.5 rounded-xl bg-slate-800 hover:bg-red-950 hover:text-red-300 text-slate-300 text-xs font-medium transition-colors cursor-pointer"
          title="Sign Out of BonesCEO"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Quick Real-Time Metrics Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
      <div class="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono">Daily Users Today</span>
        <div class="text-2xl font-black text-emerald-400 font-mono">{analytics.dailyUsersToday}</div>
        <span class="text-[10px] text-slate-500 block">Real-time sessions</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono">All-Time Visitors</span>
        <div class="text-2xl font-black text-white font-mono">{analytics.allTimeUniqueVisitors}</div>
        <span class="text-[10px] text-slate-500 block">Unique visitors</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-1">
        <span class="text-[10px] font-bold text-sky-400 uppercase tracking-wider font-mono">Total Articles</span>
        <div class="text-2xl font-black text-sky-400 font-mono">{stats.totalArticles}</div>
        <span class="text-[10px] text-sky-400/70 block">+{analytics.newlyFetched24h} in last 24h</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-1">
        <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider font-mono">User Reports</span>
        <div class="text-2xl font-black text-amber-400 font-mono">{stats.pendingReports}</div>
        <span class="text-[10px] text-amber-400/70 block">Awaiting review</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-1 col-span-2 sm:col-span-1">
        <span class="text-[10px] font-bold text-purple-400 uppercase tracking-wider font-mono">Unresolved Leads</span>
        <div class="text-2xl font-black text-purple-400 font-mono">{stats.totalRejected}</div>
        <span class="text-[10px] text-purple-400/70 block">AI parse fail / unclear</span>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-1.5 border-b border-slate-800 pb-2 overflow-x-auto no-scrollbar">
      <button data-tab="analytics" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-emerald-600 text-white cursor-pointer whitespace-nowrap">
        📊 Real-Time Analytics
      </button>
      <button data-tab="reports" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        🚨 User Reports ({reports.length})
      </button>
      <button data-tab="rejected" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        ⚠️ Unresolved & Rejected ({rejectedArticles.length})
      </button>
      <button data-tab="sources" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        📡 RSS & Wires ({sources.length})
      </button>
      <button data-tab="articles" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        📰 Articles ({articles.length})
      </button>
      <button data-tab="automation" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        🤖 AI & GitHub Actions
      </button>
      <button data-tab="settings" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        ⚙️ Site Config
      </button>
      <button data-tab="logs" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-900 transition-all cursor-pointer whitespace-nowrap">
        📜 System Logs
      </button>
    </div>

    <!-- TAB 1: REAL-TIME ANALYTICS -->
    <div id="tab-analytics" class="admin-tab-content space-y-6">
      <!-- Tools & Infrastructure Section -->
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
        <h3 class="text-sm font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          Integrated Infrastructure & Automation Tools
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {analytics.toolStats.map((tool) => (
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-white">{tool.name}</span>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 font-mono">{tool.status}</span>
              </div>
              <p class="text-[11px] text-emerald-400/80 font-mono">{tool.tier}</p>
              <p class="text-[11px] text-slate-400">{tool.model}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Trending Stories & Newly Fetched News -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Most Trending Stories -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              Most Trending Content
            </h3>
            <span class="text-[10px] text-slate-400 font-mono">By Engagement</span>
          </div>

          <div class="space-y-2">
            {analytics.trendingStories.map((story, idx) => (
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/70 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="text-xs font-black text-emerald-400 font-mono shrink-0">#{idx + 1}</span>
                  <a href={`/news/${story.slug}`} target="_blank" class="text-xs font-bold text-white hover:text-emerald-400 transition-colors truncate">
                    {story.title}
                  </a>
                </div>
                <span class="text-xs font-mono font-bold text-slate-400 shrink-0">{story.views_count} views</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Audience & Fetch Activity -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Audience Breakdown & Traffic
          </h3>

          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300">Page Impressions Today</span>
              <span class="text-sm font-black text-emerald-400 font-mono">{analytics.totalPageViewsToday} hits</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300">Articles Synthesized (Last 24h)</span>
              <span class="text-sm font-black text-sky-400 font-mono">+{analytics.newlyFetched24h} articles</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300">Primary Audience Geography</span>
              <span class="text-xs font-bold text-white">Nigeria (92%), UK/US Diaspora (8%)</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-300">Mobile vs Desktop Viewers</span>
              <span class="text-xs font-bold text-white">94% Mobile (Safe Area PWA)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: USER REPORTS TAB -->
    <div id="tab-reports" class="admin-tab-content hidden space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Article Reports & Inquiries</h2>
          <p class="text-xs text-slate-400">Reports submitted by readers via the Report button on articles.</p>
        </div>
      </div>

      {reports.length === 0 ? (
        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800 text-center text-slate-400 text-xs">
          No reports have been submitted. All published articles are in good standing!
        </div>
      ) : (
        <div class="space-y-3">
          {reports.map((rep) => (
            <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 space-y-2">
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase font-mono ${rep.status === 'pending' ? 'bg-amber-950 text-amber-300 border border-amber-800' : 'bg-emerald-950 text-emerald-300'}`}>
                      {rep.status}
                    </span>
                    <span class="text-xs font-bold text-white">{rep.reason}</span>
                  </div>
                  <p class="text-xs text-slate-300">Article: <a href={`/news/${rep.article_slug}`} target="_blank" class="text-emerald-400 underline">{rep.article_title || rep.article_id}</a></p>
                  {rep.details && <p class="text-xs text-slate-400 bg-slate-950 p-2 rounded-lg border border-slate-800/60 mt-1">"{rep.details}"</p>}
                  {rep.reporter_email && <p class="text-[11px] text-slate-500">Contact: {rep.reporter_email}</p>}
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  {rep.status === 'pending' && (
                    <button
                      onclick={`handleResolveReport('${rep.id}', 'resolved')`}
                      class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold cursor-pointer transition-colors"
                    >
                      Resolve
                    </button>
                  )}
                  <button
                    onclick={`handleResolveReport('${rep.id}', 'dismissed')`}
                    class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium cursor-pointer transition-colors"
                  >
                    Dismiss
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- TAB 3: UNRESOLVED & REJECTED NEWS -->
    <div id="tab-rejected" class="admin-tab-content hidden space-y-4">
      <div>
        <h2 class="text-base font-bold text-white">Unresolved & Rejected Leads (AI Strict Gate)</h2>
        <p class="text-xs text-slate-400">News stories that all 3 AI models couldn't rewrite, parse, or understand. These are kept private here to prevent publishing low quality.</p>
      </div>

      {rejectedArticles.length === 0 ? (
        <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800 text-center text-slate-400 text-xs">
          No rejected news leads in the queue. All ingested articles passed AI verification!
        </div>
      ) : (
        <div class="space-y-3">
          {rejectedArticles.map((rej) => (
            <div class="p-4 rounded-2xl bg-slate-900/90 border border-slate-800 space-y-2">
              <div class="flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase font-mono bg-red-950 text-red-300 border border-red-800">
                      AI REJECTED
                    </span>
                    <span class="text-xs font-mono text-slate-400">{rej.source_name}</span>
                  </div>
                  <h4 class="text-sm font-bold text-white">{rej.original_title}</h4>
                  <p class="text-xs text-red-300 font-mono">Reason: {rej.rejection_reason}</p>
                  {rej.ai_tier_failures && <p class="text-[11px] text-slate-400">{rej.ai_tier_failures}</p>}
                </div>

                <a
                  href={rej.original_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium cursor-pointer shrink-0 transition-colors"
                >
                  View Original &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- TAB 4: RSS & API SOURCES MANAGEMENT -->
    <div id="tab-sources" class="admin-tab-content hidden space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Configured Real RSS Feeds & Syndication Wires</h2>
          <p class="text-xs text-slate-400">Punch, Vanguard, Reuters, BBC Sports, TechCabal, World & more.</p>
        </div>
        <button
          id="btn-open-add-source"
          class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <span>+ Add Feed</span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {sources.map((src) => (
          <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 space-y-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-bold text-white">{src.name}</h3>
                  {src.is_official === 1 && (
                    <span class="px-1.5 py-0.5 text-[9px] font-bold uppercase rounded bg-emerald-950 text-emerald-300 border border-emerald-800/60">Official</span>
                  )}
                </div>
                <span class="text-[10px] text-slate-400 font-mono block mt-0.5 truncate max-w-xs">{src.feed_url}</span>
              </div>
              <button
                onclick={`handleTriggerSourceCrawl('${src.id}')`}
                class="px-2.5 py-1 rounded-lg bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600 hover:text-white text-xs font-bold transition-colors cursor-pointer shrink-0"
              >
                Fetch Now
              </button>
            </div>

            <div class="flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-slate-800">
              <span>Category: <strong class="text-slate-200">{src.category_name || 'General'}</strong></span>
              <span>Trust: <strong class="text-emerald-400">{src.trust_score}%</strong></span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- TAB 5: ARTICLES MANAGER -->
    <div id="tab-articles" class="admin-tab-content hidden space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Live Published Articles ({articles.length})</h2>
          <p class="text-xs text-slate-400">All verified articles currently serving on 9jaBeacon.</p>
        </div>
      </div>

      <div class="space-y-3">
        {articles.map((art) => (
          <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-4">
            <div class="space-y-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-950 text-emerald-300 border border-emerald-800/50">
                  {art.category_name || 'News'}
                </span>
                <span class="text-xs text-slate-400 font-mono">{art.views_count} views</span>
              </div>
              <h4 class="text-sm font-bold text-white truncate">{art.title}</h4>
              <p class="text-xs text-slate-400 truncate">{art.summary}</p>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <a
                href={`/news/${art.slug}`}
                target="_blank"
                class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition-colors"
              >
                View
              </a>
              <button
                onclick={`handleDeleteArticle('${art.id}')`}
                class="px-2.5 py-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 text-red-300 text-xs font-medium transition-colors cursor-pointer"
              >
                Delete
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- TAB 6: AI & GITHUB ACTIONS TAB -->
    <div id="tab-automation" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-white">3-Tier Multi-LLM & Image Generation Pipeline</h2>
            <p class="text-xs text-slate-400">Configure Cloudflare Workers AI, OpenRouter Multi-Model Fallbacks, and Flux-1-Schnell Image Studio.</p>
          </div>
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800/60 font-mono">
            Strict AI Gate Active
          </span>
        </div>

        <form id="automation-settings-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Cloudflare Account ID (Tier 1 AI & Flux Image)</label>
              <input type="text" name="cloudflare_account_id" value={autoSettingsMap.cloudflare_account_id || ''} placeholder="e.g. 7a8b9c..." class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Cloudflare API Token (Workers AI + D1)</label>
              <input type="password" name="cloudflare_api_token" value={autoSettingsMap.cloudflare_api_token || ''} placeholder="••••••••" class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">OpenRouter API Key (Tier 2 Multi-Model Fallback)</label>
              <input type="password" name="openrouter_api_key" value={autoSettingsMap.openrouter_api_key || ''} placeholder="sk-or-v1-••••••••" class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">OpenRouter Primary Model</label>
              <select name="openrouter_model" class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono">
                <option value="meta-llama/llama-3.3-70b-instruct:free" selected={autoSettingsMap.openrouter_model === 'meta-llama/llama-3.3-70b-instruct:free'}>Llama 3.3 70B Instruct (Free / Fast)</option>
                <option value="google/gemini-2.0-flash-exp:free" selected={autoSettingsMap.openrouter_model === 'google/gemini-2.0-flash-exp:free'}>Gemini 2.0 Flash Exp (Free)</option>
                <option value="meta-llama/llama-3.1-8b-instruct:free" selected={autoSettingsMap.openrouter_model === 'meta-llama/llama-3.1-8b-instruct:free'}>Llama 3.1 8B Instruct (Free)</option>
                <option value="mistralai/mistral-7b-instruct:free" selected={autoSettingsMap.openrouter_model === 'mistralai/mistral-7b-instruct:free'}>Mistral 7B Instruct (Free)</option>
                <option value="deepseek/deepseek-r1:free" selected={autoSettingsMap.openrouter_model === 'deepseek/deepseek-r1:free'}>DeepSeek R1 (Free / Reasoning)</option>
                <option value="qwen/qwen-2.5-72b-instruct" selected={autoSettingsMap.openrouter_model === 'qwen/qwen-2.5-72b-instruct'}>Qwen 2.5 72B Instruct</option>
                <option value="openai/gpt-4o-mini" selected={autoSettingsMap.openrouter_model === 'openai/gpt-4o-mini'}>GPT-4o Mini</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Pollinations API Key (Tier 3 Optional)</label>
              <input type="text" name="pollinations_api_key" value={autoSettingsMap.pollinations_api_key || ''} placeholder="Optional custom bearer token" class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Cloudflare Image Model</label>
              <input type="text" readonly value="@cf/black-forest-labs/flux-1-schnell" class="w-full h-10 px-3 bg-slate-950/60 border border-slate-800/80 rounded-xl text-xs text-emerald-400 font-mono" />
              <span class="text-[10px] text-slate-400 mt-1 block">Strict No-Human Policy active: Generates conceptual 3D/editorial still life only.</span>
            </div>
          </div>

          <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors cursor-pointer">
            Save AI & Model Settings
          </button>
        </form>
      </div>
    </div>

    <!-- TAB 7: SITE CONFIG -->
    <div id="tab-settings" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <h2 class="text-base font-bold text-white">Site Settings & Security</h2>
        <form id="site-settings-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Site Name</label>
              <input type="text" name="site_name" value={siteSettings.site_name || '9jaBeacon'} class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-300 mb-1">Admin Authorized Email</label>
              <input type="email" name="admin_email" value={siteSettings.admin_email || 'officialbonesceo@gmail.com'} class="w-full h-10 px-3 bg-slate-950 border border-slate-800 rounded-xl text-xs text-white font-mono" />
            </div>
          </div>

          <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors cursor-pointer">
            Save Site Settings
          </button>
        </form>
      </div>
    </div>

    <!-- TAB 8: AUDIT LOGS -->
    <div id="tab-logs" class="admin-tab-content hidden space-y-3">
      <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 space-y-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono">Real-Time Ingestion & Audit Stream</h3>
        <div class="divide-y divide-slate-800 max-h-96 overflow-y-auto font-mono text-[11px]">
          {logs.map((log) => (
            <div class="py-2 flex items-start gap-3">
              <span class={`px-1.5 py-0.5 rounded text-[9px] uppercase font-bold shrink-0 ${log.level === 'error' ? 'bg-red-950 text-red-300' : log.level === 'warning' ? 'bg-amber-950 text-amber-300' : 'bg-emerald-950 text-emerald-300'}`}>
                {log.event_type}
              </span>
              <span class="text-slate-300 flex-1">{log.message}</span>
              <span class="text-slate-500 shrink-0">{log.created_at}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  // Authentication Guard Check
  (function() {
    const token = localStorage.getItem('bonesceo_auth_token');
    const user = localStorage.getItem('bonesceo_auth_user');
    if (!token || user !== 'officialbonesceo@gmail.com') {
      window.location.href = '/bonesceo/admin/login';
    }
  })();

  // Admin Tab Switching
  document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      document.querySelectorAll('.admin-tab-btn').forEach((b) => {
        b.classList.remove('bg-emerald-600', 'text-white');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-emerald-600', 'text-white');
      btn.classList.remove('text-slate-400');

      document.querySelectorAll('.admin-tab-content').forEach((content) => {
        content.classList.add('hidden');
      });
      document.getElementById(`tab-${target}`)?.classList.remove('hidden');
    });
  });

  // Logout Handler
  document.getElementById('btn-admin-logout')?.addEventListener('click', () => {
    localStorage.removeItem('bonesceo_auth_token');
    localStorage.removeItem('bonesceo_auth_user');
    window.location.href = '/bonesceo/admin/login';
  });

  // Trigger All Feeds Crawl
  document.getElementById('btn-trigger-all-crawl')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-trigger-all-crawl');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Syncing RSS Feeds via AI...';
    }
    try {
      const res = await fetch('/api/admin/trigger-crawl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });
      const data = await res.json();
      if (data.success) {
        window.showToast?.(`Sync finished! ${data.totalIngested} stories published, ${data.totalRejectedNoAi} queued in rejected tab.`, 'success');
        setTimeout(() => window.location.reload(), 1500);
      }
    } catch {
      window.showToast?.('Error syncing feeds.');
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  // Global action handlers
  window.handleTriggerSourceCrawl = async function(sourceId) {
    try {
      window.showToast?.('Fetching source feed...', 'info');
      const res = await fetch('/api/admin/trigger-crawl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source_id: sourceId }),
      });
      const data = await res.json();
      if (data.success) {
        window.showToast?.(`Ingested ${data.totalIngested} articles!`, 'success');
        setTimeout(() => window.location.reload(), 1200);
      }
    } catch {}
  };

  window.handleResolveReport = async function(reportId, status) {
    try {
      const res = await fetch('/api/admin/reports', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: reportId, status }),
      });
      if (res.ok) {
        window.showToast?.(`Report marked as ${status}!`, 'success');
        setTimeout(() => window.location.reload(), 800);
      }
    } catch {}
  };

  window.handleDeleteArticle = async function(id) {
    if (confirm('Are you sure you want to delete this article?')) {
      try {
        const res = await fetch('/api/admin/articles', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        if (res.ok) {
          window.showToast?.('Article deleted');
          setTimeout(() => window.location.reload(), 800);
        }
      } catch {}
    }
  };

  // Save Settings Forms
  document.getElementById('automation-settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const settings = Object.fromEntries(formData.entries());
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'automation', settings }),
      });
      if (res.ok) window.showToast?.('AI settings updated successfully!', 'success');
    } catch {}
  });

  document.getElementById('site-settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const settings = Object.fromEntries(formData.entries());
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'site', settings }),
      });
      if (res.ok) window.showToast?.('Site settings saved!', 'success');
    } catch {}
  });
</script>
