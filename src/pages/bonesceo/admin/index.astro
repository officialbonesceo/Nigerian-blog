---
import Layout from '../../../layouts/Layout.astro';
import {
  getD1,
  getAdminDashboardStats,
  getArticles,
  getCategories,
  getSiteSettings,
} from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';
import StickmanStudio from '../../../components/StickmanStudio.astro';

const db = getD1(Astro.locals);
const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) token = match[1];
else if (authHeader.startsWith('Bearer ')) token = authHeader.slice(7).trim();
else if (queryToken) token = queryToken;

const siteSettings = await getSiteSettings(db);
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
if (!tokenVerification.valid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login', 302);
}

if (queryToken && tokenVerification.valid) {
  const isHttps =
    Astro.request.url.startsWith('https://') ||
    Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}

let stats: any = {};
let articles: any[] = [];
let categories: any[] = [];
try {
  const results = await Promise.all([
    getAdminDashboardStats(db),
    getArticles(db, { limit: 20 }),
    getCategories(db),
  ]);
  stats = results[0] || {};
  articles = results[1] || [];
  categories = results[2] || [];
} catch (e) {
  console.error('[Admin Hub]', e);
}

const totalArticles = stats.totalArticles || articles.length || 0;
const s = siteSettings as Record<string, string>;
---

<Layout title="Command Hub — 9jaBeacon" activeNav="menu" isWideLayout={true}>
  <div class="admin-shell min-h-[80vh] -mx-2 sm:mx-0">
    <!-- Mobile top bar -->
    <div class="lg:hidden sticky top-0 z-40 flex items-center justify-between gap-2 px-3 py-2.5 bg-white/95 dark:bg-slate-950/95 backdrop-blur border-b border-slate-200 dark:border-slate-800">
      <button type="button" id="drawerOpen" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800" aria-label="Open menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <span class="text-sm font-black text-slate-900 dark:text-white">Command Hub</span>
      <button type="button" onclick="logoutAdmin()" class="text-[11px] font-bold text-red-600 px-2">Out</button>
    </div>

    <div class="flex">
      <!-- Drawer backdrop -->
      <div id="drawerBackdrop" class="fixed inset-0 z-40 bg-black/40 hidden lg:hidden"></div>

      <!-- Sidebar / drawer -->
      <aside id="adminDrawer" class="fixed lg:sticky top-0 left-0 z-50 h-full lg:h-auto lg:top-0 w-[min(86vw,280px)] lg:w-56 shrink-0 bg-slate-950 text-slate-100 border-r border-slate-800 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out flex flex-col max-h-screen lg:max-h-none overflow-y-auto">
        <div class="p-4 border-b border-slate-800 flex items-center justify-between">
          <div>
            <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider">9jaBeacon</div>
            <div class="text-sm font-black">Admin</div>
          </div>
          <button type="button" id="drawerClose" class="lg:hidden p-1.5 rounded-lg hover:bg-slate-800" aria-label="Close">✕</button>
        </div>
        <nav class="p-2 space-y-0.5 flex-1" id="adminNav">
          <p class="px-3 pt-2 pb-1 text-[9px] font-bold text-slate-500 uppercase">Workspace</p>
          <button type="button" data-view="overview" class="nav-item w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800 flex items-center gap-2">Overview</button>
          <button type="button" data-view="articles" class="nav-item w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800 flex items-center gap-2">Articles</button>
          <a href="/bonesceo/admin/article-edit" class="block px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800 text-emerald-400">+ Write article</a>
          <button type="button" data-view="stickman" class="nav-item w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Stickman studio</button>

          <p class="px-3 pt-3 pb-1 text-[9px] font-bold text-slate-500 uppercase">Growth</p>
          <button type="button" data-view="socials" class="nav-item w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Social links</button>
          <a href="/bonesceo/admin/traffic" class="block px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Traffic analytics</a>
          <a href="/bonesceo/admin/hero" class="block px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Homepage hero</a>
          <a href="/bonesceo/admin/broadcast-desk" class="block px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Broadcast desk</a>

          <p class="px-3 pt-3 pb-1 text-[9px] font-bold text-slate-500 uppercase">System</p>
          <button type="button" data-view="security" class="nav-item w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800">Security</button>
          <a href="/" target="_blank" rel="noopener" class="block px-3 py-2.5 rounded-xl text-xs font-semibold hover:bg-slate-800 text-slate-400">View live site ↗</a>
        </nav>
        <div class="p-3 border-t border-slate-800 hidden lg:block">
          <button type="button" onclick="logoutAdmin()" class="w-full px-3 py-2 rounded-xl text-xs font-bold bg-red-950/50 text-red-300 hover:bg-red-900/40">Sign out</button>
        </div>
      </aside>

      <!-- Main content panels -->
      <main class="flex-1 min-w-0 p-3 sm:p-5 space-y-4 pb-24">
        <!-- OVERVIEW -->
        <section data-panel="overview" class="admin-panel space-y-4">
          <div>
            <h1 class="text-xl font-black text-slate-900 dark:text-white">Overview</h1>
            <p class="text-xs text-slate-500">Same shell · switch sections from the menu · no hunting URLs</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="text-[10px] uppercase font-bold text-slate-500">Articles</div>
              <div class="text-xl font-black mt-0.5">{totalArticles}</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="text-[10px] uppercase font-bold text-slate-500">Categories</div>
              <div class="text-xl font-black mt-0.5">{categories.length}</div>
            </div>
            <button type="button" data-view="articles" class="p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-left">
              <div class="text-[10px] uppercase font-bold text-emerald-700">Quick</div>
              <div class="text-sm font-bold text-emerald-900 dark:text-emerald-200 mt-1">Manage articles →</div>
            </button>
            <a href="/bonesceo/admin/traffic" class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 block">
              <div class="text-[10px] uppercase font-bold text-slate-500">Traffic</div>
              <div class="text-sm font-bold mt-1">Analytics →</div>
            </a>
          </div>
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex justify-between">
              <h2 class="text-sm font-black">Latest</h2>
              <button type="button" data-view="articles" class="text-[10px] font-bold text-emerald-600">All →</button>
            </div>
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
              {articles.slice(0, 8).map((a: any) => (
                <li class="px-4 py-2.5 flex gap-2 items-center">
                  <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="text-xs font-semibold line-clamp-1 flex-1 hover:text-emerald-600">{a.title}</a>
                  <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="text-[10px] font-bold text-emerald-600 shrink-0">Edit</a>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- ARTICLES -->
        <section data-panel="articles" class="admin-panel hidden space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h1 class="text-xl font-black">Articles</h1>
              <p class="text-xs text-slate-500">Edit · change images in dual-pane editor</p>
            </div>
            <a href="/bonesceo/admin/article-edit" class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold">+ Write</a>
          </div>
          <ul class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800">
            {articles.map((a: any) => (
              <li class="p-3 flex gap-3">
                {a.image_url ? <img src={a.image_url} alt="" class="w-14 h-10 rounded-lg object-cover shrink-0" loading="lazy" /> : <div class="w-14 h-10 rounded-lg bg-slate-100 dark:bg-slate-800 shrink-0" />}
                <div class="min-w-0 flex-1">
                  <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="text-xs font-bold line-clamp-2 hover:text-emerald-600">{a.title}</a>
                  <div class="flex gap-2 mt-1">
                    <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="text-[10px] font-bold text-emerald-600">Edit</a>
                    <a href={`/news/${a.slug}`} target="_blank" rel="noopener" class="text-[10px] font-bold text-slate-500">View</a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- SOCIALS -->
        <section data-panel="socials" class="admin-panel hidden space-y-3">
          <div>
            <h1 class="text-xl font-black">Social links</h1>
            <p class="text-xs text-slate-500">Public profile links for footer / about / share UI. Saved to site settings.</p>
          </div>
          <form id="socialsForm" class="space-y-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="block text-[10px] font-bold text-slate-500 uppercase">WhatsApp channel URL
                <input name="social_whatsapp" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_whatsapp || s.whatsapp_channel || 'https://whatsapp.com/channel/0029Vb99qfRJZg451r58zq00'} />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">X / Twitter
                <input name="social_twitter" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_twitter || s.twitter_url || ''} placeholder="https://x.com/..." />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">Bluesky
                <input name="social_bluesky" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_bluesky || ''} placeholder="https://bsky.app/profile/..." />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">Facebook
                <input name="social_facebook" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_facebook || ''} />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">YouTube
                <input name="social_youtube" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_youtube || ''} />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">TikTok
                <input name="social_tiktok" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_tiktok || ''} />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">Instagram
                <input name="social_instagram" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_instagram || ''} />
              </label>
              <label class="block text-[10px] font-bold text-slate-500 uppercase">Telegram
                <input name="social_telegram" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs" value={s.social_telegram || ''} />
              </label>
            </div>
            <p id="socialsStatus" class="text-xs font-semibold hidden"></p>
            <button type="submit" class="px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold">Save socials</button>
          </form>
        </section>

        <!-- STICKMAN -->
        <section data-panel="stickman" class="admin-panel hidden space-y-2">
          <h1 class="text-xl font-black">Stickman Presenter Studio</h1>
          <StickmanStudio />
        </section>

        <!-- SECURITY -->
        <section data-panel="security" class="admin-panel hidden space-y-3">
          <h1 class="text-xl font-black">Security</h1>
          <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            <p><strong class="text-slate-900 dark:text-white">Session:</strong> HttpOnly cookie <code class="text-[10px]">bonesceo_session</code> · SameSite=Lax · 30-day token HMAC.</p>
            <p><strong class="text-slate-900 dark:text-white">Settings API:</strong> requires valid admin session; cannot write password/secret keys via generic form.</p>
            <p><strong class="text-slate-900 dark:text-white">Do:</strong> use strong password in Cloudflare env <code>ADMIN_PASSWORD</code> · rotate if shared · never paste API tokens into article body.</p>
            <p><strong class="text-slate-900 dark:text-white">D1:</strong> automation capped · prefer traffic via Cloudflare Analytics (zero D1) · avoid bulk admin list scans on phone data.</p>
            <p class="text-amber-700 dark:text-amber-300">Hardcoded fallback secrets in code should be rotated to env-only when you can — treat current login as single-admin trust model.</p>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script is:inline>
  function logoutAdmin() {
    document.cookie = 'bonesceo_session=; Path=/; Max-Age=0';
    window.location.href = '/bonesceo/admin/login';
  }
  window.logoutAdmin = logoutAdmin;

  (function () {
    var drawer = document.getElementById('adminDrawer');
    var backdrop = document.getElementById('drawerBackdrop');
    function openDrawer() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
    }
    function closeDrawer() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
    }
    document.getElementById('drawerOpen')?.addEventListener('click', openDrawer);
    document.getElementById('drawerClose')?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    function showView(name) {
      document.querySelectorAll('.admin-panel').forEach(function (el) {
        el.classList.toggle('hidden', el.getAttribute('data-panel') !== name);
      });
      document.querySelectorAll('.nav-item').forEach(function (btn) {
        var active = btn.getAttribute('data-view') === name;
        btn.classList.toggle('bg-emerald-600', active);
        btn.classList.toggle('text-white', active);
      });
      try {
        history.replaceState(null, '', '#/' + name);
      } catch (e) {}
      closeDrawer();
      window.scrollTo(0, 0);
    }

    document.querySelectorAll('[data-view]').forEach(function (el) {
      el.addEventListener('click', function () {
        showView(el.getAttribute('data-view') || 'overview');
      });
    });

    var hash = (location.hash || '').replace(/^#\/?/, '') || 'overview';
    if (!document.querySelector('[data-panel="' + hash + '"]')) hash = 'overview';
    showView(hash);

    document.getElementById('socialsForm')?.addEventListener('submit', async function (e) {
      e.preventDefault();
      var form = e.target;
      var settings = {};
      new FormData(form).forEach(function (v, k) { settings[k] = String(v); });
      var st = document.getElementById('socialsStatus');
      try {
        var res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ type: 'site', settings: settings }),
        });
        var data = await res.json();
        if (st) {
          st.classList.remove('hidden');
          st.textContent = data.success ? '✅ Social links saved' : ('❌ ' + (data.error || 'Failed'));
          st.className = 'text-xs font-semibold ' + (data.success ? 'text-emerald-600' : 'text-red-600');
        }
      } catch (err) {
        if (st) {
          st.classList.remove('hidden');
          st.textContent = '❌ ' + err.message;
          st.className = 'text-xs font-semibold text-red-600';
        }
      }
    });
  })();
</script>
