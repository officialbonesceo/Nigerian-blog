      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'site',
            settings: {
              bing_api_key: apiKey,
              site_url: siteUrl,
              indexnow_key: indexNowKey,
              bing_auto_submit_enabled: autoSubmit,
              bing_include_indexnow: includeIndexNow,
            },
          }),
        });

        if (res.ok) {
          showBingResult('✔ Bing Webmaster settings saved successfully!', 'success');
        } else {
          const data = await res.json().catch(() => ({ error: 'Failed to save' }));
          showBingResult('✖ Error saving settings: ' + (data.error || 'Server error'), 'error');
        }
      } catch (err) {
        showBingResult('✖ Network error: ' + err.message, 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = originalText;
        }
      }
    }
    window.saveBingSettings = saveBingSettings;

    async function testBingConnection() {
      const testBtn = document.getElementById('testBingBtn');
      const apiKey = document.getElementById('bing_api_key')?.value?.trim() || '';
      const siteUrl = document.getElementById('bing_site_url')?.value?.trim() || 'https://9jabeacon.name.ng';

      if (!apiKey) {
        showBingResult('⚠ Please enter your Bing Webmaster API Key first.', 'warning');
        return;
      }

      if (testBtn) {
        testBtn.disabled = true;
        testBtn.innerText = 'Pinging Bing API...';
      }

      try {
        const res = await fetch('/api/admin/bing-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'test_connection',
            apiKey,
            siteUrl,
          }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showBingResult(`✔ Bing API Connection Verified! Status: ${data.statusCode || 200}. Homepage successfully pinged for indexing.`, 'success');
        } else {
          showBingResult(`✖ Bing API verification failed: ${data.message || data.error || 'Check API Key and verified site domain'}`, 'error');
        }
      } catch (err) {
        showBingResult('✖ Network error testing connection: ' + err.message, 'error');
      } finally {
        if (testBtn) {
          testBtn.disabled = false;
          testBtn.innerText = 'Test API Connection';
        }
      }
    }
    window.testBingConnection = testBingConnection;

    async function submitAllRecentToBing() {
      const batchBtn = document.getElementById('submitAllRecentBtn');
      const apiKey = document.getElementById('bing_api_key')?.value?.trim() || '';
      const siteUrl = document.getElementById('bing_site_url')?.value?.trim() || 'https://9jabeacon.name.ng';

