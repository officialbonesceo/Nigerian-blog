    window.callGenerateTimelineApi = async function() {
      const pId = workbenchSettings.activePresenterId;
      const headline = document.getElementById('wb-input-headline')?.value || '';
      const script = document.getElementById('wb-input-script')?.value || '';

      try {
        const res = await fetch('/api/admin/presenter-timeline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            presenterId: pId,
            headline,
            scriptText: script,
            speechRate: workbenchSettings.speechRate,
            hasBreakingAlert: workbenchSettings.hasBreakingAlert,
            outputFormat: 'landscape'
          })
        });

        const data = await res.json();
        if (data.success) {
          const jsonBlob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(jsonBlob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `timeline-${pId}-${Date.now()}.json`;
          a.click();
          URL.revokeObjectURL(url);
        } else {
          console.error('Timeline generation response:', data);
        }
      } catch (err) {
        console.error('Timeline API call failed:', err);
      }
    };

