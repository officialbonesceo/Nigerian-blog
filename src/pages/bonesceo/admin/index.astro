                <div id="modalArticleTitle" class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs font-bold text-slate-200"></div>
                <input type="hidden" id="modalArticleId" value="" />
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Rewrite Mode:</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-emerald-500/50 transition">
                    <input type="radio" name="modalRewriteMode" value="fresh_from_headline" checked class="mt-0.5 text-emerald-500 focus:ring-emerald-500" />
                    <div>
                      <span class="block text-xs font-bold text-white">Fresh From Headline</span>
                      <span class="block text-[10px] text-slate-400 mt-0.5">Discards any previous text/jargon and writes 500-700 words strictly grounded in the headline.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-emerald-500/50 transition">
                    <input type="radio" name="modalRewriteMode" value="full" class="mt-0.5 text-emerald-500 focus:ring-emerald-500" />
                    <div>
                      <span class="block text-xs font-bold text-white">Refine & Resynthesize</span>
                      <span class="block text-[10px] text-slate-400 mt-0.5">Re-reads existing lead notes and refines vocabulary and journalistic flow.</span>
                    </div>
                  </label>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Custom Editorial Guidance (Optional):</label>
                <textarea
                  id="modalCustomInstruction"
                  rows="2"
                  placeholder="e.g. Focus specifically on the economic impact on SME businesses, or emphasize official CBN statements..."
                  class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
                ></textarea>
              </div>

              <div id="modalRewriteStatus" class="hidden p-3 rounded-xl text-xs"></div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
              <button
                type="button"
                onclick="closeAiRewriteModal()"
                class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="button"
                id="modalSubmitRewriteBtn"
                onclick="executeModalRewrite()"
                class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-500/20"
