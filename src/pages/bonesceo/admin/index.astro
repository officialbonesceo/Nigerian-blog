                  </label>
                  <input
                    type="text"
                    name="baidu_site_verification"
                    value={siteSettings.baidu_site_verification || ''}
                    placeholder="e.g. baidu-site-verification token"
                    class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-500 font-mono"
                  />
                </div>

                <!-- Canonical URL -->
                <div>
                  <label class="block text-[11px] font-medium text-slate-300 mb-1">Production Canonical URL:</label>
                  <input
                    type="url"
                    name="site_url"
                    value={siteSettings.site_url || 'https://9jabeacon.name.ng'}
                    placeholder="https://9jabeacon.name.ng"
                    class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500 font-mono"
                  />
                </div>
              </div>

              <!-- Quick Sitemap & Feeds Links -->
              <div class="pt-2 grid grid-cols-3 gap-2 text-xs">
                <a
                  href="/sitemap.xml"
