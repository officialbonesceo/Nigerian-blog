    async function inspectBufferProfiles() {
      const tokenInput = document.getElementById('buffer_access_token_input');
      const inspectBtn = document.getElementById('inspectBufferBtn');
      const resultsBox = document.getElementById('buffer-profiles-results');
      const token = tokenInput ? tokenInput.value.trim() : '';

      if (!token) {
        alert('Please enter your Buffer Access Token first.');
        return;
      }

      if (inspectBtn) {
        inspectBtn.disabled = true;
        inspectBtn.textContent = 'Connecting to Buffer API...';
      }

      try {
        const res = await fetch('/api/admin/test-buffer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'verify_token', access_token: token }),
        });
        const data = await res.json();

        if (resultsBox) {
          resultsBox.classList.remove('hidden');
          if (data.success && Array.isArray(data.profiles) && data.profiles.length > 0) {
            let html = `<div class="p-2.5 rounded bg-emerald-950/40 text-emerald-300 font-bold mb-2">✔ Connected! Found ${data.profiles.length} Buffer social channel(s):</div><div class="space-y-2">`;
            for (const p of data.profiles) {
              const svc = (p.service || '').toLowerCase();
              const isPinterest = svc === 'pinterest';
              const isFacebook = svc === 'facebook';
              const isInstagram = svc === 'instagram';
              const targetInputId = isPinterest ? 'buffer_pinterest_id_input' : (isInstagram ? 'buffer_instagram_id_input' : 'buffer_facebook_id_input');

              html += `
                <div class="p-2.5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    ${p.avatar ? `<img src="${p.avatar}" class="w-6 h-6 rounded-full border border-slate-700 object-cover" />` : ''}
                    <div>
                      <div class="font-bold text-white text-xs">${p.formatted_service || p.service}: <span class="text-slate-300 font-normal">${p.service_username}</span></div>
                      <div class="text-[10px] text-slate-400 font-mono">ID: ${p.id}</div>
                    </div>
                  </div>
                  <button
                    type="button"
                    onclick="document.getElementById('${targetInputId}').value = '${p.id}'; this.textContent = '✔ Assigned!'; setTimeout(() => this.textContent = 'Use as ${p.service}', 2000)"
                    class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-xs text-emerald-400 font-semibold border border-slate-700 cursor-pointer"
                  >
                    Use as ${p.formatted_service || p.service}
                  </button>
                </div>
              `;
            }
            html += `</div>`;
            resultsBox.innerHTML = html;
          } else {
            resultsBox.innerHTML = `<div class="p-2.5 rounded bg-rose-950/40 text-rose-300">⚠ Buffer error: ${data.error || 'No channels found for this token. Make sure a Pinterest board or Facebook page is connected in your Buffer dashboard.'}</div>`;
          }
        }
      } catch (err) {
        if (resultsBox) {
          resultsBox.classList.remove('hidden');
          resultsBox.innerHTML = `<div class="p-2.5 rounded bg-rose-950/40 text-rose-300">⚠ Network error communicating with Buffer API: ${err.message}</div>`;
        }
      } finally {
        if (inspectBtn) {
          inspectBtn.disabled = false;
          inspectBtn.textContent = 'Inspect Buffer Channels (Find Pinterest Board)';
        }
      }
    }
    window.inspectBufferProfiles = inspectBufferProfiles;

