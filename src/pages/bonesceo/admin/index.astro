---
import Layout from '../../../layouts/Layout.astro';
import {
  getD1,
  getAdminDashboardStats,
  getSources,
  getArticles,
  getCategories,
  getAnalyticsMetrics,
  getAutomationLogs,
  getAutomationSettings,
  getRejectedArticles,
  getSiteSettings,
  getAdvertInquiries,
  getCustomAds,
  getVideoArticles,
  getPublishers,
} from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';
import { presenters } from '../../../lib/presenters-data';
import PresenterSprite from '../../../components/PresenterSprite.astro';
import BotVerifiedBadge from '../../../components/BotVerifiedBadge.astro';

const db = getD1(Astro.locals);

const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) {
  token = match[1];
} else if (authHeader.startsWith('Bearer ')) {
  token = authHeader.slice(7).trim();
} else if (queryToken) {
  token = queryToken;
}

const siteSettings = await getSiteSettings(db);
const videosEnabled = siteSettings.videos_enabled !== '0';
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
const isSessionValid = tokenVerification.valid;

// If a valid queryToken is present, set the cookie header on response so subsequent requests are authenticated
if (queryToken && isSessionValid) {
  const isHttps = Astro.request.url.startsWith('https://') || Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}

if (!isSessionValid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login', 302);
}

let stats: any = {};
let sources: any[] = [];
let articles: any[] = [];
let analytics: any = {};
let logs: any[] = [];
let autoSettings: any[] = [];
let rejectedList: any[] = [];
let categories: any[] = [];
let advertInquiries: any[] = [];
let customAds: any[] = [];
let videos: any[] = [];
let publishers: any[] = [];

try {
  const results = await Promise.all([
    getAdminDashboardStats(db),
    getSources(db),
    getArticles(db, { limit: 120 }),
    getAnalyticsMetrics(db),
    getAutomationLogs(db, 80),
    getAutomationSettings(db),
    getRejectedArticles(db, 40),
    getCategories(db),
    getAdvertInquiries(db),
    getCustomAds(db),
    getVideoArticles(db, { limit: 100, status: 'all' }),
    getPublishers(db, { onlyActive: false }),
  ]);
  stats = results[0];
  sources = results[1];
  articles = results[2];
  analytics = results[3];
  logs = results[4];
  autoSettings = results[5];
  rejectedList = results[6];
  categories = results[7];
  advertInquiries = results[8];
  customAds = results[9];
  videos = results[10]?.videos || [];
  publishers = results[11] || [];
} catch (dashErr) {
  console.error('[Admin Dashboard Error]:', dashErr);
}

const settingsMap: Record<string, string> = {};
for (const s of autoSettings) {
  settingsMap[s.key] = s.value;
}

const categoryFreshness = (categories || []).map((cat: any) => {
  const catArticles = (articles || []).filter((a: any) => a.category_id === cat.id || a.category_id === cat.slug);
  const latest = catArticles[0];
  const latestDate = latest?.published_at ? new Date(latest.published_at) : null;
  const hoursAgo = latestDate ? (Date.now() - latestDate.getTime()) / (1000 * 60 * 60) : null;
  const isFresh = hoursAgo !== null && hoursAgo <= 48;
  return {
    id: cat.id,
    slug: cat.slug,
    name: cat.name,
    icon: cat.icon || 'newspaper',
    color: cat.color || '#008751',
    count: catArticles.length,
    latestTitle: latest?.title || 'No recent articles',
    latestTimeStr: latestDate ? latestDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Never',
    hoursAgo,
    isFresh,
  };
});

// Database analytics & capacity projection metrics
const totalArticlesCount = stats.totalArticles || articles.length;
const totalSourcesCount = sources.length;
const totalLogsCount = logs.length;
const totalPublishersCount = publishers.length;
// Honest category publication metrics (Daily Goal: Exactly 2 per category = 8 total/day)
const todayDateStr = new Date().toISOString().split('T')[0];
const todayPublishedCount = (articles || []).filter((a: any) => {
  const d = a.published_at || a.created_at || '';
  return d.startsWith(todayDateStr);
}).length;
---

<Layout title="9jaBeacon Editorial Command Hub" activeNav="menu" isWideLayout={true}>
  <div class="space-y-6 pb-20">
    <!-- Header -->
    <header class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md flex flex-col md:flex-row md:items-center md:justify-between gap-4 transition-colors">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800/60">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span> LIVE REPOSITORY & D1
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">9jaBeacon Editorial Newsroom</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight text-slate-900 dark:text-white mt-1">Autonomous News & Editorial Command Hub</h1>
        <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-2xl leading-relaxed">
          Full-stack editorial operations, automated multi-LLM news synthesis, real-time wire ingestion monitors, and category broadcast telemetry.
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a
          href="/"
          target="_blank"
          class="px-3.5 py-2 text-xs font-semibold rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 hover:text-slate-950 dark:hover:text-white transition border border-slate-300 dark:border-slate-700 inline-flex items-center gap-1.5"
        >
          <span>View Live Site</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button
          id="quickCrawlBtn"
          onclick="triggerCrawlWorkflow()"
          class="px-4 py-2 text-xs font-bold rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition shadow-lg shadow-emerald-500/20 inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>Run Ingestion Workflow</span>
        </button>
        <button
          onclick="logoutAdmin()"
          title="Sign Out of Admin Portal"
          class="px-3 py-2 text-xs font-semibold rounded-xl bg-red-50 dark:bg-red-950/50 hover:bg-red-100 dark:hover:bg-red-900/80 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900/60 transition inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Sign Out</span>
        </button>
      </div>
    </header>

    <!-- High Level Metrics Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-slate-900 dark:text-white">{stats.publishedArticles}</div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Published News</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{stats.enabledSources} <span class="text-xs text-slate-400 font-normal">/ {sources.length}</span></div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Active Wire Feeds</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-cyan-600 dark:text-cyan-400">{logs.length}</div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Workflow Logs</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-amber-600 dark:text-amber-400">{stats.rejectedArticles}</div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Rejected Queue</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-purple-600 dark:text-purple-400">{stats.articleViews}</div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Total Page Views</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
        <div class="text-2xl font-black text-blue-600 dark:text-blue-400">{analytics.todayVisits}</div>
        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-0.5">Today Visits</div>
      </div>
    </div>

    <!-- CATEGORY FRESHNESS & LIVE WIRE DESKS MONITOR -->
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4 transition-colors">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-800/80">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">Live News Desks & Category Wire Monitor</h2>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Real-time status of all public news categories. Trigger targeted wire ingestion per desk or execute balanced multi-desk sync.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            onclick="triggerCrawlForCategory('', 'Balanced Multi-Category')"
            class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition shadow-sm inline-flex items-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            <span>Balanced Multi-Category Sync</span>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        {categoryFreshness.map((c) => (
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/90 dark:border-slate-800 flex flex-col justify-between space-y-3 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full" style={`background-color: ${c.color};`}></span>
                  {c.name}
                </span>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider ${
                  c.isFresh
                    ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30'
                    : 'bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30'
                }`}>
                  {c.isFresh ? 'Fresh • Live' : 'Needs Update'}
                </span>
              </div>
              <div class="mt-2 text-2xl font-black text-slate-900 dark:text-white">
                {c.count} <span class="text-xs font-normal text-slate-400">articles</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-400 line-clamp-1 mt-1 font-medium" title={c.latestTitle}>
                Latest: {c.latestTitle}
              </p>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
                Updated: <span class="font-mono text-slate-700 dark:text-slate-300">{c.latestTimeStr}</span>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center gap-2">
              <button
                onclick={`triggerCrawlForCategory('${c.id}', '${c.name}')`}
                class="flex-1 py-1.5 px-2.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-bold text-[11px] border border-emerald-500/20 transition flex items-center justify-center gap-1 cursor-pointer"
                title={`Fetch latest news for ${c.name}`}
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Crawl Desk</span>
              </button>
              <a
                href={`/category/${c.slug}`}
                target="_blank"
                class="p-1.5 rounded-lg bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition"
                title="View Category Page"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-3 overflow-x-auto no-scrollbar">
      <button
        onclick="switchAdminTab('crawler')"
        id="tab-btn-crawler"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>Workflow & Crawler</span>
      </button>
      <button
        onclick="switchAdminTab('logs')"
        id="tab-btn-logs"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Workflow Logs ({logs.length})</span>
      </button>
      <button
        onclick="switchAdminTab('ai-config')"
        id="tab-btn-ai-config"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>Editorial Engine & Social Channels</span>
      </button>
      <button
        onclick="switchAdminTab('sources')"
        id="tab-btn-sources"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        <span>RSS Sources ({sources.length})</span>
      </button>
      <button
        onclick="switchAdminTab('compose')"
        id="tab-btn-compose"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-500 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5 shadow-sm active:scale-95"
      >
        <span>✍️ Write Article & Post Now</span>
      </button>
      <button
        onclick="switchAdminTab('articles')"
        id="tab-btn-articles"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <span>Published Articles ({articles.length})</span>
      </button>
      <button
        onclick="switchAdminTab('videos')"
        id="tab-btn-videos"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M10 8l6 4-6 4V8zm11-5H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14z"/></svg>
        <span>Video News ({videos.length})</span>
        <span
          id="nav-videos-status-badge"
          class={`text-[9px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider ${
            videosEnabled
              ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
              : 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
          }`}
        >
          {videosEnabled ? 'LIVE' : 'PAUSED'}
        </span>
      </button>
      <button
        onclick="switchAdminTab('publishers')"
        id="tab-btn-publishers"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <BotVerifiedBadge size="xs" />
        <span>Editorial Desks ({publishers.length})</span>
        <span class="text-[9px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider bg-blue-500/20 text-blue-400 border border-blue-500/30">
          MUA
        </span>
      </button>
      <button
        onclick="switchAdminTab('rejected')"
        id="tab-btn-rejected"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white border border-slate-200 dark:border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
