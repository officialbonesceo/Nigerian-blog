    async function executeSaveArticleEdit() {
      const id = document.getElementById('editModalArticleId')?.value?.trim();
      const title = document.getElementById('editModalTitle')?.value?.trim();
      const slug = document.getElementById('editModalSlug')?.value?.trim();
      const category_id = document.getElementById('editModalCategory')?.value;
      const status = document.getElementById('editModalStatus')?.value;
      const source_name = document.getElementById('editModalSource')?.value?.trim();
      const reading_time_minutes = parseInt(document.getElementById('editModalReadingTime')?.value || '3', 10);
      const image_url = document.getElementById('editModalImageUrl')?.value?.trim();
      const is_top_story = document.getElementById('editModalIsTopStory')?.checked ? 1 : 0;
      const is_trending = document.getElementById('editModalIsTrending')?.checked ? 1 : 0;
      const is_breaking = document.getElementById('editModalIsBreaking')?.checked ? 1 : 0;
      const summary = document.getElementById('editModalSummary')?.value?.trim();
      const content = document.getElementById('editModalContent')?.value?.trim();

      const statusBox = document.getElementById('editModalStatusBox');
      const btn = document.getElementById('editModalSubmitBtn');
      const spinner = document.getElementById('editModalSpinner');
      const btnText = document.getElementById('editModalSubmitText');

      if (!id || !title || !content) {
        if (statusBox) {
          statusBox.className = 'block p-3 rounded-xl text-xs bg-red-950/80 border border-red-800 text-red-300';
          statusBox.textContent = '❌ Headline and Content body are required.';
        }
        return;
      }

      if (btn) btn.disabled = true;
      if (spinner) spinner.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Saving...';

      try {
        const payload = {
          id,
          title,
          slug,
          category_id,
          status,
          source_name,
          reading_time_minutes,
          image_url,
          is_top_story,
          is_trending,
          is_breaking,
          summary,
          content,
        };

        const res = await fetch('/api/admin/articles', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (res.ok && data.success) {
          if (statusBox) {
            statusBox.className = 'block p-3 rounded-xl text-xs bg-emerald-950/80 border border-emerald-800 text-emerald-300 font-bold';
            statusBox.textContent = '✔ Changes saved successfully!';
          }

          // Update the card live in the list
          const titleCardEl = document.getElementById('article-title-' + id);
          if (titleCardEl) {
            const anchor = titleCardEl.querySelector('a');
            if (anchor) anchor.textContent = title;
            else titleCardEl.textContent = title;
          }
          const summaryCardEl = document.getElementById('article-summary-' + id);
          if (summaryCardEl) {
            summaryCardEl.textContent = summary;
          }

          setTimeout(() => {
            closeEditArticleModal();
            if (btn) btn.disabled = false;
            if (spinner) spinner.classList.add('hidden');
            if (btnText) btnText.textContent = 'Save Changes';
          }, 900);
        } else {
          if (statusBox) {
            statusBox.className = 'block p-3 rounded-xl text-xs bg-red-950/80 border border-red-800 text-red-300';
            statusBox.textContent = '❌ Save failed: ' + (data.error || 'Unknown error');
          }
          if (btn) btn.disabled = false;
          if (spinner) spinner.classList.add('hidden');
          if (btnText) btnText.textContent = 'Save Changes';
        }
      } catch (err) {
        if (statusBox) {
          statusBox.className = 'block p-3 rounded-xl text-xs bg-red-950/80 border border-red-800 text-red-300';
          statusBox.textContent = '❌ Network error: ' + err.message;
        }
        if (btn) btn.disabled = false;
        if (spinner) spinner.classList.add('hidden');
        if (btnText) btnText.textContent = 'Save Changes';
      }
    }
