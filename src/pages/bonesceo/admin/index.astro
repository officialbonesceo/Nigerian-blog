---
import Layout from '../../../layouts/Layout.astro';
import {
  getD1,
  getAdminDashboardStats,
  getArticles,
  getCategories,
  getSiteSettings,
} from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';
import StickmanStudio from '../../../components/StickmanStudio.astro';

const db = getD1(Astro.locals);
const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) token = match[1];
else if (authHeader.startsWith('Bearer ')) token = authHeader.slice(7).trim();
else if (queryToken) token = queryToken;

const siteSettings = await getSiteSettings(db);
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
if (!tokenVerification.valid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login', 302);
}

if (queryToken && tokenVerification.valid) {
  const isHttps =
    Astro.request.url.startsWith('https://') ||
    Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}

let stats: any = {};
let articles: any[] = [];
let categories: any[] = [];
try {
  const results = await Promise.all([
    getAdminDashboardStats(db),
    getArticles(db, { limit: 12 }),
    getCategories(db),
  ]);
  stats = results[0] || {};
  articles = results[1] || [];
  categories = results[2] || [];
} catch (e) {
  console.error('[Admin Hub]', e);
}

const totalArticles = stats.totalArticles || articles.length || 0;
---

<Layout title="Command Hub — 9jaBeacon" activeNav="menu" isWideLayout={true}>
  <div class="max-w-5xl mx-auto space-y-5 pb-24 px-1 sm:px-0">
    <!-- Header -->
    <header class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
              LIVE
            </span>
            <span class="text-[11px] text-slate-500">9jaBeacon newsroom</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mt-1 tracking-tight">Command Hub</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md">
            Articles · traffic · stickman studio. No smartlink ads. Fits phone and desktop.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a
            href="/bonesceo/admin/traffic"
            class="px-3.5 py-2 text-xs font-bold rounded-xl bg-emerald-600 text-white hover:bg-emerald-500 inline-flex items-center gap-1.5"
          >
            Traffic Analytics
          </a>
          <a
            href="/"
            target="_blank"
            rel="noopener"
            class="px-3.5 py-2 text-xs font-semibold rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200"
          >
            View site
          </a>
          <button
            type="button"
            onclick="logoutAdmin()"
            class="px-3 py-2 text-xs font-semibold rounded-xl bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-300"
          >
            Sign out
          </button>
        </div>
      </div>
    </header>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase font-bold text-slate-500">Articles</div>
        <div class="text-xl font-black text-slate-900 dark:text-white mt-0.5">{totalArticles}</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase font-bold text-slate-500">Categories</div>
        <div class="text-xl font-black text-slate-900 dark:text-white mt-0.5">{categories.length}</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 col-span-2 sm:col-span-1">
        <div class="text-[10px] uppercase font-bold text-slate-500">Ads</div>
        <div class="text-sm font-bold text-slate-700 dark:text-slate-200 mt-1">Smartlink removed</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 col-span-2 sm:col-span-1">
        <div class="text-[10px] uppercase font-bold text-emerald-700 dark:text-emerald-400">Traffic</div>
        <a href="/bonesceo/admin/traffic" class="text-sm font-bold text-emerald-800 dark:text-emerald-200 mt-1 inline-block hover:underline">Open dashboard →</a>
      </div>
    </div>

    <!-- Quick links -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href="/bonesceo/admin/traffic" class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-400 transition">
        <div class="text-sm font-black text-slate-900 dark:text-white">Traffic & regions</div>
        <p class="text-[11px] text-slate-500 mt-1">Cloudflare edge analytics · zero D1 · busy region · paths</p>
      </a>
      <a href="/bonesceo/admin/hero" class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-400 transition">
        <div class="text-sm font-black text-slate-900 dark:text-white">Homepage hero</div>
        <p class="text-[11px] text-slate-500 mt-1">Carousel on/off · Adsterra hero slide only (no smartlink)</p>
      </a>
      <a href="/bonesceo/admin/broadcast-desk" class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-400 transition">
        <div class="text-sm font-black text-slate-900 dark:text-white">Broadcast desk</div>
        <p class="text-[11px] text-slate-500 mt-1">Desk brief / presenter tools</p>
      </a>
      <a href="#stickman" class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-400 transition">
        <div class="text-sm font-black text-slate-900 dark:text-white">Stickman studio</div>
        <p class="text-[11px] text-slate-500 mt-1">Presenter still live on this page ↓</p>
      </a>
    </section>

    <!-- Recent articles -->
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h2 class="text-sm font-black text-slate-900 dark:text-white">Latest articles</h2>
        <span class="text-[10px] text-slate-400">read-only list</span>
      </div>
      <ul class="divide-y divide-slate-100 dark:divide-slate-800">
        {articles.length === 0 && (
          <li class="px-4 py-6 text-xs text-slate-500 text-center">No articles loaded</li>
        )}
        {articles.map((a: any) => (
          <li class="px-4 py-3 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
            <a href={`/news/${a.slug}`} class="text-xs font-semibold text-slate-800 dark:text-slate-100 hover:text-emerald-600 line-clamp-2 flex-1" target="_blank" rel="noopener">
              {a.title}
            </a>
            <span class="text-[10px] text-slate-400 shrink-0">{(a.published_at || '').slice(0, 10)}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Stickman kept -->
    <section id="stickman" class="space-y-2">
      <h2 class="text-sm font-black text-slate-900 dark:text-white px-1">Stickman Presenter Studio</h2>
      <StickmanStudio />
    </section>

    <p class="text-[11px] text-slate-500 px-1 leading-relaxed">
      Full crawler / sources / multi-tab ops panel was slimmed for speed and mobile. Smartlink ad field removed from defaults.
      Traffic lives at <a class="text-emerald-600 font-semibold" href="/bonesceo/admin/traffic">/bonesceo/admin/traffic</a>.
      We can re-attach heavy ops tabs as separate pages without bloating this hub.
    </p>
  </div>
</Layout>

<script is:inline>
  function logoutAdmin() {
    document.cookie = 'bonesceo_session=; Path=/; Max-Age=0';
    window.location.href = '/bonesceo/admin/login';
  }
  window.logoutAdmin = logoutAdmin;
</script>
