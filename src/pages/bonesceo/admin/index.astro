    }
    window.submitAllRecentToBing = submitAllRecentToBing;

    async function submitSingleUrlManually() {
      const input = document.getElementById('manualSubmitUrlInput');
      const submitBtn = document.getElementById('manualSubmitBtn');
      const rawUrl = input ? input.value.trim() : '';

      if (!rawUrl) {
        showBingResult('⚠ Please enter a valid URL to submit.', 'warning');
        return;
      }

      const apiKey = document.getElementById('bing_api_key')?.value?.trim() || '';
      const siteUrl = document.getElementById('bing_site_url')?.value?.trim() || 'https://9jabeacon.name.ng';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting...';
      }

      try {
        const res = await fetch('/api/admin/bing-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'submit_single',
            url: rawUrl,
            apiKey,
            siteUrl,
          }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showBingResult(`✔ URL submitted to Bing & IndexNow: ${rawUrl}`, 'success');
          if (input) input.value = '';
        } else {
          showBingResult(`✖ Submission failed: ${data.message || data.error}`, 'error');
        }
      } catch (err) {
        showBingResult('✖ Network error: ' + err.message, 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit to Bing Now';
        }
      }
    }
    window.submitSingleUrlManually = submitSingleUrlManually;

    function showBingResult(msg, type = 'info') {
      const box = document.getElementById('bingResultBox');
      if (!box) return;
      box.classList.remove('hidden', 'bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300', 'bg-red-950/80', 'border-red-800', 'text-red-300', 'bg-amber-950/80', 'border-amber-800', 'text-amber-300', 'bg-slate-900', 'border-slate-800', 'text-slate-300');

      if (type === 'success') {
        box.classList.add('bg-emerald-950/80', 'border-emerald-800', 'text-emerald-300');
      } else if (type === 'error') {
        box.classList.add('bg-red-950/80', 'border-red-800', 'text-red-300');
      } else if (type === 'warning') {
        box.classList.add('bg-amber-950/80', 'border-amber-800', 'text-amber-300');
      } else {
        box.classList.add('bg-slate-900', 'border-slate-800', 'text-slate-300');
      }

      box.textContent = msg;
    }
  </script>
</Layout>
