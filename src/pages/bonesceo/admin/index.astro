    <!-- TAB 1: WORKFLOW & CRAWLER -->
    <div id="tab-content-crawler" class="admin-tab-content space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Execution Control Card -->
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Trigger Autonomous Crawl</span>
          </h2>
          <p class="text-xs text-slate-400">
            Pulls raw RSS leads, sends them through the 4-tier AI cascade (or local Qwen), rewrites headline and content, assigns categories with reasoning, generates visuals, and publishes directly to Cloudflare D1.
          </p>

          <div class="space-y-3 pt-2">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Target Source:</label>
              <select id="crawlSourceSelect" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                <option value="" selected>🔄 All Categories (Balanced Round-Robin Ingestion)</option>
                <optgroup label="Target by Category Desks">
                  <option value="cat_money_hustle">💼 Business & Financial News Feeds (TechCabal, BusinessDay, CNBC, Nairametrics)</option>
                  <option value="cat_sports">⚽ Sports News Feeds (BBC Sport, Sky Sports)</option>
                  <option value="cat_world">🌍 World News Wire Feeds (Reuters, BBC World, Al Jazeera)</option>
                  <option value="cat_naija_news">🇳🇬 Naija National News Feeds (Punch, Vanguard, Channels TV, etc.)</option>
                </optgroup>
                <optgroup label="Individual Wire Feeds">
                  {sources.map(s => (
                    <option value={s.id}>{s.name} ({s.category_name || 'General'})</option>
                  ))}
                </optgroup>
              </select>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Items Per Source (Batch size):</label>
              <select id="crawlBatchSize" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                <option value="2">2 items per feed (Fast verification)</option>
                <option value="4" selected>4 items per feed (Recommended)</option>
                <option value="8">8 items per feed (Deep batch)</option>
              </select>
            </div>

            <button
              id="startCrawlBtn"
              onclick="triggerCrawlWorkflow()"
              class="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer mt-3"
            >
              <svg id="crawlSpinner" class="w-4 h-4 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              <span id="crawlBtnText">Execute Editorial Workflow</span>
            </button>
          </div>

          <!-- Active Synthesis Engine Indicator -->
          <div class="pt-3 border-t border-slate-800/80 space-y-2">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Active Synthesis Engine Waterfall:</div>
            <div class="space-y-1.5 text-xs text-slate-300">
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-blue-950 text-blue-400 text-[10px] font-bold flex items-center justify-center">1</span>
                <div>
                  <div class="font-semibold text-white">Cloudflare Fast Engine</div>
                  <div class="text-[10px] text-slate-400">Llama 3.1 8B &bull; Qwen 1.5 7B &bull; DeepSeek Qwen 32B</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-purple-950 text-purple-400 text-[10px] font-bold flex items-center justify-center">2</span>
                <div>
                  <div class="font-semibold text-white">OpenRouter Editorial Engine</div>
                  <div class="text-[10px] text-slate-400">Qwen 2.5 72B &bull; DeepSeek R1 &bull; Llama 3.3 70B</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 text-[10px] font-bold flex items-center justify-center">3</span>
                <div>
                  <div class="font-semibold text-white">Local Offline Models (Ollama/LM Studio)</div>
                  <div class="text-[10px] text-slate-400">{settingsMap.local_ai_model || 'qwen2.5:3b'} @ {settingsMap.local_ai_endpoint || 'http://127.0.0.1:11434'}</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-emerald-950 text-emerald-400 text-[10px] font-bold flex items-center justify-center">4</span>
                <div>
                  <div class="font-semibold text-white">Pollinations Editorial Engine</div>
                  <div class="text-[10px] text-slate-400">Qwen-Coder &bull; Mistral &bull; Fast Models</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-300 text-[10px] font-bold flex items-center justify-center">5</span>
                <div>
                  <div class="font-semibold text-white">9jaBeacon Editorial NLP Core</div>
                  <div class="text-[10px] text-slate-400">In-depth contextual background, stakeholder impact & category verification</div>
                </div>
              </div>
            </div>
          </div>

          <!-- GitHub Actions Push Guard Policy Card -->
          <div class="pt-3 border-t border-slate-800/80 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">GitHub Actions Policy:</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                Push Triggers Disabled
              </span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-400 space-y-1">
              <div class="flex items-center gap-1.5 text-slate-300 font-semibold">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Zero CI/CD Runs on Git Push</span>
              </div>
              <p class="text-[11px] text-slate-400 leading-relaxed">
                Workflows will never trigger on <code class="text-slate-200 font-mono">git push</code>. Pipeline executes only via 4x daily scheduled cron or manual <code class="text-slate-200 font-mono">workflow_dispatch</code> in GitHub Actions.
              </p>
            </div>
          </div>
        </div>

        <!-- Live Workflow Execution Terminal -->
        <div class="lg:col-span-2 p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col justify-between space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
              <span class="text-xs font-mono text-slate-400 ml-2">editorial-workflow.log</span>
            </div>
            <button
              onclick="clearTerminalLog()"
              class="text-[11px] text-slate-500 hover:text-slate-300 transition"
            >
              Clear Console
            </button>
          </div>

          <div id="workflowTerminal" class="h-96 overflow-y-auto font-mono text-xs text-slate-300 space-y-1.5 p-2 bg-slate-900/50 rounded-xl border border-slate-800/60">
            <div class="text-emerald-400"># 9jaBeacon Autonomous Workflow Console Ready.</div>
            <div class="text-slate-500">// Click "Execute Editorial Workflow" to start real-time ingestion and synthesis.</div>
            {logs.slice(0, 15).map(l => (
              <div class="text-[11px] flex items-start gap-2">
                <span class="text-slate-500 whitespace-nowrap">[{new Date(l.created_at).toLocaleTimeString()}]</span>
                <span class={l.level === 'error' ? 'text-red-400 font-bold' : l.level === 'warning' ? 'text-amber-400' : 'text-slate-300'}>
                  {l.message}
                </span>
              </div>
            ))}
          </div>

          <div id="workflowStatusBadge" class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs flex items-center justify-between">
            <span class="text-slate-400">Workflow Status:</span>
            <span id="workflowStatusText" class="font-bold text-emerald-400">Idle &bull; Ready to crawl</span>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: WORKFLOW LOGS & AUDIT TRAIL -->
    <div id="tab-content-logs" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white">Full Automation & AI Telemetry Logs</h2>
            <p class="text-xs text-slate-400">Every decision, AI model call, classification score, and rejection reason recorded with high fidelity.</p>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="logSearchInput"
              onkeyup="filterLogsTable()"
              placeholder="Search logs by keyword..."
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500"
            />
            <button
              onclick="refreshLogsView()"
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition"
            >
              Refresh
            </button>
            <button
              onclick="clearAllLogsFromDb()"
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-red-950/60 hover:bg-red-900 text-red-300 border border-red-800/60 transition"
            >
              Clear Logs
            </button>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs" id="logsTable">
            <thead class="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="p-3 whitespace-nowrap">Timestamp</th>
                <th class="p-3 whitespace-nowrap">Event / Action</th>
                <th class="p-3 whitespace-nowrap">Source</th>
                <th class="p-3">Message / Rationale</th>
                <th class="p-3 whitespace-nowrap">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono">
              {logs.map(l => (
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="p-3 text-slate-400 whitespace-nowrap text-[11px]">{new Date(l.created_at).toLocaleTimeString()} ({new Date(l.created_at).toLocaleDateString()})</td>
                  <td class="p-3 font-semibold text-white whitespace-nowrap">{l.event_type || 'WORKFLOW_EVENT'}</td>
                  <td class="p-3 text-slate-300 whitespace-nowrap">{l.source_name || 'System'}</td>
                  <td class="p-3 text-slate-200">{l.message}</td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                      l.level === 'error' ? 'bg-red-950 text-red-400 border border-red-800' :
                      l.level === 'warning' ? 'bg-amber-950 text-amber-400 border border-amber-800' :
                      'bg-emerald-950 text-emerald-400 border border-emerald-800'
                    }`}>
                      {l.level.toUpperCase()}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Logs Pagination Controls -->
        <div class="pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-3">
            <span id="logs-pagination-info" class="text-slate-400 font-mono">
              Showing logs
            </span>
            <div class="flex items-center gap-1 text-slate-400">
              <span>Per page:</span>
              <select id="logs-pagesize" onchange="changeLogsPageSize()" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-slate-200">
                <option value="15">15</option>
                <option value="30" selected>30</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="logs-prev-btn"
              onclick="changeLogsPage(-1)"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
            >
              &larr; Prev
            </button>
            <span id="logs-page-indicator" class="font-mono text-slate-400 px-2">
              Page 1
            </span>
            <button
              id="logs-next-btn"
              onclick="changeLogsPage(1)"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
            >
              Next &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: EDITORIAL ENGINE & SOCIAL CONFIG -->
    <div id="tab-content-ai-config" class="admin-tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Configuration Form -->
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
            <span>Editorial Engine & Offline Fallback Setup</span>
          </h2>
          <p class="text-xs text-slate-400">
            Configure your automated editorial synthesis providers. When Cloudflare or OpenRouter hit quotas, the system seamlessly falls back to your local downloaded small models (Qwen, Ollama, LM Studio) or Editorial NLP.
          </p>

          <form id="aiSettingsForm" class="space-y-4 pt-2">
            <!-- Local Offline Section -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-amber-900/40 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span> Local Offline Fallback (Qwen / Ollama / LM Studio)
                </span>
                <span class="text-[10px] text-slate-500 font-mono">Offline Capable</span>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Local Endpoint URL:</label>
                <input
                  type="text"
                  name="local_ai_endpoint"
                  value={settingsMap.local_ai_endpoint || 'http://127.0.0.1:11434'}
                  placeholder="e.g. http://127.0.0.1:11434 or http://localhost:1234/v1"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-amber-400"
                />
                <p class="text-[10px] text-slate-500 mt-1">Supports Ollama, LM Studio, or LocalAI OpenAI-compatible API.</p>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Local Model Tag:</label>
                <input
                  type="text"
                  name="local_ai_model"
                  value={settingsMap.local_ai_model || 'qwen2.5:3b'}
                  placeholder="e.g. qwen2.5:3b, qwen2.5:7b, qwen2.5:0.5b, llama3.2:1b"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-amber-400"
                />
              </div>
            </div>

            <!-- Cloudflare Fast Engine -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
              <span class="text-xs font-bold text-blue-400 uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span> Cloudflare Fast Engine
              </span>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Cloudflare Account ID:</label>
                <input
                  type="text"
                  name="cloudflare_account_id"
                  value={settingsMap.cloudflare_account_id || ''}
                  placeholder="Paste Cloudflare Account ID"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-400"
