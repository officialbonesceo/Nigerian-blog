    window.toggleWorkbenchBroll = function(forceState) {
      const brollLayer = document.getElementById('wb-broll-layer');
      if (!brollLayer) return;
      const isCurrentlyActive = !brollLayer.classList.contains('opacity-0');
      const willBeActive = typeof forceState === 'boolean' ? forceState : !isCurrentlyActive;

      if (willBeActive) {
        brollLayer.classList.remove('opacity-0', 'pointer-events-none');
        brollLayer.classList.add('opacity-100');
      } else {
        brollLayer.classList.remove('opacity-100');
        brollLayer.classList.add('opacity-0', 'pointer-events-none');
      }
    };

    window.generateActiveTimeline = function() {
      const scriptInput = document.getElementById('wb-input-script');
      const script = (scriptInput ? scriptInput.value : '').trim();
      const words = script.split(/\s+/).filter(Boolean);
      const wordCount = Math.max(words.length, 1);
      const effectiveWpm = 135 * (workbenchSettings.speechRate || 1.0);
      const totalDurationMs = Math.max(Math.round((wordCount / effectiveWpm) * 60 * 1000), 12000);
      workbenchSettings.totalDurationMs = totalDurationMs;

      const events = [];
      const tPrepEnd = Math.min(1400, Math.round(totalDurationMs * 0.08));
      const tSpeechEnd = Math.max(totalDurationMs - 1200, 4000);

      const tAudienceEnd = Math.round(tPrepEnd + (tSpeechEnd - tPrepEnd) * 0.30);
      const tScreenEnd = Math.round(tPrepEnd + (tSpeechEnd - tPrepEnd) * 0.55);
      const tBrollEnd = Math.round(tPrepEnd + (tSpeechEnd - tPrepEnd) * 0.75);
      const tBookEnd = Math.round(tPrepEnd + (tSpeechEnd - tPrepEnd) * 0.90);

      // Phase 1: Standby / Preparing at desk looking at book
      events.push({
        timeMs: 0,
        pose: 'idle',
        mouth: 'closed',
        gaze: 'book',
        armState: 'hold_notes',
        stageMode: 'studio',
        coords: { x: '50%', y: '50%' }
      });

      // Phase 2: Look up to audience for speech start
      events.push({
        timeMs: tPrepEnd,
        pose: 'speaking',
        mouth: 'open',
        gaze: 'audience',
        armState: 'desk_rest',
        stageMode: 'studio',
        coords: { x: '50%', y: '50%' }
      });

      const cycleMs = 190;
      for (let t = tPrepEnd + 200; t < tSpeechEnd; t += cycleMs) {
        const isMouthOpen = (Math.floor(t / cycleMs) % 2 === 0);

        if (t < tAudienceEnd) {
          // Direct audience delivery
          events.push({
            timeMs: t,
            pose: workbenchSettings.hasBreakingAlert ? 'breaking' : 'speaking',
            mouth: isMouthOpen ? 'open' : 'closed',
            gaze: 'audience',
            armState: 'desk_rest',
            stageMode: 'studio',
            coords: { x: '50%', y: '50%' }
          });
        } else if (t < tScreenEnd) {
          // Turn to side screen and point arm
          events.push({
            timeMs: t,
            pose: 'speaking',
            mouth: isMouthOpen ? 'open' : 'closed',
            gaze: 'screen',
            armState: 'gesture_screen',
            stageMode: 'studio',
            coords: { x: '50%', y: '50%' }
          });
        } else if (t < tBrollEnd) {
          // B-Roll Interstitial Cutaway!
          events.push({
            timeMs: t,
            pose: 'speaking',
            mouth: isMouthOpen ? 'open' : 'closed',
            gaze: 'audience',
            armState: 'desk_rest',
            stageMode: 'b_roll',
            coords: { x: '50%', y: '50%' }
          });
        } else if (t < tBookEnd) {
          // Return to studio desk, looking down at book speaking stats
          events.push({
            timeMs: t,
            pose: 'speaking',
            mouth: isMouthOpen ? 'open' : 'closed',
            gaze: 'book',
            armState: 'hold_notes',
            stageMode: 'studio',
            coords: { x: '50%', y: '50%' }
          });
        } else {
          // Final audience address
          events.push({
            timeMs: t,
            pose: 'speaking',
            mouth: isMouthOpen ? 'open' : 'closed',
            gaze: 'audience',
            armState: 'desk_rest',
            stageMode: 'studio',
            coords: { x: '50%', y: '50%' }
          });
        }
      }

      // Wrap-up pose
      events.push({
        timeMs: tSpeechEnd,
        pose: 'wrap',
        mouth: 'closed',
        gaze: 'audience',
        armState: 'desk_rest',
        stageMode: 'studio',
        coords: { x: '50%', y: '50%' }
      });

      // Concluded
      events.push({
        timeMs: totalDurationMs,
        pose: 'idle',
        mouth: 'closed',
        gaze: 'book',
        armState: 'hold_notes',
        stageMode: 'studio',
        coords: { x: '50%', y: '50%' }
      });

      workbenchSettings.timelineEvents = events;

      // Update UI total time and frames
      const totalTimeLabel = document.getElementById('wb-total-time-label');
      const timeDisplay = document.getElementById('wb-time-display');
      const frameTotal = document.getElementById('wb-frame-total');

      if (totalTimeLabel) totalTimeLabel.textContent = formatTimeMsDisplay(totalDurationMs);
      if (timeDisplay && !workbenchSettings.isPlaying) {
        timeDisplay.textContent = `00:00.000 / ${formatTimeMsDisplay(totalDurationMs)}`;
      }
      if (frameTotal) {
        frameTotal.textContent = String(Math.round((totalDurationMs / 1000) * 30));
      }
    };

    function getEventAtTimeMs(timeMs) {
      const events = workbenchSettings.timelineEvents || [];
      if (!events || events.length === 0) {
        return {
          timeMs: 0,
          pose: 'idle',
          mouth: 'closed',
          gaze: 'audience',
          armState: 'desk_rest',
          stageMode: 'studio',
          coords: { x: '50%', y: '50%' }
        };
      }
      let current = events[0];
      for (let i = 0; i < events.length; i++) {
        if (events[i].timeMs <= timeMs) {
          current = events[i];
        } else {
          break;
        }
      }
      return current;
    }

    function applyTimelineEventToMonitor(event, currentTimeMs) {
      if (!event) return;

      // 1. Time display and scrubber
      const timeDisplay = document.getElementById('wb-time-display');
      const scrubber = document.getElementById('wb-scrubber-slider');
      const scrubberProgress = document.getElementById('wb-scrubber-progress');
      const frameCurrent = document.getElementById('wb-frame-current');

      if (timeDisplay) {
        timeDisplay.textContent = `${formatTimeMsDisplay(currentTimeMs)} / ${formatTimeMsDisplay(workbenchSettings.totalDurationMs)}`;
      }
      const pct = workbenchSettings.totalDurationMs > 0 ? (currentTimeMs / workbenchSettings.totalDurationMs) * 100 : 0;
      if (scrubber) scrubber.value = String(pct);
      if (scrubberProgress) scrubberProgress.style.width = `${pct}%`;
      if (frameCurrent) frameCurrent.textContent = String(Math.round((currentTimeMs / 1000) * 30));

      // 2. Pose badge
      const poseLabel = document.getElementById('wb-pose-label');
      if (poseLabel) {
        const poseName = event.pose ? (event.pose.charAt(0).toUpperCase() + event.pose.slice(1)) : 'Speaking';
        poseLabel.textContent = `Pose: ${poseName}`;
      }

      // 3. Apply Gesture
      const activeGesture = event.gesture || 
        (event.armState === 'gesture_screen' ? 'point-right' : 
         event.armState === 'hold_notes' ? 'reading' : 'idle');
      setWorkbenchGesture(activeGesture);

      // 4. Apply Gaze & Head Tilt
      const activeGaze = event.gaze === 'book' ? 'down' :
        event.gaze === 'screen' ? 'right' :
        event.gaze || (activeGesture === 'reading' ? 'down' : 'camera');
      setWorkbenchGaze(activeGaze);

      // 5. Apply Expression
      const activeExpr = event.expression || 
        (event.pose === 'breaking' ? 'serious' : 
         event.pose === 'wrap' ? 'happy' : 'neutral');
      setWorkbenchExpression(activeExpr);

      // 6. Apply Articulated Mouth (Directly on user's SVG face)
      if (event.mouth === 'open') {
        setWorkbenchMouth('open');
      } else if (event.mouth === 'alert' || event.mouth === 'wide') {
        setWorkbenchMouth('wide');
      } else {
        setWorkbenchMouth('closed');
      }

      // 7. Stage Mode & B-Roll Interstitial Layer
      const brollLayer = document.getElementById('wb-broll-layer');
      if (brollLayer) {
        if (event.stageMode === 'b_roll') {
          brollLayer.classList.remove('opacity-0', 'pointer-events-none');
          brollLayer.classList.add('opacity-100');
        } else {
          brollLayer.classList.remove('opacity-100');
          brollLayer.classList.add('opacity-0', 'pointer-events-none');
        }
      }
    }

    window.handleWorkbenchScrub = function(sliderVal) {
      const pct = parseFloat(sliderVal) / 100;
      const targetTimeMs = Math.round(pct * workbenchSettings.totalDurationMs);
      workbenchSettings.currentTimeMs = targetTimeMs;

      const event = getEventAtTimeMs(targetTimeMs);
      applyTimelineEventToMonitor(event, targetTimeMs);
    };

    window.toggleWorkbenchPlay = function() {
      if (workbenchSettings.isPlaying) {
        pauseWorkbenchTest();
      } else {
        startWorkbenchTest();
      }
    };

    window.startWorkbenchTest = function() {
      const scriptInput = document.getElementById('wb-input-script');
      const script = (scriptInput ? scriptInput.value : '').trim();
      if (!script) return;

      generateActiveTimeline();
      workbenchSettings.isPlaying = true;
      workbenchSettings.isPaused = false;

      // Update Play button state
      const playText = document.getElementById('wb-play-text');
      const playIcon = document.getElementById('wb-play-icon');
      const statusText = document.getElementById('wb-status-text');
      const statusDot = document.getElementById('wb-status-dot');
      const statusBadge = document.getElementById('wb-status-badge');
      const waveform = document.getElementById('wb-waveform');
      const audioIndicator = document.getElementById('wb-audio-indicator');

      if (playText) playText.textContent = 'Pause Test';
      if (playIcon) playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';

      if (statusText) statusText.textContent = workbenchSettings.hasBreakingAlert ? 'BREAKING ON AIR' : 'LIVE ON AIR';
      if (statusDot) statusDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping';
      if (statusBadge) statusBadge.className = 'px-2.5 py-1 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-mono text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5';
      if (waveform) waveform.classList.remove('opacity-40');

      // Play Background Tension Music Bed
      const bgAudio = document.getElementById('wb-bg-music');
      const musicSelect = document.getElementById('wb-select-bg-music');
      const chosenMusic = musicSelect ? musicSelect.value : '/audio/breaking-news-tension-bed.wav';

      if (bgAudio && chosenMusic !== 'none') {
        if (!bgAudio.src.endsWith(chosenMusic)) {
          bgAudio.src = chosenMusic;
        }
        const volSlider = document.getElementById('wb-music-volume');
        const vol = volSlider ? parseFloat(volSlider.value) / 100 : 0.15;
        bgAudio.volume = vol;
        bgAudio.play().catch(() => {});
        if (audioIndicator) audioIndicator.classList.remove('hidden');
      }

      const p = workbenchPresentersData[workbenchSettings.activePresenterId] || workbenchPresentersData['presenter_femi'];

      // Start SpeechSynthesis
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(script);
        utter.pitch = p.pitch;
        utter.rate = workbenchSettings.speechRate;

        const voices = window.speechSynthesis.getVoices();
        const prefVoice = voices.find(v => 
          (p.gender === 'female' ? v.name.toLowerCase().includes('female') || v.name.includes('Zira') || v.name.includes('Samantha') : v.name.toLowerCase().includes('male') || v.name.includes('David')) ||
          v.lang.startsWith('en')
        );
        if (prefVoice) utter.voice = prefVoice;

        utter.onend = function() {
          stopWorkbenchTest();
        };
        utter.onerror = function() {
          // If speech synthesis has an error, timer continues to demonstrate deterministic timeline
        };

        workbenchSettings.utterance = utter;
        setTimeout(() => window.speechSynthesis.speak(utter), 40);
      }

      // Start timeline animation interval
      const startTime = Date.now() - workbenchSettings.currentTimeMs;
      if (workbenchSettings.timerInterval) clearInterval(workbenchSettings.timerInterval);

      workbenchSettings.timerInterval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        workbenchSettings.currentTimeMs = elapsed;

        if (elapsed >= workbenchSettings.totalDurationMs) {
          stopWorkbenchTest();
          return;
        }

        const ev = getEventAtTimeMs(elapsed);
        applyTimelineEventToMonitor(ev, elapsed);
      }, 50);
    };

    window.pauseWorkbenchTest = function() {
      workbenchSettings.isPlaying = false;
      workbenchSettings.isPaused = true;
      if (workbenchSettings.timerInterval) clearInterval(workbenchSettings.timerInterval);
      if ('speechSynthesis' in window) window.speechSynthesis.pause();

      const bgAudio = document.getElementById('wb-bg-music');
      if (bgAudio) bgAudio.pause();

      const playText = document.getElementById('wb-play-text');
      const playIcon = document.getElementById('wb-play-icon');
      const statusText = document.getElementById('wb-status-text');
      const statusDot = document.getElementById('wb-status-dot');
      const waveform = document.getElementById('wb-waveform');

      if (playText) playText.textContent = 'Resume Test';
      if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      if (statusText) statusText.textContent = 'PAUSED';
      if (statusDot) statusDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400';
      if (waveform) waveform.classList.add('opacity-40');
    };

    window.stopWorkbenchTest = function() {
      workbenchSettings.isPlaying = false;
      workbenchSettings.isPaused = false;
      workbenchSettings.currentTimeMs = 0;
      if (workbenchSettings.timerInterval) clearInterval(workbenchSettings.timerInterval);
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();

      const bgAudio = document.getElementById('wb-bg-music');
      const audioIndicator = document.getElementById('wb-audio-indicator');
      if (bgAudio) {
        bgAudio.pause();
        bgAudio.currentTime = 0;
      }
      if (audioIndicator) audioIndicator.classList.add('hidden');

      const playText = document.getElementById('wb-play-text');
      const playIcon = document.getElementById('wb-play-icon');
      const statusText = document.getElementById('wb-status-text');
      const statusDot = document.getElementById('wb-status-dot');
      const statusBadge = document.getElementById('wb-status-badge');
      const waveform = document.getElementById('wb-waveform');

      if (playText) playText.textContent = 'Start Live Test';
      if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      if (statusText) statusText.textContent = 'STANDBY';
      if (statusDot) statusDot.className = 'w-1.5 h-1.5 rounded-full bg-slate-400';
      if (statusBadge) statusBadge.className = 'px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700 text-slate-300 font-mono text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5';
      if (waveform) waveform.classList.add('opacity-40');

      // Reset to Standby idle
      const ev = getEventAtTimeMs(0);
      applyTimelineEventToMonitor(ev, 0);
    };

    // 1-Click Auto-Select Real Trending Story Handler
    window.autoSelectRealStory = async function(mode) {
      const btn = mode === 'trending' ? document.getElementById('btn-auto-trending') : document.getElementById('btn-auto-mostread');
      const originalHtml = btn ? btn.innerHTML : '';
      if (btn) btn.innerHTML = '<span>⏳ Fetching story...</span>';

      try {
        const res = await fetch(`/api/admin/auto-select-story?mode=${mode}`);
        const data = await res.json();
        if (data.success) {
          // 1. Headline
          const headlineInput = document.getElementById('wb-input-headline');
          const headlineDisplay = document.getElementById('wb-display-headline');
          if (headlineInput) headlineInput.value = data.headline;
          if (headlineDisplay) headlineDisplay.textContent = data.headline;

          // 2. Script
          const scriptInput = document.getElementById('wb-input-script');
          if (scriptInput) {
            scriptInput.value = data.script;
            handleScriptInput(data.script);
          }

          // 3. Side Projection Bullets
          if (data.keyPoints && data.keyPoints.length) {
            const bulletsText = data.keyPoints.join('\n');
            const bulletsInput = document.getElementById('wb-input-bullets');
            if (bulletsInput) bulletsInput.value = bulletsText;
            updateProjectionBullets(bulletsText);
          }

          // 4. Auto-select matching presenter
          if (data.presenter && data.presenter.id) {
            selectWorkbenchPresenter(data.presenter.id);
          }

          if (btn) {
            btn.innerHTML = `<span>✅ Loaded: ${data.category}</span>`;
            setTimeout(() => { btn.innerHTML = originalHtml; }, 2500);
          }
        } else {
          if (btn) {
            btn.innerHTML = `<span>⚠️ ${data.error || 'Failed'}</span>`;
            setTimeout(() => { btn.innerHTML = originalHtml; }, 2500);
          }
        }
      } catch (e) {
        if (btn) {
          btn.innerHTML = '<span>⚠️ Network error</span>';
          setTimeout(() => { btn.innerHTML = originalHtml; }, 2500);
        }
      }
    };

