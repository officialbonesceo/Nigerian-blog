                    class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 leading-relaxed"
                    placeholder="Executive 2-sentence summary..."
                  ></textarea>
                </div>

                <!-- Full Article Body -->
                <div class="flex-1 flex flex-col">
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1 flex items-center justify-between">
                    <span>Full Article Body (HTML / 4 Subheadings):</span>
                    <span class="text-[10px] text-slate-500 font-normal">Supports &lt;h3&gt;, &lt;p&gt;, &lt;blockquote&gt;</span>
                  </label>
                  <textarea
                    id="editModalContent"
                    rows="10"
                    class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 leading-relaxed flex-1"
                    placeholder="Enter article body HTML..."
                  ></textarea>
                </div>

                <div id="editModalStatusBox" class="hidden p-3 rounded-xl text-xs"></div>
              </div>

              <!-- PANE 2: Original News Source (Live Wire - NOT saved in DB) -->
              <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3.5 flex flex-col">
                <div class="flex items-center justify-between pb-2 border-b border-slate-800 flex-wrap gap-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                    <span class="text-xs font-bold text-white uppercase tracking-wider">Article 2: Original News Source</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-300 border border-cyan-800">
                      NOT SAVED IN DB (ZERO COST)
                    </span>
                  </div>
                </div>

                <!-- Wire Source Header Bar -->
                <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                  <div class="space-y-0.5">
                    <div class="text-[11px] text-slate-400">Original Wire Outlet:</div>
                    <div id="editModalWireSourceName" class="text-xs font-extrabold text-white">Verified News Source</div>
                  </div>
                  <div class="flex items-center gap-2">
                    <a
                      id="editModalWireLink"
                      href="#"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-400 hover:text-cyan-300 text-xs font-semibold transition inline-flex items-center gap-1 border border-slate-700"
                    >
                      <span>Open Live Source</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    <button
                      type="button"
                      id="editModalToggleViewBtn"
                      onclick="toggleWireSourceViewMode()"
                      class="px-3 py-1.5 rounded-lg bg-cyan-950 hover:bg-cyan-900/80 text-cyan-300 border border-cyan-800 text-xs font-bold transition cursor-pointer"
                    >
                      Toggle Reader / iFrame
                    </button>
                  </div>
                </div>

                <!-- Quick Copy Assist Bar -->
                <div class="flex flex-wrap items-center gap-2 p-2 rounded-xl bg-slate-900/60 border border-slate-800 text-[11px]">
                  <span class="text-slate-400 font-medium">Quick Actions:</span>
                  <button
                    type="button"
                    onclick="copyWireToEditorHeadline()"
                    class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold transition cursor-pointer"
                  >
                    📋 Copy Headline
                  </button>
                  <button
                    type="button"
                    onclick="copyWireToEditorSummary()"
                    class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold transition cursor-pointer"
                  >
                    📋 Copy Lead Excerpt
                  </button>
                  <button
                    type="button"
                    onclick="appendWireQuoteToContent()"
                    class="px-2.5 py-1 rounded-lg bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-800 font-semibold transition cursor-pointer"
                  >
                    ✍️ Append Quote
                  </button>
                </div>

                <!-- Interactive Container: iFrame or Clean Reader -->
                <div class="flex-1 flex flex-col min-h-[460px] relative rounded-xl border border-slate-800 overflow-hidden bg-slate-900">
                  <!-- Mode 1: Live iFrame View -->
                  <div id="editModalIframeContainer" class="w-full h-full flex flex-col flex-1">
                    <div class="px-3 py-1.5 bg-slate-900 border-b border-slate-800 text-[10px] text-slate-400 flex items-center justify-between">
                      <span class="flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                        <span>Live Embedded Webpage Preview</span>
                      </span>
                      <span class="text-slate-500 font-mono">Zero DB storage consumed</span>
                    </div>
                    <iframe
                      id="editModalWireIframe"
                      src="about:blank"
                      class="w-full flex-1 min-h-[420px] bg-white border-0"
                      sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                      loading="lazy"
                    ></iframe>
                  </div>

                  <!-- Mode 2: Clean Reader View (Fall-safe if site blocks iframe embedding) -->
                  <div id="editModalReaderContainer" class="hidden p-4 space-y-3 overflow-y-auto flex-1">
                    <div class="p-3 rounded-lg bg-cyan-950/40 border border-cyan-800/60 text-[11px] text-cyan-300">
                      💡 <strong>Reader Mode Active:</strong> Reading source wire directly in reader format. You can copy phrases or facts directly into your 9jaBeacon article on the left.
                    </div>
                    <div>
                      <div class="text-[10px] uppercase font-mono text-slate-400">Wire Source Title:</div>
                      <div id="editModalReaderTitle" class="text-sm font-bold text-white mt-0.5"></div>
                    </div>
                    <div>
                      <div class="text-[10px] uppercase font-mono text-slate-400">Original URL:</div>
                      <div id="editModalReaderUrl" class="text-xs font-mono text-cyan-400 break-all mt-0.5"></div>
                    </div>
                    <div>
                      <div class="text-[10px] uppercase font-mono text-slate-400">Raw Excerpt / Summary:</div>
                      <div id="editModalReaderExcerpt" class="text-xs text-slate-300 leading-relaxed mt-1 p-3 rounded-xl bg-slate-950 border border-slate-800 whitespace-pre-wrap"></div>
                    </div>
                  </div>
                </div>

                <!-- Footer Cost Note -->
                <div class="text-[10px] text-slate-500 flex items-center justify-between font-mono">
                  <span>Client-side dynamic render</span>
                  <span class="text-emerald-400 font-bold">100% Free • $0 Cloudflare D1 impact</span>
                </div>
              </div>
            </div>

            <!-- Modal Footer Controls -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-800 shrink-0">
              <div class="text-xs text-slate-400 hidden sm:block">
                All changes saved on the left directly update the live 9jaBeacon website.
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  onclick="closeEditArticleModal()"
                  class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition cursor-pointer"
                >
                  Close Workstation
                </button>
                <button
                  type="button"
                  id="editModalSubmitBtn"
                  onclick="executeSaveArticleEdit()"
                  class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-500/20 active:scale-95"
                >
                  <svg id="editModalSpinner" class="w-3.5 h-3.5 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                  <span id="editModalSubmitText">💾 Save Changes to Database</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: VIDEO BROADCASTS DESK -->
    <div id="tab-content-videos" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <!-- MASTER VIDEO TAB PAUSE / TOGGLE CARD -->
        <div id="video-tab-controller-card" class="p-4 sm:p-5 rounded-2xl bg-slate-950 border border-slate-800 shadow-xl space-y-3">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2.5">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                  <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M10 8l6 4-6 4V8zm11-5H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14z"/></svg>
                  <span>Public Video Tab Status</span>
                </h3>
                <span id="video-tab-status-pill" class={`px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider flex items-center gap-1.5 ${videosEnabled ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30'}`}>
                  <span id="video-tab-status-dot" class={`w-2 h-2 rounded-full ${videosEnabled ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400'}`}></span>
                  <span id="video-tab-status-text">{videosEnabled ? 'Live & Visible' : 'Paused / Hidden'}</span>
                </span>
              </div>
              <p id="video-tab-status-desc" class="text-xs text-slate-400 max-w-2xl leading-relaxed">
                {videosEnabled
                  ? 'The "Videos" navigation tab is currently live in the top header and mobile drawer. Direct visits to /videos are accessible to all visitors.'
                  : 'The "Videos" tab is paused. It is hidden from public visitors in the header and mobile drawer, and direct visits to /videos redirect to Home (302). Admin accounts retain full preview access.'}
              </p>
            </div>

            <div class="flex items-center gap-2.5 shrink-0">
              <a
                href="/videos"
                target="_blank"
                class="px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-semibold border border-slate-800 transition flex items-center gap-1.5 cursor-pointer"
                title="Preview video hub in a new tab (authenticated admin preview works even when paused)"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span>Preview /videos</span>
              </a>

              <button
                type="button"
                id="btn-toggle-video-tab"
                onclick={`toggleAdminVideoTab(${videosEnabled ? 'false' : 'true'})`}
                class={`px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 cursor-pointer shadow-md ${
                  videosEnabled
                    ? 'bg-amber-600/90 hover:bg-amber-500 text-white shadow-amber-950/40'
                    : 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-emerald-950/40'
                }`}
              >
                <svg id="toggle-video-tab-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {videosEnabled ? (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  ) : (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  )}
                </svg>
                <span id="btn-toggle-video-tab-label">
                  {videosEnabled ? 'Pause Video Tab' : 'Enable / Publish Video Tab'}
                </span>
              </button>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span>Video News & Autonomous Broadcasts</span>
              <span id="admin-videos-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-red-950 text-red-300 border border-red-800">
                {videos.length} broadcasts
              </span>
            </h2>
            <p class="text-xs text-slate-400">Manage video news reports, live broadcast feeds, and YouTube syndicate channels.</p>
          </div>

          <!-- Controls: Add Video & Fetch YouTube News -->
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onclick="fetchLatestYouTubeVideos()"
              id="btn-fetch-yt-videos"
              class="px-3.5 py-1.5 rounded-xl bg-red-600/90 hover:bg-red-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-red-950/40"
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              <span>Fetch YouTube News</span>
            </button>

            <button
              type="button"
              onclick="openVideoModal(null)"
              class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-950/40"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>+ Add Video</span>
            </button>
          </div>
        </div>

        <!-- Filter Bar -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-800">
          <input
            type="text"
            id="admin-videos-search"
            oninput="filterAdminVideos()"
            placeholder="Search by title, source, or slug..."
            class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-red-500 w-52 sm:w-64"
          />
          <select
            id="admin-videos-category-filter"
            onchange="filterAdminVideos()"
            class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-red-500"
          >
            <option value="">All Categories</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Videos Table -->
        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-3">Video / Title</th>
                <th class="p-3">Source Channel</th>
                <th class="p-3">Category</th>
                <th class="p-3">Duration & Views</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="admin-videos-tbody" class="divide-y divide-slate-800/60 font-sans">
              {videos.map((vid) => (
                <tr class="hover:bg-slate-800/40 transition-colors admin-video-row" data-video-id={vid.id} data-video-category={vid.category_id} data-video-title={vid.title.toLowerCase()} data-video-source={vid.source_name.toLowerCase()}>
                  <td class="p-3">
                    <div class="flex items-center gap-3">
                      <div class="relative w-20 h-12 rounded-lg overflow-hidden bg-slate-950 shrink-0 border border-slate-700/60">
                        <img src={vid.thumbnail_url} alt="" class="w-full h-full object-cover" loading="lazy" />
                        <span class="absolute bottom-0.5 right-0.5 px-1 rounded bg-black/80 text-white text-[9px] font-mono font-bold">
                          {Math.floor(vid.duration_seconds / 60)}:{(vid.duration_seconds % 60).toString().padStart(2, '0')}
                        </span>
                      </div>
                      <div class="min-w-0 max-w-sm">
                        <div class="font-bold text-white line-clamp-1 hover:text-emerald-400">
                          <a href={`/videos/${vid.slug}`} target="_blank">{vid.title}</a>
                        </div>
                        <div class="text-[11px] text-slate-500 font-mono truncate mt-0.5">
                          slug: {vid.slug}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                      {vid.source_name}
                    </span>
                    <div class="text-[10px] text-slate-500 uppercase font-mono mt-0.5">
                      {vid.video_type}
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">
                      {vid.category_name || vid.category_id}
                    </span>
                  </td>
                  <td class="p-3 font-mono text-[11px] text-slate-400">
                    <div>{vid.views_count.toLocaleString()} views</div>
                    <div class="text-[10px] text-slate-500">{new Date(vid.published_at).toLocaleDateString()}</div>
                  </td>
                  <td class="p-3">
                    <div class="flex items-center gap-1.5">
                      <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase font-mono ${
                        vid.status === 'published'
                          ? 'bg-emerald-950 text-emerald-400 border border-emerald-800'
                          : 'bg-amber-950 text-amber-400 border border-amber-800'
                      }`}>
                        {vid.status}
                      </span>
                      {vid.is_featured ? (
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
                          Featured
                        </span>
                      ) : null}
                    </div>
                  </td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <a
                        href={`/videos/${vid.slug}`}
                        target="_blank"
                        class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition"
                        title="View Public Video"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      </a>
                      <button
                        type="button"
                        onclick={`editVideoItem('${vid.id}', ${JSON.stringify(vid.title)}, ${JSON.stringify(vid.video_url)}, ${JSON.stringify(vid.thumbnail_url)}, ${JSON.stringify(vid.category_id)}, ${vid.duration_seconds}, ${JSON.stringify(vid.source_name)}, ${JSON.stringify(vid.summary)}, ${vid.is_featured ? 'true' : 'false'}, ${JSON.stringify(vid.status)})`}
                        class="p-1.5 rounded-lg bg-blue-950 hover:bg-blue-900 text-blue-400 hover:text-white transition cursor-pointer"
                        title="Edit Video"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      </button>
                      <button
                        type="button"
                        onclick={`deleteVideoItem('${vid.id}')`}
                        class="p-1.5 rounded-lg bg-red-950 hover:bg-red-900 text-red-400 hover:text-white transition cursor-pointer"
                        title="Delete Video"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add/Edit Video Modal -->
      <div id="videoModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="w-full max-w-xl max-h-[90vh] bg-slate-900 rounded-2xl border border-slate-800 shadow-2xl overflow-hidden flex flex-col">
          <div class="p-4 border-b border-slate-800 flex items-center justify-between">
            <h3 id="videoModalTitle" class="text-sm font-bold text-white">Add New Video Broadcast</h3>
            <button type="button" onclick="closeVideoModal()" class="p-1 text-slate-400 hover:text-white rounded-lg cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <form id="videoModalForm" class="p-4 space-y-3 overflow-y-auto flex-1 text-xs">
            <input type="hidden" id="videoModalId" />


            <div>
              <label class="block font-semibold text-slate-300 mb-1">Headline / Video Title *</label>
              <input type="text" id="videoModalInputTitle" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" placeholder="e.g. Presidential Address: Comprehensive Economic Outlook" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-semibold text-slate-300 mb-1">Video URL (YouTube or MP4) *</label>
                <input type="url" id="videoModalInputUrl" oninput="autoDetectYtThumbnail(this.value)" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" placeholder="https://www.youtube.com/watch?v=..." />
              </div>
              <div>
                <label class="block font-semibold text-slate-300 mb-1">Thumbnail Image URL</label>
                <input type="url" id="videoModalInputThumb" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" placeholder="Auto-generated from YouTube if blank" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label class="block font-semibold text-slate-300 mb-1">Category</label>
                <select id="videoModalInputCategory" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500">
                  {categories.map((c) => (
                    <option value={c.id}>{c.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="block font-semibold text-slate-300 mb-1">Duration (Seconds)</label>
                <input type="number" id="videoModalInputDuration" min="0" value="300" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" />
              </div>
              <div>
                <label class="block font-semibold text-slate-300 mb-1">Source Name</label>
                <input type="text" id="videoModalInputSource" value="Channels Television" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" />
              </div>
            </div>

            <div>
              <label class="block font-semibold text-slate-300 mb-1">Summary & Key Context</label>
              <textarea id="videoModalInputSummary" rows="3" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-xs focus:outline-none focus:border-red-500" placeholder="Brief summary of key discussion points in this video broadcast..."></textarea>
            </div>

            <div class="flex items-center gap-6 pt-1">
              <label class="flex items-center gap-2 cursor-pointer text-slate-300">
                <input type="checkbox" id="videoModalInputFeatured" class="rounded accent-emerald-500" />
                <span>Featured on Video Hub Header</span>
              </label>

              <label class="flex items-center gap-2 cursor-pointer text-slate-300">
                <select id="videoModalInputStatus" class="px-2 py-1 rounded bg-slate-950 border border-slate-800 text-xs text-white">
                  <option value="published">Published</option>
                  <option value="draft">Draft</option>
                </select>
              </label>
            </div>

            <div class="pt-3 border-t border-slate-800 flex items-center justify-end gap-2">
              <button type="button" onclick="closeVideoModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs cursor-pointer">
                Cancel
              </button>
              <button type="submit" id="videoModalSubmitBtn" class="px-5 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-red-950/40">
                <span id="videoModalSubmitText">Save Video</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- TAB: AI PUBLISHERS & EDITORIAL TEAM -->
    <div id="tab-content-publishers" class="admin-tab-content hidden space-y-4">
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-6">
        <!-- Header & Action Row -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-base font-bold text-white">Editorial Bureau & AI Publishers</h2>
              <BotVerifiedBadge size="sm" showLabel={true} />
            </div>
            <p class="text-xs text-slate-400 mt-1 max-w-2xl">
              Manage the 15 Nigerian newsroom correspondents trained at MUA. Toggle publishing desks on or off, edit bios and beats, or apply the 5-profile core rotation preset.
            </p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button
              type="button"
              onclick="setCoreFivePublishers()"
              id="btn-set-core-5"
              class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-950/40"
              title="Activates the 5 primary correspondents and sets remaining 10 to reserve"
            >
              <span>⚡ Preset: Activate 5 Core Profiles</span>
            </button>
            <button
              type="button"
              onclick="openPublisherModal()"
              class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-950/40"
            >
              <span>+ Add Correspondent</span>
            </button>
          </div>
        </div>

        <!-- Metrics Overview -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Publishers</div>
            <div class="text-xl font-extrabold text-white mt-0.5">{publishers.length}</div>
            <div class="text-[10px] text-slate-500">Profiles in Registry</div>
          </div>
          <div class="p-3.5 rounded-xl bg-emerald-950/40 border border-emerald-800/60">
            <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Active Desks</div>
            <div id="metric-active-publishers-count" class="text-xl font-extrabold text-emerald-300 mt-0.5">
              {publishers.filter(p => p.is_active).length}
            </div>
            <div class="text-[10px] text-emerald-400/80">Currently Publishing</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800/80">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Reserve Desks</div>
            <div id="metric-inactive-publishers-count" class="text-xl font-extrabold text-slate-300 mt-0.5">
              {publishers.filter(p => !p.is_active).length}
            </div>
            <div class="text-[10px] text-slate-500">Toggled Off / Standby</div>
          </div>
          <div class="p-3.5 rounded-xl bg-blue-950/40 border border-blue-800/60">
            <div class="text-[10px] font-bold uppercase tracking-wider text-blue-400">Verified Academy</div>
            <div class="text-xl font-extrabold text-blue-300 mt-0.5">MUA</div>
            <div class="text-[10px] text-blue-400/80">Certified AI Journalism</div>
          </div>
        </div>

        <!-- Publishers Table / Cards -->
        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-950/70 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="p-3">Correspondent / Beat</th>
                <th class="p-3">Specialty</th>
                <th class="p-3">Academy</th>
                <th class="p-3">Dispatches</th>
                <th class="p-3">Active Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="admin-publishers-tbody" class="divide-y divide-slate-800/60 font-sans">
              {publishers.map((pub) => (
                <tr class="hover:bg-slate-800/40 transition-colors" data-pub-id={pub.id}>
                  <td class="p-3">
                    <div class="flex items-center gap-3">
                      <div class="relative w-12 h-12 rounded-xl overflow-hidden bg-slate-950 shrink-0 border border-slate-700/60">
                        <img src={pub.avatar_url} alt="" class="w-full h-full object-cover" loading="lazy" />
                        <div class="absolute -bottom-0.5 -right-0.5 bg-white dark:bg-slate-900 rounded-full p-0.5">
                          <BotVerifiedBadge size="xs" />
                        </div>
                      </div>
                      <div class="min-w-0 max-w-xs">
                        <div class="font-bold text-white flex items-center gap-1.5 hover:text-emerald-400">
                          <a href={`/publishers/${pub.slug}`} target="_blank">{pub.name}</a>
                          <BotVerifiedBadge size="xs" />
                        </div>
                        <div class="text-[11px] text-emerald-400 font-medium truncate mt-0.5">
                          {pub.role}
                        </div>
                        <div class="text-[10px] text-slate-500 font-mono truncate">
                          /{pub.slug}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="p-3">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">
                      {pub.category_specialty || 'General'}
                    </span>
                  </td>
                  <td class="p-3 font-mono text-[11px] text-slate-300">
                    <span class="px-2 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-900 font-bold">
                      {pub.school || 'MUA'}
                    </span>
                  </td>
                  <td class="p-3 font-mono text-[11px] text-slate-400">
                    {pub.articles_count || 0} articles
                  </td>
                  <td class="p-3">
                    <label class="relative inline-flex items-center cursor-pointer select-none">
                      <input
                        type="checkbox"
                        checked={Boolean(pub.is_active)}
                        onchange={`togglePublisherStatus('${pub.id}', this.checked)`}
                        class="sr-only peer"
                      />
                      <div class="w-9 h-5 bg-slate-700 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
                      <span class={`ml-2 text-[10px] font-bold pub-status-text-${pub.id} ${pub.is_active ? 'text-emerald-400' : 'text-slate-500'}`}>
                        {pub.is_active ? 'ACTIVE' : 'OFF'}
                      </span>
                    </label>
                  </td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <a
                        href={`/publishers/${pub.slug}`}
                        target="_blank"
                        class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition"
                        title="View Public Profile"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      </a>
                      <button
                        type="button"
                        onclick={`editPublisherModal(${JSON.stringify(pub)})`}
                        class="p-1.5 rounded-lg bg-blue-950 hover:bg-blue-900 text-blue-400 hover:text-white transition cursor-pointer"
                        title="Edit Publisher Profile"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      </button>
                      <button
                        type="button"
                        onclick={`deletePublisherItem('${pub.id}')`}
                        class="p-1.5 rounded-lg bg-red-950 hover:bg-red-900 text-red-400 hover:text-white transition cursor-pointer"
                        title="Delete Publisher"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add/Edit Publisher Modal -->
      <div id="publisherModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="w-full max-w-lg max-h-[90vh] bg-slate-900 rounded-2xl border border-slate-800 shadow-2xl overflow-hidden flex flex-col">
          <div class="p-4 border-b border-slate-800 flex items-center justify-between">
            <h3 id="publisherModalTitle" class="text-sm font-bold text-white flex items-center gap-1.5">
              <span>Edit Publisher Profile</span>
              <BotVerifiedBadge size="xs" />
            </h3>
            <button type="button" onclick="closePublisherModal()" class="p-1 text-slate-400 hover:text-white rounded-lg cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <form id="publisherModalForm" onsubmit="savePublisherModalForm(event)" class="p-5 space-y-4 overflow-y-auto">
            <input type="hidden" id="pubModalInputId" value="" />

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
              <input type="text" id="pubModalInputName" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500" placeholder="e.g. Damilola Adeyemi" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">URL Slug</label>
                <input type="text" id="pubModalInputSlug" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 font-mono" placeholder="damilola-adeyemi" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Academy / School</label>
                <input type="text" id="pubModalInputSchool" value="MUA" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 font-mono" placeholder="MUA" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Newsroom Role / Beat Title</label>
              <input type="text" id="pubModalInputRole" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500" placeholder="e.g. Lead Governance & Policy Correspondent" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Category Specialty</label>
                <select id="pubModalInputCategory" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500">
                  <option value="cat_naija_news">Naija News & Governance</option>
                  <option value="cat_money_hustle">Business, Markets & FX</option>
                  <option value="cat_sports">Sports & Athletics</option>
                  <option value="cat_world">World Affairs & Diplomacy</option>
                  <option value="cat_tech">Tech Ecosystem & AI</option>
                  <option value="cat_entertainment">Culture & Entertainment</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Active Status</label>
                <select id="pubModalInputActive" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500">
                  <option value="1">Active Publishing Desk</option>
                  <option value="0">Reserve / Inactive</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Studio Avatar URL</label>
              <input type="text" id="pubModalInputAvatar" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 font-mono text-[11px]" placeholder="/publishers/damilola-adeyemi.jpg" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Editorial Biography</label>
              <textarea id="pubModalInputBio" rows="3" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-hidden focus:border-emerald-500 leading-relaxed" placeholder="Brief biography highlighting their beat and MUA training..."></textarea>
            </div>

            <div class="pt-3 border-t border-slate-800 flex items-center justify-end gap-2">
              <button type="button" onclick="closePublisherModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs cursor-pointer">
                Cancel
              </button>
              <button type="submit" id="pubModalSubmitBtn" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-950/40">
                <span id="pubModalSubmitText">Save Correspondent</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- TAB 6: REJECTED LEADS QUEUE -->
    <div id="tab-content-rejected" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-white">Unresolved & Rejected Leads Queue</h2>
            <p class="text-xs text-slate-400">Leads that could not be verified, parsed, or synthesized by AI models. Logged safely to prevent bad publishes.</p>
          </div>
        </div>

        {rejectedList.length === 0 ? (
          <div class="p-8 text-center text-slate-500 text-xs">No rejected leads found. All stories have synthesized cleanly.</div>
        ) : (
          <div id="rejected-leads-container" class="space-y-3">
            {rejectedList.map(r => (
              <div class="rejected-lead-item p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <div class="font-bold text-xs text-white">{r.original_title}</div>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-950 text-red-400 border border-red-800 whitespace-nowrap">
                    REJECTED
                  </span>
                </div>
                <div class="text-[11px] text-red-300 font-mono bg-red-950/20 p-2 rounded border border-red-900/40">
                  Reason: {r.rejection_reason}
                </div>
                {r.ai_tier_failures && (
                  <div class="text-[10px] text-slate-400 font-mono">
                    AI Trace: {r.ai_tier_failures}
                  </div>
                )}
                <div class="text-[10px] text-slate-500 flex items-center justify-between pt-1">
                  <span>Source: {r.source_name || 'Unknown'} &bull; {new Date(r.created_at).toLocaleString()}</span>
                  {r.original_url && (
                    <a href={r.original_url} target="_blank" class="text-slate-400 hover:text-white underline">
                      View Original Lead
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- Rejected Leads Pagination Controls -->
        {rejectedList.length > 0 && (
          <div id="rejected-pagination-bar" class="pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
            <span id="rejected-pagination-info" class="text-slate-400 font-mono">
              Showing leads
            </span>
            <div class="flex items-center gap-2">
              <button
                id="rejected-prev-btn"
                onclick="changeRejectedPage(-1)"
                class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
              >
                &larr; Prev
              </button>
              <span id="rejected-page-indicator" class="font-mono text-slate-400 px-2">
                Page 1
              </span>
              <button
                id="rejected-next-btn"
                onclick="changeRejectedPage(1)"
                class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
              >
                Next &rarr;
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- TAB 7: ADMIN & SECURITY CREDENTIALS -->
    <div id="tab-content-security" class="admin-tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Credentials Manager -->
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Administrator Access Credentials</span>
            </h2>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">
              D1 & Cloudflare Synced
            </span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Manage your admin access credentials. Changing your password here will immediately persist it to your Cloudflare D1 database and keep it synchronized across all workers.
          </p>

          <form id="adminCredentialsForm" class="space-y-4 pt-2">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Primary Admin Email</label>
              <input
                type="email"
                id="secAdminEmail"
                name="admin_email"
                value={siteSettings.admin_email || 'officialbonesceo@gmail.com'}
                required
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-emerald-500 font-mono"
              />
              <p class="text-[11px] text-slate-500 mt-1">Authorized for 1-click Google Sign-in and standard password authentication.</p>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Update Admin Password</label>
              <input
                type="password"
                id="secAdminPassword"
                name="admin_password"
                placeholder="Enter new administrator password"
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:border-emerald-500 font-mono"
              />
              <p class="text-[11px] text-slate-500 mt-1">Leave blank to keep your current password, or enter a new one to update immediately.</p>
            </div>

            <div id="credSaveStatus" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

            <button
              type="submit"
              id="saveCredsBtn"
              class="w-full px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center justify-center gap-2 cursor-pointer shadow-md"
            >
