---
import Layout from '../../../layouts/Layout.astro';
import {
  getD1,
  getAdminDashboardStats,
  getSources,
  getArticles,
  getAnalyticsMetrics,
  getAutomationLogs,
  getAutomationSettings,
  getRejectedArticles,
  getSiteSettings,
} from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';

const db = getD1(Astro.locals);

const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) {
  token = match[1];
} else if (authHeader.startsWith('Bearer ')) {
  token = authHeader.slice(7).trim();
} else if (queryToken) {
  token = queryToken;
}

const siteSettings = await getSiteSettings(db);
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
const isSessionValid = tokenVerification.valid;

// If a valid queryToken is present, set the cookie header on response so subsequent requests are authenticated
if (queryToken && isSessionValid) {
  const isHttps = Astro.request.url.startsWith('https://') || Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}

// Redirect to login only if neither valid token nor cookie is present
if (!isSessionValid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login');
}

const [stats, sources, articles, analytics, logs, autoSettings, rejectedList] = await Promise.all([
  getAdminDashboardStats(db),
  getSources(db),
  getArticles(db, { limit: 120 }),
  getAnalyticsMetrics(db),
  getAutomationLogs(db, 80),
  getAutomationSettings(db),
  getRejectedArticles(db, 40),
]);

const settingsMap: Record<string, string> = {};
for (const s of autoSettings) {
  settingsMap[s.key] = s.value;
}
---

<Layout title="9jaBeacon Editorial Command Hub" activeNav="menu">
  <div class="space-y-6 pb-20">
    <!-- Header -->
    <header class="p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-950 text-emerald-400 border border-emerald-800/60">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span> LIVE D1 DATABASE
          </span>
          <span class="text-xs text-slate-400 font-medium">9jaBeacon Editorial Engine</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-black tracking-tight text-white mt-1">Autonomous News & Editorial Command Hub</h1>
        <p class="text-xs md:text-sm text-slate-400 mt-1 max-w-2xl">
          Multi-tier automated synthesis (Cloudflare Fast Engine &rarr; OpenRouter &rarr; Local Offline Models &rarr; Editorial NLP) with real-time telemetry logs.
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a
          href="/"
          target="_blank"
          class="px-3.5 py-2 text-xs font-semibold rounded-xl bg-slate-800 text-slate-200 hover:bg-slate-700 hover:text-white transition border border-slate-700 inline-flex items-center gap-1.5"
        >
          <span>View Live Site</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button
          id="quickCrawlBtn"
          onclick="triggerCrawlWorkflow()"
          class="px-4 py-2 text-xs font-bold rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition shadow-lg shadow-emerald-500/20 inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>Run Ingestion Workflow</span>
        </button>
        <button
          onclick="logoutAdmin()"
          title="Sign Out of Admin Portal"
          class="px-3 py-2 text-xs font-semibold rounded-xl bg-red-950/50 hover:bg-red-900/80 text-red-300 border border-red-900/60 transition inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Sign Out</span>
        </button>
      </div>
    </header>

    <!-- High Level Metrics Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-white">{stats.publishedArticles}</div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Published News</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-emerald-400">{stats.enabledSources} <span class="text-xs text-slate-500 font-normal">/ {sources.length}</span></div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Active Wire Feeds</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-cyan-400">{logs.length}</div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Workflow Logs</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-amber-400">{stats.rejectedArticles}</div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Rejected Queue</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-purple-400">{stats.articleViews}</div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Total Page Views</div>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
        <div class="text-2xl font-black text-blue-400">{analytics.todayVisits}</div>
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mt-0.5">Today Visits</div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-800 pb-3 overflow-x-auto no-scrollbar">
      <button
        onclick="switchAdminTab('crawler')"
        id="tab-btn-crawler"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>Workflow & Crawler</span>
      </button>
      <button
        onclick="switchAdminTab('logs')"
        id="tab-btn-logs"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Workflow Logs ({logs.length})</span>
      </button>
      <button
        onclick="switchAdminTab('ai-config')"
        id="tab-btn-ai-config"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>Editorial Engine & Social Channels</span>
      </button>
      <button
        onclick="switchAdminTab('sources')"
        id="tab-btn-sources"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
        <span>RSS Sources ({sources.length})</span>
      </button>
      <button
        onclick="switchAdminTab('articles')"
        id="tab-btn-articles"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <span>Published Articles ({articles.length})</span>
      </button>
      <button
        onclick="switchAdminTab('rejected')"
        id="tab-btn-rejected"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span>Rejected Leads ({rejectedList.length})</span>
      </button>
      <button
        onclick="switchAdminTab('security')"
        id="tab-btn-security"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Admin & Security Credentials</span>
      </button>
      <button
        onclick="switchAdminTab('monetag')"
        id="tab-btn-monetag"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Monetag Ad Integration</span>
      </button>
      <button
        onclick="switchAdminTab('bing')"
        id="tab-btn-bing"
        class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition bg-slate-900 text-slate-300 hover:text-white border border-slate-800 cursor-pointer whitespace-nowrap inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span>Bing & IndexNow SEO API</span>
      </button>
    </div>

    <!-- TAB 1: WORKFLOW & CRAWLER -->
    <div id="tab-content-crawler" class="admin-tab-content space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Execution Control Card -->
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Trigger Autonomous Crawl</span>
          </h2>
          <p class="text-xs text-slate-400">
            Pulls raw RSS leads, sends them through the 4-tier AI cascade (or local Qwen), rewrites headline and content, assigns categories with reasoning, generates visuals, and publishes directly to Cloudflare D1.
          </p>

          <div class="space-y-3 pt-2">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Target Source:</label>
              <select id="crawlSourceSelect" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                <option value="">⚡ All Enabled Sources ({sources.filter(s => s.is_enabled).length})</option>
                {sources.map(s => (
                  <option value={s.id}>{s.name} ({s.category_name || 'General'})</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Items Per Source (Batch size):</label>
              <select id="crawlBatchSize" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                <option value="2">2 items per feed (Fast verification)</option>
                <option value="4" selected>4 items per feed (Recommended)</option>
                <option value="8">8 items per feed (Deep batch)</option>
              </select>
            </div>

            <button
              id="startCrawlBtn"
              onclick="triggerCrawlWorkflow()"
              class="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer mt-3"
            >
              <svg id="crawlSpinner" class="w-4 h-4 hidden animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
              <span id="crawlBtnText">Execute Editorial Workflow</span>
            </button>
          </div>

          <!-- Active Synthesis Engine Indicator -->
          <div class="pt-3 border-t border-slate-800/80 space-y-2">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Active Synthesis Engine Waterfall:</div>
            <div class="space-y-1.5 text-xs text-slate-300">
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-blue-950 text-blue-400 text-[10px] font-bold flex items-center justify-center">1</span>
                <div>
                  <div class="font-semibold text-white">Cloudflare Fast Engine</div>
                  <div class="text-[10px] text-slate-400">Llama 3.1 8B &bull; Qwen 1.5 7B &bull; DeepSeek Qwen 32B</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-purple-950 text-purple-400 text-[10px] font-bold flex items-center justify-center">2</span>
                <div>
                  <div class="font-semibold text-white">OpenRouter Editorial Engine</div>
                  <div class="text-[10px] text-slate-400">Qwen 2.5 72B &bull; DeepSeek R1 &bull; Llama 3.3 70B</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-amber-950 text-amber-400 text-[10px] font-bold flex items-center justify-center">3</span>
                <div>
                  <div class="font-semibold text-white">Local Offline Models (Ollama/LM Studio)</div>
                  <div class="text-[10px] text-slate-400">{settingsMap.local_ai_model || 'qwen2.5:3b'} @ {settingsMap.local_ai_endpoint || 'http://127.0.0.1:11434'}</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-emerald-950 text-emerald-400 text-[10px] font-bold flex items-center justify-center">4</span>
                <div>
                  <div class="font-semibold text-white">Pollinations Editorial Engine</div>
                  <div class="text-[10px] text-slate-400">Qwen-Coder &bull; Mistral &bull; Fast Models</div>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border border-slate-800">
                <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-300 text-[10px] font-bold flex items-center justify-center">5</span>
                <div>
                  <div class="font-semibold text-white">9jaBeacon Editorial NLP Core</div>
                  <div class="text-[10px] text-slate-400">In-depth contextual background, stakeholder impact & category verification</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Live Workflow Execution Terminal -->
        <div class="lg:col-span-2 p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col justify-between space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
              <span class="text-xs font-mono text-slate-400 ml-2">editorial-workflow.log</span>
            </div>
            <button
              onclick="clearTerminalLog()"
              class="text-[11px] text-slate-500 hover:text-slate-300 transition"
            >
              Clear Console
            </button>
          </div>

          <div id="workflowTerminal" class="h-96 overflow-y-auto font-mono text-xs text-slate-300 space-y-1.5 p-2 bg-slate-900/50 rounded-xl border border-slate-800/60">
            <div class="text-emerald-400"># 9jaBeacon Autonomous Workflow Console Ready.</div>
            <div class="text-slate-500">// Click "Execute Editorial Workflow" to start real-time ingestion and synthesis.</div>
            {logs.slice(0, 15).map(l => (
              <div class="text-[11px] flex items-start gap-2">
                <span class="text-slate-500 whitespace-nowrap">[{new Date(l.created_at).toLocaleTimeString()}]</span>
                <span class={l.level === 'error' ? 'text-red-400 font-bold' : l.level === 'warning' ? 'text-amber-400' : 'text-slate-300'}>
                  {l.message}
                </span>
              </div>
            ))}
          </div>

          <div id="workflowStatusBadge" class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs flex items-center justify-between">
            <span class="text-slate-400">Workflow Status:</span>
            <span id="workflowStatusText" class="font-bold text-emerald-400">Idle &bull; Ready to crawl</span>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: WORKFLOW LOGS & AUDIT TRAIL -->
    <div id="tab-content-logs" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white">Full Automation & AI Telemetry Logs</h2>
            <p class="text-xs text-slate-400">Every decision, AI model call, classification score, and rejection reason recorded with high fidelity.</p>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="logSearchInput"
              onkeyup="filterLogsTable()"
              placeholder="Search logs by keyword..."
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder:text-slate-600 focus:outline-none focus:border-emerald-500"
            />
            <button
              onclick="refreshLogsView()"
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition"
            >
              Refresh
            </button>
            <button
              onclick="clearAllLogsFromDb()"
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-red-950/60 hover:bg-red-900 text-red-300 border border-red-800/60 transition"
            >
              Clear Logs
            </button>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs" id="logsTable">
            <thead class="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="p-3 whitespace-nowrap">Timestamp</th>
                <th class="p-3 whitespace-nowrap">Event / Action</th>
                <th class="p-3 whitespace-nowrap">Source</th>
                <th class="p-3">Message / Rationale</th>
                <th class="p-3 whitespace-nowrap">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-mono">
              {logs.map(l => (
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="p-3 text-slate-400 whitespace-nowrap text-[11px]">{new Date(l.created_at).toLocaleTimeString()} ({new Date(l.created_at).toLocaleDateString()})</td>
                  <td class="p-3 font-semibold text-white whitespace-nowrap">{l.event_type || 'WORKFLOW_EVENT'}</td>
                  <td class="p-3 text-slate-300 whitespace-nowrap">{l.source_name || 'System'}</td>
                  <td class="p-3 text-slate-200">{l.message}</td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                      l.level === 'error' ? 'bg-red-950 text-red-400 border border-red-800' :
                      l.level === 'warning' ? 'bg-amber-950 text-amber-400 border border-amber-800' :
                      'bg-emerald-950 text-emerald-400 border border-emerald-800'
                    }`}>
                      {l.level.toUpperCase()}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Logs Pagination Controls -->
        <div class="pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-3">
            <span id="logs-pagination-info" class="text-slate-400 font-mono">
              Showing logs
            </span>
            <div class="flex items-center gap-1 text-slate-400">
              <span>Per page:</span>
              <select id="logs-pagesize" onchange="changeLogsPageSize()" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-slate-200">
                <option value="15">15</option>
                <option value="30" selected>30</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="logs-prev-btn"
              onclick="changeLogsPage(-1)"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
            >
              &larr; Prev
            </button>
            <span id="logs-page-indicator" class="font-mono text-slate-400 px-2">
              Page 1
            </span>
            <button
              id="logs-next-btn"
              onclick="changeLogsPage(1)"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-30 disabled:cursor-not-allowed text-slate-200 font-semibold cursor-pointer"
            >
              Next &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: EDITORIAL ENGINE & SOCIAL CONFIG -->
    <div id="tab-content-ai-config" class="admin-tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Configuration Form -->
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
            <span>Editorial Engine & Offline Fallback Setup</span>
          </h2>
          <p class="text-xs text-slate-400">
            Configure your automated editorial synthesis providers. When Cloudflare or OpenRouter hit quotas, the system seamlessly falls back to your local downloaded small models (Qwen, Ollama, LM Studio) or Editorial NLP.
          </p>

          <form id="aiSettingsForm" class="space-y-4 pt-2">
            <!-- Local Offline Section -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-amber-900/40 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span> Local Offline Fallback (Qwen / Ollama / LM Studio)
                </span>
                <span class="text-[10px] text-slate-500 font-mono">Offline Capable</span>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Local Endpoint URL:</label>
                <input
                  type="text"
                  name="local_ai_endpoint"
                  value={settingsMap.local_ai_endpoint || 'http://127.0.0.1:11434'}
                  placeholder="e.g. http://127.0.0.1:11434 or http://localhost:1234/v1"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-amber-400"
                />
                <p class="text-[10px] text-slate-500 mt-1">Supports Ollama, LM Studio, or LocalAI OpenAI-compatible API.</p>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Local Model Tag:</label>
                <input
                  type="text"
                  name="local_ai_model"
                  value={settingsMap.local_ai_model || 'qwen2.5:3b'}
                  placeholder="e.g. qwen2.5:3b, qwen2.5:7b, qwen2.5:0.5b, llama3.2:1b"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-amber-400"
                />
              </div>
            </div>

            <!-- Cloudflare Fast Engine -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
              <span class="text-xs font-bold text-blue-400 uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span> Cloudflare Fast Engine
              </span>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Cloudflare Account ID:</label>
                <input
                  type="text"
                  name="cloudflare_account_id"
                  value={settingsMap.cloudflare_account_id || ''}
                  placeholder="Paste Cloudflare Account ID"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-400"
                />
              </div>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Cloudflare API Token:</label>
                <input
                  type="password"
                  name="cloudflare_api_token"
                  value={settingsMap.cloudflare_api_token || ''}
                  placeholder="Cloudflare API Token"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-400"
                />
              </div>
            </div>

            <!-- OpenRouter Engine -->
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
              <span class="text-xs font-bold text-purple-400 uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-purple-400"></span> OpenRouter Engine (Qwen 2.5 72B / DeepSeek)
              </span>
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">OpenRouter API Key:</label>
                <input
                  type="password"
                  name="openrouter_api_key"
                  value={settingsMap.openrouter_api_key || ''}
                  placeholder="sk-or-v1-..."
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-purple-400"
                />
              </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button
                type="submit"
                class="flex-1 py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition cursor-pointer"
              >
                Save Engine Configuration
              </button>
              <button
                type="button"
                onclick="runAiDiagnostics()"
                class="py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition cursor-pointer border border-slate-700 inline-flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Test Pipeline</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Right Column: Social Channels & Diagnostics -->
        <div class="space-y-6">
          <!-- Social Media Channels Form -->
          <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
              <span>Social Channels & Community Links</span>
            </h2>
            <p class="text-xs text-slate-400">
              Configure your verified social media links. These links appear prominently in the site footer, navigation drawer, and article share panels.
            </p>

            <form id="socialSettingsForm" class="space-y-3.5 pt-1">
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-[#1877F2]"></span> Facebook Page URL:
                </label>
                <input
                  type="url"
                  name="social_facebook_url"
                  value={siteSettings.social_facebook_url || 'https://facebook.com/9jabeacon'}
                  placeholder="https://facebook.com/your-page"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-500"
                />
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-pink-500"></span> TikTok Channel URL:
                </label>
                <input
                  type="url"
                  name="social_tiktok_url"
                  value={siteSettings.social_tiktok_url || 'https://tiktok.com/@9jabeacon'}
                  placeholder="https://tiktok.com/@your-handle"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-pink-500"
                />
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-[#FF0000]"></span> YouTube Channel URL:
                </label>
                <input
                  type="url"
                  name="social_youtube_url"
                  value={siteSettings.social_youtube_url || 'https://youtube.com/@9jabeacon'}
                  placeholder="https://youtube.com/@your-channel"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-red-500"
                />
              </div>

              <button
                type="submit"
                class="w-full py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition cursor-pointer shadow-md shadow-emerald-500/10"
              >
                Save Social Channels
              </button>
            </form>
          </div>

          <!-- SEO & Search Console Verification -->
          <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>SEO & Google Search Console Verification</span>
            </h2>
            <p class="text-xs text-slate-400">
              Paste your Google & Bing verification codes to verify ownership in 1 click and ensure rapid indexing.
            </p>

            <form id="seoSettingsForm" class="space-y-3.5 pt-1">
              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-blue-400"></span> Google Site Verification Code:
                </label>
                <input
                  type="text"
                  name="google_site_verification"
                  value={siteSettings.google_site_verification || ''}
                  placeholder="Paste string or HTML tag content value"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-blue-400"
                />
                <p class="text-[10px] text-slate-500 mt-1">From Google Search Console &rarr; Settings &rarr; Ownership verification &rarr; HTML tag</p>
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-teal-400"></span> Bing Webmaster Verification:
                </label>
                <input
                  type="text"
                  name="bing_site_verification"
                  value={siteSettings.bing_site_verification || ''}
                  placeholder="e.g. msvalidate.01 code"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-teal-400"
                />
              </div>

              <div>
                <label class="block text-[11px] font-medium text-slate-300 mb-1">Production Canonical URL:</label>
                <input
                  type="url"
                  name="site_url"
                  value={siteSettings.site_url || 'https://9jabeacon.name.ng'}
                  placeholder="https://9jabeacon.name.ng"
                  class="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
                />
              </div>

              <div class="pt-2 grid grid-cols-2 gap-2 text-xs">
                <a
                  href="/sitemap.xml"
                  target="_blank"
                  class="p-2 rounded-lg bg-slate-950 border border-slate-800 hover:border-slate-700 text-slate-300 text-center flex items-center justify-center gap-1.5"
                >
                  <span>View Sitemap.xml</span>
                  <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                <a
                  href="/robots.txt"
                  target="_blank"
                  class="p-2 rounded-lg bg-slate-950 border border-slate-800 hover:border-slate-700 text-slate-300 text-center flex items-center justify-center gap-1.5"
                >
                  <span>View Robots.txt</span>
                  <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>

              <button
                type="submit"
                class="w-full py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition cursor-pointer shadow-md shadow-emerald-500/10"
              >
                Save SEO & Verification
              </button>
            </form>
          </div>

          <!-- Diagnostics & Live Pipeline Output -->
          <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
            <div>
              <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                <span>Editorial Pipeline Diagnostic Test</span>
              </h3>
              <p class="text-xs text-slate-400 mt-1">
                Runs a sample Nigerian business lead through the cascade and verifies each tier's response time and schema validity.
              </p>

              <div id="aiTestResultBox" class="mt-4 p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3 font-mono text-xs text-slate-300">
                <div class="text-slate-500">// Press "Test Pipeline" to execute live end-to-end multi-tier test...</div>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 text-xs space-y-2">
              <div class="font-bold text-slate-300">Why Automated Fallback Matters:</div>
              <p class="text-slate-400 text-[11px] leading-relaxed">
                If internet access fluctuates or cloud quotas expire, your local downloaded small models (e.g. Qwen 2.5 3B / Ollama) step in without crashing the news pipeline.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: SOURCES -->
    <div id="tab-content-sources" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-white">Configured Nigerian & Global RSS Sources</h2>
            <p class="text-xs text-slate-400">Manage wire feeds, toggle ingestion status, and test feed responsiveness.</p>
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800">
              <tr>
                <th class="p-3">Source Name</th>
                <th class="p-3">Feed URL</th>
                <th class="p-3">Default Category</th>
                <th class="p-3">Last Fetched</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {sources.map(s => (
                <tr class="hover:bg-slate-800/40 transition">
                  <td class="p-3 font-bold text-white whitespace-nowrap">{s.name}</td>
                  <td class="p-3 text-slate-400 font-mono text-[11px] max-w-xs truncate">{s.feed_url}</td>
                  <td class="p-3 text-slate-300">{s.category_name || 'General'}</td>
                  <td class="p-3 text-slate-400 whitespace-nowrap">{s.last_fetched_at ? new Date(s.last_fetched_at).toLocaleTimeString() : 'Never'}</td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                      s.is_enabled ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-400'
                    }`}>
                      {s.is_enabled ? 'ACTIVE' : 'DISABLED'}
                    </span>
                  </td>
                  <td class="p-3 text-right whitespace-nowrap">
                    <button
                      onclick={`triggerCrawlForSingleSource('${s.id}')`}
                      class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[11px] font-semibold transition"
                    >
                      Fetch Now
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 5: PUBLISHED ARTICLES -->
    <div id="tab-content-articles" class="admin-tab-content hidden space-y-4">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>Published Articles Inventory</span>
              <span id="admin-articles-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-950 text-emerald-300 border border-emerald-800">
                {articles.length} total
              </span>
            </h2>
            <p class="text-xs text-slate-400">All stories currently live on 9jaBeacon with synthesis attributions and verified pagination.</p>
          </div>

          <!-- Controls: Search & Category Filter -->
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="text"
              id="admin-articles-search"
              placeholder="Filter by title or wire..."
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500 w-44 sm:w-56"
            />
            <select
              id="admin-articles-category"
              class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="">All Categories</option>
              <option value="naija-news">Naija News</option>
              <option value="business">Business</option>
              <option value="sports">Sports</option>
              <option value="world">World</option>
            </select>
            <select
              id="admin-articles-pagesize"
              class="px-2.5 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
            >
              <option value="8">8 / page</option>
              <option value="16" selected>16 / page</option>
              <option value="32">32 / page</option>
            </select>
          </div>
        </div>

        <!-- Quality Control & AI Health Maintenance Banner -->
        <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <div class="text-xs font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Content Quality & Image Health</span>
            </div>
