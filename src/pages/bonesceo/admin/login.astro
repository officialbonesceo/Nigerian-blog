---
import Layout from '../../../layouts/Layout.astro';
import { getSiteSettings } from '../../../lib/db';

const settings = getSiteSettings();
const siteName = settings.site_name || '9jaBeacon';
const targetEmail = settings.admin_email || 'officialbonesceo@gmail.com';
---

<Layout title={`BonesCEO Admin Login - ${siteName}`}>
  <div class="max-w-md mx-auto my-12 p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6">
    <div class="text-center space-y-2">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white mx-auto shadow-lg shadow-emerald-500/20">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight font-display">BonesCEO Portal</h1>
      <p class="text-xs text-slate-400">Authenticated Editorial & Automation Command Center</p>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 text-[11px] font-mono mt-1">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Locked strictly to {targetEmail}
      </div>
    </div>

    <!-- Error Alert Box -->
    <div id="login-error-box" class="hidden p-3.5 rounded-xl bg-red-950/80 border border-red-800/80 text-red-200 text-xs leading-relaxed"></div>

    <!-- 1. Google One-Click Sign-In Option -->
    <div class="space-y-3">
      <button
        id="btn-google-login"
        type="button"
        class="w-full h-12 rounded-xl bg-white hover:bg-slate-100 text-slate-900 text-xs font-bold transition-all flex items-center justify-center gap-3 shadow-md cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12 0 12s.7 2.3 1.9 4.7l3.7-2.9z"/>
          <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 16.4C3.7 20.1 7.5 23 12 23z"/>
        </svg>
        <span>Sign In with Google ({targetEmail})</span>
      </button>

      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-800"></div>
        <span class="text-[10px] uppercase font-bold text-slate-500 font-mono">Or Credentials</span>
        <div class="flex-1 h-px bg-slate-800"></div>
      </div>
    </div>

    <!-- 2. Email + Password Credentials Form -->
    <form id="bonesceo-login-form" class="space-y-4">
      <div>
        <label for="admin-email" class="block text-xs font-semibold text-slate-300 mb-1.5">Admin Email</label>
        <input
          type="email"
          id="admin-email"
          required
          value={targetEmail}
          class="w-full h-11 px-3.5 bg-slate-950 border border-slate-700 focus:border-emerald-500 rounded-xl text-sm text-white outline-none transition-all font-mono"
        />
      </div>

      <div>
        <label for="admin-password" class="block text-xs font-semibold text-slate-300 mb-1.5">Secure Password Key</label>
        <input
          type="password"
          id="admin-password"
          required
          placeholder="••••••••••••••••"
          class="w-full h-11 px-3.5 bg-slate-950 border border-slate-700 focus:border-emerald-500 rounded-xl text-sm text-white outline-none transition-all font-mono"
        />
      </div>

      <button
        type="submit"
        id="btn-login-submit"
        class="w-full h-11 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md active:scale-[0.98]"
      >
        <span>Authorize & Enter Admin Hub</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </form>
  </div>
</Layout>

<script is:inline>
  const form = document.getElementById('bonesceo-login-form');
  const googleBtn = document.getElementById('btn-google-login');
  const errorBox = document.getElementById('login-error-box');

  function showError(msg) {
    if (errorBox) {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    }
  }

  // Google Sign-In Handler
  googleBtn?.addEventListener('click', async () => {
    try {
      googleBtn.disabled = true;
      googleBtn.textContent = 'Verifying Google Account...';
      
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          auth_type: 'google',
          email: 'officialbonesceo@gmail.com',
        }),
      });

      const data = await res.json();
      if (data.success) {
        localStorage.setItem('bonesceo_auth_token', data.token);
        localStorage.setItem('bonesceo_auth_user', data.email);
        window.location.href = data.redirectUrl || '/bonesceo/admin';
      } else {
        showError(data.error || 'Google login authorization failed.');
        googleBtn.disabled = false;
        googleBtn.innerHTML = `<span>Sign In with Google</span>`;
      }
    } catch (err) {
      showError('Network error during Google sign-in. Please try again.');
      googleBtn.disabled = false;
    }
  });

  // Email/Password Form Handler
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('admin-email')?.value;
    const password = document.getElementById('admin-password')?.value;
    const submitBtn = document.getElementById('btn-login-submit');

    try {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Verifying credentials...';
      }

      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();
      if (data.success) {
        localStorage.setItem('bonesceo_auth_token', data.token);
        localStorage.setItem('bonesceo_auth_user', data.email);
        window.location.href = data.redirectUrl || '/bonesceo/admin';
      } else {
        showError(data.error || 'Invalid administrator login credentials.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Authorize & Enter Admin Hub';
        }
      }
    } catch (err) {
      showError('Network error during authentication.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Authorize & Enter Admin Hub';
      }
    }
  });
</script>
