---
import Layout from '../../../layouts/Layout.astro';
import { getD1, getArticles, getCategories, getSiteSettings } from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';

const db = getD1(Astro.locals);
const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) token = match[1];
else if (authHeader.startsWith('Bearer ')) token = authHeader.slice(7).trim();
else if (queryToken) token = queryToken;

const siteSettings = await getSiteSettings(db);
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
if (!tokenVerification.valid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login', 302);
}

if (queryToken && tokenVerification.valid) {
  const isHttps =
    Astro.request.url.startsWith('https://') ||
    Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}

const articles = await getArticles(db, { limit: 40 }).catch(() => []);
const categories = await getCategories(db).catch(() => []);
const catMap = Object.fromEntries((categories || []).map((c: any) => [c.id, c.name]));

const siteBase = 'https://www.9jabeacon.name.ng';
function gscInspectUrl(pageUrl: string) {
  const resource = encodeURIComponent(siteBase + '/');
  const id = encodeURIComponent(pageUrl);
  return `https://search.google.com/search-console/inspect?resource_id=${resource}&id=${id}`;
}
---

<Layout title="Articles — Command Hub" activeNav="menu" isWideLayout={true}>
  <div class="max-w-5xl mx-auto space-y-4 pb-24 px-1 sm:px-0">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <a href="/bonesceo/admin" class="text-[11px] font-bold text-emerald-600 hover:underline">← Hub</a>
        <h1 class="text-xl font-black text-slate-900 dark:text-white mt-0.5">Articles</h1>
        <p class="text-xs text-slate-500">Edit, write, change images · GSC inspect per story</p>
      </div>
      <a
        href="/bonesceo/admin/article-edit"
        class="px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500"
      >
        + Write new
      </a>
    </div>

    <ul class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800 overflow-hidden">
      {(articles || []).length === 0 && (
        <li class="px-4 py-8 text-center text-xs text-slate-500">No articles</li>
      )}
      {(articles || []).map((a: any) => {
        const pageUrl = `${siteBase}/news/${a.slug}`;
        const inspect = gscInspectUrl(pageUrl);
        return (
        <li class="p-3 sm:p-4 flex gap-3 items-start">
          {a.image_url ? (
            <img src={a.image_url} alt="" class="w-16 h-12 sm:w-20 sm:h-14 rounded-lg object-cover bg-slate-100 shrink-0" loading="lazy" />
          ) : (
            <div class="w-16 h-12 sm:w-20 sm:h-14 rounded-lg bg-slate-100 dark:bg-slate-800 shrink-0" />
          )}
          <div class="min-w-0 flex-1">
            <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white hover:text-emerald-600 line-clamp-2">
              {a.title}
            </a>
            <div class="flex flex-wrap gap-2 mt-1 text-[10px] text-slate-500">
              <span>{catMap[a.category_id] || a.category_id || '—'}</span>
              <span>{(a.published_at || '').slice(0, 10)}</span>
              <span class="uppercase">{a.status || 'published'}</span>
            </div>
            <div class="flex flex-wrap gap-2 mt-2">
              <a href={`/bonesceo/admin/article-edit?id=${a.id}`} class="px-2.5 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold">Edit</a>
              <a href={`/news/${a.slug}`} target="_blank" rel="noopener" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[10px] font-bold">View</a>
              <a
                href={inspect}
                target="_blank"
                rel="noopener noreferrer"
                class="px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 text-[10px] font-bold"
                title="Open URL Inspection in Google Search Console"
              >Inspect in Google</a>
            </div>
          </div>
        </li>
        );
      })}
    </ul>
  </div>
</Layout>
