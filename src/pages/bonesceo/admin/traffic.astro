---
import Layout from '../../../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../../../lib/runtime-db';
import { verifyAdminToken, getEnvSecret } from '../../../lib/auth';

const db = getD1(Astro.locals);
const cookie = Astro.request.headers.get('cookie') || '';
const authHeader = Astro.request.headers.get('authorization') || '';
const url = new URL(Astro.request.url);
const queryToken = url.searchParams.get('token') || '';

let token = '';
const match = cookie.match(/bonesceo_session=([^;]+)/);
if (match) token = match[1];
else if (authHeader.startsWith('Bearer ')) token = authHeader.slice(7).trim();
else if (queryToken) token = queryToken;

const siteSettings = await getSiteSettings(db);
const secretKey =
  getEnvSecret(Astro.locals, 'ADMIN_SECRET_KEY', 'admin_secret_key', 'SECRET_KEY') ||
  siteSettings.admin_secret_key ||
  '9jaBeacon_bonesceo_secret_key_2026_super_secure';

const tokenVerification = token ? verifyAdminToken(token, secretKey) : { valid: false };
if (!tokenVerification.valid && !cookie.includes('bonesceo_session=') && !queryToken) {
  return Astro.redirect('/bonesceo/admin/login', 302);
}

if (queryToken && tokenVerification.valid) {
  const isHttps =
    Astro.request.url.startsWith('https://') ||
    Astro.request.headers.get('x-forwarded-proto') === 'https';
  Astro.response.headers.set(
    'Set-Cookie',
    `bonesceo_session=${queryToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000${isHttps ? '; Secure' : ''}`
  );
}
---

<Layout title="Traffic & Regions — 9jaBeacon" activeNav="menu" isWideLayout={true}>
  <div class="max-w-5xl mx-auto space-y-6 pb-20 px-1">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-xl font-black text-slate-900 dark:text-white">Traffic dashboard</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-md">
          Live edge stats from Cloudflare — <strong>not</strong> from the database. Zero D1 cost.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <select id="daysSel" class="text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2 py-1.5">
          <option value="1">Last 1 day</option>
          <option value="7" selected>Last 7 days</option>
          <option value="14">Last 14 days</option>
          <option value="30">Last 30 days</option>
        </select>
        <button id="refreshBtn" type="button" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-500">Refresh</button>
        <a href="/bonesceo/admin" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">← Hub</a>
      </div>
    </div>

    <div id="statusBar" class="text-xs text-slate-500">Loading Cloudflare analytics…</div>

    <!-- Glossary -->
    <details class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
      <summary class="text-sm font-bold cursor-pointer text-slate-800 dark:text-slate-100">What do these numbers mean?</summary>
      <ul class="mt-3 space-y-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        <li><strong>Visits (best signal for humans)</strong> — Rough count of real browsing sessions. Prefer this over “requests”.</li>
        <li><strong>Page views</strong> — How many times a full page was shown (Cloudflare’s pageViews).</li>
        <li><strong>Requests</strong> — Every hit to the edge: pages, images, CSS, JS, bots, scrapers. Can look huge even with few people.</li>
        <li><strong>Uniques</strong> — Approximate distinct visitors per day (summed across days can over-count return visitors).</li>
        <li><strong>Data transferred</strong> — Bytes sent from Cloudflare to visitors (images + HTML).</li>
        <li><strong>Threats</strong> — Blocked or challenged suspicious traffic.</li>
        <li><strong>Busy region</strong> — Country with the most <em>requests</em>. Check Visits column too — bots can inflate requests (e.g. TW).</li>
      </ul>
    </details>

    <!-- Summary cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" id="summaryCards">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-bold">Page views</div>
        <div class="text-xl font-black text-slate-900 dark:text-white mt-1" id="cPageViews">—</div>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-bold">Visits signal</div>
        <div class="text-xl font-black text-emerald-600 dark:text-emerald-400 mt-1" id="cVisits">—</div>
        <div class="text-[10px] text-slate-400 mt-0.5">sum of country visits</div>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-bold">All requests</div>
        <div class="text-xl font-black text-slate-900 dark:text-white mt-1" id="cRequests">—</div>
        <div class="text-[10px] text-slate-400 mt-0.5">includes bots</div>
      </div>
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        <div class="text-[10px] uppercase tracking-wide text-slate-500 font-bold">Daily uniques (sum)</div>
        <div class="text-xl font-black text-slate-900 dark:text-white mt-1" id="cUniques">—</div>
      </div>
      <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 col-span-2 sm:col-span-1">
        <div class="text-[10px] uppercase tracking-wide text-emerald-700 dark:text-emerald-400 font-bold">Busy region</div>
        <div class="text-lg font-black text-emerald-900 dark:text-emerald-200 mt-1" id="cBusy">—</div>
        <div class="text-[10px] text-emerald-700/80 dark:text-emerald-400/80 mt-0.5" id="cBusySub"></div>
      </div>
    </div>

    <!-- Regions table -->
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-black text-slate-900 dark:text-white">Where traffic comes from</h2>
        <div class="flex gap-1 text-[11px]">
          <button type="button" data-sort="visits" class="sortBtn px-2 py-1 rounded-md bg-emerald-600 text-white font-bold">Most visits</button>
          <button type="button" data-sort="requests" class="sortBtn px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold">Most requests</button>
          <button type="button" data-sort="bytes" class="sortBtn px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold">Most data</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950/80 text-slate-500">
            <tr>
              <th class="px-4 py-2 font-bold">#</th>
              <th class="px-4 py-2 font-bold">Country / region</th>
              <th class="px-4 py-2 font-bold text-right">Visits</th>
              <th class="px-4 py-2 font-bold text-right">Requests</th>
              <th class="px-4 py-2 font-bold text-right">Data</th>
            </tr>
          </thead>
          <tbody id="countryBody" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </section>

    <!-- Paths -->
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-black text-slate-900 dark:text-white">Most requested paths</h2>
        <div class="flex gap-1 text-[11px]">
          <button type="button" data-psort="visits" class="psortBtn px-2 py-1 rounded-md bg-emerald-600 text-white font-bold">Most visits</button>
          <button type="button" data-psort="requests" class="psortBtn px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold">Most requests</button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950/80 text-slate-500">
            <tr>
              <th class="px-4 py-2 font-bold">Path</th>
              <th class="px-4 py-2 font-bold text-right">Visits</th>
              <th class="px-4 py-2 font-bold text-right">Requests</th>
            </tr>
          </thead>
          <tbody id="pathBody" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </section>

    <!-- Daily series -->
    <section class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
        <h2 class="text-sm font-black text-slate-900 dark:text-white">Day by day</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950/80 text-slate-500">
            <tr>
              <th class="px-4 py-2 font-bold">Date</th>
              <th class="px-4 py-2 font-bold text-right">Page views</th>
              <th class="px-4 py-2 font-bold text-right">Uniques</th>
              <th class="px-4 py-2 font-bold text-right">Requests</th>
              <th class="px-4 py-2 font-bold text-right">Threats</th>
            </tr>
          </thead>
          <tbody id="seriesBody" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    var COUNTRY = {
      NG: 'Nigeria', US: 'United States', GB: 'United Kingdom', UK: 'United Kingdom',
      GH: 'Ghana', KE: 'Kenya', ZA: 'South Africa', CA: 'Canada', DE: 'Germany',
      FR: 'France', NL: 'Netherlands', IN: 'India', CN: 'China', TW: 'Taiwan',
      SG: 'Singapore', AE: 'UAE', SA: 'Saudi Arabia', BR: 'Brazil', MX: 'Mexico',
      AR: 'Argentina', PE: 'Peru', SE: 'Sweden', FI: 'Finland', UA: 'Ukraine',
      RU: 'Russia', JP: 'Japan', KR: 'South Korea', AU: 'Australia', IE: 'Ireland',
      IT: 'Italy', ES: 'Spain', PT: 'Portugal', PL: 'Poland', CH: 'Switzerland',
      BE: 'Belgium', AT: 'Austria', TR: 'Turkey', EG: 'Egypt', MA: 'Morocco',
      TN: 'Tunisia', DZ: 'Algeria', CI: 'Côte d\'Ivoire', SN: 'Senegal',
      CM: 'Cameroon', UG: 'Uganda', TZ: 'Tanzania', RW: 'Rwanda', ET: 'Ethiopia',
      PH: 'Philippines', ID: 'Indonesia', MY: 'Malaysia', VN: 'Vietnam',
      HK: 'Hong Kong', IL: 'Israel', PK: 'Pakistan', BD: 'Bangladesh',
      BB: 'Barbados', T1: 'Tor / anonymous'
    };

    var state = { countries: [], paths: [], series: [], sort: 'visits', psort: 'visits' };

    function fmt(n) {
      n = Number(n) || 0;
      if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
      if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K';
      return String(Math.round(n));
    }
    function fmtBytes(b) {
      b = Number(b) || 0;
      if (b >= 1e9) return (b / 1e9).toFixed(2) + ' GB';
      if (b >= 1e6) return (b / 1e6).toFixed(1) + ' MB';
      if (b >= 1e3) return (b / 1e3).toFixed(0) + ' KB';
      return b + ' B';
    }
    function countryName(code) {
      if (!code) return 'Unknown';
      return (COUNTRY[code] || code) + ' (' + code + ')';
    }

    function renderCountries() {
      var rows = state.countries.slice();
      var key = state.sort;
      rows.sort(function (a, b) { return (b[key] || 0) - (a[key] || 0); });
      var body = document.getElementById('countryBody');
      if (!body) return;
      body.innerHTML = rows.map(function (r, i) {
        return '<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">' +
          '<td class="px-4 py-2 text-slate-400">' + (i + 1) + '</td>' +
          '<td class="px-4 py-2 font-semibold text-slate-800 dark:text-slate-100">' + countryName(r.country) + '</td>' +
          '<td class="px-4 py-2 text-right font-bold text-emerald-600 dark:text-emerald-400">' + fmt(r.visits) + '</td>' +
          '<td class="px-4 py-2 text-right text-slate-600 dark:text-slate-300">' + fmt(r.requests) + '</td>' +
          '<td class="px-4 py-2 text-right text-slate-500">' + fmtBytes(r.bytes) + '</td></tr>';
      }).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No country data</td></tr>';
    }

    function renderPaths() {
      var rows = state.paths.slice();
      var key = state.psort;
      rows.sort(function (a, b) { return (b[key] || 0) - (a[key] || 0); });
      var body = document.getElementById('pathBody');
      if (!body) return;
      body.innerHTML = rows.map(function (r) {
        return '<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">' +
          '<td class="px-4 py-2 font-mono text-[11px] text-slate-700 dark:text-slate-200 break-all">' + (r.path || '/') + '</td>' +
          '<td class="px-4 py-2 text-right font-bold text-emerald-600">' + fmt(r.visits) + '</td>' +
          '<td class="px-4 py-2 text-right text-slate-600">' + fmt(r.requests) + '</td></tr>';
      }).join('') || '<tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">No path data</td></tr>';
    }

    function renderSeries() {
      var body = document.getElementById('seriesBody');
      if (!body) return;
      var rows = (state.series || []).slice();
      body.innerHTML = rows.map(function (r) {
        return '<tr>' +
          '<td class="px-4 py-2 font-semibold">' + (r.date || '') + '</td>' +
          '<td class="px-4 py-2 text-right">' + fmt(r.pageViews) + '</td>' +
          '<td class="px-4 py-2 text-right">' + fmt(r.uniques) + '</td>' +
          '<td class="px-4 py-2 text-right">' + fmt(r.requests) + '</td>' +
          '<td class="px-4 py-2 text-right">' + fmt(r.threats) + '</td></tr>';
      }).join('') || '<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No daily data</td></tr>';
    }

    function setSortBtns() {
      document.querySelectorAll('.sortBtn').forEach(function (btn) {
        var on = btn.getAttribute('data-sort') === state.sort;
        btn.className = 'sortBtn px-2 py-1 rounded-md font-bold ' + (on ? 'bg-emerald-600 text-white' : 'bg-slate-100 dark:bg-slate-800 font-semibold');
      });
      document.querySelectorAll('.psortBtn').forEach(function (btn) {
        var on = btn.getAttribute('data-psort') === state.psort;
        btn.className = 'psortBtn px-2 py-1 rounded-md font-bold ' + (on ? 'bg-emerald-600 text-white' : 'bg-slate-100 dark:bg-slate-800 font-semibold');
      });
    }

    async function load() {
      var days = document.getElementById('daysSel')?.value || '7';
      var status = document.getElementById('statusBar');
      if (status) status.textContent = 'Fetching Cloudflare edge analytics…';
      try {
        var res = await fetch('/api/admin/analytics?days=' + days, { credentials: 'same-origin' });
        var data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed');

        state.countries = data.countries || [];
        state.paths = data.top_paths || [];
        state.series = data.series || [];

        var t = data.totals || {};
        var visitSum = state.countries.reduce(function (s, c) { return s + (c.visits || 0); }, 0);
        document.getElementById('cPageViews').textContent = fmt(t.pageViews);
        document.getElementById('cVisits').textContent = fmt(visitSum);
        document.getElementById('cRequests').textContent = fmt(t.requests);
        document.getElementById('cUniques').textContent = fmt(t.uniques);

        // Prefer busiest by visits for the highlight card (more human)
        var byVisits = state.countries.slice().sort(function (a, b) { return (b.visits || 0) - (a.visits || 0); })[0];
        var busy = byVisits || data.busy_region;
        if (busy) {
          document.getElementById('cBusy').textContent = countryName(busy.country);
          document.getElementById('cBusySub').textContent =
            fmt(busy.visits) + ' visits · ' + fmt(busy.requests) + ' requests';
        }

        if (status) {
          status.innerHTML = '✅ Cloudflare data · last <strong>' + (data.range_days || days) +
            '</strong> days · <span class="text-emerald-600">zero D1</span> · updated just now';
        }
        setSortBtns();
        renderCountries();
        renderPaths();
        renderSeries();
      } catch (e) {
        if (status) status.textContent = '❌ ' + (e.message || e);
      }
    }

    document.getElementById('refreshBtn')?.addEventListener('click', load);
    document.getElementById('daysSel')?.addEventListener('change', load);
    document.querySelectorAll('.sortBtn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.sort = btn.getAttribute('data-sort') || 'visits';
        setSortBtns();
        renderCountries();
      });
    });
    document.querySelectorAll('.psortBtn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.psort = btn.getAttribute('data-psort') || 'visits';
        setSortBtns();
        renderPaths();
      });
    });

    load();
  })();
</script>
