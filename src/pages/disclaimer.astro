---
import Layout from '../layouts/Layout.astro';
import { getD1, getSiteSettings } from '../lib/runtime-db';

export const prerender = false;

const db = getD1(Astro.locals);
const settings = await getSiteSettings(db);

const siteName = settings.site_name || '9jaBeacon';
const rawSiteUrl = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteUrl = rawSiteUrl === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteUrl;
const contactEmail = settings.contact_email || settings.admin_email || 'officialbonesceo@gmail.com';
const lastUpdated = 'November 10, 2026';
---

<Layout
  title={`Disclaimer | ${siteName}`}
  description={`Simple disclaimer for ${siteName}: we are a blog, sources can change, and posts are for general information.`}
  canonicalUrl={`${siteUrl}/disclaimer`}
>
  <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
    <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
    <span>/</span>
    <span class="text-slate-800 dark:text-slate-200">Disclaimer</span>
  </nav>

  <article class="bg-white dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xs space-y-6">
    <header class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-2">
      <p class="text-xs text-slate-500">Updated: {lastUpdated}</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        Disclaimer
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Please read this before relying on anything you see on {siteName}.
      </p>
    </header>

    <div class="space-y-5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">1. We are a blog</h2>
        <p>
          {siteName} is an independent blog. We are not a government office, bank, law firm, or official newspaper. Posts are written for general reading only.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">2. Sources can change</h2>
        <p>
          We often summarise stories that other outlets or public bodies have already published. Those sources can later correct or update their own reports. When we notice a problem on our side, we try to fix it.
        </p>
        <p>
          We do our best to be careful, but we do not promise that every detail is complete or final.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">3. Not advice</h2>
        <p>
          Nothing on this site is financial, legal, medical, or investment advice. If a decision matters to your money or your rights, talk to a qualified professional.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">4. Credits and takedowns</h2>
        <p>
          If we used your material and you want a credit change or removal, email us with the page link and what you want changed. We will review it in good faith.
        </p>
        <p>
          <a href={`mailto:${contactEmail}`} class="text-emerald-600 dark:text-emerald-400 font-semibold underline">{contactEmail}</a>
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">5. Corrections</h2>
        <p>
          Found a mistake? Send the article link and the correct detail. Helpful notes are welcome.
        </p>
      </section>
    </div>
  </article>
</Layout>
