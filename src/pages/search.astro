---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getD1, getArticles } from '../lib/runtime-db';
const d1=getD1(Astro.locals);
const q=(Astro.url.searchParams.get('q')||'').trim();
const all=await getArticles(d1,{limit:200});
const articles=q?all.filter(a=>`${a.title} ${a.summary} ${a.content} ${a.category_name}`.toLowerCase().includes(q.toLowerCase())):all.slice(0,30);
---
<Layout title={q?`Search: ${q} - 9jaBeacon`:'Search Nigerian News - 9jaBeacon'} description="Search Nigerian news directly from the live 9jaBeacon D1 database." activeNav="search">
<form class="mb-5 flex gap-2" method="get"><input name="q" value={q} placeholder="Search CBN, fuel, Dangote, politics..." class="min-w-0 flex-1 h-12 px-4 rounded-2xl bg-slate-900 border border-slate-800 text-white outline-none focus:border-emerald-500"/><button class="px-4 rounded-2xl bg-emerald-600 text-white font-bold">Search</button></form>
<div class="flex items-center justify-between mb-3"><h1 class="text-lg font-black">{q?`Results for “${q}”`:'Latest stories'}</h1><span class="text-xs text-slate-500">{articles.length} results</span></div>
<div class="space-y-2.5">{articles.map(a=><ArticleCard article={a}/>)}</div>
{articles.length===0&&<div class="p-8 text-center rounded-2xl bg-slate-900 border border-slate-800 text-slate-400">No matching stories yet.</div>}
</Layout>
