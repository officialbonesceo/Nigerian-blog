---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getD1, searchArticles } from '../lib/runtime-db';
const query=(Astro.url.searchParams.get('q')||'').trim();
const d1=getD1(Astro.locals);
const results=query?await searchArticles(d1,query,50):[];
---
<Layout title={query?`Search: ${query} - 9jaBeacon`:'Search Nigerian News - 9jaBeacon'} description="Search Nigerian news directly from the live 9jaBeacon database." activeNav="search">
<section class="space-y-5"><form class="flex gap-2" method="get"><input name="q" value={query} placeholder="Search CBN, fuel price, Dangote, Super Eagles..." class="flex-1 h-12 px-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm outline-none focus:border-emerald-500"/><button class="px-5 rounded-2xl bg-emerald-600 text-white text-sm font-bold">Search</button></form>{query?<h1 class="text-lg font-black text-slate-900 dark:text-white">Results for “{query}” <span class="text-sm text-slate-500">({results.length})</span></h1>:<p class="text-sm text-slate-500">Search the latest stories stored in D1.</p>}{results.length?<div class="space-y-2.5">{results.map(article=><ArticleCard article={article}/>)}</div>:query?<div class="p-8 text-center rounded-2xl border border-slate-200 dark:border-slate-800 text-sm text-slate-500">No published stories matched your search.</div>:null}</section>
</Layout>
