---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { searchArticles, getCategories } from '../lib/db';

const query = Astro.url.searchParams.get('q') || '';
const categoryId = Astro.url.searchParams.get('category') || '';

const categories = getCategories();
const results = searchArticles(query, categoryId || undefined, 20);
---

<Layout
  title="Search Nigerian News - 9jaBeacon"
  description="Search breaking news, politics, business, economy and sports across Nigeria."
  activeNav="search"
>
  <div class="space-y-4">
    <!-- Search Bar Form -->
    <form method="GET" action="/search" class="relative">
      <div class="relative flex items-center">
        <input
          type="text"
          name="q"
          id="search-input"
          value={query}
          placeholder="Search news, topics, people, CBN, Fuel..."
          autofocus
          class="w-full h-12 pl-11 pr-24 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:border-emerald-500 rounded-2xl text-sm text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 outline-none transition-all shadow-xs dark:shadow-md focus:ring-1 focus:ring-emerald-500/20"
        />
        <svg class="absolute left-3.5 w-5 h-5 text-slate-400 dark:text-slate-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>

        <button
          type="submit"
          class="absolute right-2 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors cursor-pointer"
        >
          Search
        </button>
      </div>
    </form>

    <!-- Recent Searches Bar (as in the screenshot) -->
    <div id="recent-searches-box" class="p-3.5 rounded-xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 shadow-xs dark:shadow-none space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-600 dark:text-slate-400 font-sans">Recent Searches</span>
        <button
          type="button"
          id="btn-clear-recents"
          class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors cursor-pointer"
        >
          Clear
        </button>
      </div>

      <div id="recent-tags" class="flex flex-wrap gap-1.5">
        <a href="/search?q=CBN" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium transition-colors">
          CBN ×
        </a>
        <a href="/search?q=Fuel%20Price" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium transition-colors">
          Fuel Price ×
        </a>
        <a href="/search?q=Elections" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium transition-colors">
          Elections ×
        </a>
        <a href="/search?q=Naira" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium transition-colors">
          Naira ×
        </a>
      </div>
    </div>

    <!-- Category Filter Dropdown -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
      <a
        href={query ? `/search?q=${encodeURIComponent(query)}` : '/search'}
        class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors ${
          !categoryId ? 'bg-emerald-600 text-white font-bold' : 'bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-800'
        }`}
      >
        All Categories
      </a>
      {categories.map((cat) => (
        <a
          href={`/search?q=${encodeURIComponent(query)}&category=${cat.id}`}
          class={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors ${
            categoryId === cat.id
              ? 'bg-emerald-600 text-white font-bold'
              : 'bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-800'
          }`}
        >
          {cat.name}
        </a>
      ))}
    </div>

    <!-- Search Results Header & Feed -->
    <section class="mt-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider font-mono">
          {query ? `Results for "${query}"` : 'Top Results'} ({results.length})
        </h2>
      </div>

      {results.length > 0 ? (
        <div class="space-y-2.5">
          {results.map((art) => (
            <ArticleCard article={art} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center bg-white dark:bg-slate-900/40 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs dark:shadow-none space-y-3">
          <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center mx-auto text-xl">
            🔍
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">No articles matched your search</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
            Try different keywords like "Economy", "Dangote", "Super Eagles" or browse through our categories.
          </p>
          <a
            href="/"
            class="inline-block px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors"
          >
            Browse All News
          </a>
        </div>
      )}
    </section>
  </div>
</Layout>

<script is:inline>
  // Save search to recents
  const input = document.getElementById('search-input');
  if (input && input.value.trim()) {
    try {
      let recents = JSON.parse(localStorage.getItem('naijapulse_recents') || '[]');
      const val = input.value.trim();
      recents = [val, ...recents.filter(item => item.toLowerCase() !== val.toLowerCase())].slice(0, 6);
      localStorage.setItem('naijapulse_recents', JSON.stringify(recents));
    } catch {}
  }

  // Clear recents
  document.getElementById('btn-clear-recents')?.addEventListener('click', () => {
    localStorage.removeItem('naijapulse_recents');
    const box = document.getElementById('recent-searches-box');
    if (box) box.style.display = 'none';
    window.showToast?.('Cleared recent searches');
  });
</script>
