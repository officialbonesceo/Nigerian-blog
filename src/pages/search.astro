---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getD1, searchArticles } from '../lib/runtime-db';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') || '').trim();
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const pageSize = 10;
const d1 = getD1(Astro.locals);

// Search articles
const allResults = query ? await searchArticles(d1, query, 100) : [];
const totalResults = allResults.length;
const totalPages = Math.max(1, Math.ceil(totalResults / pageSize));
const validPage = Math.min(page, totalPages);
const startIndex = (validPage - 1) * pageSize;
const paginatedResults = allResults.slice(startIndex, startIndex + pageSize);

const pageBadges: { number: number; isCurrent: boolean }[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= validPage - 1 && i <= validPage + 1)) {
    pageBadges.push({ number: i, isCurrent: i === validPage });
  }
}
---

<Layout
  title={query ? `Search: “${query}” (Page ${validPage}) - 9jaBeacon` : 'Search Nigerian News - 9jaBeacon'}
  description="Search fast, verified Nigerian news directly from the live 9jaBeacon database."
  activeNav="search"
  noIndex={true}
>
  <section class="space-y-6">
    <!-- Search Bar -->
    <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
      <form class="flex flex-col sm:flex-row gap-2.5" method="get" action="/search">
        <div class="relative flex-1">
          <input
            name="q"
            value={query}
            placeholder="Search CBN, fuel subsidy, Dangote, Super Eagles, elections..."
            class="w-full h-12 pl-4 pr-10 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-sm text-slate-900 dark:text-white placeholder:text-slate-500 focus:outline-none focus:border-emerald-500 transition"
            autofocus
          />
          {query && (
            <a
              href="/search"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1"
            >
              &times;
            </a>
          )}
        </div>
        <button
          type="submit"
          class="h-12 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition shadow-xs cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search</span>
        </button>
      </form>

      <!-- Search Suggestions -->
      {!query && (
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-400 font-medium">Popular queries:</span>
          {['CBN', 'Dangote Refinery', 'Tinubu', 'Fuel Price', 'Super Eagles', 'Crypto Nigeria', 'Tech Startups'].map((tag) => (
            <a
              href={`/search?q=${encodeURIComponent(tag)}`}
              class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-500/10 hover:text-emerald-600 dark:hover:text-emerald-400 transition"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Search Results Header -->
    {query ? (
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white tracking-tight">
            Search Results for “<span class="text-emerald-600 dark:text-emerald-400">{query}</span>”
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Found {totalResults} {totalResults === 1 ? 'story' : 'stories'} {totalResults > 0 ? `(showing page ${validPage} of ${totalPages})` : ''}
          </p>
        </div>
      </div>
    ) : (
      <div class="p-8 text-center rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 space-y-2">
        <h2 class="text-base font-bold text-slate-800 dark:text-slate-200">Search 9jaBeacon Newsroom</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
          Type any keyword or topic to search through 9jaBeacon's verified stories, investigative reports, policy releases, and sports updates.
        </p>
      </div>
    )}

    <!-- Results Feed -->
    {paginatedResults.length > 0 ? (
      <div class="space-y-3">
        {paginatedResults.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : query ? (
      <div class="p-12 text-center rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="text-3xl">🔍</div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">No stories matched your search</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
          Try broader search terms like “economy”, “sports”, “Lagos”, or check our trending category wires.
        </p>
        <div class="pt-2">
          <a
            href="/"
            class="inline-block px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition"
          >
            Explore Front Page
          </a>
        </div>
      </div>
    ) : null}

    <!-- Search Pagination Controls -->
    {totalPages > 1 && (
      <div class="pt-4 pb-2 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
        {/* Previous Button */}
        {validPage > 1 ? (
          <a
            href={`/search?q=${encodeURIComponent(query)}&page=${validPage - 1}`}
            class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center gap-1.5 shadow-xs"
          >
            <span>&larr;</span>
            <span>Previous</span>
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
            &larr; Previous
          </span>
        )}

        <!-- Page Badges -->
        <div class="flex items-center gap-1.5 overflow-x-auto py-1">
          {pageBadges.map((badge) => (
            <a
              href={`/search?q=${encodeURIComponent(query)}&page=${badge.number}`}
              class={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold font-mono transition ${
                badge.isCurrent
                  ? 'bg-emerald-600 text-white shadow-xs'
                  : 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'
              }`}
            >
              {badge.number}
            </a>
          ))}
        </div>

        {/* Next Button */}
        {validPage < totalPages ? (
          <a
            href={`/search?q=${encodeURIComponent(query)}&page=${validPage + 1}`}
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-xs"
          >
            <span>Next</span>
            <span>&rarr;</span>
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 text-xs font-bold text-slate-400 cursor-not-allowed">
            Next &rarr;
          </span>
        )}
      </div>
    )}
  </section>
</Layout>
