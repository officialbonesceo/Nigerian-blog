---
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import DrawerMenu from '../components/DrawerMenu.astro';
import { getCategories, getSiteSettings } from '../lib/db';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
  };
  canonicalUrl?: string;
  activeNav?: 'home' | 'naija-news' | 'money-hustle' | 'sports' | 'world' | 'category' | 'search' | 'saved' | 'menu' | string;
}

const {
  title = '9jaBeacon - Your Trusted Light on Nigerian News',
  description = 'Fast, verified and unbiased breaking news from Nigeria. National politics, business, economy, sports, tech, energy, and global diaspora updates.',
  image = 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80',
  article,
  canonicalUrl = Astro.url.href,
  activeNav = 'home',
} = Astro.props;

const categories = getCategories();
const siteSettings = getSiteSettings();
const siteName = siteSettings.site_name || '9jaBeacon';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2246%22 fill=%22%23008751%22/><path d=%22M50 15v18M50 67v18M25 25l13 13M62 62l13 13M15 50h18M67 50h18M25 75l13-13M62 38l13-13%22 stroke=%22white%22 stroke-width=%228%22 stroke-linecap=%22round%22/><circle cx=%2250%22 cy=%2250%22 r=%2212%22 fill=%22white%22/></svg>" />
    <link rel="canonical" href={canonicalUrl} />
    <ViewTransitions />
    
    <!-- Dynamic Window Location Origin & Canonical Sync -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined') {
          // Canonical URL strips tracking query parameters and preserves clean path (e.g., https://domain.com/news/slug)
          const cleanCanonicalUrl = window.location.origin + window.location.pathname;
          
          // Dynamically set canonical link
          const canonical = document.querySelector('link[rel="canonical"]');
          if (canonical) canonical.setAttribute('href', cleanCanonicalUrl);
          
          // Dynamically set social meta URLs
          const ogUrl = document.querySelector('meta[property="og:url"]');
          if (ogUrl) ogUrl.setAttribute('content', cleanCanonicalUrl);
          
          const twUrl = document.querySelector('meta[property="twitter:url"]');
          if (twUrl) twUrl.setAttribute('content', cleanCanonicalUrl);
        }
      })();
    </script>
    
    <!-- Inline Theme Initializer (Prevents FOUC Flash) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('9jabeacon_theme') || localStorage.getItem('naijapulse_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#080d1a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />

    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.section && <meta property="article:section" content={article.section} />}

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:site" content="@9jaBeacon" />

    <!-- Google Fonts: Newsreader (Editorial Serif), Outfit (Modern Display), Plus Jakarta Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(
      article ? {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "headline": title,
        "image": [image],
        "datePublished": article.publishedTime,
        "dateModified": article.modifiedTime || article.publishedTime,
        "author": [{
          "@type": "Person",
          "name": article.author || "9jaBeacon Desk"
        }],
        "publisher": {
          "@type": "Organization",
          "name": siteName,
          "logo": {
            "@type": "ImageObject",
            "url": `${Astro.url.origin}/logo.svg`
          }
        },
        "description": description
      } : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": siteName,
        "url": Astro.url.origin,
        "potentialAction": {
          "@type": "SearchAction",
          "target": `${Astro.url.origin}/search?q={search_term_string}`,
          "query-input": "required name=search_term_string"
        }
      }
    )} />

    <style is:global>
      /* Smooth reading transitions & custom typography */
      html {
        scroll-behavior: smooth;
        -webkit-tap-highlight-color: transparent;
      }
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-display {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-editorial {
        font-family: 'Newsreader', Georgia, Cambria, serif;
      }
      
      /* Light / Dark Mode Global Overrides */
      html:not(.dark) body {
        background-color: #f8fafc;
        color: #0f172a;
      }
      html.dark body {
        background-color: #080d1a;
        color: #e2e8f0;
      }
      /* Clean mobile scrollbars */
      ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      html.dark ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
      }
      html:not(.dark) ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* High-Engagement News Reading Experience */
      .article-content {
        transition: font-size 0.15s ease, font-family 0.15s ease;
      }
      .article-content p {
        margin-bottom: 1.5rem;
        line-height: 1.85;
        letter-spacing: -0.01em;
      }
      
      /* Blockquotes with rich editorial accent */
      .article-content blockquote {
        position: relative;
        border-left: 4px solid #10b981;
        padding: 1.1rem 1.25rem;
        margin: 2rem 0;
        font-family: 'Newsreader', Georgia, serif;
        font-size: 1.15em;
        font-style: italic;
        line-height: 1.65;
        border-radius: 0 0.85rem 0.85rem 0;
      }
      html.dark .article-content blockquote {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.08) 0%, rgba(15, 23, 42, 0.4) 100%);
        color: #e2e8f0;
        border-left-color: #10b981;
      }
      html:not(.dark) .article-content blockquote {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.06) 0%, rgba(241, 245, 249, 0.8) 100%);
        color: #1e293b;
        border-left-color: #059669;
      }

      /* Editorial Subheadings: The Scoop, The Stakes, The Stats */
      .article-content h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
        font-size: 1.28rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-top: 2.2rem;
        margin-bottom: 1rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px dashed rgba(148, 163, 184, 0.25);
      }
      html.dark .article-content h3 {
        color: #f8fafc;
      }
      html:not(.dark) .article-content h3 {
        color: #0f172a;
      }
      
      .article-content ul {
        list-style-type: none;
        padding-left: 0;
        margin-bottom: 1.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .article-content li {
        position: relative;
        padding-left: 1.5rem;
        line-height: 1.7;
      }
      .article-content li::before {
        content: '▪';
        position: absolute;
        left: 0.25rem;
        top: 0;
        color: #10b981;
        font-size: 1.25em;
      }

      /* Reading font family modes */
      .reader-serif .article-content {
        font-family: 'Newsreader', Georgia, Cambria, serif;
        font-size: 1.18rem;
        line-height: 1.95;
      }
      .reader-sans .article-content {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        font-size: 1.05rem;
        line-height: 1.85;
      }

      /* Reading font size modes */
      .reader-size-sm .article-content { font-size: 0.95rem; }
      .reader-size-md .article-content { font-size: 1.1rem; }
      .reader-size-lg .article-content { font-size: 1.25rem; }
      .reader-size-xl .article-content { font-size: 1.4rem; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased pb-28 md:pb-12 selection:bg-emerald-600 selection:text-white transition-colors duration-200 overflow-x-hidden">
    <!-- Top Reading Progress Indicator (Visible on scroll) -->
    <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-300 z-50 transition-all duration-75 w-0"></div>

    <!-- Top Header -->
    <Header siteName={siteName} categories={categories} />

    <!-- Main Content Container -->
    <main class="flex-1 w-full max-w-4xl mx-auto px-3 sm:px-6 pt-3 sm:pt-4 pb-8 overflow-hidden">
      <slot />
    </main>

    <!-- Mobile Drawer Menu -->
    <DrawerMenu categories={categories} />

    <!-- Sticky Mobile Bottom Navigation -->
    <BottomNav activeNav={activeNav} />

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none flex flex-col items-center gap-2 transition-all"></div>

    <script is:inline>
      // Global Image Fallback Handler (Catches all broken or missing image loads seamlessly)
      document.addEventListener('error', function(e) {
        if (e.target && e.target.tagName === 'IMG' && !e.target.dataset.hasFallback) {
          e.target.dataset.hasFallback = 'true';
          e.target.src = '/fallback-image.svg';
        }
      }, true);

      // Global Theme Toggler
      window.toggleTheme = function() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('9jabeacon_theme', 'light');
          localStorage.setItem('naijapulse_theme', 'light');
          window.showToast?.('Switched to Light mode', 'info');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('9jabeacon_theme', 'dark');
          localStorage.setItem('naijapulse_theme', 'dark');
          window.showToast?.('Switched to Dark mode', 'info');
        }
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: isDark ? 'light' : 'dark' } }));
      };

      // Global Toast helper
      window.showToast = function(message, type = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `px-4 py-2 rounded-full text-xs font-semibold shadow-xl border backdrop-blur-md transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2 ${
          type === 'success' 
            ? 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200' 
            : 'bg-slate-900/90 border-slate-700 text-slate-100 dark:bg-slate-900/90 dark:border-slate-700 dark:text-slate-100'
        }`;
        toast.innerHTML = `<span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 2400);
      };

      // Real-time Visitor Analytics Logger
      (function() {
        try {
          let visitorId = localStorage.getItem('9jabeacon_visitor_id');
          if (!visitorId) {
            visitorId = 'vis_' + Date.now() + '_' + Math.random().toString(36).slice(2, 9);
            localStorage.setItem('9jabeacon_visitor_id', visitorId);
          }

          let sessionId = sessionStorage.getItem('9jabeacon_session_id');
          if (!sessionId) {
            sessionId = 'ses_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
            sessionStorage.setItem('9jabeacon_session_id', sessionId);
          }

          const path = window.location.pathname;
          if (!path.startsWith('/bonesceo/admin') && !path.startsWith('/api/')) {
            fetch('/api/analytics/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                visitor_id: visitorId,
                session_id: sessionId,
                page_path: path,
                referrer: document.referrer || '',
                device_type: window.innerWidth < 768 ? 'mobile' : 'desktop',
              }),
            }).catch(() => {});
          }
        } catch {}
      })();
    </script>
  </body>
</html>
