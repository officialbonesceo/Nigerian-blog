---
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import DrawerMenu from '../components/DrawerMenu.astro';
import { getCategories, getSiteSettings, getD1 } from '../lib/runtime-db';

interface Props { title?: string; description?: string; image?: string; canonicalUrl?: string; article?: { publishedTime?: string; modifiedTime?: string; author?: string; section?: string }; activeNav?: string; }
const { title='9jaBeacon - Nigerian News', description='Fast, verified Nigerian news and useful updates.', image='https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80', canonicalUrl=Astro.url.href, article, activeNav='home' } = Astro.props;
const d1=getD1(Astro.locals);
const [categories, settings]=await Promise.all([getCategories(d1),getSiteSettings(d1)]);
const siteName=settings.site_name||'9jaBeacon';
---
<!doctype html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#020617" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={image} />
{article && <><meta property="article:published_time" content={article.publishedTime} />{article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}{article.author && <meta property="article:author" content={article.author} />}</>}
<link rel="sitemap" href="/sitemap.xml" />
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased overflow-x-hidden">
<Header siteName={siteName} categories={categories} />
<DrawerMenu siteName={siteName} categories={categories} />
<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 pb-24 pt-3"><slot /></main>
<BottomNav activeNav={activeNav} />
<script is:inline>
window.addEventListener('error',()=>{});
</script>
</body>
</html>
