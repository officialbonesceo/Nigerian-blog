---
import '../index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import DrawerMenu from '../components/DrawerMenu.astro';
import { getCategories, getSiteSettings, getD1 } from '../lib/runtime-db';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  prevUrl?: string;
  nextUrl?: string;
  noIndex?: boolean;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
  };
  activeNav?: string;
  isWideLayout?: boolean;
}

const {
  title = '9jaBeacon - Verified Nigerian News',
  description = "Nigeria's independent digital newsroom. Delivering fast, verified Nigerian news, politics, business, tech, and cultural updates.",
  image = 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80',
  canonicalUrl,
  prevUrl,
  nextUrl,
  noIndex = false,
  article,
  activeNav = 'home',
  isWideLayout = false,
} = Astro.props;

const d1 = getD1(Astro.locals);
const [categories, settings] = await Promise.all([getCategories(d1), getSiteSettings(d1)]);
const siteName = settings.site_name || '9jaBeacon';
const rawSiteBase = (settings.site_url || 'https://www.9jabeacon.name.ng').replace(/\/+$/, '');
const siteBase = rawSiteBase === 'https://9jabeacon.name.ng' ? 'https://www.9jabeacon.name.ng' : rawSiteBase;

// Compute clean absolute canonical URL respecting pagination
const pagePath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageParam = Astro.url.searchParams.get('page');
const parsedPage = pageParam ? parseInt(pageParam, 10) : 1;
const isPaginated = !isNaN(parsedPage) && parsedPage > 1;

let computedPath = '';
if (pagePath === '/') {
  computedPath = isPaginated ? `/?page=${parsedPage}` : '';
} else {
  computedPath = isPaginated ? `${pagePath}?page=${parsedPage}` : pagePath;
}

let computedCanonical = canonicalUrl && canonicalUrl.startsWith('http') && !canonicalUrl.includes('localhost')
  ? canonicalUrl
  : `${siteBase}${computedPath}`;
if (computedCanonical.startsWith('https://9jabeacon.name.ng/')) {
  computedCanonical = computedCanonical.replace('https://9jabeacon.name.ng/', 'https://www.9jabeacon.name.ng/');
}

// Auto-derive prevUrl for pagination if not explicitly passed
const effectivePrevUrl = prevUrl || (isPaginated
  ? (parsedPage === 2
      ? (pagePath === '/' ? `${siteBase}/` : `${siteBase}${pagePath}`)
      : (pagePath === '/' ? `${siteBase}/?page=${parsedPage - 1}` : `${siteBase}${pagePath}?page=${parsedPage - 1}`)
    )
  : undefined);

// Helper to sanitize verification tokens if the user pasted a raw <meta> snippet
function extractVerificationCode(val?: string): string {
  if (!val) return '';
  const trimmed = val.trim();
  const match = trimmed.match(/content=["']([^"']+)["']/i);
  if (match && match[1]) return match[1].trim();
  return trimmed.replace(/^<[^>]+>/, '').replace(/["']/g, '').trim();
}

const googleVerification = extractVerificationCode(settings.google_site_verification);
const bingVerification = extractVerificationCode(settings.bing_site_verification);
const yandexVerification = extractVerificationCode(settings.yandex_site_verification);
const pinterestVerification = extractVerificationCode(settings.pinterest_site_verification);
const baiduVerification = extractVerificationCode(settings.baidu_site_verification);
const facebookVerification = extractVerificationCode(settings.facebook_domain_verification);
const customHeadTags = (settings.custom_head_tags || '').trim();
---
<!doctype html>
<html lang="en" class="dark overflow-x-hidden max-w-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  <link rel="canonical" href={computedCanonical} />
  {effectivePrevUrl && <link rel="prev" href={effectivePrevUrl} />}
  {nextUrl && <link rel="next" href={nextUrl} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#008751" />

  <!-- Ad Network & Smartlink Fast-Load Preconnect / DNS-Prefetch -->
  <link rel="preconnect" href="https://www.highrevenueformat.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.highrevenueformat.com" />
  <link rel="preconnect" href="https://www.profitableratecpmnetwork.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.profitableratecpmnetwork.com" />
  <link rel="preconnect" href="https://pl31396495.profitableratecpmnetwork.com" crossorigin />
  <link rel="dns-prefetch" href="https://pl31396495.profitableratecpmnetwork.com" />
  {googleVerification && (
    <meta name="google-site-verification" content={googleVerification} />
  )}
  {bingVerification && (
    <meta name="msvalidate.01" content={bingVerification} />
  )}
  {yandexVerification && (
    <meta name="yandex-verification" content={yandexVerification} />
  )}
  {pinterestVerification && (
    <meta name="p:domain_verify" content={pinterestVerification} />
  )}
  {baiduVerification && (
    <meta name="baidu-site-verification" content={baiduVerification} />
  )}
  {facebookVerification && (
    <meta name="facebook-domain-verification" content={facebookVerification} />
  )}
  {customHeadTags && (
    <Fragment set:html={customHeadTags} />
  )}

  <!-- Theme Initialization Script (Prevents flash of wrong theme) -->
  <script is:inline>
    (function() {
      try {
        const storedTheme = localStorage.getItem('9jabeacon_theme') || localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={computedCanonical} />
  <meta property="og:image" content={image} />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  {article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.section && <meta property="article:section" content={article.section} />}
    </>
  )}

  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="sitemap" type="application/xml" title="Google News Sitemap" href="/news-sitemap.xml" />

  <!-- Schema.org Publisher & NewsMediaOrganization Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "NewsMediaOrganization",
        "@id": `${siteBase}/#organization`,
        "name": siteName,
        "url": siteBase,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteBase}/favicon.svg`
        },
        "description": description,
        "publishingPrinciples": `${siteBase}/about`,
        "correctionsPolicy": `${siteBase}/disclaimer`,
        "sameAs": [
          settings.social_facebook_url || "https://facebook.com/9jabeacon",
          settings.social_tiktok_url || "https://tiktok.com/@9jabeacon",
          settings.social_youtube_url || "https://youtube.com/@9jabeacon"
        ]
      },
      {
        "@type": "WebSite",
        "@id": `${siteBase}/#website`,
        "url": siteBase,
        "name": siteName,
        "description": description,
        "publisher": {
          "@id": `${siteBase}/#organization`
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": `${siteBase}/search?q={search_term_string}`,
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />
</head>
<body class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased overflow-x-hidden max-w-full relative transition-colors duration-150">
  <Header siteName={siteName} categories={categories} settings={settings} />
  <DrawerMenu siteName={siteName} categories={categories} settings={settings} />
  <main class={isWideLayout ? "w-full max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pb-16 pt-3 sm:pt-4 min-w-0 overflow-x-hidden" : "w-full max-w-4xl mx-auto px-2.5 sm:px-4 md:px-6 pb-12 pt-2 sm:pt-3 min-w-0 overflow-x-hidden"}>
    <slot />
  </main>
  <Footer siteName={siteName} settings={settings} categories={categories} />
  <BottomNav activeNav={activeNav} />
  <script is:inline>
    // Lightweight, debounced visitor telemetry that respects database write limits
    (function() {
      try {
        let sid = sessionStorage.getItem('9ja_sess_id');
        if (!sid) {
          sid = 'sess_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
          sessionStorage.setItem('9ja_sess_id', sid);
        }
        const currentPath = window.location.pathname;
        const pageKey = 'pv_' + currentPath;
        // Only log once per session per page path to dramatically reduce DB writes
        if (!sessionStorage.getItem(pageKey)) {
          sessionStorage.setItem(pageKey, '1');
          const payload = JSON.stringify({
            session_id: sid,
            page_path: currentPath,
            referrer: document.referrer || null,
            device_type: window.innerWidth < 768 ? 'mobile' : 'desktop'
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/analytics/track', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/analytics/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true
            }).catch(function() {});
          }
        }
      } catch (e) {}
    })();
  </script>
</body>
</html>
