{
  "entities": {
    "Comment": {
      "title": "Comment",
      "description": "Public reader perspective and civil commentary on an article",
      "type": "object",
      "properties": {
        "articleSlug": { "type": "string", "maxLength": 200 },
        "articleTitle": { "type": "string", "maxLength": 300 },
        "userName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "content": { "type": "string", "minLength": 3, "maxLength": 1500 },
        "sentiment": { "type": "string", "enum": ["agree", "disagree", "neutral", "perspective"] },
        "parentId": { "type": "string", "maxLength": 100 },
        "replyToUser": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "likesCount": { "type": "number" }
      },
      "required": ["articleSlug", "userName", "content", "sentiment"]
    },
    "WeeklyArticleView": {
      "title": "WeeklyArticleView",
      "description": "Authentic weekly view count for an article to power trending stories",
      "type": "object",
      "properties": {
        "weekKey": { "type": "string", "maxLength": 16 },
        "articleSlug": { "type": "string", "maxLength": 200 },
        "articleTitle": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 80 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "viewsCount": { "type": "number" },
        "lastViewedAt": { "type": "number" }
      },
      "required": ["weekKey", "articleSlug", "viewsCount"]
    }
  },
  "firestore": {
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Reader comments and opinions on published articles"
    },
    "/weekly_article_views/{docId}": {
      "schema": "WeeklyArticleView",
      "description": "Real weekly view statistics that reset every 7 days"
    }
  }
}
